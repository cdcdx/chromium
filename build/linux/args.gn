# 系统公共配置；target_cpu 和 is_component_build 由构建入口按参数替换。
target_os = "linux"
target_cpu = "x64"
is_component_build = false

# Linux 的 libarupa_kernel.so 由独立薄壳 dlopen；PA-E malloc shim 无法在
# 进程初始 ELF scope 中全局覆盖 libc。Skia malloc_usable_size 因跨分配器
# 指针崩溃。Blink 显式 PartitionAlloc 仍保留；BRP 依赖 PA-E，需一同关闭。
use_partition_alloc_as_malloc = false
enable_backup_ref_ptr_support = false

is_debug = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0

ffmpeg_branding = "Chrome"
proprietary_codecs = true
media_use_ffmpeg = true

enable_platform_hevc = true
enable_hevc_parser_and_hw_decoder = true
# HEVC 硬件编解码支持在无平台实现处可能报错；报 undefined 时把下面两行注释掉：
# platform_has_optional_hevc_decode_support = true
# platform_has_optional_hevc_encode_support = true
rtc_use_h264 = true
rtc_use_h265 = true
media_use_openh264 = true
enable_mse_mpeg2ts_stream_parser = true
enable_widevine = true

# Windows专有
# enable_platform_dolby_vision = true
# enable_platform_ac3_eac3_audio = true
# enable_platform_dts_audio = true
