+// 调用方所属的册(根因三/根因四共用): 页面按**页面自身**的册(无痕面板建在临时
+// 分区里, 与 profile 全局开关无关), Worker / 进程按 profile 的册。宿主据此核对
+// 可信 sender 的 incognito, 内核据此保证普通册与无痕册不互相路由。
+TabBook TabBookForCaller(const ExtCallerIdentity &who) {
+  if (who.kind == ExtCallerIdentity::Kind::kWorker) {
+    return who.runtime_incognito_generation != 0 ? TabBook::kIncognito
+                                                 : TabBook::kRegular;
+  }
+  // 页面身份要读 RenderFrameHost/WebContents(UI 独占); 不在 UI 线程时退化为
+  // profile 册, 宁可少报无痕身份也不跨线程碰页面。
+  if (who.kind == ExtCallerIdentity::Kind::kFrame &&
+      content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    content::RenderFrameHost *rfh = content::RenderFrameHost::FromID(
+        who.frame_process_id, who.frame_routing_id);
+    if (rfh) {
+      return TabBookForWebContents(
+          content::WebContents::FromRenderFrameHost(rfh));
+    }
+  }
+  return TabBookForBrowserContext(GetKernelBrowserContextForExtensions());
+}
