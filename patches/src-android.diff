+std::string BuildTrustedContextJsonFor(const ExtCallerIdentity &who,
+                                       const std::string &extension_id,
+                                       const std::string &name,
+                                       int request_id) {
+  base::DictValue d = BuildCallerIdentityJsonFor(who, extension_id);
+  d.Set("method", name);
+  d.Set("requestId", request_id);
+  std::string contract_digest;
+  int64_t contract_epoch = 0;
+  {
+    base::AutoLock guard(Capabilities().lock);
+    contract_digest = Capabilities().contract_digest;
+    contract_epoch = Capabilities().contract_epoch;
+  }
+  d.Set("contractEpoch", base::NumberToString(contract_epoch));
+  d.Set("contractDigest", contract_digest);
+  d.Set("idempotencyKey",
+        ProfileIdForThisRun() + ":" + extension_id + ":" +
+            base::NumberToString(GetExtensionInstallGeneration(extension_id)) +
+            ":" + base::NumberToString(contract_epoch) + ":" +
+            base::NumberToString(request_id));
+  base::ListValue apis_out;
+  base::ListValue origins_out;
+  std::vector<std::string> apis;
+  std::vector<std::string> origins;
+  if (GetGrantedPermissions(extension_id, &apis, &origins)) {
+    for (const std::string &a : apis) {
+      apis_out.Append(a);
+    }
+    for (const std::string &o : origins) {
+      origins_out.Append(o);
+    }
+  }
+  base::DictValue snap;
+  snap.Set("apis", std::move(apis_out));
+  snap.Set("origins", std::move(origins_out));
+  d.Set("permissionSnapshot", std::move(snap));
+  std::string out;
+  base::JSONWriter::Write(base::Value(std::move(d)), &out);
+  return out;
+}
