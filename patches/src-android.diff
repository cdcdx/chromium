+std::string ExtensionApiCapabilityReportJson() {
+  base::DictValue root;
+  root.Set("schemaVersion", 1);
+  root.Set("kernelContractDigest", mv3::contract::kDigest);
+
+  const std::optional<base::DictValue> host_contract =
+      base::JSONReader::ReadDict(ExtApiCapabilitiesSnapshotJson(),
+                                 base::JSON_PARSE_RFC);
+  root.Set("hostContract",
+           host_contract ? host_contract->Clone() : base::DictValue());
+
+  base::ListValue permissions;
+  for (const mv3::PermissionRow &row : mv3::AllPermissions()) {
+    base::DictValue item;
+    item.Set("name", row.name);
+    item.Set("verdict", static_cast<int>(row.verdict));
+    item.Set("verdictName", mv3::PermVerdictName(row.verdict));
+    item.Set("capability", row.capability);
+    item.Set("usable", mv3::IsPermUsable(row.verdict));
+    item.Set("installable", mv3::IsPluginInstallable(row.verdict));
+    item.Set("substitutionGap", mv3::SubstitutionGap(row.name));
+    permissions.Append(std::move(item));
+  }
+  root.Set("permissions", std::move(permissions));
+
+  base::ListValue methods;
+  std::set<std::string> seen_methods;
+  auto append_method = [&](std::string_view name, const char *owner) {
+    if (!seen_methods.insert(std::string(name)).second) {
+      return;
+    }
+    base::DictValue item;
+    item.Set("name", std::string(name));
+    item.Set("owner", owner);
+    item.Set("rendererCapabilityGated", IsRendererHostCapabilityMethod(name));
+    item.Set("hostActive", HostSupportsExtApiMethod(std::string(name)));
+    methods.Append(std::move(item));
+  };
+  for (std::string_view method : kHostOwnedMethods) {
+    append_method(method, "android-host");
+  }
+  for (std::string_view method : kKernelHostBridgeMethods) {
+    append_method(method, "kernel-host-bridge");
+  }
+  root.Set("hostMethods", std::move(methods));
+
+  base::ListValue events;
+  for (std::string_view event : kHostFireableEvents) {
+    base::DictValue item;
+    item.Set("name", std::string(event));
+    item.Set("rendererCapabilityGated", IsRendererHostCapabilityEvent(event));
+    item.Set("hostActive", HostSupportsExtApiEvent(std::string(event)));
+    item.Set("coldWake", HostExtApiEventSupportsColdWake(std::string(event)));
+    events.Append(std::move(item));
+  }
+  root.Set("hostEvents", std::move(events));
+
+  base::ListValue kernel_prefixes;
+  for (std::string_view prefix : kKernelOwnedBridgePrefixes) {
+    kernel_prefixes.Append(std::string(prefix));
+  }
+  root.Set("kernelOwnedPrefixes", std::move(kernel_prefixes));
+
+  std::string json;
+  base::JSONWriter::Write(root, &json);
+  return json;
+}
