+void RedispatchOnUiThread(int64_t scan_gen) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const base::FilePath root = GetExtensionRoot();
+
+  if (root.empty()) {
+    NotifyRuntimeStateMayHaveChanged();
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ScanExtensionDirs, root),
+      base::BindOnce(
+          [](int64_t scan_gen, base::FilePath scanned_root,
+             std::vector<ScannedExtension> items) {
+            DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+            RememberScan(scanned_root, items);
+
+            NotifyScanCompleted(scan_gen);
+            if (items.empty() || scanned_root != GetExtensionRoot()) {
+              return;
+            }
+
+            if (ReadyHosts().empty()) {
+              int registered = 0;
+              for (const ScannedExtension &item : items) {
+                if (ParseAndRegisterExtension(item.dir, item.manifest_json,
+                                              nullptr)) {
+                  ++registered;
+                }
+              }
+              LOG(INFO) << "[arupa] 还没有 renderer ⇒ **只登记不下发**: "
+                        << registered << "/" << items.size()
+                        << " 个扩展已可被 ListExtensions() 看到"
+                           "(下发要等 renderer ready, 那是另一件事)";
+              return;
+            }
+
+            int loaded = 0, failed = 0;
+            for (content::RenderProcessHost *host : ReadyHosts()) {
+              for (const ScannedExtension &item : items) {
+                std::string error;
+
+                if (LoadExtensionFromManifestJson(host, item.dir,
+                                                  item.manifest_json, &error)) {
+                  ++loaded;
+                } else {
+                  ++failed;
+                  LOG(WARNING) << "[arupa] 补发扩展失败 " << item.dir.value()
+                               << " :: " << error;
+                }
+              }
+            }
+            LOG(INFO) << "[arupa] 扩展根后设 ⇒ 回头补发: " << loaded
+                      << " 成功 / " << failed
+                      << " 失败(已发过的算成功, 不会重复下发)";
+          },
+          scan_gen, root));
+
+  NotifyRuntimeStateMayHaveChanged();
+}
