+
+bool IsSafeOpaqueIdentity(std::string_view value, size_t max_length) {
+  if (value.empty() || value.size() > max_length) {
+    return false;
+  }
+  for (const char c : value) {
+    const bool alpha_numeric = (c >= 'a' && c <= 'z') ||
+                               (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
+    if (!alpha_numeric && c != '_' && c != '-' && c != '.') {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<HostRuntimeIdentity> ReadHostRuntimeIdentity() {
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      GetHostRuntimeIdentityJson(), base::JSON_PARSE_RFC);
+  const base::DictValue *value =
+      parsed && parsed->is_dict() ? &parsed->GetDict() : nullptr;
+  if (!value || value->FindInt("version").value_or(0) != 1) {
+    return std::nullopt;
+  }
+  const std::string *account_scope = value->FindString("accountScope");
+  const std::string *session_epoch = value->FindString("sessionEpoch");
+  const std::optional<bool> incognito = value->FindBool("incognitoActive");
+  if (!account_scope || !IsSafeOpaqueIdentity(*account_scope, 256) ||
+      !session_epoch || !IsSafeOpaqueIdentity(*session_epoch, 128) ||
+      !incognito) {
+    return std::nullopt;
+  }
+  HostRuntimeIdentity identity;
+  identity.off_the_record = *incognito;
+  identity.account_scope = *account_scope;
+  identity.session_epoch = *session_epoch;
+  return identity;
+}
+
+std::optional<Pending> TakePending(int request_id) {
+  base::AutoLock guard(S().lock);
+  auto it = S().pending.find(request_id);
+  if (it == S().pending.end()) {
+    return std::nullopt;
+  }
+  Pending p = std::move(it->second);
+  S().pending.erase(it);
+  return p;
+}
+
+void RunPending(Pending p, std::string result_json, std::string error) {
+  if (p.who.runtime_identity_bound && !HostRuntimeIdentityStillCurrent(p.who)) {
+    result_json.clear();
+    error = p.name + ": 宿主账号/无痕会话已变化，迟到回执已拒绝";
+  }
+  if (error.empty() && p.who.runtime_off_the_record &&
+      !IsExtensionIncognitoAccessAllowed(p.extension_id)) {
+    result_json.clear();
+    error = p.name + ": 无痕授权已撤销，迟到回执已拒绝";
+  }
+  if (error.empty() && !ValidateHostApiResult(p.name, result_json, &error)) {
+    // error 由 validator 填写；下面统一清空不可信宿主数据。
+  } else if (error.empty() && p.name.starts_with("storage.sync.") &&
+             (p.name.ends_with(".set") || p.name.ends_with(".remove") ||
+              p.name.ends_with(".clear"))) {
+    const std::optional<base::ListValue> values =
+        base::JSONReader::ReadList(result_json, base::JSON_PARSE_RFC);
+    const base::DictValue *commit =
+        values && values->size() == 1 ? (*values)[0].GetIfDict() : nullptr;
+    const std::optional<HostRuntimeIdentity> identity =
+        ReadHostRuntimeIdentity();
+    const std::string *account =
+        commit ? commit->FindString("accountScope") : nullptr;
+    const std::string *session =
+        commit ? commit->FindString("sessionEpoch") : nullptr;
+    if (!commit || !account || !session || !identity ||
+        *account != identity->account_scope ||
+        *session != identity->session_epoch) {
+      error = p.name + ": storage sync commit scope is stale";
+    } else if (commit->FindBool("conflict").value_or(true)) {
+      error = p.name + ": STORAGE_SYNC_CONFLICT";
+    } else {
+      // commitId/revision 只是宿主与内核的对账回执，标准
+      // chrome.storage Promise 的成功值仍为 void。
+      result_json = "[]";
+    }
+  } else if (error.empty() && p.name == "tabs.query") {
+    error = ScrubHostTabsReply(p.extension_id, p.args_json,
+                               p.who.runtime_off_the_record, &result_json);
+  } else if (error.empty() &&
+             (p.name == "tabs.create" || p.name == "tabs.update" ||
+              p.name == "tabs.duplicate" || p.name == "tabs.move")) {
+    error = ScrubHostTabReply(p.extension_id, p.name,
+                              p.who.runtime_off_the_record, &result_json);
+  } else if (error.empty() && p.name == "tabs.captureVisibleTab") {
+    error = ScrubHostVisibleTabCaptureReply(
+        p.extension_id, p.who.runtime_off_the_record, &result_json);
+  } else if (error.empty() && p.name == "identity.getProfileUserInfo" &&
+             GrantedPermissionsContain(p.extension_id, {"identity.email"},
+                                       {}) != 1) {
+    auto values = base::JSONReader::ReadList(result_json, base::JSON_PARSE_RFC);
+    if (!values || values->empty() || !(*values)[0].is_dict()) {
+      error = "identity.getProfileUserInfo: host returned an invalid result";
+    } else {
+      (*values)[0].GetDict().Set("email", std::string());
+      (*values)[0].GetDict().Set("id", std::string());
+      base::JSONWriter::Write(*values, &result_json);
+    }
+  }
+  // 被权限层拒绝的宿主数据不得跟着 error 穿过 renderer 边界。
+  if (!error.empty()) {
+    result_json.clear();
+  }
+  LOG(INFO) << "[arupa][extapi] " << p.name
+            << (error.empty() ? " 完成 ok" : (" 完成 错误: " + error));
+  std::move(p.callback).Run(result_json, error);
+}
+
+base::TimeDelta TimeoutFor(const std::string &name) {
+  base::AutoLock guard(Ctx().lock);
+  int best_len = -1;
+  int seconds = 0;
+  for (const auto &kv : Ctx().timeout_override) {
+    if (name.compare(0, kv.first.size(), kv.first) == 0 &&
+        static_cast<int>(kv.first.size()) > best_len) {
+      best_len = static_cast<int>(kv.first.size());
+      seconds = kv.second;
+    }
+  }
+  if (seconds > 0) {
+    return base::Seconds(seconds);
+  }
+  // 大插件(AdBlockPlus 量级)一次推几千条规则, 宿主解析 JSON + 重建索引远超 10
+  // 秒; 超时会触发整份规则回滚, 表现为"装了但没生效"。与桌面端给
+  // downloads.download 单独放宽同一手法(桌面是 135 秒)。
+  if (name == "permissions.request") {
+    // Android consent UI waits up to 20 seconds. The host request must remain
+    // live long enough for its explicit answer and the UI-thread handoff.
+    return base::Seconds(30);
+  }
+  if (name == "nomad.dnr.applyDynamicRules" ||
+      name == "declarativeNetRequest.updateDynamicRules" ||
+      name == "declarativeNetRequest.updateSessionRules" ||
+      name == "declarativeNetRequest.updateEnabledRulesets" ||
+      name == "identity.launchWebAuthFlow") {
+    return base::Seconds(name == "identity.launchWebAuthFlow" ? 610 : 60);
+  }
+  // 管理卸载可能包含宿主确认 UI，保留较长超时；网页插件中心已从 Android
+  // 内核删除，不再为 webstore.* 设置特殊通道或超时。
+  if (name == "management.uninstall" || name == "management.uninstallSelf") {
+    return base::Seconds(300);
+  }
+  return kHostTimeout;
+}
+
+void NotifyHostCancel(int request_id, const std::string &extension_id,
+                      const std::string &reason);
+
+void OnTimeout(int request_id) {
+  std::optional<Pending> p = TakePending(request_id);
+  if (!p) {
+    return;
+  }
+  const std::string name = p->name;
+  const int secs = static_cast<int>(TimeoutFor(name).InSeconds());
+  LOG(ERROR) << "[arupa][extapi] " << name << " 宿主 " << secs
+             << " 秒没答 id=" << request_id;
+  {
+    base::AutoLock guard(S().lock);
+    if (S().cancelled.size() >= 1024) {
+      S().cancelled.erase(S().cancelled.begin());
+    }
+    S().cancelled[request_id] = {p->extension_id, p->name};
+    if (HostMethodMayHaveExternalSideEffect(p->name)) {
+      S().reconciliation_required.insert(p->extension_id + "\n" + p->name);
+    }
+  }
+  NotifyHostCancel(request_id, p->extension_id, "host request timed out");
+  RunPending(
+      std::move(*p), std::string(),
+      name + (HostMethodMayHaveExternalSideEffect(name)
+                  ? ": HOST_OPERATION_STATE_UNKNOWN; 已冻结等待取消 ACK/对账"
+                  : ": 宿主未在 " + base::NumberToString(secs) +
+                        " 秒内答复(内核侧超时兜底)"));
+}
+
+void NotifyHostCancel(int request_id, const std::string &extension_id,
+                      const std::string &reason) {
+  if (!S().cancel_registered) {
+    return;
+  }
+  NotifyExtensionApiCancelled(request_id, extension_id, reason);
+}
+
+std::vector<std::pair<int, Pending>>
+TakePendingWhere(const base::RepeatingCallback<bool(const Pending &)> &match) {
+  std::vector<std::pair<int, Pending>> out;
+  base::AutoLock guard(S().lock);
+  for (auto it = S().pending.begin(); it != S().pending.end();) {
+    if (match.Run(it->second)) {
+      out.emplace_back(it->first, std::move(it->second));
+      it = S().pending.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  return out;
+}
+
+void CancelTaken(std::vector<std::pair<int, Pending>> taken,
+                 const std::string &reason) {
+  for (auto &kv : taken) {
+    const int id = kv.first;
+    Pending p = std::move(kv.second);
+    const std::string name = p.name;
+    LOG(WARNING) << "[arupa][extapi] 作废在途请求 id=" << id << " " << name
+                 << " ext=" << p.extension_id << " —— " << reason;
+    {
+      base::AutoLock guard(S().lock);
+      if (S().cancelled.size() >= 1024) {
+        S().cancelled.erase(S().cancelled.begin());
+      }
+      S().cancelled[id] = {p.extension_id, p.name};
+      if (HostMethodMayHaveExternalSideEffect(p.name)) {
+        S().reconciliation_required.insert(p.extension_id + "\n" + p.name);
+      }
+    }
+    NotifyHostCancel(id, p.extension_id, reason);
+    scoped_refptr<base::SequencedTaskRunner> seq = p.seq;
+    if (!seq) {
+      continue;
+    }
+    seq->PostTask(FROM_HERE, base::BindOnce(
+                                 [](Pending pending, std::string why) {
+                                   RunPending(std::move(pending), std::string(),
+                                              why);
+                                 },
+                                 std::move(p), name + ": " + reason));
+  }
+}
