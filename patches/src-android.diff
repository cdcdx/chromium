+namespace {
+
+// 解析宿主规则引擎的回执：只有明说 interception=="active" 才算生效。
+// DNR 失败原因的稳定错误码（S-03）。
+//
+// 插件方要把"引擎未接入 / 规则校验失败 / 回退失败 /
+// 站点上下文错误"分别映射成可操作
+// 文案，靠匹配中文自由文本是不可靠的（而且同一语义在两条路径上文案还不一样）。
+// 所以错误串统一以 `CODE: 人话` 的形式给出：前缀稳定可机读，后半段保留给人看。
+constexpr char kDnrErrEngine[] = "E_DNR_ENGINE_UNAVAILABLE";
+constexpr char kDnrErrValidation[] = "E_DNR_RULE_VALIDATION";
+constexpr char kDnrErrRollback[] = "E_DNR_ROLLBACK_FAILED";
+constexpr char kDnrErrUnsupported[] = "E_DNR_UNSUPPORTED_METHOD";
+// 静态规则集自身的错误（没声明过这个 ruleset id / 启用数超上限 / 结果失败）——
+// 与"规则内容不合法"分开，插件才能分别提示（S-03 要求逐类可识别）。
+constexpr char kDnrErrRuleset[] = "E_DNR_RULESET_INVALID";
+// 已存规则读不出来（存储里的东西损坏/半截）。这时回空数组等于把"读失败"说成
+// "你没有规则" —— 插件会以为规则丢了而重新下发，实际是内核读不到。
+constexpr char kDnrErrStorage[] = "E_DNR_STORAGE_UNREADABLE";
+constexpr char kDnrErrBusy[] = "E_DNR_UPDATE_IN_PROGRESS";
+constexpr char kDnrErrDesynchronized[] = "E_DNR_DESYNCHRONIZED";
+
+// Chromium 把同一扩展的 dynamic/session 更新放在同一条队列。Android 的宿主回执
+// 是异步的，若允许第二次更新在第一次回执前提交，第一次失败会把第二次成功状态
+// 回滚掉。这里按扩展串行 dynamic/session/static-enable；不同扩展互不阻塞。
+struct DnrUpdatesInFlight {
+  base::Lock lock;
+  std::set<std::string> extensions GUARDED_BY(lock);
+  std::set<std::string> desynchronized GUARDED_BY(lock);
+  std::map<std::string, uint64_t> reconciled_generation GUARDED_BY(lock);
+  std::map<std::string, uint64_t> lifecycle_generation GUARDED_BY(lock);
+};
+
+DnrUpdatesInFlight &DnrUpdates() {
+  static base::NoDestructor<DnrUpdatesInFlight> updates;
+  return *updates;
+}
+
+bool BeginDnrUpdate(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  if (DnrUpdates().desynchronized.contains(extension_id)) {
+    return false;
+  }
+  return DnrUpdates().extensions.insert(extension_id).second;
+}
+
+void MarkDnrDesynchronized(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  DnrUpdates().desynchronized.insert(extension_id);
+  DnrUpdates().reconciled_generation.erase(extension_id);
+}
+
+bool DnrDesynchronized(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  return DnrUpdates().desynchronized.contains(extension_id);
+}
+
+bool DnrUpdateInProgress(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  return DnrUpdates().extensions.contains(extension_id);
+}
+
+bool DnrSnapshotReconciled(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  const auto it = DnrUpdates().reconciled_generation.find(extension_id);
+  return it != DnrUpdates().reconciled_generation.end() &&
+         it->second == mv3::DnrActiveEngineGeneration();
+}
+
+bool DnrReceiptLifecycleCurrent(
+    const std::string &extension_id,
+    const mv3::DnrHostReceiptExpectation &expected) {
+  return expected.lifecycle_generation ==
+         HostDnrSnapshotLifecycleGeneration(extension_id);
+}
+
+std::string DnrError(const char *code, const std::string &detail);
+
+std::string DnrReadBlockReason(const std::string &extension_id, bool has_rules,
+                               std::string_view name) {
+  if (DnrDesynchronized(extension_id)) {
+    return DnrError(kDnrErrDesynchronized,
+                    std::string(name) + ": matcher 与规则存储已失同步");
+  }
+  if (DnrUpdateInProgress(extension_id)) {
+    return DnrError(kDnrErrBusy,
+                    std::string(name) + ": 规则事务尚未取得宿主回执");
+  }
+  if (has_rules &&
+      (!mv3::DnrEngineAvailable() || !DnrSnapshotReconciled(extension_id))) {
+    return DnrError(kDnrErrEngine,
+                    std::string(name) + ": 已存规则尚无当前引擎代次的生效回执");
+  }
+  return {};
+}
+
+void FinishDnrUpdate(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  DnrUpdates().extensions.erase(extension_id);
+}
+
+std::string DnrError(const char *code, const std::string &detail) {
+  return std::string(code) + ": " + detail;
+}
+
+// K1(S-02)：DNR 失败时除兼容文本外，额外在结果通道回结构化信封，
+// 插件可按 error.code 机读（不再依赖对 "CODE: 人话" 做字符串切分）。
+std::string DnrFailureJson(const std::string &error) {
+  const size_t sep = error.find(':');
+  base::DictValue err;
+  err.Set("code", sep == std::string::npos ? error : error.substr(0, sep));
+  err.Set("message", error);
+  base::DictValue envelope;
+  envelope.Set("ok", false);
+  envelope.Set("error", std::move(err));
+  return base::WriteJson(envelope).value_or("{}");
+}
+
+// 统一的 DNR 失败出口：结果通道回结构化信封，错误通道保留兼容文本。
+void RunDnrFailure(mojom::ExtApiHost::CallCallback callback,
+                   const std::string &error) {
+  std::move(callback).Run(DnrFailureJson(error), error);
+}
+
+bool DnrReceiptActive(const std::string &result_json, const std::string &error,
+                      const mv3::DnrHostReceiptExpectation &expected,
+                      std::string *reason) {
+  if (expected.engine_generation == 0 ||
+      expected.engine_generation != mv3::DnrActiveEngineGeneration()) {
+    *reason = "宿主规则引擎已切换，旧代次回执无效";
+    return false;
+  }
+  return mv3::DnrApplyReceiptMatches(result_json, error, expected, reason);
+}
+
+void CompensateDnrSnapshot(const std::string &extension_id,
+                           mojom::ExtApiHost::CallCallback callback,
+                           std::string original_error);
+
+// 宿主规则引擎对"这份规则已生效"的回执（动态规则）。失败必须把内核里的规则集回滚
+// —— 否则 getDynamicRules 会报出"存了但从没生效"的规则，等于假保护。
+void OnDnrEngineAck(const std::string &extension_id,
+                    mv3::DnrHostReceiptExpectation expected,
+                    const std::string &before_json,
+                    mojom::ExtApiHost::CallCallback callback,
+                    const std::string &result_json, const std::string &error) {
+  if (!DnrReceiptLifecycleCurrent(extension_id, expected)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(kDnrErrEngine,
+                 "declarativeNetRequest.updateDynamicRules: 扩展实例已切换"));
+    return;
+  }
+  // 回执是权威：宿主说"引擎不可用"就不能当成功。宁可让插件看到明确失败，也不能让它
+  // 以为规则生效了（S-01：无可用引擎不得假显示已保护）。
+  std::string reason;
+  const bool active =
+      DnrReceiptActive(result_json, error, expected, &reason) &&
+      ConfirmHostDnrSnapshotReconciled(extension_id, expected.engine_generation,
+                                       expected.lifecycle_generation);
+  if (!active && reason.empty()) {
+    reason = "宿主规则引擎已切换，旧代次回执无效";
+  }
+  // 不再用单个扩展的回执去翻**全局**引擎开关：那是宿主按设备上报的
+  // (setDnrEngineAvailable)，一个扩展的规则没装上不代表别人的引擎也坏了。
+  // 以前这里会把全局置 false，导致其它扩展跟着报"引擎不可用"(K4)。
+  if (!active) {
+    if (!FindLoadedExtension(extension_id)) {
+      FinishDnrUpdate(extension_id);
+      RunDnrFailure(
+          std::move(callback),
+          DnrError(kDnrErrEngine,
+                   "declarativeNetRequest.updateDynamicRules: " + reason));
+      return;
+    }
+    mv3::ReplaceDynamicRulesJsonAsync(
+        extension_id, before_json,
+        base::BindOnce(
+            [](std::string id, std::string failure,
+               mojom::ExtApiHost::CallCallback done, bool rolled_back) {
+              if (!rolled_back) {
+                LOG(ERROR) << "[arupa][dnr] 规则未生效且回滚失败 ext=" << id
+                           << " 原因=" << failure;
+                MarkDnrDesynchronized(id);
+                FinishDnrUpdate(id);
+                RunDnrFailure(
+                    std::move(done),
+                    DnrError(kDnrErrRollback,
+                             "declarativeNetRequest.updateDynamicRules: " +
+                                 failure + "；且旧规则回滚失败"));
+                return;
+              }
+              CompensateDnrSnapshot(
+                  id, std::move(done),
+                  DnrError(kDnrErrEngine,
+                           "declarativeNetRequest.updateDynamicRules: " +
+                               failure));
+            },
+            extension_id, reason, std::move(callback)));
+    return;
+  }
+  LOG(INFO) << "[arupa][dnr] 规则已生效 ext=" << extension_id
+            << " 宿主回执=" << result_json;
+  FinishDnrUpdate(extension_id);
+  std::move(callback).Run("[]", std::string());
+}
+
+// session rules 的宿主回执。它们不落盘，但与 dynamic 一样必须在宿主确认整份
+// effective snapshot 生效后才向扩展返回成功；失败恢复更新前的进程内快照。
+void OnDnrSessionEngineAck(const std::string &extension_id,
+                           mv3::DnrHostReceiptExpectation expected,
+                           const std::string &before_json,
+                           mojom::ExtApiHost::CallCallback callback,
+                           const std::string &result_json,
+                           const std::string &error) {
+  if (!DnrReceiptLifecycleCurrent(extension_id, expected)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(kDnrErrEngine,
+                 "declarativeNetRequest.updateSessionRules: 扩展实例已切换"));
+    return;
+  }
+  std::string reason;
+  const bool active =
+      DnrReceiptActive(result_json, error, expected, &reason) &&
+      ConfirmHostDnrSnapshotReconciled(extension_id, expected.engine_generation,
+                                       expected.lifecycle_generation);
+  if (!active && reason.empty()) {
+    reason = "宿主规则引擎已切换，旧代次回执无效";
+  }
+  if (!active) {
+    const bool rolled_back =
+        mv3::ReplaceSessionRulesJson(extension_id, before_json);
+    if (!rolled_back) {
+      LOG(ERROR) << "[arupa][dnr] session 规则未生效且回滚失败 ext="
+                 << extension_id << " 原因=" << reason;
+      MarkDnrDesynchronized(extension_id);
+      FinishDnrUpdate(extension_id);
+      RunDnrFailure(
+          std::move(callback),
+          DnrError(kDnrErrRollback,
+                   "declarativeNetRequest.updateSessionRules: " + reason +
+                       "；且旧 session 规则回滚失败, 请停用再启用扩展"));
+      return;
+    }
+    LOG(ERROR) << "[arupa][dnr] session 规则未生效, 已回滚 ext=" << extension_id
+               << " 原因=" << reason;
+    CompensateDnrSnapshot(
+        extension_id, std::move(callback),
+        DnrError(kDnrErrEngine,
+                 "declarativeNetRequest.updateSessionRules: " + reason));
+    return;
+  }
+  LOG(INFO) << "[arupa][dnr] session 规则已生效 ext=" << extension_id
+            << " 宿主回执=" << result_json;
+  FinishDnrUpdate(extension_id);
+  std::move(callback).Run("[]", std::string());
+}
+
+// updateEnabledRulesets 的回执：失败回滚的是**启用集合**，不是动态规则
+// （动态规则没动过，清空它就是误伤）。
+void OnDnrRulesetAck(const std::string &extension_id,
+                     mv3::DnrHostReceiptExpectation expected,
+                     std::vector<std::string> before_enabled,
+                     mojom::ExtApiHost::CallCallback callback,
+                     const std::string &result_json, const std::string &error) {
+  if (!DnrReceiptLifecycleCurrent(extension_id, expected)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(
+            kDnrErrEngine,
+            "declarativeNetRequest.updateEnabledRulesets: 扩展实例已切换"));
+    return;
+  }
+  std::string reason;
+  const bool active =
+      DnrReceiptActive(result_json, error, expected, &reason) &&
+      ConfirmHostDnrSnapshotReconciled(extension_id, expected.engine_generation,
+                                       expected.lifecycle_generation);
+  if (!active && reason.empty()) {
+    reason = "宿主规则引擎已切换，旧代次回执无效";
+  }
+  // 同上：不翻全局开关。
+  if (!active) {
+    if (!FindLoadedExtension(extension_id)) {
+      FinishDnrUpdate(extension_id);
+      RunDnrFailure(
+          std::move(callback),
+          DnrError(kDnrErrEngine,
+                   "declarativeNetRequest.updateEnabledRulesets: " + reason));
+      return;
+    }
+    mv3::ReplaceEnabledRulesetIdsAsync(
+        extension_id, before_enabled,
+        base::BindOnce(
+            [](std::string id, std::string failure_reason,
+               mojom::ExtApiHost::CallCallback done, bool rolled_back) {
+              const std::string failure =
+                  DnrError(rolled_back ? kDnrErrEngine : kDnrErrRollback,
+                           "declarativeNetRequest.updateEnabledRulesets: " +
+                               failure_reason +
+                               (rolled_back ? "" : "；且启用集合回滚失败"));
+              if (rolled_back) {
+                CompensateDnrSnapshot(id, std::move(done), failure);
+              } else {
+                MarkDnrDesynchronized(id);
+                FinishDnrUpdate(id);
+                RunDnrFailure(std::move(done), failure);
+              }
+            },
+            extension_id, reason, std::move(callback)));
+    return;
+  }
+  LOG(INFO) << "[arupa][dnr] 规则集切换已生效 ext=" << extension_id
+            << " 宿主回执=" << result_json;
+  FinishDnrUpdate(extension_id);
+  std::move(callback).Run("[]", std::string());
+}
+
+void OnDnrStaticRulesAck(const std::string &extension_id,
+                         mv3::DnrHostReceiptExpectation expected,
+                         std::string ruleset_id,
+                         std::vector<int> before_disabled,
+                         mojom::ExtApiHost::CallCallback callback,
+                         const std::string &result_json,
+                         const std::string &error) {
+  if (!DnrReceiptLifecycleCurrent(extension_id, expected)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(kDnrErrEngine,
+                 "declarativeNetRequest.updateStaticRules: 扩展实例已切换"));
+    return;
+  }
+  std::string reason;
+  const bool active =
+      DnrReceiptActive(result_json, error, expected, &reason) &&
+      ConfirmHostDnrSnapshotReconciled(extension_id, expected.engine_generation,
+                                       expected.lifecycle_generation);
+  if (!active && reason.empty()) {
+    reason = "宿主规则引擎已切换，旧代次回执无效";
+  }
+  if (!active) {
+    // 卸载已经清空 PluginStorage；迟到回执不能再创建一份孤儿禁用集合。
+    if (!FindLoadedExtension(extension_id)) {
+      FinishDnrUpdate(extension_id);
+      RunDnrFailure(
+          std::move(callback),
+          DnrError(kDnrErrEngine,
+                   "declarativeNetRequest.updateStaticRules: " + reason));
+      return;
+    }
+    mv3::ReplaceDisabledStaticRuleIdsAsync(
+        extension_id, ruleset_id, before_disabled,
+        base::BindOnce(
+            [](std::string id, std::string failure_reason,
+               mojom::ExtApiHost::CallCallback done, bool rolled_back) {
+              const std::string failure = DnrError(
+                  rolled_back ? kDnrErrEngine : kDnrErrRollback,
+                  "declarativeNetRequest.updateStaticRules: " + failure_reason +
+                      (rolled_back ? "" : "；且禁用集合回滚失败"));
+              if (rolled_back) {
+                CompensateDnrSnapshot(id, std::move(done), failure);
+              } else {
+                MarkDnrDesynchronized(id);
+                FinishDnrUpdate(id);
+                RunDnrFailure(std::move(done), failure);
+              }
+            },
+            extension_id, reason, std::move(callback)));
+    return;
+  }
+  LOG(INFO) << "[arupa][dnr] 静态规则启停已生效 ext=" << extension_id
+            << " ruleset=" << ruleset_id << " 宿主回执=" << result_json;
+  FinishDnrUpdate(extension_id);
+  std::move(callback).Run("[]", std::string());
+}
+
+// 静态规则可达数万条；读文件、合并和 JSON 序列化必须离开 UI
+// 序列。宿主约定的入参是只含一个规则数组的 arguments 数组。
+struct DnrPushResult {
+  bool ok = false;
+  std::string error;
+  std::string args_json;
+  mv3::DnrHostReceiptExpectation receipt;
+};
+
+DnrPushResult BuildEffectiveDnrPushJson(
+    const std::string &extension_id,
+    mv3::DnrHostAccessPolicy access_policy) {
+  DnrPushResult result;
+  mv3::DnrSnapshotResult snapshot =
+      mv3::BuildEffectiveRulesSnapshot(extension_id);
+  if (!snapshot.ok) {
+    result.error = snapshot.error_code + ": " + snapshot.error_ruleset_id;
+    return result;
+  }
+  if (snapshot.skipped_rules != 0) {
+    LOG(WARNING) << "[arupa][dnr] 推送快照已跳过无效静态规则 ext="
+                 << extension_id << " skipped=" << snapshot.skipped_rules;
+  }
+  mv3::DnrHostRequest request = mv3::BuildDnrHostRequest(
+      extension_id, snapshot.rules_json, snapshot.rule_count, false,
+      GetExtensionInstallGeneration(extension_id), access_policy);
+  if (!request.ok) {
+    result.error = "DNR_SERIALIZATION_FAILED";
+    return result;
+  }
+  result.args_json = std::move(request.args_json);
+  result.receipt = std::move(request.receipt);
+  result.ok = true;
+  return result;
+}
+
+void CompensateDnrSnapshot(const std::string &extension_id,
+                           mojom::ExtApiHost::CallCallback callback,
+                           std::string original_error) {
+  if (IsExtensionDisabled(extension_id) || !FindLoadedExtension(extension_id)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(std::move(callback), original_error);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&BuildEffectiveDnrPushJson, extension_id,
+                     CaptureDnrHostAccessPolicy(extension_id)),
+      base::BindOnce(
+          [](std::string id, mojom::ExtApiHost::CallCallback done,
+             std::string failure, DnrPushResult old_snapshot) {
+            if (!old_snapshot.ok || IsExtensionDisabled(id)) {
+              MarkDnrDesynchronized(id);
+              FinishDnrUpdate(id);
+              RunDnrFailure(std::move(done),
+                            DnrError(kDnrErrRollback,
+                                     failure + "; compensation build failed: " +
+                                         old_snapshot.error));
+              return;
+            }
+            ExtCallerIdentity control_caller;
+            control_caller.kind = ExtCallerIdentity::Kind::kProcess;
+            old_snapshot.receipt.engine_generation =
+                mv3::DnrActiveEngineGeneration();
+            old_snapshot.receipt.lifecycle_generation =
+                HostDnrSnapshotLifecycleGeneration(id);
+            CallHostApiFromKernelFrom(
+                control_caller, id, "nomad.dnr.applyDynamicRules",
+                old_snapshot.args_json,
+                base::BindOnce(
+                    [](std::string extension_id,
+                       mv3::DnrHostReceiptExpectation expected,
+                       mojom::ExtApiHost::CallCallback callback,
+                       std::string original_error,
+                       const std::string &result_json,
+                       const std::string &host_error) {
+                      if (!DnrReceiptLifecycleCurrent(extension_id, expected)) {
+                        FinishDnrUpdate(extension_id);
+                        RunDnrFailure(std::move(callback), original_error);
+                        return;
+                      }
+                      std::string reason;
+                      if (!DnrReceiptActive(result_json, host_error, expected,
+                                            &reason) ||
+                          !ConfirmHostDnrSnapshotReconciled(
+                              extension_id, expected.engine_generation,
+                              expected.lifecycle_generation)) {
+                        if (reason.empty()) {
+                          reason = "宿主规则引擎已切换，旧代次回执无效";
+                        }
+                        MarkDnrDesynchronized(extension_id);
+                        original_error =
+                            DnrError(kDnrErrRollback,
+                                     original_error +
+                                         "; compensation failed: " + reason);
+                      }
+                      FinishDnrUpdate(extension_id);
+                      RunDnrFailure(std::move(callback), original_error);
+                    },
+                    id, old_snapshot.receipt, std::move(done), failure));
+          },
+          extension_id, std::move(callback), std::move(original_error)));
+}
+
+void PushEnabledRulesetSnapshot(ExtCallerIdentity who, std::string extension_id,
+                                std::vector<std::string> before_enabled,
+                                mojom::ExtApiHost::CallCallback callback,
+                                DnrPushResult push) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (IsExtensionDisabled(extension_id) || !push.ok) {
+    std::string cause = push.ok ? "扩展在规则快照生成期间已被停用"
+                                : "规则快照构建失败: " + push.error;
+    if (!FindLoadedExtension(extension_id)) {
+      FinishDnrUpdate(extension_id);
+      RunDnrFailure(
+          std::move(callback),
+          DnrError(kDnrErrEngine,
+                   "declarativeNetRequest.updateEnabledRulesets: " + cause));
+      return;
+    }
+    mv3::ReplaceEnabledRulesetIdsAsync(
+        extension_id, before_enabled,
+        base::BindOnce(
+            [](std::string id, std::string failure,
+               mojom::ExtApiHost::CallCallback done, bool rolled_back) {
+              if (!rolled_back) {
+                MarkDnrDesynchronized(id);
+              }
+              FinishDnrUpdate(id);
+              RunDnrFailure(
+                  std::move(done),
+                  DnrError(rolled_back ? kDnrErrEngine : kDnrErrRollback,
+                           "declarativeNetRequest.updateEnabledRulesets: " +
+                               failure +
+                               (rolled_back ? ", 更新已回滚"
+                                            : ", 且启用集合回滚失败")));
+            },
+            extension_id, std::move(cause), std::move(callback)));
+    return;
+  }
+  push.receipt.engine_generation = mv3::DnrActiveEngineGeneration();
+  push.receipt.lifecycle_generation =
+      HostDnrSnapshotLifecycleGeneration(extension_id);
+  CallHostApiFromKernelFrom(
+      who, extension_id, "nomad.dnr.applyDynamicRules", push.args_json,
+      base::BindOnce(&OnDnrRulesetAck, extension_id, push.receipt,
+                     std::move(before_enabled), std::move(callback)));
+}
+
+void PushStaticRulesSnapshot(ExtCallerIdentity who, std::string extension_id,
+                             std::string ruleset_id,
+                             std::vector<int> before_disabled,
+                             mojom::ExtApiHost::CallCallback callback,
+                             DnrPushResult push) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (IsExtensionDisabled(extension_id) || !push.ok) {
+    std::string cause = push.ok ? "扩展在规则快照生成期间已被停用"
+                                : "规则快照构建失败: " + push.error;
+    if (!FindLoadedExtension(extension_id)) {
+      FinishDnrUpdate(extension_id);
+      RunDnrFailure(
+          std::move(callback),
+          DnrError(kDnrErrEngine,
+                   "declarativeNetRequest.updateStaticRules: " + cause));
+      return;
+    }
+    mv3::ReplaceDisabledStaticRuleIdsAsync(
+        extension_id, ruleset_id, before_disabled,
+        base::BindOnce(
+            [](std::string id, std::string failure,
+               mojom::ExtApiHost::CallCallback done, bool rolled_back) {
+              if (!rolled_back) {
+                MarkDnrDesynchronized(id);
+              }
+              FinishDnrUpdate(id);
+              RunDnrFailure(
+                  std::move(done),
+                  DnrError(
+                      rolled_back ? kDnrErrEngine : kDnrErrRollback,
+                      "declarativeNetRequest.updateStaticRules: " + failure +
+                          (rolled_back ? ", 更新已回滚"
+                                       : ", 且禁用集合回滚失败")));
+            },
+            extension_id, std::move(cause), std::move(callback)));
+    return;
+  }
+  push.receipt.engine_generation = mv3::DnrActiveEngineGeneration();
+  push.receipt.lifecycle_generation =
+      HostDnrSnapshotLifecycleGeneration(extension_id);
+  CallHostApiFromKernelFrom(
+      who, extension_id, "nomad.dnr.applyDynamicRules", push.args_json,
+      base::BindOnce(&OnDnrStaticRulesAck, extension_id, push.receipt,
+                     std::move(ruleset_id), std::move(before_disabled),
+                     std::move(callback)));
+}
+
+void PushRuntimeRulesSnapshot(bool dynamic, ExtCallerIdentity who,
+                              std::string extension_id, std::string before_json,
+                              mojom::ExtApiHost::CallCallback callback,
+                              DnrPushResult push) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (IsExtensionDisabled(extension_id) || !push.ok) {
+    if (dynamic) {
+      std::string cause = push.ok ? "扩展在规则快照生成期间已被停用"
+                                  : "规则快照构建失败: " + push.error;
+      if (!FindLoadedExtension(extension_id)) {
+        FinishDnrUpdate(extension_id);
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrEngine,
+                     "declarativeNetRequest.updateDynamicRules: " + cause));
+        return;
+      }
+      mv3::ReplaceDynamicRulesJsonAsync(
+          extension_id, before_json,
+          base::BindOnce(
+              [](std::string id, std::string failure,
+                 mojom::ExtApiHost::CallCallback done, bool rolled_back) {
+                if (!rolled_back) {
+                  MarkDnrDesynchronized(id);
+                }
+                FinishDnrUpdate(id);
+                RunDnrFailure(
+                    std::move(done),
+                    DnrError(
+                        rolled_back ? kDnrErrEngine : kDnrErrRollback,
+                        "declarativeNetRequest.updateDynamicRules: " + failure +
+                            (rolled_back ? ", 更新已回滚"
+                                         : ", 且旧规则回滚失败")));
+              },
+              extension_id, std::move(cause), std::move(callback)));
+      return;
+    }
+    const bool rolled_back =
+        mv3::ReplaceSessionRulesJson(extension_id, before_json);
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(rolled_back ? kDnrErrEngine : kDnrErrRollback,
+                 std::string("declarativeNetRequest.update") +
+                     (dynamic ? "DynamicRules" : "SessionRules") +
+                     (push.ok ? ": 扩展在规则快照生成期间已被停用"
+                              : ": 规则快照构建失败: " + push.error) +
+                     (rolled_back ? ", 更新已回滚" : ", 且旧规则回滚失败")));
+    return;
+  }
+  push.receipt.engine_generation = mv3::DnrActiveEngineGeneration();
+  push.receipt.lifecycle_generation =
+      HostDnrSnapshotLifecycleGeneration(extension_id);
+  if (dynamic) {
+    CallHostApiFromKernelFrom(
+        who, extension_id, "nomad.dnr.applyDynamicRules", push.args_json,
+        base::BindOnce(&OnDnrEngineAck, extension_id, push.receipt, before_json,
+                       std::move(callback)));
+  } else {
+    CallHostApiFromKernelFrom(
+        who, extension_id, "nomad.dnr.applyDynamicRules", push.args_json,
+        base::BindOnce(&OnDnrSessionEngineAck, extension_id, push.receipt,
+                       before_json, std::move(callback)));
+  }
+}
