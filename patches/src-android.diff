+extensions::PermissionSet
+FilterByKernelGuard(const extensions::PermissionSet &set,
+                    const extensions::ExtensionId &id) {
+  extensions::APIPermissionSet kept_apis;
+  for (const extensions::APIPermission *permission : set.apis()) {
+    const mv3::PermVerdict verdict = mv3::MapPermission(permission->name());
+    const mv3::ApiPolicy policy = mv3::GetApiPolicy();
+    // 产品策略只能批准指纹类风险，不能凭空制造一个 Android 实现。未知、特权、
+    // 明确不可用的权限无论什么档位都不能进入 renderer 的有效权限集。
+    const bool consented_fingerprint_risk =
+        verdict == mv3::PermVerdict::kDenyFingerprintRisk &&
+        (policy == mv3::ApiPolicy::kAllowAll ||
+         (policy == mv3::ApiPolicy::kConsent &&
+          HasExtensionPermissionConsent(id, permission->name())));
+    if (mv3::IsPermUsable(verdict) || consented_fingerprint_risk) {
+      kept_apis.insert(permission->Clone());
+      continue;
+    }
+    VLOG(1) << "[arupa][guard] API 未授予 ext=" << id
+            << " permission=" << permission->name()
+            << " verdict=" << mv3::PermVerdictName(verdict);
+  }
+
+  extensions::URLPatternSet kept_hosts;
+  for (const URLPattern &pattern : set.explicit_hosts()) {
+    if (pattern.match_all_urls()) {
+      const mv3::HostPolicy policy = mv3::GetHostPolicy();
+      if (policy == mv3::HostPolicy::kStrict) {
+        LOG(WARNING) << "[arupa][guard] 剥 host 权限 ext=" << id
+                     << " pattern=" << pattern.GetAsString()
+                     << " · 档位=" << mv3::HostPolicyName(policy);
+        continue;
+      }
+      LOG(WARNING) << "[arupa][guard] 保留全站 host 权限 ext=" << id
+                   << " · 档位=" << mv3::HostPolicyName(policy);
+    }
+    kept_hosts.AddPattern(pattern);
+  }
+
+  return extensions::PermissionSet(
+      std::move(kept_apis), set.manifest_permissions().Clone(),
+      std::move(kept_hosts), set.scriptable_hosts().Clone());
+}
