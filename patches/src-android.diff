+ExtensionEnableResult SetExtensionEnabledOnUi(const std::string &extension_id,
+                                              bool enabled) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty()) {
+    return {ExtensionEnableStatus::kInvalidExtensionId, false, false};
+  }
+  if (enabled && IsOptionalPermissionDesynchronized(extension_id)) {
+    LOG(ERROR) << "[arupa][perm] 可选权限状态未同步，拒绝启用 ext="
+               << extension_id;
+    return {ExtensionEnableStatus::kOptionalPermissionStateDesynchronized,
+            false, false};
+  }
+  if (!enabled) {
+    // 停用 = 扩展级上下文失效: 作废在途 + 通知宿主清退窗口/租约/待办。
+    InvalidateExtensionContexts(extension_id, "扩展已被停用");
+    // R-03 的另一半: 作废内容脚本代次 —— 停用这一刻还在途的补注入回执必须按迟到
+    // 丢弃, 否则它会在停用之后把旧阅读层"复活"回页面(清单原话: 卸载中的迟到
+    // 回包不能复活旧会话)。
+    InvalidateContentScriptGeneration(extension_id);
+  }
+  bool state_changed = false;
+  {
+    base::AutoLock guard(DisabledLock());
+    const bool was_disabled = DisabledIds().count(extension_id) > 0;
+    if (was_disabled != !enabled) {
+      state_changed = true;
+      if (enabled) {
+        DisabledIds().erase(extension_id);
+      } else {
+        DisabledIds().insert(extension_id);
+      }
+    }
+  }
+  if (enabled) {
+    if (state_changed) {
+      LOG(INFO) << "[arupa] 扩展已启用 id=" << extension_id << " ⇒ 触发补发";
+      RedispatchToReadyRenderers();
+      BumpActionForExtension(extension_id);
+      // R-03: 上面两条只对**之后**加载的文档生效 —— 内容脚本经
+      // mojom::Renderer::UpdateUserScripts 下发, 而渲染侧上游
+      // ScriptInjectionManager::OnUserScriptsUpdated 只擦 pending injection。
+      // 于是"停用 → 重新启用"不会让既有页面恢复阅读层, 用户得刷新页面。
+      // 这里补上缺的那一环: 向**已打开的文档**重注入该扩展的静态内容脚本。
+      // 只在 state_changed(真的发生停用→启用跳变)时补 —— 状态没变还补会把已经
+      // 带着阅读层的页面再注入一遍(双重注入)。
+      ReinjectContentScriptsIntoExistingDocuments(
+          FindLoadedExtension(extension_id));
+    }
+    // 状态没变也要补: 宿主启动/重装后对"内核本来就没停用过"的插件调启用走的正是
+    // 这条早退路径, 而它恰恰是没有经过 Renderer 下发的那一批。见上面的注释。
+    EnsureServiceWorkerForEnabledOnUi(extension_id);
+    // EnsureServiceWorker 的冷扫描通常会触发
+    // ParseAndRegisterExtension；这里再做一次
+    // 幂等恢复，覆盖扩展已经登记、无需扫描的启用路径。
+    RestoreAlarmsForExtension(extension_id);
+    // 同上：启用路径（含早退分支）同样要恢复 unlimitedStorage 的配额结论。
+    SyncUnlimitedStorageForExtension(extension_id);
+    return {state_changed ? ExtensionEnableStatus::kApplied
+                          : ExtensionEnableStatus::kNoChange,
+            true, state_changed};
+  }
+
+  if (!state_changed) {
+    return {ExtensionEnableStatus::kNoChange, false, false};
+  }
+  UnloadFromReadyRenderersOnUi(extension_id);
+  return {ExtensionEnableStatus::kApplied, false, true};
+}
+
+ExtensionEnableResult
+SetExtensionEnabledWithResult(const std::string &extension_id, bool enabled) {
+  if (extension_id.empty()) {
+    return {ExtensionEnableStatus::kInvalidExtensionId, false, false};
+  }
+  if (content::BrowserThread::IsThreadInitialized(content::BrowserThread::UI) &&
+      !content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    return {ExtensionEnableStatus::kWrongSequence,
+            !IsExtensionDisabled(extension_id), false};
+  }
+  return SetExtensionEnabledOnUi(extension_id, enabled);
+}
+
+void SetExtensionEnabled(const std::string &extension_id, bool enabled) {
+  if (extension_id.empty()) {
+    return;
+  }
+  // 扩展表、Renderer、WebContents、补注入任务都归 UI 序列。过去只有停用路径最后
+  // 的 Unload 被切回 UI，前面的失效通知以及整个启用/补注入仍可能从 JNI 宿主线程
+  // 直接运行，正好覆盖 R-03 的 re-enable SIGSEGV 窗口。
+  if (content::BrowserThread::IsThreadInitialized(content::BrowserThread::UI) &&
+      !content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](std::string id, bool new_enabled) {
+                         SetExtensionEnabledOnUi(id, new_enabled);
+                       },
+                       extension_id, enabled));
+    return;
+  }
+  SetExtensionEnabledOnUi(extension_id, enabled);
+}
