+void MaybeInstallArupaInterceptProxy(
+    content::RenderFrameHost *frame, int render_process_id,
+    network::URLLoaderFactoryBuilder &factory_builder) {
+  content::WebContents *web_contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate =
+      GetKernelViewJavaDelegate(web_contents);
+  if (java_delegate.is_null()) {
+    return;
+  }
+
+  mojo::PendingReceiver<network::mojom::URLLoaderFactory> proxied_receiver;
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> target_remote;
+  std::tie(proxied_receiver, target_remote) = factory_builder.Append();
+
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &ArupaProxyingURLLoaderFactory::CreateOnIO, std::move(java_delegate),
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+          TabIdForWebContents(web_contents),
+          // Android 的无痕是逐视图内存分区，不能只看 BrowserContext。
+          TabBookForWebContents(web_contents) == TabBook::kIncognito
+              ? "incognito"
+              : "regular",
+#else
+          -1, "regular",
+#endif
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+          render_process_id, FrameIdOf(frame),
+          FrameIdOf(frame->GetParentOrOuterDocument()), DocumentIdOf(frame),
+          DocumentIdOf(frame->GetParentOrOuterDocument()),
+          DocumentLifecycleOf(frame), FrameTypeOf(frame),
+#else
+          render_process_id, -1, -1, std::string(), std::string(),
+          std::string(), std::string(),
+#endif
+          frame->GetFrameTreeNodeId().value(),
+          frame->GetParent() ? frame->GetParent()->GetFrameTreeNodeId().value()
+                             : -1,
+          std::move(proxied_receiver), std::move(target_remote)));
+}
