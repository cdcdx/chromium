+void OnDynamicRulesCommitted(ExtCallerIdentity who, std::string extension_id,
+                             std::string before_json,
+                             mojom::ExtApiHost::CallCallback callback,
+                             mv3::DnrUpdateOutcome outcome) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!outcome.ok) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(outcome.storage_error ? kDnrErrStorage : kDnrErrValidation,
+                 "declarativeNetRequest.updateDynamicRules: " + outcome.error));
+    return;
+  }
+  if (!FindLoadedExtension(extension_id) || IsExtensionDisabled(extension_id)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(std::move(callback),
+                  DnrError(kDnrErrEngine,
+                           "declarativeNetRequest.updateDynamicRules: "
+                           "扩展在持久提交期间已停用或卸载"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&BuildEffectiveDnrPushJson, extension_id,
+                     CaptureDnrHostAccessPolicy(extension_id)),
+      base::BindOnce(&PushRuntimeRulesSnapshot, true, who, extension_id,
+                     before_json, std::move(callback)));
+}
