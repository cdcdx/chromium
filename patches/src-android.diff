+base::DictValue
+BuildManagementExtensionInfo(const extensions::Extension &extension) {
+  const base::DictValue &manifest = *extension.manifest()->value();
+  base::DictValue info;
+  info.Set("id", extension.id());
+  info.Set("name", extension.name());
+  info.Set("shortName", extension.short_name().empty()
+                            ? extension.name()
+                            : extension.short_name());
+  const std::string *description = manifest.FindString("description");
+  info.Set("description", description ? *description : std::string());
+  info.Set("version", extension.VersionString());
+  if (const std::string *version_name = manifest.FindString("version_name")) {
+    info.Set("versionName", *version_name);
+  }
+  info.Set("mayDisable", true);
+  const bool enabled = !IsExtensionDisabled(extension.id());
+  info.Set("enabled", enabled);
+  if (!enabled) {
+    info.Set("mayEnable", true);
+    info.Set("disabledReason", "unknown");
+  }
+  info.Set("isApp", false);
+  info.Set("type", "extension");
+  info.Set("offlineEnabled",
+           manifest.FindBool("offline_enabled").value_or(false));
+
+  std::string options_url;
+  if (const base::DictValue *options_ui = manifest.FindDict("options_ui")) {
+    if (const std::string *page = options_ui->FindString("page")) {
+      options_url = extension.GetResourceURL(*page).spec();
+    }
+  } else if (const std::string *page = manifest.FindString("options_page")) {
+    options_url = extension.GetResourceURL(*page).spec();
+  }
+  info.Set("optionsUrl", options_url);
+  if (const std::string *homepage = manifest.FindString("homepage_url")) {
+    info.Set("homepageUrl", *homepage);
+  }
+  if (const std::string *update = manifest.FindString("update_url")) {
+    info.Set("updateUrl", *update);
+  }
+
+  if (const base::DictValue *manifest_icons = manifest.FindDict("icons")) {
+    base::ListValue icons;
+    for (const auto [size_text, value] : *manifest_icons) {
+      int size = 0;
+      if (!value.is_string() || !base::StringToInt(size_text, &size) ||
+          size <= 0) {
+        continue;
+      }
+      base::DictValue icon;
+      icon.Set("size", size);
+      icon.Set("url", extension.GetResourceURL(value.GetString()).spec());
+      icons.Append(std::move(icon));
+    }
+    if (!icons.empty()) {
+      info.Set("icons", std::move(icons));
+    }
+  }
+
+  std::vector<std::string> permissions;
+  std::vector<std::string> hosts;
+  GetGrantedPermissions(extension.id(), &permissions, &hosts);
+  base::ListValue permission_values;
+  for (const std::string &permission : permissions) {
+    permission_values.Append(permission);
+  }
+  base::ListValue host_values;
+  for (const std::string &host : hosts) {
+    host_values.Append(host);
+  }
+  info.Set("permissions", std::move(permission_values));
+  info.Set("hostPermissions", std::move(host_values));
+  info.Set("installType", "development");
+  return info;
+}
+
+base::ListValue ManagementWarnings(const extensions::Extension &extension) {
+  base::ListValue warnings;
+  for (const extensions::PermissionMessage &message :
+       extension.permissions_data()->GetPermissionMessages()) {
+    warnings.Append(base::UTF16ToUTF8(message.message()));
+  }
+  return warnings;
+}
+
+void DispatchManagementEvent(const std::string &event_name,
+                             base::DictValue extension_info) {
+  base::ListValue args;
+  args.Append(std::move(extension_info));
+  for (const std::string &observer_id : LoadedExtensionIds()) {
+    if (GrantedPermissionsContain(observer_id, {"management"}, {}) != 1 ||
+        !HasExtensionPermissionConsent(observer_id, "management") ||
+        IsExtensionDisabled(observer_id)) {
+      continue;
+    }
+    DispatchEventToFrames(observer_id, event_name, args, false, true);
+    WakeDispatchToAllActiveServiceWorkers(observer_id, event_name, args.Clone(),
+                                          false);
+  }
+}
