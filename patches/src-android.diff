+// 已存规则在存储里是否还解析得出来（false = 有内容但读不出：损坏/半截）。
+// 读不出来时 GetDynamicRulesJson 会回 "[]"，那等于把"读失败"说成"你没有规则"；
+// 调用方必须先问这一句，再决定是回规则还是回
+// E_DNR_STORAGE_UNREADABLE（S-03 的"回读失败可识别"）。
+bool DynamicRulesStorageIntact(const std::string& extension_id);
+
+// 旧同步兼容/测试入口：返回 true 只表示写入已排队。生产回滚必须使用
+// ReplaceDynamicRulesJsonAsync 等待磁盘提交。传空字符串 = 清空。
+bool ReplaceDynamicRulesJson(const std::string& extension_id,
+                             const std::string& rules_json);
+void ReplaceDynamicRulesJsonAsync(const std::string& extension_id,
+                                  const std::string& rules_json,
+                                  DnrStorageCallback callback);
