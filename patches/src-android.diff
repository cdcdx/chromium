+class AutoDispatchMarker : public base::SupportsUserData::Data {
+public:
+  static const void *Key() {
+    static const int kKey = 0;
+    return &kKey;
+  }
+};
+
+} // namespace
+
+void AttachAutoExtensionDispatch(content::RenderProcessHost *process) {
+  if (!process) {
+    return;
+  }
+
+  if (process->GetUserData(AutoDispatchMarker::Key())) {
+    return;
+  }
+  process->SetUserData(AutoDispatchMarker::Key(),
+                       std::make_unique<AutoDispatchMarker>());
+
+  {
+    const base::FilePath root = GetExtensionRoot();
+    ScanCache &cache = Cache();
+    if (!root.empty() && cache.valid && cache.root == root) {
+      int loaded = 0, failed = 0;
+      for (const ScannedExtension &item : cache.items) {
+        std::string error;
+        if (LoadExtensionFromManifestJson(process, item.dir, item.manifest_json,
+                                          &error)) {
+          ++loaded;
+        } else {
+          ++failed;
+          LOG(WARNING) << "[arupa] WillLaunch 下发失败 "
+                       << item.dir.AsUTF8Unsafe() << " :: " << error;
+        }
+      }
+      if (loaded || failed) {
+        LOG(INFO)
+            << "[arupa][ext] 🟢 **进程启动前**就下发了(导航必然在这之后): "
+            << loaded << " 成功 / " << failed
+            << " 失败 pid=" << process->GetDeprecatedID();
+      }
+    } else {
+      LOG(WARNING) << "[arupa][ext] 🔴 进程启动前**没能下发**(扩展根未设 或 "
+                      "扫盘缓存还是冷的) ⇒ 这个进程要等 Ready 才拿到扩展, "
+                      "而它的导航可能更早 pid="
+                   << process->GetDeprecatedID();
+    }
+  }
+
+  LOG(INFO) << "[arupa][ext] 挂上自动下发观察者 pid="
+            << process->GetDeprecatedID();
+  new AutoDispatchObserver(process);
+}
