+class DnrRulesTest : public Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(root_.CreateUniqueTempDir());
+    PluginStorage::Get().SetRoot(root_.GetPath().AsUTF8Unsafe());
+    extension_id_ = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+  }
+
+  void TearDown() override {
+    ClearSessionRules(extension_id_);
+    ClearDynamicRules(extension_id_);
+    ClearStaticRulesets(extension_id_);
+    task_environment_.RunUntilIdle();
+    PluginStorage::Get().ResetWriterForTesting();
+  }
+
+  // 重新挂根 = 丢掉内存缓存, 从磁盘重建(模拟重启)。
+  void ReloadFromDisk() {
+    task_environment_.RunUntilIdle();
+    PluginStorage::Get().SetRoot(root_.GetPath().AsUTF8Unsafe());
+  }
+
+  std::vector<int> IdsFrom(const std::string& json) {
+    std::vector<int> ids;
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+    if (parsed && parsed->is_list()) {
+      for (const base::Value& v : parsed->GetList()) {
+        const base::DictValue* d = v.GetIfDict();
+        if (d && d->FindInt("id")) {
+          ids.push_back(*d->FindInt("id"));
+        }
+      }
+    }
+    return ids;
+  }
+
+  std::vector<int> StoredIds() {
+    std::vector<int> ids = IdsFrom(GetDynamicRulesJson(extension_id_));
+    std::ranges::sort(ids);
+    return ids;
+  }
+
+  std::vector<int> SessionIds() {
+    return IdsFrom(GetSessionRulesJson(extension_id_));
+  }
+
+  base::DictValue StaticManifest(const std::string& ruleset_id,
+                                 const std::string& path) {
+    base::DictValue resource;
+    resource.Set("id", ruleset_id);
+    resource.Set("path", path);
+    resource.Set("enabled", true);
+    base::ListValue resources;
+    resources.Append(std::move(resource));
+    base::DictValue dnr;
+    dnr.Set("rule_resources", std::move(resources));
+    base::DictValue manifest;
+    manifest.Set("declarative_net_request", std::move(dnr));
+    return manifest;
+  }
+
+  void WriteStaticRules(const std::string& path, const std::vector<int>& ids) {
+    base::ListValue rules;
+    for (int id : ids) {
+      rules.Append(BlockRule(id, "||static.example^"));
+    }
+    const std::string json = base::WriteJson(rules).value_or("[]");
+    ASSERT_TRUE(base::WriteFile(root_.GetPath().AppendASCII(path), json));
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir root_;
+  std::string extension_id_;
+};
