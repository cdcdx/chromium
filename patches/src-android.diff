+namespace {
+
+// 可选权限的"用户决定"账本。存的是**意图**而不是当下的权限位：宿主可以先把授权交进来
+// （甚至在扩展还没被扫描加载时），内核在扩展加载/重载后再按清单核对并应用。
+struct OptionalPermissionIntent {
+  bool grant = false;
+  std::vector<std::string> apis;
+  std::vector<std::string> origins;
+};
+
+constexpr char kOptionalPermissionIntentsKey[] =
+    "optional_permission_intents_v1";
