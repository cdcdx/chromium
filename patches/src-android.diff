+    resources.Append(std::move(resource));
+  }
+  base::DictValue dnr;
+  dnr.Set("rule_resources", std::move(resources));
+  base::DictValue manifest;
+  manifest.Set("declarative_net_request", std::move(dnr));
+
+  ASSERT_EQ(15,
+            RegisterStaticRulesets(extension_id_, root_.GetPath(), manifest));
+  EXPECT_EQ(15u, GetEnabledRulesetIds(extension_id_).size());
+  EXPECT_GE(kMaxStaticRules, 62277);
+}
