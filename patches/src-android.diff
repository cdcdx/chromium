+TEST_F(DnrRulesTest, QueryTreatsOmittedOptionalFilterAsAllRules) {
+  const std::string rules = R"([{"id":1},{"id":2}])";
+  std::string result;
+  std::string error;
+  for (const std::string& args : {"[]", "[null]", "[{}]"}) {
+    SCOPED_TRACE(args);
+    EXPECT_TRUE(BuildDnrRulesQueryResult(rules, args, &result, &error));
+    EXPECT_EQ(R"([[{"id":1},{"id":2}]])", result);
+  }
+  EXPECT_TRUE(BuildDnrRulesQueryResult("[]", "[null]", &result, &error));
+  EXPECT_EQ("[[]]", result);
+  EXPECT_TRUE(
+      BuildDnrRulesQueryResult(rules, R"([{"ruleIds":[2]}])", &result, &error));
+  EXPECT_EQ(R"([[{"id":2}]])", result);
+  EXPECT_TRUE(
+      BuildDnrRulesQueryResult(rules, R"([{"ruleIds":[]}])", &result, &error));
+  EXPECT_EQ("[[]]", result);
+}
+
+TEST_F(DnrRulesTest, QueryRejectsMalformedFilterWithoutChangingRules) {
+  const std::string rules = R"([{"id":1},{"id":2}])";
+  std::string result;
+  std::string error;
+  for (const std::string& args :
+       {"null", R"([1])", R"([{},{}])", R"([{"ruleIds":"2"}])",
+        R"([{"ruleIds":["2"]}])"}) {
+    SCOPED_TRACE(args);
+    EXPECT_FALSE(BuildDnrRulesQueryResult(rules, args, &result, &error));
+    EXPECT_FALSE(error.empty());
+    error.clear();
+  }
+  EXPECT_FALSE(BuildDnrRulesQueryResult("{}", "[null]", &result, &error));
+  EXPECT_EQ("规则快照不是数组", error);
+}
