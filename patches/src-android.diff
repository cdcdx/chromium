+bool ParseColor(const base::Value *v, std::array<int, 4> *out,
+                std::string *why) {
+  if (!v) {
+    *why = "缺 color 字段";
+    return false;
+  }
+  if (v->is_list()) {
+    const base::ListValue &l = v->GetList();
+    if (l.size() != 4) {
+      *why = "color 数组要 4 个分量 [r,g,b,a], 收到 " +
+             base::NumberToString(l.size()) + " 个";
+      return false;
+    }
+    for (size_t i = 0; i < 4; ++i) {
+      if (!l[i].is_int() || l[i].GetInt() < 0 || l[i].GetInt() > 255) {
+        *why = "color 分量必须是 0..255 的整数";
+        return false;
+      }
+      (*out)[i] = l[i].GetInt();
+    }
+    return true;
+  }
+  if (!v->is_string()) {
+    *why = "color 既不是字符串也不是数组";
+    return false;
+  }
+  const std::string s = v->GetString();
+  if (s.empty() || s[0] != '#') {
+    *why = "只支持 #RGB / #RGBA / #RRGGBB / #RRGGBBAA 或 [r,g,b,a], 收到: " + s;
+    return false;
+  }
+  const std::string hex = s.substr(1);
+  auto nib = [](char c, int *n) -> bool {
+    if (c >= '0' && c <= '9') {
+      *n = c - '0';
+      return true;
+    }
+    if (c >= 'a' && c <= 'f') {
+      *n = c - 'a' + 10;
+      return true;
+    }
+    if (c >= 'A' && c <= 'F') {
+      *n = c - 'A' + 10;
+      return true;
+    }
+    return false;
+  };
+  if (hex.size() == 3 || hex.size() == 4) {
+    for (size_t i = 0; i < hex.size(); ++i) {
+      int n = 0;
+      if (!nib(hex[i], &n)) {
+        *why = "十六进制里有非法字符: " + s;
+        return false;
+      }
+      (*out)[i] = n * 17;
+    }
+    if (hex.size() == 3) {
+      (*out)[3] = 255;
+    }
+    return true;
+  }
+  if (hex.size() == 6 || hex.size() == 8) {
+    for (size_t i = 0; i < hex.size(); i += 2) {
+      int hi = 0;
+      int lo = 0;
+      if (!nib(hex[i], &hi) || !nib(hex[i + 1], &lo)) {
+        *why = "十六进制里有非法字符: " + s;
+        return false;
+      }
+      (*out)[i / 2] = hi * 16 + lo;
+    }
+    if (hex.size() == 6) {
+      (*out)[3] = 255;
+    }
+    return true;
+  }
+  *why = "十六进制长度只支持 3/4/6/8 位: " + s;
+  return false;
+}
+
+bool NormalizeExtensionRelativePath(const std::string &in, std::string *out) {
+  if (in.find(':') != std::string::npos || in.find('\\') != std::string::npos) {
+    return false;
+  }
+  size_t start = 0;
+  while (start < in.size() && in[start] == '/') {
+    ++start;
+  }
+  const std::string rel = in.substr(start);
+  for (const std::string_view seg : base::SplitStringPiece(
+           rel, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (seg == "..") {
+      return false;
+    }
+  }
+  *out = rel;
+  return true;
+}
+
+bool HandleKernelOwnedAction(const ExtCallerIdentity &who,
+                             const std::string &extension_id,
+                             const std::string &name,
+                             const std::string &args_json,
+                             mojom::ExtApiHost::CallCallback &callback) {
+  static constexpr const char *kKernelOwned[] = {
+      "action.setBadgeText",
+      "action.getBadgeText",
+      "action.setBadgeBackgroundColor",
+      "action.getBadgeBackgroundColor",
+      "action.setBadgeTextColor",
+      "action.getBadgeTextColor",
+      "action.setTitle",
+      "action.getTitle",
+      "action.setPopup",
+      "action.getPopup",
+      "action.setIcon",
+      "action.enable",
+      "action.disable",
+      "action.isEnabled",
+  };
+  bool matched = false;
+  for (const char *n : kKernelOwned) {
+    if (name == n) {
+      matched = true;
+      break;
+    }
+  }
+  if (!matched) {
+    return false;
+  }
+
+  std::optional<base::ListValue> args =
+      base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+  const base::DictValue *arg = nullptr;
+  if (args) {
+    for (const base::Value &v : *args) {
+      if (v.is_dict()) {
+        arg = &v.GetDict();
+        break;
+      }
+    }
+  }
+
+  auto reply = [&callback](base::ListValue result, const std::string &error) {
+    std::string json;
+    base::JSONWriter::Write(base::Value(std::move(result)), &json);
+    std::move(callback).Run(error.empty() ? json : std::string(), error);
+  };
+
+  int tab_id = -1;
+  const base::Value *tab = arg ? arg->Find("tabId") : nullptr;
+  // action.enable/disable/isEnabled 的 tabId 是第一个整数参数，不在 details
+  // 字典里。
+  if ((name == "action.enable" || name == "action.disable" ||
+       name == "action.isEnabled") &&
+      args && !args->empty() && !(*args)[0].is_none()) {
+    tab = &(*args)[0];
+  }
+  if (tab && !tab->is_none()) {
+    if (!tab->is_int() || tab->GetInt() < 0) {
+      reply(base::ListValue(), name + ": tabId 必须是非负整数");
+      return true;
+    }
+    tab_id = tab->GetInt();
+    TabBook owner = TabBook::kRegular;
+    if (!BookForTabId(tab_id, &owner)) {
+      reply(base::ListValue(),
+            name + (WasTabIdRetired(tab_id) ? ": tabId 已关闭"
+                                            : ": unknown tabId"));
+      return true;
+    }
+    const TabBook caller_book = TabBookForCaller(who);
+    if (owner != caller_book) {
+      reply(base::ListValue(), name + ": TAB_BOOK_MISMATCH: tabId 属于 " +
+                                   TabBookName(owner) + "，调用方属于 " +
+                                   TabBookName(caller_book));
+      return true;
+    }
+    if (!FindWebContentsByTabIdInBook(tab_id, caller_book)) {
+      reply(base::ListValue(), name + ": tabId 已关闭");
+      return true;
+    }
+  }
+
+  const std::string no_ext =
+      name + ": 内核不认识这个扩展(" + extension_id + ")";
+
+  if (name == "action.setBadgeBackgroundColor" ||
+      name == "action.setBadgeTextColor") {
+    std::array<int, 4> rgba = {0, 0, 0, 0};
+    std::string why;
+    if (!ParseColor(arg ? arg->Find("color") : nullptr, &rgba, &why)) {
+      reply(base::ListValue(), name + ": " + why);
+      return true;
+    }
+    const bool ok =
+        (name == "action.setBadgeBackgroundColor")
+            ? SetActionBadgeBackgroundColor(extension_id, rgba, tab_id)
+            : SetActionBadgeTextColor(extension_id, rgba, tab_id);
+    reply(base::ListValue(), ok ? std::string() : no_ext);
+    return true;
+  }
+  if (name == "action.setBadgeText" || name == "action.setTitle" ||
+      name == "action.setPopup") {
+    const char *key = name == "action.setBadgeText" ? "text"
+                      : name == "action.setTitle"   ? "title"
+                                                    : "popup";
+    const base::Value *raw = arg ? arg->Find(key) : nullptr;
+    // schema 中 text 是 optional：绑定层可能把 JS null 规范化成字段缺失。
+    // 指定 tab 时二者都表示删除覆盖；全局调用则保持既有的“清空 badge”语义。
+    if (name == "action.setBadgeText" && (!raw || raw->is_none())) {
+      reply(base::ListValue(),
+            (tab_id >= 0 ? ClearActionBadgeText(extension_id, tab_id)
+                         : SetActionBadgeText(extension_id, std::string()))
+                ? std::string()
+                : no_ext);
+      return true;
+    }
+    if (!raw) {
+      reply(base::ListValue(), name + ": 缺少 " + key + " 字段");
+      return true;
+    }
+    if (!raw->is_string()) {
+      reply(base::ListValue(), name + ": " + key + " 必须是字符串");
+      return true;
+    }
+    std::string value = raw->GetString();
+    if (name == "action.setPopup" &&
+        !NormalizeExtensionRelativePath(value, &value)) {
+      reply(base::ListValue(),
+            name + ": popup 必须是扩展包内的相对路径: " + raw->GetString());
+      return true;
+    }
+    const bool ok = name == "action.setBadgeText"
+                        ? SetActionBadgeText(extension_id, value, tab_id)
+                    : name == "action.setTitle"
+                        ? SetActionTitle(extension_id, value, tab_id)
+                        : SetActionPopup(extension_id, value, tab_id);
+    reply(base::ListValue(), ok ? std::string() : no_ext);
+    return true;
+  }
+  if (name == "action.setIcon") {
+    const base::Value *path = arg ? arg->Find("path") : nullptr;
+    if (!path && arg && arg->Find("imageData")) {
+      // Pixel-backed icons require Android density selection and Bitmap
+      // ownership. Let the exact action.setIcon host capability consume the
+      // serialized ImageData; path-backed icons stay kernel-owned below.
+      return false;
+    }
+    std::string picked;
+    if (path && path->is_string()) {
+      picked = path->GetString();
+    } else if (path && path->is_dict()) {
+      int best = -1;
+      for (const auto kv : path->GetDict()) {
+        int px = 0;
+        if (!base::StringToInt(kv.first, &px) || !kv.second.is_string()) {
+          continue;
+        }
+        if (px > best) {
+          best = px;
+          picked = kv.second.GetString();
+        }
+      }
+    }
+    if (!NormalizeExtensionRelativePath(picked, &picked)) {
+      reply(base::ListValue(), name + ": path 必须是扩展包内的相对路径");
+      return true;
+    }
+    reply(base::ListValue(),
+          SetActionIcon(extension_id, picked, tab_id) ? std::string() : no_ext);
+    return true;
+  }
+  if (name == "action.enable" || name == "action.disable") {
+    reply(base::ListValue(),
+          SetActionEnabled(extension_id, name == "action.enable", tab_id)
+              ? std::string()
+              : no_ext);
+    return true;
+  }
+
+  std::string out;
+  bool on = false;
+  bool ok = false;
+  base::ListValue r;
+  if (name == "action.getBadgeBackgroundColor" ||
+      name == "action.getBadgeTextColor") {
+    std::array<int, 4> rgba = {0, 0, 0, 0};
+    ok = (name == "action.getBadgeBackgroundColor")
+             ? GetActionBadgeBackgroundColor(extension_id, &rgba, tab_id)
+             : GetActionBadgeTextColor(extension_id, &rgba, tab_id);
+    base::ListValue c;
+    for (const int v : rgba) {
+      c.Append(v);
+    }
+    r.Append(base::Value(std::move(c)));
+  } else if (name == "action.getBadgeText") {
+    ok = GetActionBadgeText(extension_id, &out, tab_id);
+    r.Append(out);
+  } else if (name == "action.getTitle") {
+    ok = GetActionTitle(extension_id, &out, tab_id);
+    r.Append(out);
+  } else if (name == "action.getPopup") {
+    ok = GetActionPopup(extension_id, &out, tab_id);
+    r.Append(out);
+  } else if (name == "action.isEnabled") {
+    ok = GetActionEnabled(extension_id, &on, tab_id);
+    r.Append(on);
+  }
+  if (!ok) {
+    reply(base::ListValue(), no_ext);
+  } else {
+    reply(std::move(r), std::string());
+  }
+  return true;
+}
+
+// ── 独立审计(v2 留痕) ───────────────────────────────────────────────────────
+// nomad.sitePermissionAudit.* 由内核账本直接实现; 站点授权读改写转发宿主
+// (内核 contentSettings 为降级不可用, 宿主的 SitePermissions 才是权威后端)。
+// 独立审计权限默认拒绝 —— 仅当用户/宿主授予 nomadSitePermissionAudit 时才把该
+// 子命名空间绑定到特权世界; 未授予按"不可用"返回(插件 try/catch 已按此披露)。
+// 分区 = extension:install:account:session，使账号 + 登录会话 + 扩展 + 装机代次
+// 天然隔离；登出再登录也不能读到上一登录会话的审计数据。
+
+std::string AuditPartitionFor(const ExtCallerIdentity &who,
+                              const std::string &extension_id) {
+  if (!who.runtime_identity_bound || who.account_scope.empty()) {
+    return std::string();
+  }
+  return extension_id + ":" +
+         base::NumberToString(GetExtensionInstallGeneration(extension_id)) +
+         ":acct-" + who.account_scope + ":sess-" + who.session_epoch;
+}
+
+// 设备本地指纹: 与浏览模式无关(不含 OTR 标记), 表示"这台设备上的这个安装"。
+const std::string &DeviceLocalIdForThisRun() {
+  static base::NoDestructor<std::string> id([] {
+    content::BrowserContext *bc = GetKernelBrowserContextForExtensions();
+    std::string seed = "device";
+    if (bc) {
+      seed += bc->GetPath().value();
+    }
+    return "dev-" + base::NumberToString(base::FastHash(seed) & 0xFFFFFFFFull);
+  }());
+  return *id;
+}
+
+// v2 审计上下文: contextId 必须覆盖 profile + 账号 + 会话 + 装机代次(+OTR)，
+// 且在同一会话内稳定
+// —— 插件用 contextId 判"同一次检查", 用安装代次而非 Worker 版本, 这样 Worker
+// 重启后旧事件不会被判为不可信。
+base::DictValue AuditContextJson(const ExtCallerIdentity &who,
+                                 const std::string &extension_id) {
+  const bool otr = TabBookForCaller(who) == TabBook::kIncognito;
+  std::string context_id =
+      ProfileIdForThisRun() + ":" +
+      base::NumberToString(GetExtensionInstallGeneration(extension_id)) + ":" +
+      who.account_scope + ":" + who.session_epoch;
+  if (otr) {
+    context_id += ":otr";
+  }
+  base::DictValue ctx;
+  ctx.Set("profileId", ProfileIdForThisRun());
+  ctx.Set("mode", otr ? "incognito" : "regular");
+  ctx.Set("contextId", std::move(context_id));
+  ctx.Set("deviceLocalId", DeviceLocalIdForThisRun());
+  ctx.Set("accountScope", who.account_scope);
+  ctx.Set("sessionEpoch", who.session_epoch);
+  return ctx;
+}
+
+// 插件以 `source[method](args)` 单对象调用, 这里取入参数组里的第一个对象。
+const base::DictValue *
+FirstDictArg(const std::optional<base::ListValue> &args) {
+  if (!args) {
+    return nullptr;
+  }
+  for (const base::Value &v : *args) {
+    if (v.is_dict()) {
+      return &v.GetDict();
+    }
+  }
+  return nullptr;
+}
+
+// 只接受精确 origin(不含路径/凭据/查询), 否则插件不会把它归因为可信事件。
+bool IsExactOrigin(const std::string &value) {
+  if (value.empty()) {
+    return false;
+  }
+  const GURL g(value);
+  if (!g.SchemeIs("http") && !g.SchemeIs("https")) {
+    return false;
+  }
+  return url::Origin::Create(g).Serialize() == value;
+}
+
+bool SameAuditContext(const base::DictValue &expected,
+                      const base::DictValue &supplied) {
+  for (const char *key : {"profileId", "contextId", "mode", "deviceLocalId",
+                          "accountScope", "sessionEpoch"}) {
+    const std::string *expected_value = expected.FindString(key);
+    const std::string *supplied_value = supplied.FindString(key);
+    if (!expected_value || !supplied_value ||
+        *expected_value != *supplied_value) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<int64_t> SafeRevision(const base::DictValue &request,
+                                    std::string_view field) {
+  const std::optional<double> value = request.FindDouble(field);
+  constexpr double kMaxSafeInteger = 9007199254740991.0;
+  if (!value || !std::isfinite(*value) || *value < 0.0 ||
+      *value > kMaxSafeInteger || std::trunc(*value) != *value) {
+    return std::nullopt;
+  }
+  return static_cast<int64_t>(*value);
+}
+
+constexpr char kSiteAuditPluginId[] = "com.nomadbrowser.trace";
+
+bool IsTrustedSiteAuditConsumer(const std::string &extension_id) {
+  scoped_refptr<const extensions::Extension> extension =
+      FindLoadedExtension(extension_id);
+  if (!extension || !extension->manifest()) {
+    return false;
+  }
+  const std::string *logical_id =
+      extension->manifest()->value()->FindString("nomad_plugin_id");
+  return logical_id && *logical_id == kSiteAuditPluginId;
+}
+
+void DispatchSiteAuditNotice(const std::string &extension_id,
+                             const std::string &event_suffix,
+                             bool wake_worker) {
+  PostToUi(base::BindOnce(
+      [](std::string ext, std::string suffix, bool wake) {
+        if (IsExtensionDisabled(ext)) {
+          return;
+        }
+        const bool native = IsTrustedSiteAuditConsumer(ext) &&
+                            GrantedPermissionsContain(
+                                ext, {"nativeMessaging"}, {}) == 1;
+        const bool legacy =
+            GrantedPermissionsContain(ext, {"nomadSitePermissionAudit"}, {}) ==
+                1 &&
+            HasExtensionPermissionConsent(ext, "nomadSitePermissionAudit");
+        if (!native && !legacy) {
+          return;
+        }
+        for (const auto &[allowed, prefix] :
+             {std::pair{native || legacy, "sitePermissionAudit."},
+              std::pair{legacy, "nomad.sitePermissionAudit."}}) {
+          if (!allowed) {
+            continue;
+          }
+          base::ListValue args;
+          base::DictValue notice;
+          notice.Set("contractVersion", 2);
+          args.Append(std::move(notice));
+          const std::string name = std::string(prefix) + suffix;
+          DispatchEventToFrames(ext, name, args, false, true);
+          if (wake) {
+            WakeDispatchToServiceWorker(ext, name, std::move(args), false);
+          } else {
+            ArupaServiceWorkerHost::DispatchToExtension(ext, name,
+                                                        std::move(args), false);
+          }
+        }
+      },
+      extension_id, event_suffix, wake_worker));
+}
+
+void NotifySiteAuditEventsAvailable(const std::string &extension_id) {
+  DispatchSiteAuditNotice(extension_id, "onEventsAvailable", true);
+}
+
+void NotifySiteAuditContextChanged(const std::string &extension_id) {
+  // MV3 Worker 可以在两次浏览上下文变化之间进入 idle。上下文通知与事件可用
+  // 通知一样必须走冷唤醒；只投递到 LiveHosts 会在 Worker 已停时直接丢弃。
+  // 消费者收到后仍以 getContext 的六字段身份为准，不信任通知载荷。
+  DispatchSiteAuditNotice(extension_id, "onContextChanged", true);
+}
+
+void ReplyAuditControlAfterCommit(
+    std::string extension_id, std::string method_name, std::string partition,
+    ExtCallerIdentity who, base::DictValue context, int64_t expected_revision,
+    mojom::ExtApiHost::CallCallback callback, int result,
+    siteaudit::Control control, bool replayed_events) {
+  if (!HostRuntimeIdentityStillCurrent(who) ||
+      AuditPartitionFor(who, extension_id) != partition) {
+    std::move(callback).Run(
+        std::string(),
+        MakeAuditError(kAuditErrContextStale,
+                       method_name + ": 宿主账号会话或扩展安装代次已经变化"));
+    return;
+  }
+  if (replayed_events && !IsExtensionDisabled(extension_id)) {
+    NotifySiteAuditEventsAvailable(extension_id);
+  }
+  if (result != siteaudit::kOk) {
+    const char *code = kAuditErrStorageUnavailable;
+    if (result == siteaudit::kRevisionConflict) {
+      code = kAuditErrRevisionConflict;
+    } else if (result == siteaudit::kWriteNotCommitted) {
+      code = kAuditErrWriteNotCommitted;
+    } else if (result == siteaudit::kInvalidArgs) {
+      code = kAuditErrBadArgument;
+    } else if (result == siteaudit::kExtensionDisabled) {
+      code = kAuditErrPermissionDenied;
+    }
+    std::string why = "内部错误 code=" + base::NumberToString(result);
+    if (result == siteaudit::kRevisionConflict) {
+      why =
+          "revision 冲突(expected=" + base::NumberToString(expected_revision) +
+          ", current=" + base::NumberToString(siteaudit::Revision(partition)) +
+          ")";
+    }
+    std::move(callback).Run(std::string(),
+                            MakeAuditError(code, method_name + ": " + why));
+    return;
+  }
+  base::DictValue state;
+  state.Set("contractVersion", 2);
+  state.Set("context", std::move(context));
+  state.Set("enabled", control.enabled);
+  state.Set("revision", static_cast<double>(control.revision));
+  state.Set("clearRevision", static_cast<double>(control.clear_revision));
+  state.Set("cursor", control.cursor);
+  base::ListValue reply;
+  reply.Append(std::move(state));
+  std::string json;
+  if (!base::JSONWriter::Write(base::Value(std::move(reply)), &json)) {
+    std::move(callback).Run(std::string(),
+                            MakeAuditError(kAuditErrStorageUnavailable,
+                                           method_name + ": 回包序列化失败"));
+    return;
+  }
+  std::move(callback).Run(json, std::string());
+}
+
+// 实现本体在下面（匿名 namespace，内部链接）。本函数只是它的外部可见入口，
+// 声明在 arupa_ext_api_host.h，供 arupa_native_host.cc 调用。
+bool DispatchSiteAuditMethodImpl(const ExtCallerIdentity &who,
+                                 const std::string &extension_id,
+                                 const std::string &name,
+                                 const std::string &args_json,
+                                 mojom::ExtApiHost::CallCallback &callback,
+                                 bool require_audit_consent);
+
+bool HandleSitePermissionAudit(const ExtCallerIdentity &who,
+                               const std::string &extension_id,
+                               const std::string &name,
+                               const std::string &args_json,
+                               mojom::ExtApiHost::CallCallback &callback) {
+  // The direct binding is shared by the fixed nativeMessaging consumer and
+  // the explicitly consented legacy permission because Chromium cannot
+  // reliably materialize a nested dotted namespace. Dispatch still
+  // distinguishes the two authorization paths and keeps both fail-closed.
+  const bool direct_native = HasApiPrefix(name, "sitePermissionAudit.");
+  return DispatchSiteAuditMethodImpl(who, extension_id, name, args_json,
+                                     callback,
+                                     /*require_audit_consent=*/!direct_native);
+}
+
+// 实现本体：与 HandleSitePermissionAudit 一起位于匿名 namespace 内。
+bool DispatchSiteAuditMethodImpl(const ExtCallerIdentity &who,
+                                 const std::string &extension_id,
+                                 const std::string &name,
+                                 const std::string &args_json,
+                                 mojom::ExtApiHost::CallCallback &callback,
+                                 bool require_audit_consent) {
+  static constexpr std::string_view kLegacyPrefix =
+      "nomad.sitePermissionAudit.";
+  static constexpr std::string_view kDirectPrefix = "sitePermissionAudit.";
+  const std::string_view prefix =
+      HasApiPrefix(name, kDirectPrefix) ? kDirectPrefix : kLegacyPrefix;
+  if (!HasApiPrefix(name, prefix)) {
+    return false;
+  }
+
+  auto reply_obj = [&callback](base::DictValue obj) {
+    base::ListValue out;
+    out.Append(std::move(obj));
+    std::string json;
+    base::JSONWriter::Write(base::Value(std::move(out)), &json);
+    std::move(callback).Run(json, std::string());
+  };
+  // 固定错误码 + 人话（见 arupa_ext_api_host.h 的 AUDIT_* 契约）。
+  //
+  // 此前这里只回 `nomad.sitePermissionAudit.xxx: <中文原因>`，宿主桥再把整串
+  // 包成 code="SITE_PERMISSION_AUDIT_ERROR" —— 插件按 error.code 分支时全部落到
+  // 泛化降级，AUDIT_WRITE_NOT_COMMITTED / AUDIT_CONTEXT_STALE
+  // 等合同分支不可达。 现在错误串统一 `CODE: <方法名>:
+  // <人话>`：前缀机读，后半段给人看/看日志。
+  auto fail = [&callback, &name](const char *code, const std::string &why) {
+    std::move(callback).Run(std::string(),
+                            MakeAuditError(code, name + ": " + why));
+  };
+  // 账本结果码 → 合同错误码。未知/存储类一律 AUDIT_STORAGE_UNAVAILABLE，
+  // 不把内部 code 透给插件。
+  auto result_code = [](int rc) -> const char * {
+    switch (rc) {
+    case siteaudit::kInvalidArgs:
+    case siteaudit::kBadPayload:
+    case siteaudit::kBadContext:
+    case siteaudit::kContractVersion:
+    case siteaudit::kLimitTooLarge:
+      return kAuditErrBadArgument;
+    case siteaudit::kNoPermission:
+    case siteaudit::kExtensionDisabled:
+      return kAuditErrPermissionDenied;
+    case siteaudit::kRevisionConflict:
+      return kAuditErrRevisionConflict;
+    case siteaudit::kWriteNotCommitted:
+      return kAuditErrWriteNotCommitted;
+    default:
+      return kAuditErrStorageUnavailable;
+    }
+  };
+
+  const bool has_explicit_audit_consent =
+      GrantedPermissionsContain(extension_id,
+                                {"nomadSitePermissionAudit"}, {}) == 1 &&
+      HasExtensionPermissionConsent(extension_id,
+                                    "nomadSitePermissionAudit");
+
+  // Legacy callers always require their dedicated manifest permission and
+  // durable user consent. The direct API may use the same explicit path; if
+  // it does not, it falls back to the fixed nativeMessaging product boundary.
+  if (require_audit_consent || has_explicit_audit_consent) {
+    if (!has_explicit_audit_consent) {
+      fail(kAuditErrPermissionDenied,
+           "未授予 nomadSitePermissionAudit 权限(独立审计默认拒绝, 不可用)");
+      return true;
+    }
+  } else {
+    // 固定 native host 不能把账本暴露给任意声明 nativeMessaging 的扩展。
+    // Chromium id 会随签名变化，逻辑产品 id 才是商店签名包的稳定身份。
+    if (!IsTrustedSiteAuditConsumer(extension_id)) {
+      fail(kAuditErrPermissionDenied, "调用方不是受信的网站权限留痕插件");
+      return true;
+    }
+    // 标准 sendNativeMessage 通道的授权依据：清单里的 nativeMessaging 权限。
+    // 留痕 0.4.5 起已从清单移除 nomadSitePermissionAudit，只声明
+    // nativeMessaging —— 沿用旧的逐权限同意会把新包挡死(这正是 T-02
+    // 的启用前置)。 GrantedPermissionsContain: 1=授予, 0=未授予, -1=扩展未加载
+    // ⇒ 只有 1 才放行。
+    if (GrantedPermissionsContain(extension_id, {"nativeMessaging"}, {}) != 1) {
+      fail(kAuditErrPermissionDenied,
+           "标准原生消息要求清单授予 nativeMessaging 权限");
+      return true;
+    }
+  }
+  if (IsExtensionDisabled(extension_id)) {
+    fail(kAuditErrPermissionDenied, "扩展已停用");
+    return true;
+  }
+  if (!who.runtime_identity_bound) {
+    fail(kAuditErrContextStale, "调用方没有绑定宿主账号会话");
+    return true;
+  }
+  if (!HostRuntimeIdentityStillCurrent(who)) {
+    fail(kAuditErrContextStale, "宿主账号/无痕会话已经变化，请重建调用通道");
+    return true;
+  }
+
+  const std::string method = name.substr(prefix.size());
+  const std::string partition = AuditPartitionFor(who, extension_id);
+  const bool caller_is_incognito = TabBookForCaller(who) == TabBook::kIncognito;
+  const base::DictValue context = AuditContextJson(who, extension_id);
+
+  std::optional<base::ListValue> args =
+      base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+  const base::DictValue *req = FirstDictArg(args);
+
+  // RecordingState: 控制视图 + 契约版本 + 上下文(插件 validateRecording 要求)。
+  auto recording_state = [&context](const siteaudit::Control &c) {
+    base::DictValue d;
+    d.Set("contractVersion", 2);
+    d.Set("context", context.Clone());
+    d.Set("enabled", c.enabled);
+    d.Set("revision", static_cast<double>(c.revision));
+    d.Set("clearRevision", static_cast<double>(c.clear_revision));
+    d.Set("cursor", c.cursor);
+    return d;
+  };
+  if (method == "getContext") {
+    reply_obj(context.Clone());
+    return true;
+  }
+
+  if (!req || req->FindInt("contractVersion").value_or(-1) != 2) {
+    fail(kAuditErrBadArgument, "契约版本不受支持(contractVersion 必须为 2)");
+    return true;
+  }
+  const base::DictValue *supplied_context = req->FindDict("context");
+  if (!supplied_context || !SameAuditContext(context, *supplied_context)) {
+    fail(kAuditErrContextStale, "上下文已过期或不属于当前调用方");
+    return true;
+  }
+  if (caller_is_incognito && method != "getCapabilities") {
+    fail(kAuditErrIncognitoForbidden,
+         "无痕模式只允许读取上下文与能力，不读取或更改普通账本/网站授权");
+    return true;
+  }
+
+  if (method == "getCapabilities") {
+    base::DictValue cap;
+    cap.Set("contractVersion", 2);
+    cap.Set("scope", "website-permissions");
+    // v2.2: 事件矩阵从单一 change 扩到 request/result/change(+/use-*)。
+    cap.Set("capabilityVersion", "arupa-audit-v2.2");
+    // 无痕不持久: 插件按 persistent === (mode==='regular') 核对。
+    cap.Set("persistent", !caller_is_incognito);
+    cap.Set("context", context.Clone());
+    const bool can_manage_permissions =
+        GrantedPermissionsContain(extension_id, {"contentSettings"}, {}) == 1;
+    base::ListValue methods;
+    for (const char *supported :
+         {"getContext", "getCapabilities", "readEvents", "getCheckpoint",
+          "getRecording", "setRecording", "clearEvents"}) {
+      methods.Append(supported);
+    }
+    if (can_manage_permissions) {
+      methods.Append("getPermission");
+      methods.Append("setPermission");
+    }
+    cap.Set("methods", std::move(methods));
+    base::DictValue perms;
+    for (const char *p : {"camera", "microphone", "location"}) {
+      base::DictValue item;
+      base::ListValue events;
+      // request/result/change 三类权限全有; use-start/use-end 只有媒体类有
+      // (定位没有"使用开始/结束"的等价信号)。
+      events.Append("request");
+      events.Append("result");
+      if (can_manage_permissions) {
+        events.Append("change");
+      }
+      if (std::string_view(p) != "location") {
+        events.Append("use-start");
+        events.Append("use-end");
+      }
+      item.Set("events", std::move(events));
+      item.Set("query", can_manage_permissions);
+      base::ListValue modify;
+      if (can_manage_permissions) {
+        modify.Append("block");
+        modify.Append("ask");
+      }
+      item.Set("modify", std::move(modify));
+      // openSettings 暂不实现: 宿主没有"跳到该站权限设置页"的链路, 诚实声明
+      // false。
+      item.Set("openSettings", false);
+      perms.Set(p, std::move(item));
+    }
+    cap.Set("permissions", std::move(perms));
+    reply_obj(std::move(cap));
+    return true;
+  }
+
+  if (method == "getRecording" || method == "getCheckpoint") {
+    siteaudit::Control c;
+    const int rc = siteaudit::GetControl(partition, &c);
+    if (rc != siteaudit::kOk) {
+      fail(result_code(rc), "内部错误 code=" + base::NumberToString(rc));
+      return true;
+    }
+    reply_obj(recording_state(c));
+    return true;
+  }
+
+  if (method == "setRecording") {
+    const std::optional<int64_t> expected =
+        SafeRevision(*req, "expectedRevision");
+    const std::optional<bool> enabled = req->FindBool("enabled");
+    if (!expected || !enabled) {
+      fail(kAuditErrBadArgument,
+           "expectedRevision 必须是安全非负整数，enabled 必须是布尔值");
+      return true;
+    }
+    siteaudit::SetRecordingAsync(partition, *expected, *enabled,
+                                 base::BindOnce(&ReplyAuditControlAfterCommit,
+                                                extension_id, name, partition,
+                                                who, context.Clone(), *expected,
+                                                std::move(callback)));
+    return true;
+  }
+
+  if (method == "clearEvents" || method == "clear") {
+    // clear 是"无乐观并发保护的历史别名"(见 api/site_audit.json): 缺
+    // expectedRevision 时按当前版本提交, 不能把文档承诺的别名打成参数错误。
+    std::optional<int64_t> expected = SafeRevision(*req, "expectedRevision");
+    if (!expected) {
+      if (method == "clear") {
+        siteaudit::Control current;
+        if (siteaudit::GetControl(partition, &current) != siteaudit::kOk) {
+          fail(kAuditErrStorageUnavailable, "无法读取当前记录控制版本");
+          return true;
+        }
+        expected = current.revision;
+      } else {
+        fail(kAuditErrBadArgument, "expectedRevision 必须是安全非负整数");
+        return true;
+      }
+    }
+    siteaudit::ClearAsync(partition, *expected,
+                          base::BindOnce(&ReplyAuditControlAfterCommit,
+                                         extension_id, name, partition, who,
+                                         context.Clone(), *expected,
+                                         std::move(callback)));
+    return true;
+  }
+
+  if (method == "readEvents") {
+    const std::string *after_p = req ? req->FindString("after") : nullptr;
+    const std::string after = after_p ? *after_p : std::string();
+    const int limit =
+        req ? req->FindInt("limit").value_or(siteaudit::kMaxPageSize)
+            : siteaudit::kMaxPageSize;
+    std::string json;
+    const int rc = siteaudit::ReadEvents(partition, 2, after, limit, &json);
+    if (rc != siteaudit::kOk) {
+      fail(result_code(rc), "内部错误 code=" + base::NumberToString(rc));
+      return true;
+    }
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+    base::DictValue page = (parsed && parsed->is_dict())
+                               ? std::move(parsed->GetDict())
+                               : base::DictValue();
+    // 账本只产出 events/nextCursor/hasMore; 上下文由内核按当前会话回填, 插件
+    // 用它核对"这一页属于同一次检查"。
+    page.Set("context", context.Clone());
+    page.Set("contractVersion", 2);
+    reply_obj(std::move(page));
+    return true;
+  }
+
+  if (method == "getPermission" || method == "setPermission") {
+    if (GrantedPermissionsContain(extension_id, {"contentSettings"}, {}) != 1) {
+      fail(kAuditErrPermissionDenied,
+           "网站权限管理需要已授予的 contentSettings 权限");
+      return true;
+    }
+    const std::string *req_origin =
+        req ? req->FindString("requestOrigin") : nullptr;
+    const std::string *top_origin =
+        req ? req->FindString("topOrigin") : nullptr;
+    const std::string *permission =
+        req ? req->FindString("permission") : nullptr;
+    if (!req_origin || !top_origin || !permission ||
+        !IsExactOrigin(*req_origin) || !IsExactOrigin(*top_origin)) {
+      fail(kAuditErrBadArgument,
+           "网站权限参数无效(需要精确 origin 与 permission)");
+      return true;
+    }
+    const bool is_set = (method == "setPermission");
+    if (is_set) {
+      const std::string *setting = req->FindString("setting");
+      // 留痕插件只允许收紧或恢复询问；主动放开网站敏感权限仍留给浏览器 UI。
+      if (!setting || (*setting != "block" && *setting != "ask")) {
+        fail(kAuditErrBadArgument,
+             "不支持的权限操作(setting 仅支持 'block'|'ask')");
+        return true;
+      }
+    }
+
+    // 宿主的 SitePermissions 是权威后端: 内核把读/改写转出去, 回包后补上 v2
+    // 上下文; 改写成功再以 change 事件入账并把事件 id 回给插件对账。
+    const uint64_t event_token = is_set ? siteaudit::NewEventToken() : 0;
+    CallHostApiFromKernelFrom(
+        who, extension_id, std::string(kLegacyPrefix) + method, args_json,
+        base::BindOnce(
+            [](std::string extension_id, std::string partition,
+               base::DictValue context, std::string perm,
+               std::string request_origin, std::string top_origin, bool is_set,
+               uint64_t event_token, mojom::ExtApiHost::CallCallback done,
+               const std::string &result_json, const std::string &error) {
+              if (!error.empty()) {
+                // 宿主/底层原始错误统一折成 AUDIT_STORAGE_UNAVAILABLE:
+                // 不把宿主错误域、路径、账号标识透给插件。
+                std::move(done).Run(
+                    std::string(),
+                    MakeAuditError(kAuditErrStorageUnavailable, error));
+                return;
+              }
+              std::optional<base::ListValue> host =
+                  base::JSONReader::ReadList(result_json, base::JSON_PARSE_RFC);
+              const base::DictValue *hv =
+                  (host && !host->empty()) ? (*host)[0].GetIfDict() : nullptr;
+              const std::string *host_setting =
+                  hv ? hv->FindString("setting") : nullptr;
+              if (!host_setting) {
+                std::move(done).Run(
+                    std::string(),
+                    MakeAuditError(kAuditErrStorageUnavailable,
+                                   "宿主返回的站点授权结果无效"));
+                return;
+              }
+              base::DictValue out;
+              out.Set("contractVersion", 2);
+              out.Set("setting", *host_setting);
+              const std::string *profile_id_value =
+                  context.FindString("profileId");
+              const std::string *context_id_value =
+                  context.FindString("contextId");
+              const std::string profile_id =
+                  profile_id_value ? *profile_id_value : std::string();
+              const std::string context_id =
+                  context_id_value ? *context_id_value : std::string();
+              out.Set("context", std::move(context));
+              if (!is_set) {
+                const std::string *restriction =
+                    hv->FindString("systemRestriction");
+                out.Set("systemRestriction",
+                        restriction ? *restriction : std::string("none"));
+              } else {
+                const std::string event_id =
+                    base::Uuid::GenerateRandomV4().AsLowercaseString();
+                base::DictValue ev;
+                ev.Set("profileId", profile_id);
+                ev.Set("contextId", context_id);
+                ev.Set("mode", "regular");
+                ev.Set("attribution", "verified");
+                ev.Set("requestOrigin", request_origin);
+                ev.Set("topOrigin", top_origin);
+                ev.Set("permission", perm);
+                ev.Set("type", "change");
+                ev.Set("eventId", event_id);
+                ev.Set("occurredAt",
+                       base::Time::Now().InMillisecondsFSinceUnixEpoch());
+                ev.Set("result", *host_setting);
+                std::string ev_json;
+                base::JSONWriter::Write(base::Value(std::move(ev)), &ev_json);
+                if (siteaudit::RecordEvent(partition, ev_json, event_token)) {
+                  NotifySiteAuditEventsAvailable(extension_id);
+                }
+                out.Set("changeEventId", event_id);
+              }
+              base::ListValue out_list;
+              out_list.Append(std::move(out));
+              std::string json;
+              base::JSONWriter::Write(base::Value(std::move(out_list)), &json);
+              std::move(done).Run(json, std::string());
+            },
+            extension_id, partition, context.Clone(), *permission, *req_origin,
+            *top_origin, is_set, event_token, std::move(callback)));
+    return true;
+  }
+
+  fail(kAuditErrMethodUnsupported, "不支持的方法");
+  return true;
+}
