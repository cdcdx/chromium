+// 逐风净化 0.4.4 的真实总开关规则形状。它不使用宽泛域名规则：两条精确
+// script regex block；站点例外再追加高优先级 main_frame allowAllRequests。
+// 这条回归同时钉住 resourceTypes 小写字段名，防止它再次被误按 requestMethods
+// 校验，出现“插件可安装、总开关永远打不开”。
+TEST_F(DnrRulesTest, ZhufengShieldDynamicRulesAreAcceptedAndRoundTrip) {
+  auto make_rule = [](int id, int priority, const char* action_type,
+                      const char* regex, const char* resource_type,
+                      bool case_sensitive) {
+    base::DictValue action;
+    action.Set("type", action_type);
+    base::DictValue condition;
+    condition.Set("regexFilter", regex);
+    condition.Set("isUrlFilterCaseSensitive", case_sensitive);
+    base::ListValue resource_types;
+    resource_types.Append(resource_type);
+    condition.Set("resourceTypes", std::move(resource_types));
+    base::DictValue rule;
+    rule.Set("id", id);
+    rule.Set("priority", priority);
+    rule.Set("action", std::move(action));
+    rule.Set("condition", std::move(condition));
+    return rule;
+  };
+
+  base::ListValue enable_rules;
+  enable_rules.Append(make_rule(
+      470000, 1, "block",
+      R"(^https?://pagead2\.googlesyndication\.com\.?(:[0-9]+)?/pagead/js/adsbygoogle\.js([?].*)?$)",
+      "script", true));
+  enable_rules.Append(make_rule(
+      470001, 1, "block",
+      R"(^https?://securepubads\.g\.doubleclick\.net\.?(:[0-9]+)?/tag/js/gpt\.js([?].*)?$)",
+      "script", true));
+
+  DnrUpdateOutcome enabled =
+      UpdateDynamicRules(extension_id_, {}, enable_rules);
+  ASSERT_TRUE(enabled.ok) << enabled.error;
