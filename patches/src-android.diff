+void ForgetParsedExtension(const base::FilePath &extension_dir) {
+  base::AutoLock guard(ParsedCache().lock);
+  if (extension_dir.empty()) {
+    ParsedCache().by_dir.clear();
+    return;
+  }
+  ParsedCache().by_dir.erase(extension_dir.AsUTF8Unsafe());
+}
+
+scoped_refptr<extensions::Extension>
+ParseAndRegisterExtension(const base::FilePath &extension_dir,
+                          const std::string &manifest_json,
+                          std::string *error_out) {
+  auto fail =
+      [error_out](
+          const std::string &msg) -> scoped_refptr<extensions::Extension> {
+    if (error_out) {
+      *error_out = msg;
+    }
+    return nullptr;
+  };
+
+  ArupaExtensionsClient::EnsureInitialized();
+
+  const std::string cache_key = extension_dir.AsUTF8Unsafe();
+  {
+    base::AutoLock guard(ParsedCache().lock);
+    auto it = ParsedCache().by_dir.find(cache_key);
+    // 只有 manifest 原文**完全一致**才复用：清单改过就必须重新解析重新登记，
+    // 否则会一直拿着旧代次的权限与静态规则集。
+    if (it != ParsedCache().by_dir.end() && it->second.first == manifest_json) {
+      return it->second.second;
+    }
+  }
+
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      manifest_json,
+      base::JSON_PARSE_CHROMIUM_EXTENSIONS | base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!parsed || !parsed->is_dict()) {
+    return fail("manifest.json 不是合法 JSON 对象");
+  }
+
+  // Arupa implements private browsing as an independent in-memory partition
+  // with its own renderer and MV3 service worker.  Chromium's default
+  // `spanning` mode assumes that the regular worker is shared and therefore
+  // deliberately omits a worker activation token in an incognito renderer.
+  // Starting an independent OTR worker with that manifest would hit the
+  // renderer's fail-fast token invariant.  Normalize allowed extensions to
+  // `split`; keep an explicit `not_allowed` declaration authoritative.
+  const std::string *incognito_mode = parsed->GetDict().FindString("incognito");
+  if (!incognito_mode || *incognito_mode == "spanning") {
+    parsed->GetDict().Set("incognito", "split");
+  }
+
+  // 本地化：把 manifest 里的 `__MSG_<key>__` 换成 _locales 下的真实文案。
+  //
+  // 扫盘路径(ScanExtensionDirs)已经做了，但**安装/登记路径没有** —— 于是
+  // Extension::Create 拿到的是未替换的占位符，extension->name() 就成了
+  // "__MSG_brandName__"。宿主另有一份独立解析(Mv3ManifestParser)读磁盘原文，
+  // 同样拿到占位符，两边都会把占位符当成插件名显示出来。
+  //
+  // 两条刻意的取舍：
+  //   1) 只在清单确实带 i18n 时才做 —— 绝大多数插件不带，短路保证它们的行为与
+  //      以前逐字一致，不受 LocalizeExtension 对 default_locale 的处理影响；
+  //   2) 失败**不拒装**，只记日志并按原样继续。扫盘路径拒装(FB-A057)是既有严格
+  //      口径；安装路径若照搬，会让"现在能装、只是名字怪"的插件直接装不上。
+  if (parsed->GetDict().contains("default_locale") ||
+      manifest_json.find("__MSG_") != std::string::npos) {
+    std::string l10n_error;
+    if (!extension_l10n_util::LocalizeExtension(
+            extension_dir, &parsed->GetDict(),
+            extension_l10n_util::GetGzippedMessagesPermissionForLocation(
+                extensions::mojom::ManifestLocation::kUnpacked),
+            &l10n_error)) {
+      LOG(WARNING) << "[arupa][ext] 本地化失败, 按原样继续登记(不拒装) dir="
+                   << extension_dir.AsUTF8Unsafe() << " err=" << l10n_error;
+    }
+  }
+
+  std::u16string parse_error;
+  scoped_refptr<extensions::Extension> extension =
+      extensions::Extension::Create(
+          extension_dir, extensions::mojom::ManifestLocation::kUnpacked,
+          parsed->GetDict(), extensions::Extension::NO_FLAGS, &parse_error);
+  if (!extension) {
+    return fail("Extension::Create 失败: " + base::UTF16ToUTF8(parse_error));
+  }
+
+  // 带上 extension 对象：chrome-extension:// 加载要做 web_accessible_resources
+  // 门禁、命中时补 CORS 头、并按 manifest 下发扩展页 CSP（见
+  // arupa_extension_url_loader.cc 的 CreateLoaderAndStart）。只给目录的话这三件
+  // 一件都做不了 —— 以前正是这样：任意网页能读到扩展目录下任意文件。
+  RegisterExtensionPath(extension->id(), extension_dir, extension);
+
+  RegisterExtensionAction(extension.get(), extension_dir.AsUTF8Unsafe());
+  RestoreRuntimeUninstallUrl(extension->id());
+
+  ApplySiteBlocksTo(*extension);
+  // 静态规则集(manifest 的 declarative_net_request.rule_resources)：AdBlockPlus
+  // 这类插件的规则随包分发，必须在这里登记，否则插件只能把几万条规则塞进
+  // dynamic rules（上限 30000 且原子校验，超限整批拒绝）。
+  // manifest()->value() 已经是 const base::DictValue*（154 起不再是 Value*），
+  // 没有 GetDict()，直接解引用即可。
+  const int static_rulesets = mv3::RegisterStaticRulesets(
+      extension->id(), extension_dir, *extension->manifest()->value());
+  if (static_rulesets < 0) {
+    LOG(ERROR) << "[arupa][dnr] 静态规则登记失败 ext=" << extension->id();
+  }
+  if (!IsExtensionDisabled(extension->id())) {
+    // 启动时必须恢复完整 effective snapshot，不能只在静态 ruleset 存在时
+    // 恢复：动态规则也跨重启持久化。登记失败(-1)同样走严格构建路径，
+    // 由失败分支撤下升级前旧 matcher。读取与合并放后台。
+    ScheduleHostDnrSnapshot(extension->id());
+  }
+
+  {
+    base::AutoLock guard(ParsedCache().lock);
+    ParsedCache().by_dir[cache_key] = std::make_pair(manifest_json, extension);
+  }
+
+  RegisterLoadedExtension(extension);
+  // storage.local 的 unlimitedStorage
+  // 配额豁免：登记扩展时就把权限结论推给存储层， 不必等插件先写一次 storage
+  // 才生效（早退路径同样要覆盖，见下面 SetExtensionEnabled）。
+  SyncUnlimitedStorageForExtension(extension->id());
+  // 闹钟属于 browser 进程生命周期能力，不能等扩展先调用 alarms.* 才恢复。
+  // 启动扫描在这里登记扩展时立即排定，届时即使 SW 尚未运行，闹钟到期也能通过
+  // WakeDispatchToServiceWorker 成为冷唤醒源。
+  if (!IsExtensionDisabled(extension->id()) &&
+      GrantedPermissionsContain(extension->id(), {"alarms"}, {}) == 1) {
+    RestoreAlarmsForExtension(extension->id());
+  } else {
+    SuspendAlarmsForExtension(extension->id());
+  }
+  return extension;
+}
+
+bool LoadExtensionFromManifestJson(content::RenderProcessHost *process,
+                                   const base::FilePath &extension_dir,
+                                   const std::string &manifest_json,
+                                   std::string *error_out) {
+  auto fail = [error_out](const std::string &msg) {
+    if (error_out) {
+      *error_out = msg;
+    }
+    return false;
+  };
+
+  scoped_refptr<extensions::Extension> extension =
+      ParseAndRegisterExtension(extension_dir, manifest_json, error_out);
+  if (!extension) {
+    return false;
+  }
+
+  if (IsExtensionDisabled(extension->id())) {
+    VLOG(1) << "[arupa] 扩展被禁用, 跳过下发 id=" << extension->id();
+    return true;
+  }
+
+  const TabBook worker_book =
+      process->GetStoragePartition() &&
+              process->GetStoragePartition()->GetConfig().in_memory()
+          ? TabBook::kIncognito
+          : TabBook::kRegular;
+  if (worker_book == TabBook::kIncognito &&
+      !extensions::IncognitoInfo::IsIncognitoAllowed(extension.get())) {
+    LOG(WARNING) << "[arupa] 扩展清单禁止无痕运行, 跳过内存 Renderer 下发 id="
+                 << extension->id();
+    return true;
+  }
+  if (worker_book == TabBook::kIncognito &&
+      !IsExtensionIncognitoAccessAllowed(extension->id())) {
+    VLOG(1) << "[arupa] 扩展没有无痕授权, 跳过向内存 Renderer 下发 id="
+            << extension->id();
+    return true;
+  }
+
+  if (DispatchedIds::Contains(process, extension->id())) {
+    return true;
+  }
+
+  if (!LoadExtensionIntoRenderer(process, *extension)) {
+    return fail("拿不到 renderer 的 mojo 通道");
+  }
+
+  const auto worker_context =
+      CurrentExtensionWorkerContext(extension->id(), worker_book);
+  if (worker_context) {
+    MaybeStartExtensionServiceWorker(process->GetBrowserContext(), *extension,
+                                     *worker_context);
+  } else if (worker_book == TabBook::kIncognito) {
+    LOG(WARNING) << "[arupa][sw] 无痕 Renderer 在宿主租约建立前出现, "
+                    "不注册后台 ext="
+                 << extension->id();
+  }
+  return true;
+}
+
+bool LoadExtensionDirIntoRenderer(content::RenderProcessHost *process,
+                                  const base::FilePath &extension_dir,
+                                  std::string *error_out) {
+  std::string raw;
+  if (!base::ReadFileToString(extension_dir.AppendASCII("manifest.json"),
+                              &raw)) {
+    if (error_out) {
+      *error_out = "读不到 manifest.json: " + extension_dir.AsUTF8Unsafe();
+    }
+    return false;
+  }
+  return LoadExtensionFromManifestJson(process, extension_dir, raw, error_out);
+}
