+
+bool NotifyExternalContentSettingChanged(const std::string &content_type,
+                                         const std::string &origin,
+                                         const std::string &setting) {
+  const char *resource = mv3::ContentSettingsResourceForType(content_type);
+  if (!resource || !mv3::IsSupportedContentSetting(setting)) {
+    return false;
+  }
+  std::string normalized_origin;
+  std::string error;
+  if (!mv3::OriginFromContentSettingsPattern(origin, &normalized_origin,
+                                             &error)) {
+    return false;
+  }
+  mv3::ContentSettingsTarget target;
+  target.origin = normalized_origin;
+  target.resource = resource;
+  target.primary_pattern = normalized_origin + "/*";
+  DispatchContentSettingsChanged(content_type, target, setting);
+  return true;
+}
+
+bool GetRuntimeUninstallUrlForPurge(const std::string &extension_id,
+                                    std::string *out) {
+  if (!out || extension_id.empty()) {
+    return false;
+  }
+  out->clear();
+  if (GetActionUninstallUrl(extension_id, out) && !out->empty()) {
+    return true;
+  }
+  const std::string stored = mv3::PluginStorage::Get().GetValue(
+      extension_id + "/__arupa_internal", kRuntimeUninstallUrlKey);
+  const auto parsed = base::JSONReader::Read(stored, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_string()) {
+    return false;
+  }
+  const GURL url(parsed->GetString());
+  if (!url.is_valid() || !(url.SchemeIs("http") || url.SchemeIs("https"))) {
+    return false;
+  }
+  *out = url.spec();
+  return true;
+}
+
+bool ConfirmHostDnrSnapshotReconciled(const std::string &extension_id,
+                                      uint64_t engine_generation,
+                                      uint64_t lifecycle_generation) {
+  if (engine_generation == 0 ||
+      engine_generation != mv3::DnrActiveEngineGeneration()) {
+    return false;
+  }
+  base::AutoLock guard(DnrUpdates().lock);
+  if (DnrUpdates().lifecycle_generation[extension_id] != lifecycle_generation) {
+    return false;
+  }
+  DnrUpdates().desynchronized.erase(extension_id);
+  DnrUpdates().reconciled_generation[extension_id] = engine_generation;
+  return true;
+}
+
+uint64_t HostDnrSnapshotLifecycleGeneration(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  return DnrUpdates().lifecycle_generation[extension_id];
+}
+
+void InvalidateHostDnrSnapshotReconciled(const std::string &extension_id) {
+  base::AutoLock guard(DnrUpdates().lock);
+  ++DnrUpdates().lifecycle_generation[extension_id];
+  DnrUpdates().reconciled_generation.erase(extension_id);
+}
+
+void SetExtApiHandlerRegistered(bool registered) {
+  S().registered = registered;
+  LOG(WARNING) << "[arupa][extapi] 宿主处理器 "
+               << (registered ? "已注册" : "已撤销");
+}
+
+void SetExtApiHandlerRegisteredCtx(bool registered) {
+  S().registered_ctx = registered;
+  if (!registered) {
+    {
+      base::AutoLock guard(Capabilities().lock);
+      Capabilities().installed = false;
+      Capabilities().contract_version = 0;
+      Capabilities().cancellation = false;
+      Capabilities().contract_epoch = 0;
+      Capabilities().contract_digest.clear();
+      Capabilities().kernel_contract_digest.clear();
+      Capabilities().host_build.clear();
+      Capabilities().profile_id.clear();
+      Capabilities().account_scope.clear();
+      Capabilities().session_epoch.clear();
+      Capabilities().off_the_record = false;
+      Capabilities().methods.clear();
+      Capabilities().events.clear();
+      Capabilities().data_models.clear();
+    }
+    CancelTaken(TakePendingWhere(
+                    base::BindRepeating([](const Pending &) { return true; })),
+                "context-aware host API handler was removed");
+    for (const std::string &extension_id : LoadedExtensionIds()) {
+      InvalidateExtensionContexts(
+          extension_id,
+          "host API handler removed; recreate extension contexts and bindings");
+    }
+    RefreshExtensionBindingsForHostCapabilities();
+  }
+  LOG(WARNING) << "[arupa][extapi] 宿主处理器(带可信上下文) "
+               << (registered ? "已注册" : "已撤销");
+}
+
+bool IsExtApiHandlerRegistered() {
+  return S().registered || S().registered_ctx;
+}
+
+bool SetExtApiCapabilitiesJson(const std::string &capabilities_json,
+                               std::string *error) {
+  if (error) {
+    error->clear();
+  }
+  if (capabilities_json.empty()) {
+    {
+      base::AutoLock guard(Capabilities().lock);
+      Capabilities().installed = false;
+      Capabilities().contract_version = 0;
+      Capabilities().cancellation = false;
+      Capabilities().contract_epoch = 0;
+      Capabilities().contract_digest.clear();
+      Capabilities().kernel_contract_digest.clear();
+      Capabilities().host_build.clear();
+      Capabilities().profile_id.clear();
+      Capabilities().account_scope.clear();
+      Capabilities().session_epoch.clear();
+      Capabilities().off_the_record = false;
+      Capabilities().methods.clear();
+      Capabilities().events.clear();
+      Capabilities().data_models.clear();
+    }
+    CancelTaken(TakePendingWhere(
+                    base::BindRepeating([](const Pending &) { return true; })),
+                "host capability contract removed");
+    for (const std::string &extension_id : LoadedExtensionIds()) {
+      InvalidateExtensionContexts(
+          extension_id,
+          "host capability removed; recreate extension contexts and bindings");
+    }
+    RefreshExtensionBindingsForHostCapabilities();
+    return true;
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(capabilities_json, base::JSON_PARSE_RFC);
+  const std::optional<int> version =
+      parsed ? parsed->FindInt("contractVersion") : std::nullopt;
+  const std::string *epoch_text =
+      parsed ? parsed->FindString("contractEpoch") : nullptr;
+  const std::string *supplied_digest =
+      parsed ? parsed->FindString("contractDigest") : nullptr;
+  const std::string *kernel_contract_digest =
+      parsed ? parsed->FindString("kernelContractDigest") : nullptr;
+  const std::string *host_build =
+      parsed ? parsed->FindString("hostBuild") : nullptr;
+  const base::DictValue *scope = parsed ? parsed->FindDict("scope") : nullptr;
+  const base::ListValue *methods =
+      parsed ? parsed->FindList("methods") : nullptr;
+  const base::DictValue *events = parsed ? parsed->FindDict("events") : nullptr;
+  const base::DictValue *models =
+      parsed ? parsed->FindDict("dataModels") : nullptr;
+  const std::optional<bool> cancellation_value =
+      parsed ? parsed->FindBool("cancellation") : std::nullopt;
+  int64_t contract_epoch = 0;
+  if (!parsed || !version || *version != 2 || !epoch_text ||
+      !base::StringToInt64(*epoch_text, &contract_epoch) ||
+      contract_epoch <= 0 ||
+      *epoch_text != base::NumberToString(contract_epoch) || !supplied_digest ||
+      supplied_digest->size() != 64 || !kernel_contract_digest ||
+      *kernel_contract_digest != mv3::contract::kDigest || !host_build ||
+      !IsSafeOpaqueIdentity(*host_build, 128) || !scope || !methods ||
+      !events || !models || !cancellation_value) {
+    if (error) {
+      *error =
+          "capability contract requires contractVersion=2, positive string "
+          "contractEpoch, SHA-256 contractDigest, matching "
+          "kernelContractDigest, safe hostBuild, scope, methods, events, "
+          "dataModels and cancellation";
+    }
+    return false;
+  }
+  const std::string *scope_profile = scope->FindString("profileId");
+  const std::string *scope_account = scope->FindString("accountScope");
+  const std::string *scope_session = scope->FindString("sessionEpoch");
+  const std::optional<bool> scope_incognito = scope->FindBool("incognito");
+  const std::optional<HostRuntimeIdentity> current_identity =
+      ReadHostRuntimeIdentity();
+  if (!scope_profile || *scope_profile != ProfileIdForThisRun() ||
+      !scope_account || !scope_session || !scope_incognito ||
+      !current_identity || current_identity->account_scope != *scope_account ||
+      current_identity->session_epoch != *scope_session ||
+      current_identity->off_the_record != *scope_incognito) {
+    if (error) {
+      *error = "capability scope does not match the current runtime identity";
+    }
+    return false;
+  }
+
+  std::set<std::string> next_methods;
+  std::map<std::string, std::pair<bool, bool>> next_events;
+  std::map<std::string, int> next_models;
+  for (const base::Value &value : *methods) {
+    if (!value.is_string() || value.GetString().empty() ||
+        !value.GetString().contains('.')) {
+      if (error) {
+        *error = "capability methods must contain non-empty qualified names";
+      }
+      return false;
+    }
+    if (!IsHostCapabilityMethod(value.GetString())) {
+      if (error) {
+        *error = "capability method is not in the generated exact member "
+                 "registry: " +
+                 value.GetString();
+      }
+      return false;
+    }
+    if (!next_methods.insert(value.GetString()).second) {
+      if (error) {
+        *error = "capability methods contain duplicates";
+      }
+      return false;
+    }
+  }
+  bool has_side_effect_method = false;
+  for (const std::string &method : next_methods) {
+    has_side_effect_method |= HostMethodMayHaveExternalSideEffect(method);
+  }
+  if ((*cancellation_value && !S().cancel_registered) ||
+      (has_side_effect_method && !*cancellation_value)) {
+    if (error) {
+      *error = *cancellation_value
+                   ? "capability cancellation=true requires a registered "
+                     "cancel listener"
+                   : "side-effecting capability methods require "
+                     "cancellation=true";
+    }
+    return false;
+  }
+  for (const auto [name, value] : *events) {
+    if (name.empty() || !name.contains('.') || !value.is_dict()) {
+      if (error) {
+        *error = "capability events must map qualified names to objects";
+      }
+      return false;
+    }
+    if (!IsHostFireableEvent(name)) {
+      if (error) {
+        *error = "capability event is not in the generated event registry: " +
+                 std::string(name);
+      }
+      return false;
+    }
+    const std::optional<bool> cold_wake = value.GetDict().FindBool("coldWake");
+    const std::optional<bool> replay = value.GetDict().FindBool("replay");
+    if (!cold_wake || !replay) {
+      if (error) {
+        *error =
+            "capability event objects require coldWake and replay booleans";
+      }
+      return false;
+    }
+    if (*replay) {
+      if (error) {
+        *error = "capability replay=true is unsupported until a durable "
+                 "generic event ledger is installed";
+      }
+      return false;
+    }
+    next_events.emplace(std::string(name), std::pair(*cold_wake, *replay));
+  }
+  for (const auto [name, value] : *models) {
+    if (name.empty() || !value.is_int() || value.GetInt() < 1) {
+      if (error) {
+        *error = "capability dataModels require positive integer versions";
+      }
+      return false;
+    }
+    next_models.emplace(std::string(name), value.GetInt());
+  }
+
+  struct RequiredModel {
+    std::string_view name;
+    int version;
+  };
+  auto required_model = [](std::string_view member) -> RequiredModel {
+    if (member == "tabs.captureVisibleTab") {
+      return {"TabCapture", 1};
+    }
+    if (member.starts_with("tabs.")) {
+      return {"Tab", 2};
+    }
+    if (member.starts_with("history.")) {
+      return {"HistoryItem", 1};
+    }
+    if (member.starts_with("downloads.")) {
+      return {"DownloadItem", 1};
+    }
+    if (member.starts_with("bookmarks.")) {
+      return {"BookmarkTreeNode", 1};
+    }
+    if (member.starts_with("notifications.")) {
+      return {"Notification", 1};
+    }
+    if (member.starts_with("sessions.")) {
+      return {"Session", 1};
+    }
+    if (member.starts_with("management.")) {
+      return {"ExtensionInfo", 1};
+    }
+    if (member.starts_with("declarativeContent.")) {
+      return {"DeclarativeRule", 1};
+    }
+    if (member.starts_with("declarativeNetRequest.") ||
+        member.starts_with("nomad.dnr.")) {
+      return {"DnrMatcher", 1};
+    }
+    if (member.starts_with("contentSettings.")) {
+      return {"ContentSetting", 1};
+    }
+    if (member.starts_with("system.cpu.")) {
+      return {"CpuInfo", 1};
+    }
+    if (member.starts_with("system.memory.")) {
+      return {"MemoryInfo", 1};
+    }
+    if (member.starts_with("search.")) {
+      return {"SearchProvider", 1};
+    }
+    if (member.starts_with("i18n.")) {
+      return {"LocaleList", 1};
+    }
+    if (member.starts_with("action.")) {
+      return {"ActionState", 1};
+    }
+    if (member.starts_with("identity.")) {
+      return {"IdentityProfile", 1};
+    }
+    if (member.starts_with("cookies.")) {
+      return {"Cookie", 1};
+    }
+    if (member.starts_with("storage.sync.")) {
+      return {"StorageSync", 2};
+    }
+    if (member.starts_with("storage.managed.")) {
+      return {"StorageManaged", 1};
+    }
+    if (member == "storage.onChanged" || member == "storage.sync.onChanged" ||
+        member == "storage.managed.onChanged") {
+      return {"StorageChange", 2};
+    }
+    return {};
+  };
+  auto validate_model = [&](std::string_view member) -> bool {
+    const RequiredModel required = required_model(member);
+    if (required.name.empty()) {
+      return true;
+    }
+    const auto it = next_models.find(std::string(required.name));
+    if (it != next_models.end() && it->second == required.version) {
+      return true;
+    }
+    if (error) {
+      *error = "capability member " + std::string(member) +
+               " requires dataModels." + std::string(required.name) + "=" +
+               base::NumberToString(required.version);
+    }
+    return false;
+  };
+  for (const std::string &method : next_methods) {
+    if (!validate_model(method)) {
+      return false;
+    }
+    if (method == "tabs.captureVisibleTab") {
+      const auto tab_model = next_models.find("Tab");
+      if (tab_model == next_models.end() || tab_model->second != 2) {
+        if (error) {
+          *error = "capability member tabs.captureVisibleTab requires "
+                   "dataModels.Tab=2 in addition to TabCapture=1";
+        }
+        return false;
+      }
+    }
+  }
+  for (const auto &event_capability : next_events) {
+    const std::string &event = event_capability.first;
+    if (!validate_model(event)) {
+      return false;
+    }
+  }
+
+  // 对排序后的精确合同做摘要，JSON 输入字段顺序不会改变结果。宿主生成摘要时
+  // 使用同一字段集合（不含 contractDigest 本身）。
+  base::DictValue canonical;
+  canonical.Set("contractVersion", 2);
+  canonical.Set("contractEpoch", *epoch_text);
+  canonical.Set("kernelContractDigest", *kernel_contract_digest);
+  canonical.Set("hostBuild", *host_build);
+  base::DictValue canonical_scope;
+  canonical_scope.Set("profileId", *scope_profile);
+  canonical_scope.Set("accountScope", *scope_account);
+  canonical_scope.Set("sessionEpoch", *scope_session);
+  canonical_scope.Set("incognito", *scope_incognito);
+  canonical.Set("scope", std::move(canonical_scope));
+  canonical.Set("cancellation", *cancellation_value);
+  base::ListValue canonical_methods;
+  for (const std::string &method : next_methods) {
+    canonical_methods.Append(method);
+  }
+  canonical.Set("methods", std::move(canonical_methods));
+  base::DictValue canonical_events;
+  for (const auto &[event, semantics] : next_events) {
+    base::DictValue descriptor;
+    descriptor.Set("coldWake", semantics.first);
+    descriptor.Set("replay", semantics.second);
+    canonical_events.Set(event, std::move(descriptor));
+  }
+  canonical.Set("events", std::move(canonical_events));
+  base::DictValue canonical_models;
+  for (const auto &[model, model_version] : next_models) {
+    canonical_models.Set(model, model_version);
+  }
+  canonical.Set("dataModels", std::move(canonical_models));
+  std::string canonical_json;
+  base::JSONWriter::Write(canonical, &canonical_json);
+  const std::string expected_digest =
+      base::HexEncodeLower(crypto::SHA256HashString(canonical_json));
+  if (*supplied_digest != expected_digest) {
+    if (error) {
+      *error =
+          "capability contractDigest mismatch; expected " + expected_digest;
+    }
+    return false;
+  }
+
+  const bool cancellation = *cancellation_value;
+  bool changed = false;
+  bool requires_context_refresh = false;
+  {
+    base::AutoLock guard(Capabilities().lock);
+    const bool same_scope = Capabilities().profile_id == *scope_profile &&
+                            Capabilities().account_scope == *scope_account &&
+                            Capabilities().session_epoch == *scope_session;
+    if (Capabilities().installed && same_scope &&
+        contract_epoch < Capabilities().contract_epoch) {
+      if (error) {
+        *error = "capability contractEpoch rollback rejected";
+      }
+      return false;
+    }
+    if (Capabilities().installed && same_scope &&
+        contract_epoch == Capabilities().contract_epoch &&
+        *supplied_digest != Capabilities().contract_digest) {
+      if (error) {
+        *error = "capability digest changed without advancing contractEpoch";
+      }
+      return false;
+    }
+    const bool book_only_refresh =
+        Capabilities().installed && same_scope &&
+        Capabilities().off_the_record != *scope_incognito &&
+        Capabilities().contract_version == *version &&
+        Capabilities().kernel_contract_digest == *kernel_contract_digest &&
+        Capabilities().host_build == *host_build &&
+        Capabilities().cancellation == cancellation &&
+        Capabilities().methods == next_methods &&
+        Capabilities().events == next_events &&
+        Capabilities().data_models == next_models;
+    changed =
+        !Capabilities().installed ||
+        Capabilities().contract_version != *version ||
+        Capabilities().contract_epoch != contract_epoch ||
+        Capabilities().contract_digest != *supplied_digest ||
+        Capabilities().kernel_contract_digest != *kernel_contract_digest ||
+        Capabilities().host_build != *host_build || !same_scope ||
+        Capabilities().cancellation != cancellation ||
+        Capabilities().methods != next_methods ||
+        Capabilities().events != next_events ||
+        Capabilities().data_models != next_models;
+    requires_context_refresh = changed && !book_only_refresh;
+    Capabilities().installed = true;
+    Capabilities().contract_version = *version;
+    Capabilities().contract_epoch = contract_epoch;
+    Capabilities().contract_digest = *supplied_digest;
+    Capabilities().kernel_contract_digest = *kernel_contract_digest;
+    Capabilities().host_build = *host_build;
+    Capabilities().profile_id = *scope_profile;
+    Capabilities().account_scope = *scope_account;
+    Capabilities().session_epoch = *scope_session;
+    Capabilities().off_the_record = *scope_incognito;
+    Capabilities().cancellation = cancellation;
+    Capabilities().methods = std::move(next_methods);
+    Capabilities().events = std::move(next_events);
+    Capabilities().data_models = std::move(next_models);
+    if (requires_context_refresh) {
+      base::AutoLock state_guard(S().lock);
+      S().reconciliation_required.clear();
+    }
+  }
+  if (requires_context_refresh) {
+    std::set<std::string> installed_methods;
+    {
+      base::AutoLock capability_guard(Capabilities().lock);
+      installed_methods = Capabilities().methods;
+    }
+    {
+      // 新合同（尤其账号/session 或成员集合变化）拥有独立的事件序列空间。
+      // 清掉旧 scope 的游标，既避免新事件从 1 重新计数时被误判，也避免
+      // 进程长期运行时积累不可达的旧账号键。
+      base::AutoLock context_guard(Ctx().lock);
+      Ctx().event_source_positions.clear();
+      Ctx().storage_revisions.clear();
+      Ctx().storage_commit_ids.clear();
+    }
+    CancelTaken(
+        TakePendingWhere(base::BindRepeating(
+            [](const std::set<std::string> &allowed, const Pending &pending) {
+              return !allowed.contains(pending.name);
+            },
+            std::move(installed_methods))),
+        "host capability changed while request was in flight");
+    for (const std::string &extension_id : LoadedExtensionIds()) {
+      InvalidateExtensionContexts(
+          extension_id,
+          "host capability changed; recreate extension contexts and bindings");
+    }
+    RefreshExtensionBindingsForHostCapabilities();
+  }
+  LOG(INFO) << "[arupa][extapi] 已安装宿主 capability contract v" << *version
+            << " epoch=" << contract_epoch
+            << " digest=" << supplied_digest->substr(0, 12);
+  return true;
+}
