+
+std::string SitePattern(const std::string &site) {
+  std::string s(base::TrimWhitespaceASCII(site, base::TRIM_ALL));
+  if (s.empty() || s.find('%') != std::string::npos) {
+    return std::string();
+  }
+  constexpr int kSchemes = URLPattern::SCHEME_HTTP | URLPattern::SCHEME_HTTPS;
+  std::string candidate;
+  if (s == URLPattern::kAllUrlsPattern) {
+    candidate = s;
+  } else if (s.find("://") != std::string::npos) {
+    if (s.find('*') == std::string::npos) {
+      const GURL u(s);
+      if (!u.is_valid() || !u.SchemeIsHTTPOrHTTPS() || u.host().empty()) {
+        return std::string();
+      }
+      candidate = "*://" + base::ToLowerASCII(u.host()) + "/*";
+    } else {
+      candidate = s;
+      const size_t host_at = s.find("://") + 3;
+      if (s.find('/', host_at) == std::string::npos) {
+        candidate += "/*";
+      }
+    }
+  } else if (base::StartsWith(s, "*.")) {
+    candidate = "*://" + base::ToLowerASCII(s) + "/*";
+  } else {
+    if (s.find('*') != std::string::npos) {
+      return std::string();
+    }
+    const GURL u("https://" + s);
+    if (!u.is_valid() || u.host().empty() ||
+        u.host().find('%') != std::string::npos) {
+      return std::string();
+    }
+    candidate = "*://" + base::ToLowerASCII(u.host()) + "/*";
+  }
+  URLPattern p(kSchemes);
+  if (p.Parse(candidate) != URLPattern::ParseResult::kSuccess) {
+    return std::string();
+  }
+  return p.GetAsString();
+}
+
+std::set<std::string> &SiteBlocksApplied() {
+  static base::NoDestructor<std::set<std::string>> s;
+  return *s;
+}
+
+void ApplySiteBlocksTo(const extensions::Extension &ext) {
+  auto it = RevokedSites().find(ext.id());
+  if (it == RevokedSites().end() || it->second.empty()) {
+    if (SiteBlocksApplied().erase(ext.id())) {
+      ext.permissions_data()->SetPolicyHostRestrictions(
+          extensions::URLPatternSet(), extensions::URLPatternSet());
+    }
+    return;
+  }
+  SiteBlocksApplied().insert(ext.id());
+  extensions::URLPatternSet blocked;
+  for (const std::string &pattern : it->second) {
+    URLPattern p(URLPattern::SCHEME_HTTP | URLPattern::SCHEME_HTTPS);
+    if (p.Parse(pattern) == URLPattern::ParseResult::kSuccess) {
+      blocked.AddPattern(p);
+    }
+  }
+  ext.permissions_data()->SetPolicyHostRestrictions(
+      blocked, extensions::URLPatternSet());
+}
