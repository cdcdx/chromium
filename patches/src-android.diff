+bool ValidateHostApiEventArgs(const std::string &event_name,
+                              const base::ListValue &args, std::string *error) {
+  auto fail = [&](std::string why) {
+    if (error) {
+      *error = event_name + ": " + std::move(why);
+    }
+    return false;
+  };
+  if (args.size() > 4) {
+    return fail("too many listener arguments");
+  }
+  auto dict_at = [&](size_t index) -> const base::DictValue * {
+    return index < args.size() ? args[index].GetIfDict() : nullptr;
+  };
+  auto string_at = [&](size_t index) -> const std::string * {
+    return index < args.size() ? args[index].GetIfString() : nullptr;
+  };
+  if (event_name.starts_with("tabs.")) {
+    // 精细的 tabId/分册/URL 权限检查由 ScrubHostTabEvent 执行。
+    return true;
+  }
+  if (event_name == "downloads.onCreated") {
+    const base::DictValue *item = dict_at(0);
+    return item && args.size() == 1 && item->FindInt("id") &&
+                   item->FindString("url") && item->FindString("finalUrl") &&
+                   item->FindString("filename") && item->FindString("state") &&
+                   item->FindBool("incognito") && item->FindBool("paused") &&
+                   item->FindBool("exists") &&
+                   item->FindString("byExtensionId") &&
+                   item->FindString("byExtensionName")
+               ? true
+               : fail("invalid DownloadItem v1");
+  }
+  if (event_name == "downloads.onChanged") {
+    const base::DictValue *delta = dict_at(0);
+    return delta && args.size() == 1 && delta->FindInt("id")
+               ? true
+               : fail("invalid DownloadDelta v1");
+  }
+  if (event_name == "downloads.onErased") {
+    return args.size() == 1 && args[0].is_int() ? true
+                                                : fail("download id required");
+  }
+  if (event_name == "bookmarks.onCreated") {
+    const base::DictValue *node = dict_at(1);
+    return args.size() == 2 && string_at(0) && node && node->FindString("id") &&
+                   node->FindString("title")
+               ? true
+               : fail("invalid BookmarkTreeNode v1");
+  }
+  if (event_name.starts_with("bookmarks.")) {
+    return !args.empty() && string_at(0) ? true : fail("bookmark id required");
+  }
+  if (event_name == "notifications.onClicked") {
+    return args.size() == 1 && string_at(0) ? true
+                                            : fail("notification id required");
+  }
+  if (event_name == "notifications.onClosed") {
+    return args.size() == 2 && string_at(0) && args[1].is_bool()
+               ? true
+               : fail("notification id and byUser required");
+  }
+  if (event_name == "notifications.onButtonClicked") {
+    return args.size() == 2 && string_at(0) && args[1].is_int()
+               ? true
+               : fail("notification id and button index required");
+  }
+  if (event_name == "notifications.onPermissionLevelChanged") {
+    return args.size() == 1 && string_at(0) &&
+                   (*string_at(0) == "granted" || *string_at(0) == "denied")
+               ? true
+               : fail("invalid notification permission level");
+  }
+  if (event_name == "notifications.onShowSettings") {
+    return args.empty() ? true : fail("event takes no arguments");
+  }
+  if (event_name == "history.onVisited") {
+    const base::DictValue *item = dict_at(0);
+    return args.size() == 1 && item && item->FindString("id") &&
+                   item->FindString("url")
+               ? true
+               : fail("invalid HistoryItem v1");
+  }
+  if (event_name == "history.onVisitRemoved") {
+    const base::DictValue *removed = dict_at(0);
+    return args.size() == 1 && removed && removed->FindBool("allHistory") &&
+                   removed->FindList("urls")
+               ? true
+               : fail("invalid RemovedResult v1");
+  }
+  if (event_name == "declarativeNetRequest.onRuleMatchedDebug") {
+    const base::DictValue* info = dict_at(0);
+    const base::DictValue* rule = info ? info->FindDict("rule") : nullptr;
+    const base::DictValue* request = info ? info->FindDict("request") : nullptr;
+    const std::string* url = request ? request->FindString("url") : nullptr;
+    return args.size() == 1 && info && rule && request &&
+                   rule->FindInt("ruleId") && rule->FindString("rulesetId") &&
+                   request->FindString("requestId") && url && GURL(*url).is_valid() &&
+                   request->FindString("method") && request->FindInt("frameId") &&
+                   request->FindInt("parentFrameId") && request->FindInt("tabId") &&
+                   request->FindString("type")
+               ? true
+               : fail("invalid MatchedRuleInfoDebug v1");
+  }
+  if (event_name == "identity.onSignInChanged") {
+    return args.size() == 2 && dict_at(0) && args[1].is_bool()
+               ? true
+               : fail("invalid IdentityProfile event");
+  }
+  if (event_name == "action.onUserSettingsChanged") {
+    return args.size() == 1 && dict_at(0) && dict_at(0)->FindBool("isOnToolbar")
+               ? true
+               : fail("invalid ActionUserSettings v1");
+  }
+  if (event_name == "management.onUninstalled") {
+    return args.size() == 1 && string_at(0) ? true
+                                            : fail("extension id required");
+  }
+  if (event_name.starts_with("management.")) {
+    const base::DictValue *info = dict_at(0);
+    return args.size() == 1 && info && info->FindString("id") &&
+                   info->FindString("name") && info->FindBool("enabled")
+               ? true
+               : fail("invalid ExtensionInfo v1");
+  }
+  if (event_name == "sessions.onChanged") {
+    return args.empty() ? true : fail("event takes no arguments");
+  }
+  if (event_name == "storage.onChanged" ||
+      event_name == "storage.sync.onChanged" ||
+      event_name == "storage.managed.onChanged") {
+    if (event_name != "storage.onChanged") {
+      return fail("host must emit storage.onChanged once; kernel fans out the "
+                  "area event");
+    }
+    const base::DictValue *changes = dict_at(0);
+    const std::string *area = string_at(1);
+    if (args.size() != 2 || !changes || !area ||
+        (*area != "sync" && *area != "managed")) {
+      return fail("storage changes and sync|managed area required");
+    }
+    if (changes->size() > mv3::kStorageMaxItems) {
+      return fail("storage change set exceeds MAX_ITEMS");
+    }
+    const std::optional<std::string> encoded = base::WriteJson(*changes);
+    if (!encoded || encoded->size() > mv3::kStorageQuotaBytesSync) {
+      return fail("storage change set exceeds sync quota");
+    }
+    for (const auto [key, value] : *changes) {
+      const base::DictValue *delta = value.GetIfDict();
+      if (key.empty() || key.size() > 1024 || !delta ||
+          (!delta->contains("oldValue") && !delta->contains("newValue")) ||
+          delta->size() > 2) {
+        return fail("invalid storage change entry");
+      }
+    }
+    return true;
+  }
+  if (event_name == "contentSettings.onChanged") {
+    const base::DictValue *change = dict_at(0);
+    return args.size() == 1 && change && change->FindString("type") &&
+                   change->FindString("primaryPattern")
+               ? true
+               : fail("invalid ContentSetting change v1");
+  }
+  if (event_name == "nomad.onEvent") {
+    return args.size() == 2 && string_at(0) && dict_at(1)
+               ? true
+               : fail("service and Envelope required");
+  }
+  if (event_name == "nomadTransfer.onWake" ||
+      event_name == "nomadTransfer.onTaskChanged") {
+    return args.size() == 1 && dict_at(0) ? true : fail("Envelope required");
+  }
+  return fail("no registered host event validator");
+}
+
+bool ValidateHostStorageEventRevision(const std::string &extension_id,
+                                      const std::string &event_name,
+                                      const base::ListValue &args,
+                                      const std::string &context_json,
+                                      std::string *error) {
+  if (event_name != "storage.onChanged") {
+    return true;
+  }
+  const std::string *area = args.size() == 2 ? args[1].GetIfString() : nullptr;
+  const auto context =
+      base::JSONReader::ReadDict(context_json, base::JSON_PARSE_RFC);
+  const std::string *commit_id =
+      context ? context->FindString("commitId") : nullptr;
+  const std::string *revision_text =
+      context ? context->FindString("revision") : nullptr;
+  const std::string *account_scope =
+      context ? context->FindString("accountScope") : nullptr;
+  const std::string *session_epoch =
+      context ? context->FindString("sessionEpoch") : nullptr;
+  const std::optional<bool> incognito =
+      context ? context->FindBool("incognito") : std::nullopt;
+  int64_t revision = 0;
+  if (!area || !commit_id || !IsSafeOpaqueIdentity(*commit_id, 128) ||
+      !revision_text || !base::StringToInt64(*revision_text, &revision) ||
+      revision <= 0 || *revision_text != base::NumberToString(revision) ||
+      !account_scope || !session_epoch || !incognito) {
+    if (error) {
+      *error = "storage event requires commitId and positive string revision";
+    }
+    return false;
+  }
+  const std::string scope_key =
+      extension_id + "\n" + *account_scope + "\n" + *session_epoch + "\n" +
+      (*incognito ? "incognito" : "regular") + "\n" + *area;
+  const std::string revision_key = scope_key;
+  const std::string commit_key = scope_key + "\n" + *commit_id;
+  base::AutoLock guard(Ctx().lock);
+  if (Ctx().storage_commit_ids.contains(commit_key) ||
+      revision <= Ctx().storage_revisions[revision_key]) {
+    if (error) {
+      *error = "duplicate or stale storage revision";
+    }
+    return false;
+  }
+  if (Ctx().storage_commit_ids.size() >= 4096) {
+    Ctx().storage_commit_ids.clear();
+  }
+  Ctx().storage_commit_ids.insert(commit_key);
+  Ctx().storage_revisions[revision_key] = revision;
+  return true;
+}
