+
+// ─────────────────────────────────────────────────────────────────────────────
+// 静态规则集（manifest 的 declarative_net_request.rule_resources）
+//
+// 与动态规则的三点区别：
+//   1. 规则随包分发，读扩展目录下的 JSON 文件，不进 PluginStorage；
+//   2. 不占 dynamic 配额（独立计 kMaxStaticRules）；
+//   3. 启用集合可运行时切换（updateEnabledRulesets），默认取 manifest 的
+//   enabled。
+//
+// 规则文件内容读一次就缓存（进程内），避免每次生效都重读几 MB 的 JSON。
+// ─────────────────────────────────────────────────────────────────────────────
+
+namespace {
+
+constexpr char kDnrStaticManifestKey[] = "__dnr_static_manifest_v1";
+constexpr char kDnrStaticEnabledKey[] = "__dnr_static_enabled_v1";
+constexpr char kDnrStaticDisabledKey[] = "__dnr_static_disabled_v1";
+
+struct StaticRegistry {
+  base::Lock lock;
+  // Snapshot builds reserve the shared 300k pool. Serialize the calculate +
+  // commit window so two extensions cannot both consume the same remainder.
+  base::Lock snapshot_lock;
+  // ext → 规则集（顺序 = manifest 顺序）
+  std::map<std::string, std::vector<StaticRulesetInfo>> sets GUARDED_BY(lock);
+  // ext → 扩展目录（读规则文件用）
+  std::map<std::string, base::FilePath> dirs GUARDED_BY(lock);
+  struct CachedRuleset {
+    base::ListValue rules;
+    int skipped_rules = 0;
+    int regex_rules = 0;
+  };
+  // (ext, ruleset id) → 已读并校验过的规则和跳过计数；缓存命中不能丢失诊断。
+  std::map<std::string, CachedRuleset> cache GUARDED_BY(lock);
+  // Chromium 的 30k 保底之外，每个 profile 共享 300k 静态规则池。这里只
+  // 记录每个已生效扩展实际占用的共享额度；规则禁用不释放索引额度。
+  std::map<std::string, size_t> global_allocations GUARDED_BY(lock);
+};
+
+StaticRegistry& Statics() {
+  static base::NoDestructor<StaticRegistry> r;
+  return *r;
+}
+
+std::string CacheKey(const std::string& extension_id,
+                     const std::string& ruleset_id) {
+  return extension_id + "\x1f" + ruleset_id;
+}
+
+bool StringListToVector(const base::Value* v, std::vector<std::string>* out) {
+  const base::ListValue* list = v ? v->GetIfList() : nullptr;
+  if (!list) {
+    return false;
+  }
+  for (const auto& item : *list) {
+    if (const std::string* s = item.GetIfString()) {
+      out->push_back(*s);
+    }
+  }
+  return true;
+}
+
+std::optional<base::DictValue> ReadDisabledStaticRules(
+    const std::string& extension_id) {
+  const StorageReadResult read =
+      PluginStorage::Get().GetAllValuesChecked(extension_id);
+  if (read.status != StorageWriteResult::kOk) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> values =
+      base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC);
+  if (!values) {
+    return std::nullopt;
+  }
+  const base::Value* stored = values->Find(kDnrStaticDisabledKey);
+  if (!stored) {
+    return base::DictValue();
+  }
+  const base::DictValue* parsed = stored->GetIfDict();
+  if (!parsed) {
+    return std::nullopt;
+  }
+  size_t total = 0;
+  for (const auto [ruleset_id, value] : *parsed) {
+    (void)ruleset_id;
+    const base::ListValue* ids = value.GetIfList();
+    if (!ids) {
+      return std::nullopt;
+    }
+    std::set<int> unique;
+    for (const base::Value& id : *ids) {
+      if (!id.is_int()) {
+        return std::nullopt;
+      }
+      unique.insert(id.GetInt());
+    }
+    total += unique.size();
+    if (total > static_cast<size_t>(kMaxDisabledStaticRules)) {
+      return std::nullopt;
+    }
+  }
+  return parsed->Clone();
+}
+
+bool WriteDisabledStaticRules(const std::string& extension_id,
+                              const base::DictValue& rulesets) {
+  const auto json = base::WriteJson(rulesets);
+  return json &&
+         PluginStorage::Get().SetValue(extension_id, kDnrStaticDisabledKey,
+                                       *json) == StorageWriteResult::kOk;
+}
+
+void WriteDisabledStaticRulesAsync(const std::string& extension_id,
+                                   const base::DictValue& rulesets,
+                                   DnrStorageCallback callback) {
+  const auto json = base::WriteJson(rulesets);
+  if (!json) {
+    std::move(callback).Run(false);
+    return;
+  }
+  PluginStorage::Get().SetValuesAsync(
+      extension_id, {{kDnrStaticDisabledKey, *json}},
+      base::BindOnce(
+          [](DnrStorageCallback done, StorageCommitResult result) {
+            std::move(done).Run(result.status == StorageWriteResult::kOk);
+          },
+          std::move(callback)));
+}
