+bool IsSupportedDnrRedirect(const GURL &url) {
+  return url.is_valid() &&
+         (url.SchemeIsHTTPOrHTTPS() ||
+          url.SchemeIs(extensions::kExtensionScheme) ||
+          url.SchemeIs(url::kDataScheme) || url.SchemeIsFile());
+}
