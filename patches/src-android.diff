+mojo::PendingRemote<network::mojom::URLLoaderFactory>
+CreateSchemeFactoryRemote(content::WebContents *web_contents) {
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate =
+      GetKernelViewJavaDelegate(web_contents);
+  if (java_delegate.is_null()) {
+    return {};
+  }
+
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> remote;
+  auto receiver = remote.InitWithNewPipeAndPassReceiver();
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&ArupaSchemeURLLoaderFactory::CreateOnIO,
+                                std::move(java_delegate), std::move(receiver)));
+  return remote;
+}
