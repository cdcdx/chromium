+TEST(DnrEngineAvailabilityTest, GenerationChangesOnlyOnTransitions) {
+  SetDnrEngineAvailable(false);
+  const uint64_t before = DnrEngineGeneration();
+  EXPECT_EQ(0u, DnrActiveEngineGeneration());
+  SetDnrEngineAvailable(false);
+  EXPECT_EQ(before, DnrEngineGeneration());
+  SetDnrEngineAvailable(true);
+  EXPECT_TRUE(DnrEngineAvailable());
+  EXPECT_EQ(before + 1, DnrEngineGeneration());
+  EXPECT_EQ(before + 1, DnrActiveEngineGeneration());
+  SetDnrEngineAvailable(true);
+  EXPECT_EQ(before + 1, DnrEngineGeneration());
+  SetDnrEngineAvailable(false);
+  EXPECT_FALSE(DnrEngineAvailable());
+  EXPECT_EQ(before + 2, DnrEngineGeneration());
+  EXPECT_EQ(0u, DnrActiveEngineGeneration());
+}
