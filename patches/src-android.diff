+  std::string result;
+  std::string error;
+  ASSERT_TRUE(BuildDnrRulesQueryResult(GetSessionRulesJson(extension_id_),
+                                       "[null]", &result, &error));
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(result, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed && parsed->is_list());
+  ASSERT_EQ(1u, parsed->GetList().size());
+  const base::ListValue* rules = parsed->GetList()[0].GetIfList();
+  ASSERT_TRUE(rules);
+  ASSERT_EQ(1u, rules->size());
+  const base::DictValue* rule = (*rules)[0].GetIfDict();
+  ASSERT_TRUE(rule);
+  EXPECT_EQ(91, rule->FindInt("id"));
+}
