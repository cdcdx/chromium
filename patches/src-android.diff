+std::string ExtApiCapabilitiesSnapshotJson() {
+  base::AutoLock guard(Capabilities().lock);
+  base::DictValue out;
+  out.Set("installed", Capabilities().installed);
+  out.Set("contractVersion", Capabilities().contract_version);
+  out.Set("contractEpoch", base::NumberToString(Capabilities().contract_epoch));
+  out.Set("contractDigest", Capabilities().contract_digest);
+  out.Set("kernelContractDigest", Capabilities().kernel_contract_digest);
+  out.Set("hostBuild", Capabilities().host_build);
+  base::DictValue scope;
+  scope.Set("profileId", Capabilities().profile_id);
+  scope.Set("accountScope", Capabilities().account_scope);
+  scope.Set("sessionEpoch", Capabilities().session_epoch);
+  scope.Set("incognito", Capabilities().off_the_record);
+  out.Set("scope", std::move(scope));
+  out.Set("cancellation", Capabilities().cancellation);
+  base::ListValue methods;
+  for (const std::string &method : Capabilities().methods) {
+    methods.Append(method);
+  }
+  out.Set("methods", std::move(methods));
+  base::DictValue events;
+  for (const auto &[event, semantics] : Capabilities().events) {
+    base::DictValue descriptor;
+    descriptor.Set("coldWake", semantics.first);
+    descriptor.Set("replay", semantics.second);
+    events.Set(event, std::move(descriptor));
+  }
+  out.Set("events", std::move(events));
+  base::DictValue models;
+  for (const auto &[name, version] : Capabilities().data_models) {
+    models.Set(name, version);
+  }
+  out.Set("dataModels", std::move(models));
+  std::string json;
+  base::JSONWriter::Write(out, &json);
+  return json;
+}
