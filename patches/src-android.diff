+// file:// 始终不向扩展开放；无痕授权则由宿主的 PluginIncognitoAccessPolicy
+// 维护， 必须查询宿主，不能再用固定 false 覆盖真实用户决定。
+bool HandleKernelOwnedExtension(const ExtCallerIdentity &who,
+                                const std::string &extension_id,
+                                const std::string &name,
+                                const std::string &args_json,
+                                mojom::ExtApiHost::CallCallback &callback) {
+  if (name == "extension.isAllowedIncognitoAccess") {
+    CallHostApiFromKernelFrom(who, extension_id, name, args_json,
+                              std::move(callback));
+    return true;
+  }
+  if (name != "extension.isAllowedFileSchemeAccess") {
+    return false;
+  }
+  base::ListValue result;
+  result.Append(false);
+  std::string json;
+  base::JSONWriter::Write(base::Value(std::move(result)), &json);
+  VLOG(1) << "[arupa][extapi] " << name << " → false (Android file policy)";
+  std::move(callback).Run(json, std::string());
+  return true;
+}
