+namespace {
+
+// profileId 必须是"同一 profile 稳定、OTR 与持久互不相同"的指纹:
+// 旧实现是每进程随机值, 于是 App 侧持久保存的 work scope / 窗口在重启后
+// 全部对不上(N-C02)。这里改成由 profile 目录 + 模式派生的确定性指纹。
+const std::string &ProfileIdForThisRun() {
+  static base::NoDestructor<std::string> id([] {
+    content::BrowserContext *bc = GetKernelBrowserContextForExtensions();
+    const bool otr = !bc || bc->IsOffTheRecord();
+    std::string seed = otr ? "otr:" : "persist:";
+    if (bc) {
+      seed += bc->GetPath().value();
+    }
+    if (seed.size() <= 8) {
+      // 内核还没建好 BrowserContext(理论上插件调用到不了这里): 退化为每进程
+      // 固定随机值并明确告警, 不要静默产生一个会漂的身份。
+      LOG(ERROR)
+          << "[arupa][ctx] 拿不到 profile 目录, profileId 退化为进程内随机值 "
+             "—— 跨重启的 work scope 会对不上";
+      seed += "-volatile:" +
+              base::NumberToString(base::Token::CreateRandom().high());
+    }
+    return (otr ? "otr-" : "persist-") +
+           base::NumberToString(base::FastHash(seed) & 0xFFFFFFFFull);
+  }());
+  return *id;
+}
