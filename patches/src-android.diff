+struct StaticRuleUpdateOutcome {
+  bool ok = false;
+  bool changed = false;
+  bool storage_error = false;
+  std::string error;
+  std::vector<int> disabled;
+};
+
+// 单条静态规则的启停选择按 ruleset 持久化。disable 与 enable 同时包含同一 id
+// 时 disable 优先，和 Chromium PrefsHelper::RuleIdsToUpdate 一致。
+std::vector<int> GetDisabledStaticRuleIds(const std::string& extension_id,
+                                          const std::string& ruleset_id,
