@@ -0,0 +1,53 @@
+#include "third_party/blink/renderer/modules/media_capabilities/arupa_codec_profile.h"
+#include <algorithm>
+#include <optional>
+#include <string>
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "third_party/blink/renderer/bindings/modules/v8/v8_media_capabilities_decoding_info.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+namespace blink {
+namespace {
+std::string LowerAscii(const std::string& s) {
+  std::string r = s;
+  std::transform(r.begin(), r.end(), r.begin(), [](unsigned char c) {
+    return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c;
+  });
+  return r;
+}
+}
+MediaCapabilitiesDecodingInfo* ArupaLookupCodecProfile(
+    const String& profile_json,
+    const String& content_type) {
+  if (profile_json.empty() || content_type.empty()) {
+    return nullptr;
+  }
+  std::optional<base::ListValue> root =
+      base::JSONReader::ReadList(profile_json.Utf8(), base::JSON_PARSE_RFC);
+  if (!root) {
+    return nullptr;
+  }
+  const std::string ct_lower = LowerAscii(content_type.Utf8());
+  for (const base::Value& entry : *root) {
+    const base::DictValue* dict = entry.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* entry_ct = dict->FindString("contentType");
+    if (!entry_ct) {
+      continue;
+    }
+    const std::string entry_ct_lower = LowerAscii(*entry_ct);
+    if (ct_lower.find(entry_ct_lower) == std::string::npos &&
+        entry_ct_lower.find(ct_lower) == std::string::npos) {
+      continue;
+    }
+    auto* info = MakeGarbageCollected<MediaCapabilitiesDecodingInfo>();
+    info->setSupported(dict->FindBool("supported").value_or(false));
+    info->setSmooth(dict->FindBool("smooth").value_or(false));
+    info->setPowerEfficient(dict->FindBool("powerEfficient").value_or(false));
+    return info;
+  }
+  return nullptr;
+}
+}
