+// 规则存储层和 Android 宿主 matcher 共同执行这些动作；宿主必须先用完整
+// 快照回执证明已发布，DnrEngineAvailable() 才会切到可用态。
+constexpr char kSupportedActions[] =
+    "block/allow/allowAllRequests/redirect/upgradeScheme/modifyHeaders";
+
+std::string RuleIdText(int id) {
+  return base::NumberToString(id);
+}
+
+// Schema 解码并不保证静态规则文件已经剔除未知字段。静默忽略条件会把一条
+// 本应受限的 block/allow 规则扩大为无条件匹配，不能当作成功装载。
+std::string ValidateKnownFields(
+    const base::DictValue& object,
+    const std::string& id_text,
+    std::string_view scope,
+    std::initializer_list<std::string_view> allowed) {
+  for (const auto entry : object) {
+    const std::string& key = entry.first;
+    bool known = false;
+    for (std::string_view candidate : allowed) {
+      if (key == candidate) {
+        known = true;
+        break;
+      }
+    }
+    if (!known) {
+      return "Rule with id " + id_text + ": unsupported " +
+             std::string(scope) + " field '" + key + "'.";
+    }
+  }
+  return {};
+}
+
+// 这条规则是不是走正则；正式执行器仍需单独约束内存与匹配耗时。
+bool RuleUsesRegex(const base::DictValue& rule) {
+  const base::DictValue* condition = rule.FindDict("condition");
+  const std::string* regex =
+      condition ? condition->FindString("regexFilter") : nullptr;
+  return regex && !regex->empty();
+}
+
+bool RuleIsUnsafe(const base::DictValue& rule) {
+  const base::DictValue* action = rule.FindDict("action");
+  const std::string* type = action ? action->FindString("type") : nullptr;
+  return type && (*type == "redirect" || *type == "modifyHeaders");
+}
+
+const std::string* SelectedRedirectRegexSubstitution(
+    const base::DictValue& action) {
+  const base::DictValue* redirect = action.FindDict("redirect");
+  if (!redirect || redirect->Find("url") || redirect->Find("extensionPath") ||
+      redirect->Find("transform")) {
+    return nullptr;
+  }
+  return redirect->FindString("regexSubstitution");
+}
+
+int CountRegexRules(const base::ListValue& rules) {
+  int n = 0;
+  for (const auto& item : rules) {
+    if (const base::DictValue* rule = item.GetIfDict();
+        rule && RuleUsesRegex(*rule)) {
+      ++n;
+    }
+  }
+  return n;
+}
+
+std::optional<base::ListValue> ReadStoredRules(
+    const std::string& extension_id) {
+  const StorageReadResult read =
+      PluginStorage::Get().GetAllValuesChecked(extension_id);
+  if (read.status != StorageWriteResult::kOk) {
+    LOG(ERROR) << "[arupa][dnr] 动态规则存储不可读 ext=" << extension_id;
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> values =
+      base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC);
+  if (!values) {
+    return std::nullopt;
+  }
+  const base::Value* rules = values->Find(kDnrDynamicRulesKey);
+  if (!rules) {
+    return base::ListValue();
+  }
+  if (!rules->is_list()) {
+    LOG(ERROR) << "[arupa][dnr] 已存规则不是数组 ext=" << extension_id;
+    return std::nullopt;
+  }
+  return rules->GetList().Clone();
+}
+
+// condition 里的三组枚举来自 Chromium M154 API schema。写错一个字母或
+// 使用未覆盖的类型都必须显式拒绝，不能形成假保护。
+constexpr const char* kValidResourceTypes[] = {
+    "main_frame", "sub_frame", "stylesheet",     "script",    "image",
+    "font",       "object",    "xmlhttprequest", "ping",      "csp_report",
+    "media",      "websocket", "webtransport", "webbundle", "other",
+};
+constexpr const char* kValidRequestMethods[] = {
+    "connect", "delete", "get", "head",  "options",
+    "patch",   "post",   "put", "other",
+};
+constexpr const char* kValidDomainTypes[] = {"firstParty", "thirdParty"};
+
+template <size_t N>
+bool InEnum(const char* const (&list)[N], const std::string& value) {
+  for (const char* candidate : list) {
+    if (value == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
+
+template <size_t N>
+std::string EnumListText(const char* const (&list)[N]) {
+  std::string out;
+  for (const char* candidate : list) {
+    if (!out.empty()) {
+      out += "/";
+    }
+    out += candidate;
+  }
+  return out;
+}
+
+// requestDomains / initiatorDomains 的取值必须是**纯主机名**（Chrome
+// 口径）：宿主 引擎按域名+子域匹配，带 scheme/端口/路径/通配/json
+// 转义的值永远匹配不上 —— 收下 就是"声明了规则、实际从不命中"。
+std::string ValidateDomainEntry(const std::string& key,
+                                const std::string& value,
+                                const std::string& id_text) {
+  const auto reject = [&](const char* why) {
+    return "Rule with id " + id_text + ": " + key + " entry '" + value + "' " +
+           why;
+  };
+  if (value.empty()) {
+    return reject("must not be empty.");
+  }
+  if (value.front() == '.') {
+    return reject("must not start with a dot.");
+  }
+  // 上游只接受 ASCII；国际化域名必须先转成 punycode。
+  for (const unsigned char c : value) {
+    const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                    (c >= '0' && c <= '9') || c == '-' || c == '.' ||
+                    c == '_';
+    if (!ok) {
+      return reject("must be a plain hostname (no scheme/port/path/wildcard).");
+    }
+  }
+  return std::string();
+}
+
+bool IsHeaderName(const std::string& name);
+
+enum class RegexValidation { kOk, kSyntax, kMemory, kRewrite };
+
+RegexValidation ValidateRegex(const std::string& source,
+                              bool case_sensitive,
+                              bool require_capturing,
+                              const std::string* substitution = nullptr) {
+  if (source.empty() || !base::IsStringASCII(source)) {
+    return RegexValidation::kSyntax;
+  }
+  re2::RE2::Options options;
+  options.set_encoding(re2::RE2::Options::EncodingLatin1);
+  options.set_case_sensitive(case_sensitive);
+  options.set_never_capture(!require_capturing);
+  options.set_log_errors(false);
+  options.set_max_mem(kDnrRegexMaxMemoryBytes);
+  re2::RE2 expression(source, options);
+  if (expression.error_code() == re2::RE2::ErrorPatternTooLarge) {
+    return RegexValidation::kMemory;
+  }
+  if (!expression.ok()) {
+    return RegexValidation::kSyntax;
+  }
+  std::string error;
+  if (substitution && !expression.CheckRewriteString(*substitution, &error)) {
+    return RegexValidation::kRewrite;
+  }
+  return RegexValidation::kOk;
+}
+
+bool ListsOverlap(const base::DictValue& object,
+                  const char* left_key,
+                  const char* right_key) {
+  const base::ListValue* left = object.FindList(left_key);
+  const base::ListValue* right = object.FindList(right_key);
+  if (!left || !right) {
+    return false;
+  }
+  std::set<std::string> values;
+  for (const base::Value& item : *left) {
+    if (const std::string* value = item.GetIfString()) {
+      values.insert(*value);
+    }
+  }
+  return std::ranges::any_of(*right, [&](const base::Value& item) {
+    const std::string* value = item.GetIfString();
+    return value && values.contains(*value);
+  });
+}
+
+bool IntListsOverlap(const base::DictValue& object,
+                     const char* left_key,
+                     const char* right_key) {
+  const base::ListValue* left = object.FindList(left_key);
+  const base::ListValue* right = object.FindList(right_key);
+  if (!left || !right) {
+    return false;
+  }
+  std::set<int> values;
+  for (const base::Value& item : *left) {
+    if (item.is_int()) {
+      values.insert(item.GetInt());
+    }
+  }
+  return std::ranges::any_of(*right, [&](const base::Value& item) {
+    return item.is_int() && values.contains(item.GetInt());
+  });
+}
+
+// condition 的枚举/域名/整数数组校验；返回空字符串 = 通过。
+std::string ValidateCondition(const base::DictValue& condition,
+                              const std::string& id_text,
+                              bool allow_tab_ids) {
+  const std::string unknown = ValidateKnownFields(
+      condition, id_text, "condition",
+      {"urlFilter", "regexFilter", "isUrlFilterCaseSensitive",
+       "initiatorDomains", "excludedInitiatorDomains", "requestDomains",
+       "excludedRequestDomains", "topDomains", "excludedTopDomains", "domains",
+       "excludedDomains", "resourceTypes", "excludedResourceTypes",
+       "requestMethods", "excludedRequestMethods", "domainType", "tabIds",
+       "excludedTabIds", "responseHeaders", "excludedResponseHeaders"});
+  if (!unknown.empty()) {
+    return unknown;
+  }
+  for (const char* key : {"urlFilter", "regexFilter"}) {
+    const base::Value* value = condition.Find(key);
+    if (value && !value->is_string()) {
+      return "Rule with id " + id_text + ": " + key +
+             " must be a string.";
+    }
+  }
+  if (const base::Value* sensitive =
+          condition.Find("isUrlFilterCaseSensitive");
+      sensitive && !sensitive->is_bool()) {
+    return "Rule with id " + id_text +
+           ": isUrlFilterCaseSensitive must be a boolean.";
+  }
+  for (const char* key : {"resourceTypes", "excludedResourceTypes",
+                          "requestMethods", "excludedRequestMethods",
+                          "requestDomains", "excludedRequestDomains",
+                          "initiatorDomains", "excludedInitiatorDomains",
+                          "topDomains", "excludedTopDomains", "domains",
+                          "excludedDomains", "tabIds", "excludedTabIds",
+                          "responseHeaders", "excludedResponseHeaders"}) {
+    const base::Value* value = condition.Find(key);
+    if (value && !value->is_list()) {
+      return "Rule with id " + id_text + ": " + key + " must be a list.";
+    }
+  }
+  for (const char* key : {"resourceTypes", "requestMethods", "requestDomains",
+                          "initiatorDomains", "topDomains", "domains",
+                          "tabIds"}) {
+    const base::ListValue* values = condition.FindList(key);
+    if (values && values->empty()) {
+      return "Rule with id " + id_text + ": " + key +
+             " must not be empty.";
+    }
+  }
+  const auto check_enum = [&](const char* key, const char* const* list,
+                              size_t n) -> std::string {
+    const base::ListValue* values = condition.FindList(key);
+    if (!values) {
+      return std::string();
+    }
+    for (const base::Value& v : *values) {
+      const std::string* s = v.GetIfString();
+      if (!s) {
+        return "Rule with id " + id_text + ": " + key +
+               " must contain strings.";
+      }
+      bool found = false;
+      for (size_t i = 0; i < n; ++i) {
+        if (*s == list[i]) {
+          found = true;
+          break;
+        }
+      }
+      if (!found) {
+        return "Rule with id " + id_text + ": " + key +
+               " has unsupported value '" + *s +
+               "' (逗号分隔的合法取值见 schema)。";
+      }
+    }
+    return std::string();
+  };
+  if (const std::string* t = condition.FindString("domainType");
+      t && !InEnum(kValidDomainTypes, *t)) {
+    return "Rule with id " + id_text + ": domainType '" + *t +
+           "' is not supported (supported: " + EnumListText(kValidDomainTypes) +
+           ").";
+  }
+  if (const base::Value* dt = condition.Find("domainType");
+      dt && !dt->is_string()) {
+    return "Rule with id " + id_text + ": domainType must be a string.";
+  }
+  for (const char* key : {"resourceTypes", "excludedResourceTypes",
+                          "requestMethods", "excludedRequestMethods"}) {
+    // `resourceTypes` 以小写 r 开头，而 `excludedResourceTypes` 中间才是
+    // 大写 R。旧代码用 find("ResourceTypes") 分类，导致前者被误送进
+    // requestMethods 枚举校验：任何标准值（script/main_frame/image...）都会
+    // 被拒。逐风净化 0.4.4 的总开关因此在下发第一条 script 规则时必然失败。
+    // 这里按字段身份判断，不能再依赖字段名大小写形态。
+    const std::string_view key_view(key);
+    const bool is_resource =
+        key_view == "resourceTypes" || key_view == "excludedResourceTypes";
+    const std::string reason = check_enum(
+        key, is_resource ? kValidResourceTypes : kValidRequestMethods,
+        is_resource ? std::size(kValidResourceTypes)
+                    : std::size(kValidRequestMethods));
+    if (!reason.empty()) {
+      return reason;
+    }
+  }
+  if (ListsOverlap(condition, "resourceTypes", "excludedResourceTypes")) {
+    return "Rule with id " + id_text +
+           ": a resource type cannot be both included and excluded.";
+  }
+  if (ListsOverlap(condition, "requestMethods", "excludedRequestMethods")) {
+    return "Rule with id " + id_text +
+           ": a request method cannot be both included and excluded.";
+  }
+  if (!condition.FindList("resourceTypes")) {
+    const base::ListValue* excluded =
+        condition.FindList("excludedResourceTypes");
+    if (excluded && excluded->size() >= std::size(kValidResourceTypes)) {
+      std::set<std::string> values;
+      for (const base::Value& item : *excluded) {
+        if (const std::string* value = item.GetIfString()) {
+          values.insert(*value);
+        }
+      }
+      if (values.size() == std::size(kValidResourceTypes)) {
+        return "Rule with id " + id_text +
+               ": excludedResourceTypes leaves no applicable resource type.";
+      }
+    }
+  }
+  if (!condition.FindList("requestMethods")) {
+    const base::ListValue* excluded =
+        condition.FindList("excludedRequestMethods");
+    if (excluded && excluded->size() >= std::size(kValidRequestMethods)) {
+      std::set<std::string> values;
+      for (const base::Value& item : *excluded) {
+        if (const std::string* value = item.GetIfString()) {
+          values.insert(*value);
+        }
+      }
+      if (values.size() == std::size(kValidRequestMethods)) {
+        return "Rule with id " + id_text +
+               ": excludedRequestMethods leaves no applicable request method.";
+      }
+    }
+  }
+  if (condition.FindList("domains") && condition.FindList("initiatorDomains")) {
+    return "Rule with id " + id_text +
+           ": domains and initiatorDomains cannot both be specified.";
+  }
+  if (condition.FindList("excludedDomains") &&
+      condition.FindList("excludedInitiatorDomains")) {
+    return "Rule with id " + id_text +
+           ": excludedDomains and excludedInitiatorDomains cannot both be specified.";
+  }
+  for (const char* key : {"requestDomains", "excludedRequestDomains",
+                          "initiatorDomains", "excludedInitiatorDomains",
+                          "topDomains", "excludedTopDomains", "domains",
+                          "excludedDomains"}) {
+    const base::ListValue* values = condition.FindList(key);
+    if (!values) {
+      continue;
+    }
+    for (const base::Value& v : *values) {
+      const std::string* s = v.GetIfString();
+      if (!s) {
+        return "Rule with id " + id_text + ": " + key +
+               " must contain strings.";
+      }
+      const std::string reason = ValidateDomainEntry(key, *s, id_text);
+      if (!reason.empty()) {
+        return reason;
+      }
+    }
+  }
+  for (const char* key : {"tabIds", "excludedTabIds"}) {
+    const base::ListValue* values = condition.FindList(key);
+    if (!values || values->empty()) {
+      continue;
+    }
+    for (const base::Value& v : *values) {
+      if (!v.is_int()) {
+        return "Rule with id " + id_text + ": " + key +
+               " must contain integers (tab ids).";
+      }
+    }
+    if (!allow_tab_ids) {
+      return "Rule with id " + id_text + ": " + key +
+             " is only supported for session rules.";
+    }
+  }
+  if (IntListsOverlap(condition, "tabIds", "excludedTabIds")) {
+    return "Rule with id " + id_text +
+           ": a tab id cannot be both included and excluded.";
+  }
+  std::set<std::string> required_header_names;
+  for (const char* key : {"responseHeaders", "excludedResponseHeaders"}) {
+    const base::ListValue* values = condition.FindList(key);
+    if (!values) {
+      continue;
+    }
+    if (values->empty()) {
+      return "Rule with id " + id_text + ": " + key + " must not be empty.";
+    }
+    for (const base::Value& value : *values) {
+      const base::DictValue* header = value.GetIfDict();
+      const std::string* name = header ? header->FindString("header") : nullptr;
+      if (!header || !name || !IsHeaderName(*name)) {
+        return "Rule with id " + id_text + ": " + key +
+               " entries need a valid header.";
+      }
+      const std::string unknown_header = ValidateKnownFields(
+          *header, id_text, key, {"header", "values", "excludedValues"});
+      if (!unknown_header.empty()) {
+        return unknown_header;
+      }
+      for (const char* values_key : {"values", "excludedValues"}) {
+        const base::Value* raw = header->Find(values_key);
+        if (raw && !raw->is_list()) {
+          return "Rule with id " + id_text + ": " + key + "." +
+                 values_key + " must be a list.";
+        }
+        if (const base::ListValue* patterns = header->FindList(values_key)) {
+          for (const base::Value& pattern : *patterns) {
+            const std::string* text = pattern.GetIfString();
+            if (!text || text->find('\r') != std::string::npos ||
+                text->find('\n') != std::string::npos ||
+                text->find('\0') != std::string::npos) {
+              return "Rule with id " + id_text + ": " + key + "." +
+                     values_key + " must contain valid header values.";
+            }
+          }
+        }
+      }
+      const bool name_only = !header->Find("values") &&
+                             !header->Find("excludedValues");
+      const std::string lower_name = base::ToLowerASCII(*name);
+      if (name_only && std::string_view(key) == "responseHeaders") {
+        required_header_names.insert(lower_name);
+      } else if (name_only && required_header_names.contains(lower_name)) {
+        return "Rule with id " + id_text +
+               ": the same response header cannot be required and excluded by name.";
+      }
+    }
+  }
+  return std::string();
+}
+
+bool IsHeaderName(const std::string& name) {
+  if (name.empty()) {
+    return false;
+  }
+  for (unsigned char c : name) {
+    const bool token = std::isalnum(c) || c == '!' || c == '#' || c == '$' ||
+                       c == '%' || c == '&' || c == '\'' || c == '*' ||
+                       c == '+' || c == '-' || c == '.' || c == '^' ||
+                       c == '_' || c == '`' || c == '|' || c == '~';
+    if (!token) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::string ValidateHeaderModifications(const base::DictValue& action,
+                                        const std::string& id_text,
+                                        const char* key) {
+  const base::Value* raw_values = action.Find(key);
+  if (raw_values && !raw_values->is_list()) {
+    return "Rule with id " + id_text + ": " + key + " must be a list.";
+  }
+  const base::ListValue* values = action.FindList(key);
+  if (!values) {
+    return std::string();
+  }
+  if (values->empty()) {
+    return "Rule with id " + id_text + ": " + key + " must not be empty.";
+  }
+  for (const base::Value& value : *values) {
+    const base::DictValue* modification = value.GetIfDict();
+    const std::string* header =
+        modification ? modification->FindString("header") : nullptr;
+    const std::string* operation =
+        modification ? modification->FindString("operation") : nullptr;
+    if (!header || !IsHeaderName(*header) || !operation) {
+      return "Rule with id " + id_text + ": " + key +
+             " entries need a valid header and operation.";
+    }
+    const std::string unknown = ValidateKnownFields(
+        *modification, id_text, key,
+        {"header", "operation", "value", "regexFilter",
+         "regexSubstitution", "regexOptions"});
+    if (!unknown.empty()) {
+      return unknown;
+    }
+    if (*operation != "append" && *operation != "set" &&
+        *operation != "remove") {
+      return "Rule with id " + id_text + ": unsupported header operation '" +
+             *operation + "'.";
+    }
+    if (std::string_view(key) == "requestHeaders" &&
+        *operation == "append") {
+      static constexpr std::string_view kAppendableRequestHeaders[] = {
+          "accept",          "accept-encoding", "accept-language",
+          "access-control-request-headers",       "cache-control",
+          "connection",      "content-language", "cookie",
+          "forwarded",       "if-match",         "if-none-match",
+          "keep-alive",      "range",            "te",
+          "trailer",         "transfer-encoding", "upgrade",
+          "user-agent",      "via",              "want-digest",
+          "x-forwarded-for",
+      };
+      const std::string lower = base::ToLowerASCII(*header);
+      if (std::ranges::find(kAppendableRequestHeaders, lower) ==
+          std::end(kAppendableRequestHeaders)) {
+        return "Rule with id " + id_text + ": request header '" + *header +
+               "' cannot use append.";
+      }
+    }
+    const std::string* header_value = modification->FindString("value");
+    const base::Value* raw_regex = modification->Find("regexFilter");
+    const base::Value* raw_substitution =
+        modification->Find("regexSubstitution");
+    if ((raw_regex && !raw_regex->is_string()) ||
+        (raw_substitution && !raw_substitution->is_string())) {
+      return "Rule with id " + id_text +
+             ": header regexFilter and regexSubstitution must be strings.";
+    }
+    const std::string* regex = modification->FindString("regexFilter");
+    const std::string* substitution =
+        modification->FindString("regexSubstitution");
+    if (substitution && !regex) {
+      return "Rule with id " + id_text +
+             ": header regexSubstitution requires regexFilter.";
+    }
+    if (regex) {
+      const RegexValidation validation = ValidateRegex(
+          *regex, /*case_sensitive=*/false, substitution != nullptr,
+          substitution);
+      if (validation != RegexValidation::kOk) {
+        return "Rule with id " + id_text +
+               ": invalid or over-budget header regexFilter/substitution.";
+      }
+    }
+    if (const base::Value* regex_options = modification->Find("regexOptions")) {
+      const base::DictValue* options = regex_options->GetIfDict();
+      if (!options) {
+        return "Rule with id " + id_text + ": regexOptions must be an object.";
+      }
+      const std::string unknown_options = ValidateKnownFields(
+          *options, id_text, "regexOptions", {"matchAll"});
+      if (!unknown_options.empty()) {
+        return unknown_options;
+      }
+      if (const base::Value* match_all = options->Find("matchAll");
+          match_all && !match_all->is_bool()) {
+        return "Rule with id " + id_text +
+               ": regexOptions.matchAll must be a boolean.";
+      }
+    }
+    if (*operation == "remove") {
+      if (header_value) {
+        return "Rule with id " + id_text +
+               ": remove header operation must not specify value.";
+      }
+    } else if (!header_value || header_value->find('\0') != std::string::npos ||
+               header_value->find('\r') != std::string::npos ||
+               header_value->find('\n') != std::string::npos) {
+      return "Rule with id " + id_text + ": " + *operation +
+             " header operation needs a value without CR/LF.";
+    }
+  }
+  return std::string();
+}
+
+std::string ValidateUrlTransform(const base::DictValue& transform,
+                                 const std::string& id_text) {
+  const std::string unknown = ValidateKnownFields(
+      transform, id_text, "redirect.transform",
+      {"scheme", "host", "port", "path", "query", "queryTransform",
+       "fragment", "username", "password"});
+  if (!unknown.empty()) {
+    return unknown;
+  }
+  for (const char* key : {"scheme", "host", "port", "path", "query",
+                          "fragment", "username", "password"}) {
+    const base::Value* value = transform.Find(key);
+    if (value && !value->is_string()) {
+      return "Rule with id " + id_text + ": redirect.transform." + key +
+             " must be a string.";
+    }
+  }
+  if (const std::string* scheme = transform.FindString("scheme");
+      scheme && *scheme != "http" && *scheme != "https" &&
+      *scheme != "ftp" && *scheme != "chrome-extension") {
+    return "Rule with id " + id_text + ": invalid transform scheme.";
+  }
+  if (const std::string* port = transform.FindString("port");
+      port && !port->empty()) {
+    unsigned port_number = 0;
+    if (!base::StringToUint(*port, &port_number) || port_number > 65535) {
+      return "Rule with id " + id_text + ": invalid transform port.";
+    }
+  }
+  if (const std::string* query = transform.FindString("query");
+      query && !query->empty() && query->front() != '?') {
+    return "Rule with id " + id_text +
+           ": transform query must be empty or start with '?'.";
+  }
+  if (const std::string* fragment = transform.FindString("fragment");
+      fragment && !fragment->empty() && fragment->front() != '#') {
+    return "Rule with id " + id_text +
+           ": transform fragment must be empty or start with '#'.";
+  }
+  if (transform.Find("query") && transform.Find("queryTransform")) {
+    return "Rule with id " + id_text +
+           ": transform query and queryTransform cannot both be specified.";
+  }
+  const base::Value* query_value = transform.Find("queryTransform");
+  if (!query_value) {
+    return {};
+  }
+  const base::DictValue* query_transform = query_value->GetIfDict();
+  if (!query_transform) {
+    return "Rule with id " + id_text +
+           ": redirect.transform.queryTransform must be an object.";
+  }
+  const std::string unknown_query = ValidateKnownFields(
+      *query_transform, id_text, "redirect.transform.queryTransform",
+      {"removeParams", "addOrReplaceParams"});
+  if (!unknown_query.empty()) {
+    return unknown_query;
+  }
+  if (const base::Value* remove = query_transform->Find("removeParams")) {
+    const base::ListValue* list = remove->GetIfList();
+    if (!list || std::ranges::any_of(*list, [](const base::Value& item) {
+          return !item.is_string();
+        })) {
+      return "Rule with id " + id_text +
+             ": queryTransform.removeParams must contain strings.";
+    }
+  }
+  if (const base::Value* add = query_transform->Find("addOrReplaceParams")) {
+    const base::ListValue* list = add->GetIfList();
+    if (!list) {
+      return "Rule with id " + id_text +
+             ": queryTransform.addOrReplaceParams must be a list.";
+    }
+    for (const base::Value& item : *list) {
+      const base::DictValue* pair = item.GetIfDict();
+      if (!pair || !pair->FindString("key") || !pair->FindString("value")) {
+        return "Rule with id " + id_text +
+               ": query transform entries need string key and value.";
+      }
+      const std::string pair_unknown = ValidateKnownFields(
+          *pair, id_text, "query transform entry",
+          {"key", "value", "replaceOnly"});
+      if (!pair_unknown.empty()) {
+        return pair_unknown;
+      }
+      if (const base::Value* replace_only = pair->Find("replaceOnly");
+          replace_only && !replace_only->is_bool()) {
+        return "Rule with id " + id_text +
+               ": query transform replaceOnly must be boolean.";
+      }
+    }
+  }
+  return {};
+}
+
+// 单条规则校验。返回空字符串 = 通过；否则是回给扩展的错误文案。
+std::string ValidateRule(const base::DictValue& rule,
+                         bool allow_tab_ids = false) {
+  const std::optional<int> id = rule.FindInt("id");
+  if (!id || *id <= 0) {
+    return "Rule id must be a positive integer.";
+  }
+  const std::string unknown_rule = ValidateKnownFields(
+      rule, RuleIdText(*id), "rule", {"id", "priority", "action", "condition"});
+  if (!unknown_rule.empty()) {
+    return unknown_rule;
+  }
+  const base::DictValue* action = rule.FindDict("action");
+  if (!action) {
+    return "Rule with id " + RuleIdText(*id) + " must specify an action.";
+  }
+  const std::string* type = action->FindString("type");
+  if (!type) {
+    return "Rule with id " + RuleIdText(*id) + " must specify an action type.";
+  }
+  if (*type != "block" && *type != "allow" && *type != "allowAllRequests" &&
+      *type != "redirect" && *type != "upgradeScheme" &&
+      *type != "modifyHeaders") {
+    return "Rule with id " + RuleIdText(*id) + ": action type '" + *type +
+           "' is not supported by this browser (supported: " +
+           std::string(kSupportedActions) + ").";
+  }
+  const std::string unknown_action = ValidateKnownFields(
+      *action, RuleIdText(*id), "action",
+      *type == "redirect" ? std::initializer_list<std::string_view>{"type",
+                                                                 "redirect"}
+      : *type == "modifyHeaders"
+          ? std::initializer_list<std::string_view>{"type", "requestHeaders",
+                                                    "responseHeaders"}
+          : std::initializer_list<std::string_view>{"type"});
+  if (!unknown_action.empty()) {
+    return unknown_action;
+  }
+  if (*type == "redirect") {
+    if (const base::Value* redirect_value = action->Find("redirect");
+        redirect_value && !redirect_value->is_dict()) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect must be an object.";
+    }
+    const base::DictValue* redirect = action->FindDict("redirect");
+    if (redirect) {
+      const std::string unknown_redirect = ValidateKnownFields(
+          *redirect, RuleIdText(*id), "redirect",
+          {"url", "extensionPath", "transform", "regexSubstitution"});
+      if (!unknown_redirect.empty()) {
+        return unknown_redirect;
+      }
+    }
+    if (!redirect) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect action needs redirect details.";
+    }
+    int destinations = 0;
+    for (const char* key : {"url", "extensionPath", "transform",
+                            "regexSubstitution"}) {
+      if (redirect->Find(key)) {
+        ++destinations;
+      }
+    }
+    if (destinations == 0) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect needs at least one destination.";
+    }
+    if (const base::Value* target_value = redirect->Find("url");
+        target_value && !target_value->is_string()) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect.url must be a string.";
+    }
+    if (const std::string* target = redirect->FindString("url")) {
+      const GURL target_url(*target);
+      if (!target_url.is_valid() || target_url.SchemeIs("javascript")) {
+        return "Rule with id " + RuleIdText(*id) +
+               ": redirect.url must be a valid non-JavaScript URL.";
+      }
+    }
+    if (const base::Value* path_value = redirect->Find("extensionPath");
+        path_value && !path_value->is_string()) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect.extensionPath must be a string.";
+    }
+    if (!redirect->Find("url")) {
+      if (const std::string* path = redirect->FindString("extensionPath");
+          path && (path->empty() || path->front() != '/')) {
+        return "Rule with id " + RuleIdText(*id) +
+               ": redirect.extensionPath must start with '/'.";
+      }
+    }
+    if (const base::Value* transform = redirect->Find("transform");
+        transform && !transform->is_dict()) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect.transform must be an object.";
+    }
+    if (!redirect->Find("url") && !redirect->Find("extensionPath")) {
+      const base::DictValue* transform = redirect->FindDict("transform");
+      if (transform) {
+      const std::string transform_error =
+          ValidateUrlTransform(*transform, RuleIdText(*id));
+      if (!transform_error.empty()) {
+        return transform_error;
+      }
+      }
+    }
+    if (const base::Value* substitution = redirect->Find("regexSubstitution");
+        substitution && !substitution->is_string()) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect.regexSubstitution must be a string.";
+    }
+    if (const std::string* substitution =
+            SelectedRedirectRegexSubstitution(*action);
+        substitution && substitution->empty()) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": redirect.regexSubstitution must not be empty.";
+    }
+  }
+  if (*type == "modifyHeaders") {
+    const bool has_request = action->Find("requestHeaders") != nullptr;
+    const bool has_response = action->Find("responseHeaders") != nullptr;
+    if (!has_request && !has_response) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": modifyHeaders needs requestHeaders or responseHeaders.";
+    }
+    for (const char* key : {"requestHeaders", "responseHeaders"}) {
+      const std::string reason =
+          ValidateHeaderModifications(*action, RuleIdText(*id), key);
+      if (!reason.empty()) {
+        return reason;
+      }
+    }
+  }
+  const base::DictValue* condition = rule.FindDict("condition");
+  if (!condition) {
+    return "Rule with id " + RuleIdText(*id) + " must specify a condition.";
+  }
+  if (*type == "modifyHeaders" && action->Find("requestHeaders") &&
+      (condition->Find("responseHeaders") ||
+       condition->Find("excludedResponseHeaders"))) {
+    return "Rule with id " + RuleIdText(*id) +
+           ": a response-header rule cannot modify request headers.";
+  }
+  // regexFilter 使用与 Chromium DNR 相同的 RE2 选项和 2 KiB 编译预算。
+  // Android matcher 也使用 RE2/J 执行，不能只做字符串长度近似或退回
+  // Java 正则。
+  const std::string* regex = condition->FindString("regexFilter");
+  const std::string* url_filter = condition->FindString("urlFilter");
+  if (url_filter &&
+      (url_filter->empty() || !base::IsStringASCII(*url_filter))) {
+    return "Rule with id " + RuleIdText(*id) +
+           ": urlFilter must be non-empty ASCII.";
+  }
+  if (url_filter && base::StartsWith(*url_filter, "||*")) {
+    return "Rule with id " + RuleIdText(*id) +
+           ": urlFilter cannot begin with the domain anchor followed by a wildcard.";
+  }
+  if (regex) {
+    if (condition->FindString("urlFilter")) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": cannot specify both urlFilter and regexFilter.";
+    }
+    const std::string* substitution =
+        *type == "redirect" ? SelectedRedirectRegexSubstitution(*action)
+                            : nullptr;
+    const bool case_sensitive =
+        condition->FindBool("isUrlFilterCaseSensitive").value_or(false);
+    const RegexValidation validation = ValidateRegex(
+        *regex, case_sensitive, substitution != nullptr, substitution);
+    if (validation != RegexValidation::kOk) {
+      return "Rule with id " + RuleIdText(*id) +
+             (validation == RegexValidation::kMemory
+                  ? ": regexFilter exceeds the 2KB compiled memory limit."
+                  : ": regexFilter or regexSubstitution is invalid.");
+    }
+  }
+  if (*type == "redirect" &&
+      SelectedRedirectRegexSubstitution(*action) &&
+      !regex) {
+    return "Rule with id " + RuleIdText(*id) +
+           ": regexSubstitution requires a regexFilter condition.";
+  }
+  // 枚举/域名/tabIds 的取值校验：写错的取值会被宿主引擎静默忽略（永不命中），
+  // 插件却以为规则在保护它。宁可现在拒绝并说清哪个 key 错了。
+  const std::string condition_reason =
+      ValidateCondition(*condition, RuleIdText(*id), allow_tab_ids);
+  if (!condition_reason.empty()) {
+    return condition_reason;
+  }
+  // priority（Chrome 口径）：缺省 1；显式给出必须是 >= kMinRulePriority
+  // 的整数。 越界不报错的话，插件按"我设了 9"排布、引擎按 1 排序 ——
+  // 说得出但做不到。
+  if (const base::Value* priority = rule.Find("priority")) {
+    const std::optional<int> value = priority->GetIfInt();
+    if (!value) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": priority must be an integer.";
+    }
+    if (*value < kMinRulePriority) {
+      return "Rule with id " + RuleIdText(*id) +
+             ": priority must be at least " +
+             base::NumberToString(kMinRulePriority) + ".";
+    }
+  }
+  return std::string();
+}
+
+// session rules 只活在当前进程；不复用 PluginStorage，避免“session”在浏览器
+// 重启后意外恢复。所有读写都复制快照，宿主回执失败时可原子恢复旧值。
+struct SessionRegistry {
+  base::Lock lock;
+  std::map<std::string, base::ListValue> rules GUARDED_BY(lock);
+};
+
+SessionRegistry& Sessions() {
+  static base::NoDestructor<SessionRegistry> registry;
+  return *registry;
+}
+
+base::ListValue SessionRulesSnapshot(const std::string& extension_id) {
+  base::AutoLock guard(Sessions().lock);
+  auto it = Sessions().rules.find(extension_id);
+  return it == Sessions().rules.end() ? base::ListValue() : it->second.Clone();
+}
+
+// dynamic/session 共用同一套合并、唯一性和规则语义校验。other_rules 是另一类
+// 规则的当前快照，用来执行两类共享的 regex 配额。
+DnrUpdateOutcome MergeRuntimeRules(std::string_view operation,
+                                   const base::ListValue& current_rules,
+                                   const base::ListValue& other_rules,
+                                   int own_limit,
+                                   int unsafe_limit,
+                                   const std::vector<int>& remove_rule_ids,
+                                   const base::ListValue& add_rules,
+                                   base::ListValue* merged_out) {
+  DnrUpdateOutcome out;
+
+  std::vector<int> order;
+  std::map<int, base::DictValue> by_id;
+  for (const base::Value& item : current_rules) {
+    const base::DictValue* rule = item.GetIfDict();
+    const std::optional<int> id = rule ? rule->FindInt("id") : std::nullopt;
+    if (!rule || !id || *id <= 0) {
+      continue;
+    }
+    if (by_id.emplace(*id, rule->Clone()).second) {
+      order.push_back(*id);
+    }
+  }
+  for (int remove_id : remove_rule_ids) {
+    if (remove_id <= 0) {
+      continue;
+    }
+    if (by_id.erase(remove_id) > 0) {
+      order.erase(std::remove(order.begin(), order.end(), remove_id),
+                  order.end());
+    }
+  }
+
+  std::vector<std::pair<int, base::DictValue>> incoming;
+  std::vector<int> seen;
+  for (const base::Value& item : add_rules) {
+    const base::DictValue* rule = item.GetIfDict();
+    if (!rule) {
+      out.error = "Each rule must be an object.";
+      return out;
+    }
+    const std::string reason = ValidateRule(*rule, operation == "session");
+    if (!reason.empty()) {
+      out.error = reason;
+      return out;
+    }
+    const int id = *rule->FindInt("id");
+    if (std::find(seen.begin(), seen.end(), id) != seen.end() ||
+        by_id.contains(id)) {
+      out.error =
+          "Rule with id " + RuleIdText(id) + " does not have a unique ID.";
+      return out;
+    }
+    seen.push_back(id);
+    incoming.emplace_back(id, rule->Clone());
+  }
+
+  const int own_count = static_cast<int>(by_id.size() + incoming.size());
+  if (own_count > own_limit) {
+    out.error = "Number of " + std::string(operation) +
+                " rules exceeds the limit of " +
+                base::NumberToString(own_limit) + ".";
+    return out;
+  }
+  int unsafe_count = 0;
+  for (const auto& [id, rule] : by_id) {
+    unsafe_count += RuleIsUnsafe(rule) ? 1 : 0;
+  }
+  for (const auto& [id, rule] : incoming) {
+    unsafe_count += RuleIsUnsafe(rule) ? 1 : 0;
+  }
+  if (unsafe_count > unsafe_limit) {
+    out.error = "Number of unsafe " + std::string(operation) +
+                " rules exceeds the limit of " +
+                base::NumberToString(unsafe_limit) + ".";
+    return out;
+  }
+  base::ListValue remaining;
+  for (const auto& [id, rule] : by_id) {
+    remaining.Append(rule.Clone());
+  }
+  base::ListValue incoming_list;
+  for (const auto& [id, rule] : incoming) {
+    incoming_list.Append(rule.Clone());
+  }
+  const int regex_total = CountRegexRules(remaining) +
+                          CountRegexRules(incoming_list) +
+                          CountRegexRules(other_rules);
+  if (regex_total > kMaxRegexRules) {
+    out.error =
+        "Number of regex rules in dynamic and session rules exceeds "
+        "the limit of " +
+        base::NumberToString(kMaxRegexRules) + " (got " +
+        base::NumberToString(regex_total) + ").";
+    return out;
+  }
+
+  for (auto& [id, rule] : incoming) {
+    order.push_back(id);
+    by_id[id] = std::move(rule);
+  }
+  for (int id : order) {
+    auto it = by_id.find(id);
+    if (it != by_id.end()) {
+      merged_out->Append(std::move(it->second));
+    }
+  }
+
+  out.ok = true;
+  out.rule_count = static_cast<int>(merged_out->size());
+  return out;
+}
