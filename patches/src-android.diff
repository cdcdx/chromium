+
+DnrUpdateOutcome UpdateSessionRules(const std::string& extension_id,
+                                    const std::vector<int>& remove_rule_ids,
+                                    const base::ListValue& add_rules) {
+  DnrUpdateOutcome out;
+  if (extension_id.empty()) {
+    out.error = "updateSessionRules: 扩展 id 为空";
+    return out;
+  }
+
+  // dynamic 存储损坏时不能更新 session 后再向宿主推一份缺 dynamic 的快照；
+  // 那会让原本可能仍在宿主生效的规则静默消失。
+  std::optional<base::ListValue> dynamic = ReadStoredRules(extension_id);
+  if (!dynamic) {
+    out.error = "updateSessionRules: 已存 dynamic 规则不可读";
+    out.storage_error = true;
+    return out;
+  }
+
+  base::AutoLock guard(Sessions().lock);
+  auto it = Sessions().rules.find(extension_id);
+  const base::ListValue current =
+      it == Sessions().rules.end() ? base::ListValue() : it->second.Clone();
+  base::ListValue merged;
+  out = MergeRuntimeRules("session", current, *dynamic, kMaxSessionRules,
+                          kMaxUnsafeSessionRules, remove_rule_ids, add_rules,
+                          &merged);
+  if (!out.ok) {
+    return out;
+  }
+  if (merged.empty()) {
+    Sessions().rules.erase(extension_id);
+  } else {
+    Sessions().rules[extension_id] = merged.Clone();
+  }
+  LOG(INFO) << "[arupa][dnr] session 规则已更新 ext=" << extension_id
+            << " 移除=" << remove_rule_ids.size()
+            << " 新增=" << add_rules.size() << " 现有=" << out.rule_count;
+  return out;
+}
