+
+void OnStaticRulesCommitted(ExtCallerIdentity who, std::string extension_id,
+                            std::string ruleset_id,
+                            std::vector<int> before_disabled,
+                            bool changes_effective_snapshot,
+                            mojom::ExtApiHost::CallCallback callback,
+                            mv3::StaticRuleUpdateOutcome outcome) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!outcome.ok) {
+    FinishDnrUpdate(extension_id);
+    const char *error_code =
+        outcome.storage_error
+            ? kDnrErrStorage
+            : (outcome.error.starts_with("Invalid ruleset id:")
+                   ? kDnrErrRuleset
+                   : kDnrErrValidation);
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(error_code,
+                 "declarativeNetRequest.updateStaticRules: " + outcome.error));
+    return;
+  }
+  if (!FindLoadedExtension(extension_id) || IsExtensionDisabled(extension_id)) {
+    FinishDnrUpdate(extension_id);
+    RunDnrFailure(std::move(callback),
+                  DnrError(kDnrErrEngine,
+                           "declarativeNetRequest.updateStaticRules: "
+                           "扩展在持久提交期间已停用或卸载"));
+    return;
+  }
+  if (!outcome.changed || !changes_effective_snapshot) {
+    FinishDnrUpdate(extension_id);
+    std::move(callback).Run("[]", std::string());
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&BuildEffectiveDnrPushJson, extension_id,
+                     CaptureDnrHostAccessPolicy(extension_id)),
+      base::BindOnce(&PushStaticRulesSnapshot, who, extension_id,
+                     std::move(ruleset_id), std::move(before_disabled),
+                     std::move(callback)));
+}
+
+bool HasDnrFeedbackPermission(const std::string &extension_id,
+                              std::optional<int> tab_id) {
+  if (GrantedPermissionsContain(extension_id, {"declarativeNetRequestFeedback"},
+                                {}) == 1) {
+    return true;
+  }
+  scoped_refptr<const extensions::Extension> extension =
+      FindLoadedExtension(extension_id);
+  return tab_id && *tab_id >= 0 && extension &&
+         !IsExtensionDisabled(extension_id) &&
+         extension->permissions_data()->HasAPIPermissionForTab(
+             *tab_id, extensions::mojom::APIPermissionID::
+                          kDeclarativeNetRequestFeedback);
+}
