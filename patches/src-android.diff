+} // namespace
+
+void PurgeExtensionDataDurably(const std::string &extension_id,
+                               const std::string &uninstall_url,
+                               base::OnceCallback<void(bool)> callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (!PurgesInFlight().insert(extension_id).second) {
+    std::move(callback).Run(false);
+    return;
+  }
+  // 进程恢复或宿主重试必须复用同一事务。否则一次卸载可能产生多个 ready
+  // outbox 项，并以不同 transactionId 重复打开同一个卸载页。
+  const std::optional<base::DictValue> journal = ReadPurgeJournal();
+  if (!journal) {
+    PurgesInFlight().erase(extension_id);
+    std::move(callback).Run(false);
+    return;
+  }
+  const int64_t current_generation =
+      GetExtensionInstallGeneration(extension_id);
+  const bool current_extension_loaded =
+      static_cast<bool>(FindLoadedExtension(extension_id));
+  for (const auto [key, value] : *journal) {
+    const base::DictValue *entry = value.GetIfDict();
+    const std::string *transaction =
+        entry ? entry->FindString("transactionId") : nullptr;
+    const std::string *stored_id =
+        entry ? entry->FindString("extensionId") : nullptr;
+    const std::string *generation_text =
+        entry ? entry->FindString("installGeneration") : nullptr;
+    const std::string *stored_url =
+        entry ? entry->FindString("uninstallUrl") : nullptr;
+    const std::string *stage = entry ? entry->FindString("stage") : nullptr;
+    int64_t stored_generation = 0;
+    if (!transaction || *transaction != key || !stored_id ||
+        *stored_id != extension_id || !generation_text ||
+        !base::StringToInt64(*generation_text, &stored_generation) ||
+        stored_generation < 0 || !stored_url || !stage) {
+      continue;
+    }
+    if (*stage == "ready" && current_generation == 0 &&
+        !current_extension_loaded) {
+      PurgesInFlight().erase(extension_id);
+      if (stored_url->empty()) {
+        RemovePurgeJournalEntry(*transaction);
+      } else {
+        NotifyReadyUninstallUrl(extension_id, *transaction, stored_generation,
+                                *stored_url);
+      }
+      std::move(callback).Run(true);
+      return;
+    }
+    if (*stage == "ready") {
+      // ready 只可能属于已清退的旧安装；同 ID 已重新出现时立即丢弃，不能
+      // 让它在本次卸载完成（generation 再次变为 0）后复活。
+      RemovePurgeJournalEntry(*transaction);
+      continue;
+    }
+    if (*stage == "prepared" &&
+        (current_generation == stored_generation ||
+         (current_generation == 0 && !current_extension_loaded))) {
+      RunPreparedPurge(extension_id, *transaction, stored_generation,
+                       *stored_url, std::move(callback));
+      return;
+    }
+    if (*stage == "prepared") {
+      RemovePurgeJournalEntry(*transaction);
+    }
+  }
+  const std::string transaction_id =
+      base::UnguessableToken::Create().ToString();
+  const int64_t install_generation =
+      GetExtensionInstallGeneration(extension_id);
+  PersistPurgeJournalEntry(
+      transaction_id, extension_id, install_generation, uninstall_url,
+      "prepared",
+      base::BindOnce(
+          [](std::string id, std::string transaction, int64_t generation,
+             std::string url, base::OnceCallback<void(bool)> done,
+             bool persisted) {
+            if (!persisted) {
+              PurgesInFlight().erase(id);
+              std::move(done).Run(false);
+              return;
+            }
+            RunPreparedPurge(id, transaction, generation, url, std::move(done));
+          },
+          extension_id, transaction_id, install_generation, uninstall_url,
+          std::move(callback)));
+}
+
+void ResumePendingExtensionPurges() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const std::optional<base::DictValue> journal = ReadPurgeJournal();
+  if (!journal) {
+    LOG(ERROR) << "[arupa][purge] 无法读取持久 journal";
+    return;
+  }
+  for (const auto [key, value] : *journal) {
+    const base::DictValue *entry = value.GetIfDict();
+    const std::string *transaction =
+        entry ? entry->FindString("transactionId") : nullptr;
+    const std::string *id = entry ? entry->FindString("extensionId") : nullptr;
+    const std::string *generation_text =
+        entry ? entry->FindString("installGeneration") : nullptr;
+    const std::string *url =
+        entry ? entry->FindString("uninstallUrl") : nullptr;
+    const std::string *stage = entry ? entry->FindString("stage") : nullptr;
+    int64_t install_generation = 0;
+    if (!transaction || *transaction != key || !id || !generation_text ||
+        !base::StringToInt64(*generation_text, &install_generation) ||
+        install_generation < 0 || !url || !stage) {
+      LOG(ERROR) << "[arupa][purge] journal 条目损坏 key=" << key;
+      continue;
+    }
+    if (*stage == "ready") {
+      if (url->empty()) {
+        RemovePurgeJournalEntry(*transaction);
+      } else {
+        NotifyReadyUninstallUrl(*id, *transaction, install_generation, *url);
+      }
+    } else if (*stage == "prepared" && !PurgesInFlight().contains(*id)) {
+      const int64_t current_generation = GetExtensionInstallGeneration(*id);
+      if ((current_generation != 0 &&
+           current_generation != install_generation) ||
+          (FindLoadedExtension(*id) && current_generation == 0 &&
+           install_generation != 0)) {
+        LOG(WARNING) << "[arupa][purge] prepared journal 已被重装代次取代 ext="
+                     << *id << " txn=" << *transaction;
+        RemovePurgeJournalEntry(*transaction);
+        continue;
+      }
+      PurgesInFlight().insert(*id);
+      RunPreparedPurge(*id, *transaction, install_generation, *url,
+                       base::BindOnce([](bool) {}));
+    }
+  }
+}
+
+void SetUninstallDeliveryObserver(UninstallDeliveryObserver observer) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  UninstallObserver() = observer;
+  if (observer) {
+    ResumePendingExtensionPurges();
+  }
+}
+
+void AckUninstallUrlDelivery(const std::string &extension_id,
+                             const std::string &transaction_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty() || transaction_id.empty()) {
+    return;
+  }
+  const std::optional<base::DictValue> journal = ReadPurgeJournal();
+  const base::DictValue *entry =
+      journal ? journal->FindDict(transaction_id) : nullptr;
+  const std::string *stored_extension =
+      entry ? entry->FindString("extensionId") : nullptr;
+  const std::string *stage = entry ? entry->FindString("stage") : nullptr;
+  if (stored_extension && *stored_extension == extension_id && stage &&
+      *stage == "ready") {
+    RemovePurgeJournalEntry(transaction_id);
+  } else {
+    LOG(WARNING) << "[arupa][purge] 忽略不匹配的 uninstall ACK ext="
+                 << extension_id << " txn=" << transaction_id;
+  }
+}
