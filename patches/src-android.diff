+TEST_F(DnrRulesTest, IndividualStaticRulesArePersistedFilteredAndRestorable) {
+  WriteStaticRules("privacy.json", {101, 102, 103});
+  base::DictValue manifest = StaticManifest("privacy", "privacy.json");
+  ASSERT_EQ(1,
+            RegisterStaticRulesets(extension_id_, root_.GetPath(), manifest));
+  EXPECT_EQ((std::vector<int>{101, 102, 103}),
+            IdsFrom(GetStaticRulesJson(extension_id_)));
+
+  StaticRuleUpdateOutcome disabled =
+      UpdateStaticRules(extension_id_, "privacy", {101, 102}, {});
+  ASSERT_TRUE(disabled.ok) << disabled.error;
+  EXPECT_TRUE(disabled.changed);
+  EXPECT_EQ((std::vector<int>{101, 102}),
+            GetDisabledStaticRuleIds(extension_id_, "privacy"));
+  EXPECT_EQ((std::vector<int>{103}),
+            IdsFrom(GetStaticRulesJson(extension_id_)));
+
+  // disable 与 enable 重叠时 disable 优先，与 Chromium 一致。
+  StaticRuleUpdateOutcome overlap =
+      UpdateStaticRules(extension_id_, "privacy", {102}, {101, 102});
+  ASSERT_TRUE(overlap.ok) << overlap.error;
+  EXPECT_EQ((std::vector<int>{102}),
+            GetDisabledStaticRuleIds(extension_id_, "privacy"));
+  EXPECT_EQ((std::vector<int>{101, 103}),
+            IdsFrom(GetStaticRulesJson(extension_id_)));
