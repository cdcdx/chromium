+class AutoDispatchObserver : public content::RenderProcessHostObserver {
+public:
+  explicit AutoDispatchObserver(content::RenderProcessHost *host)
+      : host_(host) {
+    host_->AddObserver(this);
+  }
+
+  void RenderProcessReady(content::RenderProcessHost *host) override {
+    ReadyHosts().insert(host);
+    NotifyRuntimeStateMayHaveChanged();
+
+    LOG(INFO) << "[arupa][ext] renderer ready pid=" << host->GetDeprecatedID();
+
+    const base::FilePath root = GetExtensionRoot();
+    if (root.empty()) {
+      LOG(WARNING)
+          << "[arupa] 扩展根未设置(没调 ArupaPluginBridge.setExtensionRoot), "
+             "跳过扩展下发。";
+      return;
+    }
+
+    ready_at_ = base::TimeTicks::Now();
+    ScanCache &cache = Cache();
+    const bool warm = cache.valid && cache.root == root;
+    if (warm) {
+      DispatchScanned(true, root, cache.items);
+    } else {
+      LOG(WARNING)
+          << "[arupa][ext] 🔴 本次下发走**冷缓存**(要先扫盘才发) —— "
+             "在扫完之前起来的扩展页面/SW 会看到一个**残缺的 chrome.* 面** "
+             "(FB-P129)。正常情况下只有进程启动后的第一次会走到这里。";
+    }
+
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ScanExtensionDirs, root),
+        base::BindOnce(&AutoDispatchObserver::DispatchScanned,
+                       weak_factory_.GetWeakPtr(), false, root));
+  }
+
+  void RenderProcessHostDestroyed(content::RenderProcessHost *host) override {
+    ReadyHosts().erase(host);
+    NotifyRuntimeStateMayHaveChanged();
+    host->RemoveObserver(this);
+    delete this;
+  }
+
+private:
+  void DispatchScanned(bool from_cache, base::FilePath scanned_root,
+                       std::vector<ScannedExtension> items) {
+    if (!from_cache) {
+      RememberScan(scanned_root, items);
+
+      NotifyScanCompleted(0);
+    }
+
+    if (scanned_root != GetExtensionRoot()) {
+      LOG(INFO) << "[arupa][root] 扫盘回来时根已换 ⇒ 旧根("
+                << scanned_root.value() << ")这份不下发";
+      return;
+    }
+    int loaded = 0, failed = 0;
+    for (const ScannedExtension &item : items) {
+      std::string error;
+      if (LoadExtensionFromManifestJson(host_, item.dir, item.manifest_json,
+                                        &error)) {
+        ++loaded;
+      } else {
+        ++failed;
+        LOG(WARNING) << "[arupa] 扩展下发失败 " << item.dir.AsUTF8Unsafe()
+                     << " :: " << error;
+      }
+    }
+    if (loaded || failed) {
+      if (from_cache) {
+        LOG(INFO) << "[arupa] renderer ready, 扩展下发(🟢 **热缓存·同步**, "
+                     "无窗口): "
+                  << loaded << " 成功 / " << failed << " 失败";
+      } else {
+        const int ms =
+            ready_at_.is_null()
+                ? -1
+                : static_cast<int>(
+                      (base::TimeTicks::Now() - ready_at_).InMilliseconds());
+        LOG(INFO) << "[arupa] renderer ready, 扩展下发(扫盘回来): " << loaded
+                  << " 成功 / " << failed << " 失败; ⚠ 从 ready 到发出隔了 "
+                  << ms << " ms —— 这段就是 FB-P129 的窗口宽度";
+      }
+    }
+  }
+
+  raw_ptr<content::RenderProcessHost> host_;
+
+  base::TimeTicks ready_at_;
+  base::WeakPtrFactory<AutoDispatchObserver> weak_factory_{this};
+};
