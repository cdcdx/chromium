+bool InstallCurrentRuntimeExtApiCapabilities(
+    const std::string& declaration_json, std::string* error) {
+  if (error) {
+    error->clear();
+  }
+  const std::optional<base::DictValue> declaration =
+      base::JSONReader::ReadDict(declaration_json, base::JSON_PARSE_RFC);
+  const std::string *epoch_text =
+      declaration ? declaration->FindString("contractEpoch") : nullptr;
+  const std::string *host_build =
+      declaration ? declaration->FindString("hostBuild") : nullptr;
+  const base::ListValue *methods =
+      declaration ? declaration->FindList("methods") : nullptr;
+  const base::DictValue *events =
+      declaration ? declaration->FindDict("events") : nullptr;
+  const base::DictValue *models =
+      declaration ? declaration->FindDict("dataModels") : nullptr;
+  const std::optional<bool> cancellation =
+      declaration ? declaration->FindBool("cancellation") : std::nullopt;
+  int64_t contract_epoch = 0;
+  const std::optional<HostRuntimeIdentity> identity = ReadHostRuntimeIdentity();
+  if (!declaration || !epoch_text ||
+      !base::StringToInt64(*epoch_text, &contract_epoch) ||
+      contract_epoch <= 0 ||
+      *epoch_text != base::NumberToString(contract_epoch) || !host_build ||
+      !IsSafeOpaqueIdentity(*host_build, 128) || !methods || !events ||
+      !models || !cancellation || !identity) {
+    if (error) {
+      *error = "host declaration requires positive string contractEpoch, safe "
+               "hostBuild, methods, events, dataModels, cancellation and a "
+               "current runtime identity";
+    }
+    return false;
+  }
+
+  std::set<std::string> sorted_methods;
+  for (const base::Value &method : *methods) {
+    if (!method.is_string() || method.GetString().empty() ||
+        !sorted_methods.insert(method.GetString()).second) {
+      if (error) {
+        *error = "host declaration methods must be unique strings";
+      }
+      return false;
+    }
+  }
+  std::map<std::string, std::pair<bool, bool>> sorted_events;
+  for (const auto [name, value] : *events) {
+    const base::DictValue *descriptor = value.GetIfDict();
+    const std::optional<bool> cold_wake =
+        descriptor ? descriptor->FindBool("coldWake") : std::nullopt;
+    const std::optional<bool> replay =
+        descriptor ? descriptor->FindBool("replay") : std::nullopt;
+    if (name.empty() || !cold_wake || !replay) {
+      if (error) {
+        *error = "host declaration events require coldWake and replay booleans";
+      }
+      return false;
+    }
+    sorted_events.emplace(std::string(name), std::pair(*cold_wake, *replay));
+  }
+  std::map<std::string, int> sorted_models;
+  for (const auto [name, value] : *models) {
+    if (name.empty() || !value.is_int() || value.GetInt() <= 0) {
+      if (error) {
+        *error =
+            "host declaration dataModels require positive integer versions";
+      }
+      return false;
+    }
+    sorted_models.emplace(std::string(name), value.GetInt());
+  }
+
+  // Keep this field set and ordering identical to SetExtApiCapabilitiesJson's
+  // canonicalization. Containers are sorted first, so Java JSONObject order
+  // and host declaration order cannot change the digest.
+  base::DictValue contract;
+  contract.Set("contractVersion", 2);
+  contract.Set("contractEpoch", *epoch_text);
+  contract.Set("kernelContractDigest", mv3::contract::kDigest);
+  contract.Set("hostBuild", *host_build);
+  base::DictValue scope;
+  scope.Set("profileId", ProfileIdForThisRun());
+  scope.Set("accountScope", identity->account_scope);
+  scope.Set("sessionEpoch", identity->session_epoch);
+  scope.Set("incognito", identity->off_the_record);
+  contract.Set("scope", std::move(scope));
+  contract.Set("cancellation", *cancellation);
+  base::ListValue canonical_methods;
+  for (const std::string &method : sorted_methods) {
+    canonical_methods.Append(method);
+  }
+  contract.Set("methods", std::move(canonical_methods));
+  base::DictValue canonical_events;
+  for (const auto &[name, semantics] : sorted_events) {
+    base::DictValue descriptor;
+    descriptor.Set("coldWake", semantics.first);
+    descriptor.Set("replay", semantics.second);
+    canonical_events.Set(name, std::move(descriptor));
+  }
+  contract.Set("events", std::move(canonical_events));
+  base::DictValue canonical_models;
+  for (const auto &[name, version] : sorted_models) {
+    canonical_models.Set(name, version);
+  }
+  contract.Set("dataModels", std::move(canonical_models));
+  std::string canonical_json;
+  if (!base::JSONWriter::Write(contract, &canonical_json)) {
+    if (error) {
+      *error = "host declaration canonicalization failed";
+    }
+    return false;
+  }
+  contract.Set("contractDigest",
+               base::HexEncodeLower(crypto::SHA256HashString(canonical_json)));
+  std::string contract_json;
+  if (!base::JSONWriter::Write(contract, &contract_json)) {
+    if (error) {
+      *error = "host capability contract serialization failed";
+    }
+    return false;
+  }
+  return SetExtApiCapabilitiesJson(contract_json, error);
+}
+
+bool HostSupportsExtApiMethod(const std::string &name) {
+  const std::optional<HostRuntimeIdentity> current = ReadHostRuntimeIdentity();
+  base::AutoLock guard(Capabilities().lock);
+  return current && Capabilities().installed &&
+         Capabilities().profile_id == ProfileIdForThisRun() &&
+         Capabilities().account_scope == current->account_scope &&
+         Capabilities().session_epoch == current->session_epoch &&
+         Capabilities().methods.contains(name);
+}
+
+bool HostSupportsExtApiEvent(const std::string &name) {
+  const std::optional<HostRuntimeIdentity> current = ReadHostRuntimeIdentity();
+  base::AutoLock guard(Capabilities().lock);
+  return current && Capabilities().installed &&
+         Capabilities().profile_id == ProfileIdForThisRun() &&
+         Capabilities().account_scope == current->account_scope &&
+         Capabilities().session_epoch == current->session_epoch &&
+         Capabilities().events.contains(name);
+}
+
+bool HostExtApiEventSupportsColdWake(const std::string &name) {
+  base::AutoLock guard(Capabilities().lock);
+  const auto it = Capabilities().events.find(name);
+  return Capabilities().installed && it != Capabilities().events.end() &&
+         it->second.first;
+}
