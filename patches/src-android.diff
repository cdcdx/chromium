+// 卸载时的预清理仅将删除排队；PurgeExtensionData 后续的有序 ClearAsync
+// 才负责确认最终删除，不能以此函数的返回作为卸载完成依据。
+void ClearDynamicRules(const std::string& extension_id);
+
+// session rules 只保存在当前内核进程，不写
+// PluginStorage；浏览器进程重启后自然清空。 更新语义与 dynamic rules
+// 相同；两类条数预算独立，regex 条数预算共享。
+DnrUpdateOutcome UpdateSessionRules(const std::string& extension_id,
+                                    const std::vector<int>& remove_rule_ids,
+                                    const base::ListValue& add_rules);
