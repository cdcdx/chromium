+void RestoreRuntimeUninstallUrl(const std::string &extension_id) {
+  const std::string stored = mv3::PluginStorage::Get().GetValue(
+      InternalStorageIdFor(extension_id), kRuntimeUninstallUrlKey);
+  if (stored.empty()) {
+    return;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(stored, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_string()) {
+    LOG(ERROR) << "[arupa][runtime] 卸载 URL 持久值损坏 ext=" << extension_id;
+    return;
+  }
+  const GURL url(parsed->GetString());
+  if (!url.is_valid() || !(url.SchemeIs("http") || url.SchemeIs("https"))) {
+    LOG(ERROR) << "[arupa][runtime] 卸载 URL 持久值不是 HTTP(S) ext="
+               << extension_id;
+    return;
+  }
+  if (!SetActionUninstallUrl(extension_id, url.spec())) {
+    LOG(ERROR) << "[arupa][runtime] 恢复卸载 URL 时 action 状态不存在 ext="
+               << extension_id;
+  }
