+namespace {
+
+// 目录 → (当时的 manifest 原文, 解析结果)。
+//
+// RedispatchOnUiThread 是「每个 renderer × 每个扩展」的双层循环，每个组合都会
+// 再走一次 ParseAndRegisterExtension —— 也就是同一个扩展被解析并登记 N×M 次：
+// JSON 解析、Extension::Create、以及四件登记（含静态规则集的持久化写入）全部
+// 重复做。这里按目录 + manifest 原文缓存，内容没变就直接复用。
+struct ParseCache {
+  base::Lock lock;
+  std::map<std::string,
+           std::pair<std::string, scoped_refptr<extensions::Extension>>>
+      by_dir GUARDED_BY(lock);
+};
+
+ParseCache &ParsedCache() {
+  static base::NoDestructor<ParseCache> c;
+  return *c;
+}
+
+std::map<std::string, int64_t> &DnrSnapshotGenerations() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<std::map<std::string, int64_t>> generations;
+  return *generations;
+}
+
+void InvalidateHostDnrSnapshot(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  ++DnrSnapshotGenerations()[extension_id];
+  InvalidateHostDnrSnapshotReconciled(extension_id);
+}
+
+void ScheduleHostDnrSnapshot(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const int64_t generation = ++DnrSnapshotGenerations()[extension_id];
+  mv3::DnrHostAccessPolicy access_policy =
+      CaptureDnrHostAccessPolicy(extension_id);
+  InvalidateHostDnrSnapshotReconciled(extension_id);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](std::string id) { return mv3::BuildEffectiveRulesSnapshot(id); },
+          extension_id),
+      base::BindOnce(
+          [](std::string id, int64_t expected_generation,
+             mv3::DnrHostAccessPolicy access_policy,
+             mv3::DnrSnapshotResult snapshot) {
+            DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+            auto it = DnrSnapshotGenerations().find(id);
+            if (it == DnrSnapshotGenerations().end() ||
+                it->second != expected_generation || IsExtensionDisabled(id)) {
+              LOG(INFO) << "[arupa][dnr] 静态快照迟到, 丢弃 ext=" << id
+                        << " gen=" << expected_generation;
+              return;
+            }
+            if (!snapshot.ok) {
+              LOG(ERROR) << "[arupa][dnr] 启动快照构建失败 ext=" << id
+                         << " code=" << snapshot.error_code
+                         << " ruleset=" << snapshot.error_ruleset_id
+                         << " skipped=" << snapshot.skipped_rules;
+              // 升级时不能继续保留旧包 matcher；removeRules 与安装空快照
+              // 不同，它明确把该扩展的旧引擎状态撤下。
+              ExtCallerIdentity lifecycle_caller;
+              lifecycle_caller.kind = ExtCallerIdentity::Kind::kProcess;
+              mv3::DnrHostRequest removal =
+                  mv3::BuildDnrHostRequest(
+                      id, "[]", 0, true, GetExtensionInstallGeneration(id),
+                      access_policy);
+              if (!removal.ok) {
+                LOG(ERROR) << "[arupa][dnr] 构建失败后撤规则请求失败 ext="
+                           << id;
+                return;
+              }
+              CallHostApiFromKernelFrom(
+                  lifecycle_caller, id, "nomad.dnr.removeRules",
+                  removal.args_json,
+                  base::BindOnce(
+                      [](std::string extension_id,
+                         mv3::DnrHostReceiptExpectation expected,
+                         const std::string &result_json,
+                         const std::string &error) {
+                        std::string reason;
+                        if (!mv3::DnrRemoveReceiptMatches(result_json, error,
+                                                          expected, &reason)) {
+                          LOG(ERROR)
+                              << "[arupa][dnr] 构建失败后撤下旧规则失败 ext="
+                              << extension_id << " error=" << reason;
+                        }
+                      },
+                      id, removal.receipt));
+              return;
+            }
+            if (snapshot.skipped_rules != 0) {
+              // Chromium 对静态规则集采用逐条容错：无法索引的规则被忽略，
+              // 其余有效规则仍然生效。这里保留诊断但不能撤掉整个 matcher。
+              LOG(WARNING) << "[arupa][dnr] 启动快照已跳过无效静态规则 ext="
+                           << id << " skipped=" << snapshot.skipped_rules;
+            }
+            std::optional<base::Value> rules = base::JSONReader::Read(
+                snapshot.rules_json, base::JSON_PARSE_RFC);
+            if (!rules || !rules->is_list()) {
+              LOG(ERROR) << "[arupa][dnr] 启动快照结构非法 ext=" << id;
+              return;
+            }
+            mv3::DnrHostRequest request = mv3::BuildDnrHostRequest(
+                id, snapshot.rules_json, snapshot.rule_count, false,
+                GetExtensionInstallGeneration(id), access_policy);
+            if (!request.ok) {
+              LOG(ERROR) << "[arupa][dnr] 启动快照序列化失败 ext=" << id;
+              return;
+            }
+            request.receipt.engine_generation =
+                mv3::DnrActiveEngineGeneration();
+            request.receipt.lifecycle_generation =
+                HostDnrSnapshotLifecycleGeneration(id);
+            ExtCallerIdentity lifecycle_caller;
+            lifecycle_caller.kind = ExtCallerIdentity::Kind::kProcess;
+            CallHostApiFromKernelFrom(
+                lifecycle_caller, id, "nomad.dnr.applyDynamicRules",
+                request.args_json,
+                base::BindOnce(
+                    [](std::string extension_id, int64_t generation,
+                       mv3::DnrHostReceiptExpectation expected,
+                       const std::string &result_json,
+                       const std::string &error) {
+                      auto it = DnrSnapshotGenerations().find(extension_id);
+                      if (it == DnrSnapshotGenerations().end() ||
+                          it->second != generation ||
+                          IsExtensionDisabled(extension_id)) {
+                        return;
+                      }
+                      std::string reason;
+                      if (!mv3::DnrApplyReceiptMatches(result_json, error,
+                                                       expected, &reason) ||
+                          !ConfirmHostDnrSnapshotReconciled(
+                              extension_id, expected.engine_generation,
+                              expected.lifecycle_generation)) {
+                        if (reason.empty()) {
+                          reason = "宿主规则引擎已切换，旧代次回执无效";
+                        }
+                        LOG(ERROR) << "[arupa][dnr] 默认静态规则快照未生效 ext="
+                                   << extension_id << " error=" << reason;
+                      } else {
+                        LOG(INFO) << "[arupa][dnr] 默认静态规则快照已生效 ext="
+                                  << extension_id << " receipt=" << result_json;
+                        RestoreDnrActionOptions(extension_id);
+                      }
+                    },
+                    id, expected_generation, request.receipt));
+          },
+          extension_id, generation, std::move(access_policy)));
+}
