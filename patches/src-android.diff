+bool BindHostRuntimeIdentity(ExtCallerIdentity *who) {
+  if (!who) {
+    return false;
+  }
+  const std::optional<HostRuntimeIdentity> identity = ReadHostRuntimeIdentity();
+  if (!identity) {
+    return false;
+  }
+  who->runtime_identity_bound = true;
+  who->runtime_off_the_record = identity->off_the_record;
+  who->account_scope = identity->account_scope;
+  who->session_epoch = identity->session_epoch;
+  return true;
+}
+
+bool HostRuntimeIdentityStillCurrent(const ExtCallerIdentity &who) {
+  if (!who.runtime_identity_bound) {
+    return false;
+  }
+  const std::optional<HostRuntimeIdentity> current = ReadHostRuntimeIdentity();
+  if (!current || current->account_scope != who.account_scope ||
+      current->session_epoch != who.session_epoch) {
+    return false;
+  }
+  if (who.kind != ExtCallerIdentity::Kind::kWorker) {
+    return true;
+  }
+  const GURL scope(who.worker_scope);
+  const TabBook book = who.runtime_incognito_generation != 0
+                           ? TabBook::kIncognito
+                           : TabBook::kRegular;
+  const auto worker_context =
+      CurrentExtensionWorkerContext(std::string(scope.host()), book);
+  return worker_context && worker_context->incognito_generation ==
+                               who.runtime_incognito_generation;
+}
+
+bool ExtensionCanUseNativeMessaging(const std::string &extension_id,
+                                    bool incognito) {
+  return !extension_id.empty() && !IsExtensionDisabled(extension_id) &&
+         (!incognito || IsExtensionIncognitoAccessAllowed(extension_id)) &&
+         GrantedPermissionsContain(extension_id, {"nativeMessaging"}, {}) == 1;
+}
