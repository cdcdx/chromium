+base::UnguessableToken
+WorkerActivationTokenFor(const extensions::ExtensionId &id) {
+  static base::NoDestructor<
+      std::map<extensions::ExtensionId, base::UnguessableToken>>
+      tokens;
+  auto it = tokens->find(id);
+  if (it == tokens->end()) {
+    it = tokens->emplace(id, base::UnguessableToken::Create()).first;
+  }
+  return it->second;
+}
+
+bool CanSendActivationToken(content::RenderProcessHost *process,
+                            const extensions::Extension &extension) {
+  if (!extensions::BackgroundInfo::IsServiceWorkerBased(&extension)) {
+    return false;
+  }
+
+  // Arupa 的逐页 OTR 使用 regular BrowserContext 下的 in-memory
+  // StoragePartition；只看 BrowserContext::IsOffTheRecord() 会把 activation
+  // token 错发给 renderer，而 renderer 已通过 `arupa-otr` 开关把自己标为
+  // incognito。 Chromium 对 spanning MV3 的约束是：这种进程绝不能带 worker
+  // token，否则 RendererExtensionRegistry::Insert 会
+  // fail-fast。浏览器侧必须使用与 AppendExtraCommandLineSwitches
+  // 完全相同的判据。
+  content::BrowserContext *context =
+      process ? process->GetBrowserContext() : nullptr;
+  content::StoragePartition *partition =
+      process ? process->GetStoragePartition() : nullptr;
+  const bool is_incognito = (context && context->IsOffTheRecord()) ||
+                            (partition && partition->GetConfig().in_memory());
+  if (is_incognito && extensions::IncognitoInfo::IsSpanningMode(&extension)) {
+    return false;
+  }
+  return true;
+}
+
+void PushCorsBypassForExtension(content::BrowserContext *ctx,
+                                const extensions::Extension &ext) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!ctx) {
+    LOG(ERROR) << "[arupa][ext] 🔴 没有 BrowserContext ⇒ **没能给 " << ext.id()
+               << " 推 CORS 豁免**; 它对自己后端的 fetch 会被当成网页拦掉";
+    return;
+  }
+  auto allow = extensions::CreateCorsOriginAccessAllowList(ext);
+  auto block = extensions::CreateCorsOriginAccessBlockList(ext);
+  const size_t n_allow = allow.size(), n_block = block.size();
+  content::CorsOriginPatternSetter::Set(ctx, url::Origin::Create(ext.url()),
+                                        std::move(allow), std::move(block),
+                                        base::DoNothing());
+  LOG(INFO) << "[arupa][ext] CORS 豁免已推 ext=" << ext.id()
+            << " allow=" << n_allow << " block=" << n_block
+            << (n_allow == 0
+                    ? "  ⚠ allow 为 0 —— 这个扩展没声明 host_permissions, "
+                      "它对外站的 fetch **仍会走 CORS**(那是对的)"
+                    : "");
+}
+
+extensions::mojom::ExtensionLoadedParamsPtr
+MakeParams(content::RenderProcessHost *process,
+           const extensions::Extension &extension) {
+  const extensions::PermissionsData *permissions = extension.permissions_data();
+
+  base::DictValue renderer_manifest = extension.manifest()->value()->Clone();
+  base::DictValue capability = RendererHostCapabilityManifestData();
+  renderer_manifest.Set(
+      kHostCapabilityManifestMembersKey,
+      std::move(*capability.Find(kHostCapabilityManifestMembersKey)));
+  if (base::Value *epoch = capability.Find(kHostCapabilityManifestEpochKey)) {
+    renderer_manifest.Set(kHostCapabilityManifestEpochKey, std::move(*epoch));
+  }
+  if (base::Value *digest = capability.Find(kHostCapabilityManifestDigestKey)) {
+    renderer_manifest.Set(kHostCapabilityManifestDigestKey, std::move(*digest));
+  }
+
+  return extensions::mojom::ExtensionLoadedParams::New(
+      std::move(renderer_manifest), extension.location(), extension.path(),
+
+      FilterByKernelGuard(permissions->active_permissions(), extension.id()),
+      ClonePermissions(permissions->withheld_permissions()),
+
+      base::flat_map<int, extensions::PermissionSet>(),
+      permissions->policy_blocked_hosts(), permissions->policy_allowed_hosts(),
+      permissions->UsesDefaultPolicyHostRestrictions(),
+
+      permissions->HasAPIPermission("userScripts"), extension.id(),
+
+      CanSendActivationToken(process, extension)
+          ? std::make_optional(WorkerActivationTokenFor(extension.id()))
+          : std::nullopt,
+      extension.creation_flags(), extension.guid());
+}
+
+class DispatchedIds : public base::SupportsUserData::Data {
+public:
+  static const void *Key() {
+    static const int kKey = 0;
+    return &kKey;
+  }
+
+  static bool Contains(content::RenderProcessHost *process,
+                       const std::string &id) {
+    DispatchedIds *d =
+        static_cast<DispatchedIds *>(process->GetUserData(Key()));
+    return d && d->ids_.count(id) > 0;
+  }
+
+  static void Remove(content::RenderProcessHost *process,
+                     const std::string &id) {
+    DispatchedIds *d =
+        static_cast<DispatchedIds *>(process->GetUserData(Key()));
+    if (d) {
+      d->ids_.erase(id);
+    }
+  }
+
+  static bool MarkIfFirst(content::RenderProcessHost *process,
+                          const std::string &id) {
+    DispatchedIds *d =
+        static_cast<DispatchedIds *>(process->GetUserData(Key()));
+    if (!d) {
+      auto owned = std::make_unique<DispatchedIds>();
+      d = owned.get();
+      process->SetUserData(Key(), std::move(owned));
+    }
+    return d->ids_.insert(id).second;
+  }
+
+private:
+  std::set<std::string> ids_;
+};
+
+} // namespace
+
+bool LoadExtensionIntoRenderer(content::RenderProcessHost *process,
+                               const extensions::Extension &extension) {
+  if (!process || !process->GetChannel()) {
+    LOG(ERROR) << "[arupa] 下发扩展失败: renderer 进程或 IPC 通道不在 ("
+               << extension.id() << ")";
+    return false;
+  }
+
+  if (!DispatchedIds::MarkIfFirst(process, extension.id())) {
+    return true;
+  }
+
+  mojo::AssociatedRemote<extensions::mojom::Renderer> renderer;
+  process->GetChannel()->GetRemoteAssociatedInterface(&renderer);
+  if (!renderer.is_bound()) {
+    LOG(ERROR) << "[arupa] 下发扩展失败: 拿不到 mojom::Renderer ("
+               << extension.id() << ")";
+
+    DispatchedIds::Remove(process, extension.id());
+    return false;
+  }
+
+  std::vector<extensions::mojom::ExtensionLoadedParamsPtr> params;
+  params.push_back(MakeParams(process, extension));
+
+  PushCorsBypassForExtension(process->GetBrowserContext(), extension);
+  renderer->LoadExtensions(std::move(params));
+
+  renderer->ActivateExtension(extension.id());
+
+  LOG(INFO) << "[arupa] 扩展已下发到 renderer pid="
+            << process->GetID().GetUnsafeValue() << " id=" << extension.id();
+
+  DispatchContentScripts(process, extension);
+  return true;
+}
