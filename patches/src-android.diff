+bool ApplyArupaWebSocketRequestDnr(
+    content::RenderFrameHost *frame, const GURL &url,
+    const net::HttpRequestHeaders &headers,
+    net::HttpRequestHeaders *modified_headers) {
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+  if (!frame || !url.SchemeIsWSOrWSS() || !modified_headers) {
+    return true;
+  }
+  content::WebContents *web_contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate =
+      GetKernelViewJavaDelegate(web_contents);
+  if (java_delegate.is_null()) {
+    return true;
+  }
+  std::vector<std::string> names;
+  std::vector<std::string> values;
+  for (const auto &header : headers.GetHeaderVector()) {
+    if (!IsDnrInternalHeader(header.key)) {
+      names.push_back(header.key);
+      values.push_back(header.value);
+    }
+  }
+  AppendDnrTrustedContextValues(
+      "websocket", frame->GetLastCommittedOrigin().Serialize(),
+      TabIdForWebContents(web_contents),
+      TabBookForWebContents(web_contents) == TabBook::kIncognito ? "incognito"
+                                                                 : "regular",
+      frame->GetFrameTreeNodeId().value(),
+      frame->GetParent() ? frame->GetParent()->GetFrameTreeNodeId().value()
+                         : -1,
+      FrameIdOf(frame), FrameIdOf(frame->GetParentOrOuterDocument()),
+      DocumentIdOf(frame), DocumentIdOf(frame->GetParentOrOuterDocument()),
+      DocumentLifecycleOf(frame), FrameTypeOf(frame),
+      &names, &values);
+  JNIEnv *env = base::android::AttachCurrentThread();
+  base::android::ScopedJavaLocalRef<jobject> response =
+      CallShouldInterceptRequest(env, java_delegate, url.spec(), "GET", false,
+                                 names, values);
+  if (response.is_null()) {
+    *modified_headers = headers;
+    return true;
+  }
+  if (!Java_ArupaWebResourceResponse_getPassThrough(env, response)) {
+    return false;
+  }
+  *modified_headers = headers;
+  ApplyRequestHeaderModifications(
+      ReadPassThroughInstruction(env, response).request_headers,
+      modified_headers);
+  return true;
+#else
+  return true;
+#endif
+}
+
+bool ApplyArupaWebSocketResponseDnr(
+    content::RenderFrameHost *frame, const GURL &url,
+    const std::string &raw_headers, std::string *modified_raw_headers) {
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+  if (!frame || !url.SchemeIsWSOrWSS() || !modified_raw_headers) {
+    return true;
+  }
+  content::WebContents *web_contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate =
+      GetKernelViewJavaDelegate(web_contents);
+  if (java_delegate.is_null()) {
+    *modified_raw_headers = raw_headers;
+    return true;
+  }
+  auto response_headers =
+      base::MakeRefCounted<net::HttpResponseHeaders>(raw_headers);
+  std::vector<std::string> names;
+  std::vector<std::string> values;
+  size_t cursor = 0;
+  std::string name;
+  std::string value;
+  while (response_headers->EnumerateHeaderLines(&cursor, &name, &value)) {
+    if (!IsDnrInternalHeader(name)) {
+      names.push_back(name);
+      values.push_back(value);
+    }
+  }
+  names.emplace_back(kDnrStageHeader);
+  values.emplace_back("headersReceived");
+  AppendDnrTrustedContextValues(
+      "websocket", frame->GetLastCommittedOrigin().Serialize(),
+      TabIdForWebContents(web_contents),
+      TabBookForWebContents(web_contents) == TabBook::kIncognito ? "incognito"
+                                                                 : "regular",
+      frame->GetFrameTreeNodeId().value(),
+      frame->GetParent() ? frame->GetParent()->GetFrameTreeNodeId().value()
+                         : -1,
+      FrameIdOf(frame), FrameIdOf(frame->GetParentOrOuterDocument()),
+      DocumentIdOf(frame), DocumentIdOf(frame->GetParentOrOuterDocument()),
+      DocumentLifecycleOf(frame), FrameTypeOf(frame), &names, &values);
+  JNIEnv *env = base::android::AttachCurrentThread();
+  base::android::ScopedJavaLocalRef<jobject> response =
+      CallShouldInterceptRequest(env, java_delegate, url.spec(), "GET", false,
+                                 names, values);
+  if (response.is_null()) {
+    *modified_raw_headers = raw_headers;
+    return true;
+  }
+  if (!Java_ArupaWebResourceResponse_getPassThrough(env, response)) {
+    return false;
+  }
+  auto head = network::mojom::URLResponseHead::New();
+  head->headers = std::move(response_headers);
+  ApplyResponseHeaderModifications(
+      ReadPassThroughInstruction(env, response).response_headers, head.get());
+  *modified_raw_headers = head->headers->raw_headers();
+  return true;
+#else
+  return true;
+#endif
+}
