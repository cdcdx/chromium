+void AppendCallbackRequestHeaders(const network::ResourceRequest &request,
+                                  std::vector<std::string> *names,
+                                  std::vector<std::string> *values) {
+  for (const auto &header : request.headers.GetHeaderVector()) {
+    // 这些键只允许下方从 ResourceRequest / RenderFrameHost 重新生成。
+    // HTTP 头名不区分大小写，不能依赖 Java Map 的精确大小写覆盖。
+    if (IsDnrInternalHeader(header.key)) {
+      continue;
+    }
+    names->push_back(header.key);
+    values->push_back(header.value);
+  }
+}
+
+struct DnrHeaderModification {
+  std::string header;
+  std::string operation;
+  std::string value;
+};
+
+struct PassThroughInstruction {
+  GURL redirect_url;
+  std::vector<DnrHeaderModification> request_headers;
+  std::vector<DnrHeaderModification> response_headers;
+};
+
+std::vector<DnrHeaderModification>
+ReadHeaderModifications(JNIEnv *env,
+                        const base::android::JavaRef<jobject> &response,
+                        bool request_headers) {
+  std::vector<std::string> names;
+  std::vector<std::string> operations;
+  std::vector<std::string> values;
+  if (request_headers) {
+    base::android::AppendJavaStringArrayToStringVector(
+        env, Java_ArupaWebResourceResponse_getRequestHeaderNames(env, response),
+        &names);
+    base::android::AppendJavaStringArrayToStringVector(
+        env,
+        Java_ArupaWebResourceResponse_getRequestHeaderOperations(env, response),
+        &operations);
+    base::android::AppendJavaStringArrayToStringVector(
+        env,
+        Java_ArupaWebResourceResponse_getRequestHeaderValues(env, response),
+        &values);
+  } else {
+    base::android::AppendJavaStringArrayToStringVector(
+        env,
+        Java_ArupaWebResourceResponse_getResponseHeaderNames(env, response),
+        &names);
+    base::android::AppendJavaStringArrayToStringVector(
+        env,
+        Java_ArupaWebResourceResponse_getResponseHeaderOperations(env,
+                                                                  response),
+        &operations);
+    base::android::AppendJavaStringArrayToStringVector(
+        env,
+        Java_ArupaWebResourceResponse_getResponseHeaderValues(env, response),
+        &values);
+  }
+  std::vector<DnrHeaderModification> out;
+  const size_t count =
+      std::min({names.size(), operations.size(), values.size()});
+  out.reserve(count);
+  for (size_t i = 0; i < count; ++i) {
+    if (names[i].empty() ||
+        (operations[i] != "append" && operations[i] != "set" &&
+         operations[i] != "remove")) {
+      continue;
+    }
+    out.push_back(
+        {std::move(names[i]), std::move(operations[i]), std::move(values[i])});
+  }
+  return out;
+}
+
+PassThroughInstruction
+ReadPassThroughInstruction(JNIEnv *env,
+                           const base::android::JavaRef<jobject> &response) {
+  PassThroughInstruction instruction;
+  instruction.redirect_url = GURL(base::android::ConvertJavaStringToUTF8(
+      env, Java_ArupaWebResourceResponse_getRedirectUrl(env, response)));
+  instruction.request_headers = ReadHeaderModifications(env, response, true);
+  instruction.response_headers = ReadHeaderModifications(env, response, false);
+  return instruction;
+}
+
+void ApplyRequestHeaderModifications(
+    const std::vector<DnrHeaderModification> &modifications,
+    net::HttpRequestHeaders *headers) {
+  for (const DnrHeaderModification &modification : modifications) {
+    if (IsDnrInternalHeader(modification.header) ||
+        !net::HttpUtil::IsValidHeaderName(modification.header) ||
+        (modification.operation != "remove" &&
+         !net::HttpUtil::IsValidHeaderValue(modification.value))) {
+      continue;
+    }
+    if (modification.operation == "remove") {
+      headers->RemoveHeader(modification.header);
+    } else if (modification.operation == "set") {
+      headers->SetHeader(modification.header, modification.value);
+    } else {
+      const std::optional<std::string> current =
+          headers->GetHeader(modification.header);
+      const std::string separator =
+          base::EqualsCaseInsensitiveASCII(modification.header, "cookie")
+              ? "; "
+              : ", ";
+      headers->SetHeader(modification.header,
+                         current ? *current + separator + modification.value
+                                 : modification.value);
+    }
+  }
+}
+
+void ApplyResponseHeaderModifications(
+    const std::vector<DnrHeaderModification> &modifications,
+    network::mojom::URLResponseHead *head) {
+  if (!head || !head->headers || modifications.empty()) {
+    return;
+  }
+  head->headers = base::MakeRefCounted<net::HttpResponseHeaders>(
+      head->headers->raw_headers());
+  for (const DnrHeaderModification &modification : modifications) {
+    if (!net::HttpUtil::IsValidHeaderName(modification.header) ||
+        (modification.operation != "remove" &&
+         !net::HttpUtil::IsValidHeaderValue(modification.value))) {
+      continue;
+    }
+    if (modification.operation == "remove") {
+      head->headers->RemoveHeader(modification.header);
+    } else if (modification.operation == "set") {
+      head->headers->SetHeader(modification.header, modification.value);
+    } else {
+      head->headers->AddHeader(modification.header, modification.value);
+    }
+  }
+}
