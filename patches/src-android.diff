+void RefreshExtensionBindingsForHostCapabilities() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const std::vector<std::string> ids = LoadedExtensionIds();
+  for (const std::string &id : ids) {
+    UnloadFromReadyRenderersOnUi(id, "宿主 capability 精确成员已变化");
+  }
+  RedispatchToReadyRenderers();
+}
+
+namespace {
+
+void RetireExtensionsOutsideRootOnUi() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto norm = [](const base::FilePath &p) {
+    return p.StripTrailingSeparators().value();
+  };
+  const base::FilePath root = GetExtensionRoot();
+  const std::string r = norm(root);
+  int retired = 0;
+  for (const auto &[id, dir] : ListRegisteredExtensions()) {
+    const std::string d = norm(dir);
+    const bool under_root = !r.empty() && d.size() > r.size() &&
+                            d.compare(0, r.size(), r) == 0 &&
+                            d[r.size()] == '/';
+    if (under_root) {
+      continue;
+    }
+
+    // 换根 = 该扩展的上下文整体失效: 作废在途 + 通知宿主。
+    InvalidateExtensionContexts(id, "扩展根已切换");
+    UnloadFromReadyRenderersOnUi(id, "随换根撤下");
+    ClearAlarmsForExtension(id);
+
+    UnregisterExtensionAction(id);
+    RemoveContextMenusForExtension(id);
+    LoadedExtensions().erase(id);
+    // 解析缓存按目录存，必须在 RetireExtensionPath 之前失效（之后
+    // GetRegisteredExtensionPath 就取不到这个目录了）；这里循环变量 dir
+    // 本来就有。
+    ForgetParsedExtension(dir);
+    RetireExtensionPath(id);
+    // 静态规则集的进程内登记(manifest 元数据 + 已读规则缓存)也要跟着撤，
+    // 否则换根后旧代次的规则仍会被算进"生效规则"。
+    mv3::UnregisterStaticRulesets(id);
+    mv3::ClearSessionRules(id);
+    ++retired;
+  }
+  LOG(WARNING) << "[arupa][root] 扩展根 → " << root.value()
+               << " ⇒ 撤下不在新根下的扩展 " << retired << " 个";
+}
+
+} // namespace
+
+void RetireExtensionsOutsideRoot() {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&RetireExtensionsOutsideRootOnUi));
+    return;
+  }
+  RetireExtensionsOutsideRootOnUi();
+}
+
+void RedispatchToReadyRenderers(int64_t scan_gen) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&RedispatchOnUiThread, scan_gen));
+    return;
+  }
+  RedispatchOnUiThread(scan_gen);
+}
+
+namespace {
+base::FilePath &ExtensionRootStorage() {
+  static base::NoDestructor<base::FilePath> root;
+  return *root;
+}
+} // namespace
+
+const base::FilePath &GetExtensionRoot() { return ExtensionRootStorage(); }
+
+void SetExtensionRoot(const base::FilePath &root) {
+  LOG(INFO) << "[arupa][ext] SetExtensionRoot(" << root.value() << ")";
+  const bool changed = (ExtensionRootStorage() != root);
+  ExtensionRootStorage() = root;
+
+  if (changed) {
+    RetireExtensionsOutsideRoot();
+    RedispatchToReadyRenderers();
+  }
+}
