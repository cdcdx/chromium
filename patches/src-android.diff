+            GetDisabledStaticRuleIds(extension_id_, "privacy"));
+
+  ASSERT_TRUE(
+      ReplaceDisabledStaticRuleIds(extension_id_, "privacy", {101, 102}));
+  EXPECT_EQ((std::vector<int>{103}),
+            IdsFrom(GetStaticRulesJson(extension_id_)));
+}
