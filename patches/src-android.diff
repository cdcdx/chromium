+// ResourceRequest.destination 是内核产生的可信分类；不能在 Kotlin 侧靠 URL
+// 后缀猜测（无后缀的脚本/XHR 会被分错）。内部上下文字段只加到
+// 回调副本，不会发到网络；且放在用户 header 之后，同名伪造值会被覆盖。
+std::string DnrResourceType(const network::ResourceRequest &request,
+                            bool is_main_frame) {
+  // Ping/sendBeacon 与 XHR/Fetch 通常同为 kEmpty destination；仅凭 destination
+  // 会把 1.0.13 的 ping 规则错分为 xmlhttprequest。
+  if (request.resource_type ==
+      static_cast<int>(blink::mojom::ResourceType::kPing)) {
+    return "ping";
+  }
+  const std::string_view destination =
+      network::RequestDestinationToString(request.destination);
+  if (destination == "document" || destination == "frame" ||
+      destination == "iframe" || destination == "fencedframe") {
+    return is_main_frame ? "main_frame" : "sub_frame";
+  }
+  if (destination == "style") {
+    return "stylesheet";
+  }
+  if (destination == "script" || destination == "worker" ||
+      destination == "serviceworker" || destination == "sharedworker" ||
+      destination == "audioworklet" || destination == "paintworklet" ||
+      destination == "speculationrules") {
+    return "script";
+  }
+  if (destination == "image") {
+    return "image";
+  }
+  if (destination == "font") {
+    return "font";
+  }
+  if (destination == "object" || destination == "embed") {
+    return "object";
+  }
+  if (destination == "audio" || destination == "video" ||
+      destination == "track") {
+    return "media";
+  }
+  if (destination == "report") {
+    return "csp_report";
+  }
+  if (destination == "webbundle") {
+    return "webbundle";
+  }
+  // fetch/XHR 在 Fetch 标准中的 destination 是空串。
+  if (destination.empty()) {
+    return "xmlhttprequest";
+  }
+  return "other";
+}
