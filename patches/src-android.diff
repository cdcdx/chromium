+bool ApplyArupaWebTransportRequestDnr(content::RenderFrameHost *frame,
+                                     bool incognito,
+                                     const GURL &url,
+                                     const url::Origin &initiator) {
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return true;
+  }
+  std::vector<std::string> names = {"sec-webtransport-http3-draft02"};
+  std::vector<std::string> values = {"1"};
+  AppendWebTransportDnrContext(frame, incognito, initiator, &names, &values);
+  JNIEnv *env = base::android::AttachCurrentThread();
+  base::android::ScopedJavaLocalRef<jobject> response =
+      CallWebTransportDnr(env, frame, url, names, values);
+  return response.is_null() ||
+         Java_ArupaWebResourceResponse_getPassThrough(env, response);
+#else
+  return true;
+#endif
+}
+
+bool ApplyArupaWebTransportResponseDnr(
+    content::RenderFrameHost *frame,
+    bool incognito,
+    const GURL &url,
+    const url::Origin &initiator,
+    const scoped_refptr<net::HttpResponseHeaders> &response_headers,
+    scoped_refptr<net::HttpResponseHeaders> *modified_response_headers) {
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+  if (!response_headers || !modified_response_headers) {
+    return true;
+  }
+  std::vector<std::string> names;
+  std::vector<std::string> values;
+  size_t cursor = 0;
+  std::string name;
+  std::string value;
+  while (response_headers->EnumerateHeaderLines(&cursor, &name, &value)) {
+    if (!IsDnrInternalHeader(name)) {
+      names.push_back(name);
+      values.push_back(value);
+    }
+  }
+  names.emplace_back(kDnrStageHeader);
+  values.emplace_back("headersReceived");
+  AppendWebTransportDnrContext(frame, incognito, initiator, &names, &values);
+  JNIEnv *env = base::android::AttachCurrentThread();
+  base::android::ScopedJavaLocalRef<jobject> response =
+      CallWebTransportDnr(env, frame, url, names, values);
+  if (response.is_null()) {
+    *modified_response_headers = response_headers;
+    return true;
+  }
+  if (!Java_ArupaWebResourceResponse_getPassThrough(env, response)) {
+    return false;
+  }
+  auto head = network::mojom::URLResponseHead::New();
+  head->headers = response_headers;
+  ApplyResponseHeaderModifications(
+      ReadPassThroughInstruction(env, response).response_headers, head.get());
+  *modified_response_headers = std::move(head->headers);
+  return true;
+#else
+  return true;
+#endif
+}
