+  add_text.Append(std::move(text));
+  EXPECT_FALSE(UpdateDynamicRules(extension_id_, {}, add_text).ok);
+
+  // 原子性：被拒的批次一条都不进存储。
+  EXPECT_EQ((std::vector<int>{31}), StoredIds());
