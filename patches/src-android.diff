+namespace {
+
+// 启用时**确保该扩展的 Service Worker 已注册**, 不依赖 Renderer 派发。
+//
+// 现状: SW 只在 LoadExtensionFromManifestJson()（把扩展下发进某个 Renderer
+// 时）里被 MaybeStartExtensionServiceWorker() 起过一次。于是"内核此刻没有就绪
+// Renderer"——
+// 用户在设置页/应用中心启用插件、还没打开任何网页时很常见——这条链根本走不到:
+//   · ReadyHosts() 为空时的重扫只"登记不下发"（见 RedispatchOnUiThread）;
+//   · 内核 DisabledIds 是进程内状态，重启后为空 ⇒
+//   宿主对"本来就没被停用过"的插件调
+//     启用会命中 SetExtensionEnabled 的早退，连补发都不触发。
+// 结果插件永远停在"SW 未注册"，宿主 10 秒后判定启用失败并把扩展回滚停用。
+// SW 注册本身只需要 browser
+// context（冷唤醒投递走的就是这条链），所以这里把同一条链
+// 接到启用路径上：扩展根里有这个扩展就扫盘登记并注册，与有没有 Renderer 无关。
+void EnsureServiceWorkerForEnabledOnUi(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty() || IsExtensionDisabled(extension_id)) {
+    return;
+  }
+  if (IsServiceWorkerRegistered(extension_id)) {
+    VLOG(1) << "[arupa][sw] 启用补起: 已注册, 不动 id=" << extension_id;
+    return;
+  }
+  content::BrowserContext *browser_context =
+      GetKernelBrowserContextForExtensions();
+  if (!browser_context) {
+    LOG(WARNING) << "[arupa][sw] 启用补起: 内核 browser context 还没就绪 id="
+                 << extension_id << " ⇒ 只能等 Renderer 把它带起来";
+    return;
+  }
+  LOG(INFO) << "[arupa][sw] 启用补起: 无 Renderer 也发起注册 id="
+            << extension_id;
+  // 未注册时它走冷启动扫盘链（ColdRegisterForWake → OnColdWakeScanned →
+  // MaybeStartExtensionServiceWorker）；已在注册中的实例由它内部的
+  // PendingRegisterAt 去重，不会重复注册。
+  WakeExtensionServiceWorker(extension_id);
+}
+
+} // namespace
+
+// 卸载一个扩展时，把它在**内核侧**留下的全部状态清干净。
+//
+// 为什么需要这个入口：`SetExtensionEnabled(id, false)` 只做"停用"（加
+// DisabledIds + 作废在途），磁盘与进程内的数据一样不留。于是卸载后仍会残留：
+//   * PluginStorage 的 local / sync / session / managed 四个区
+//     —— 含 DNR 动态规则(`__dnr_dynamic_rules_v1`)、静态规则集启用集合
+//        (`__dnr_static_enabled_v1`)、闹钟(`__alarms_v1`)、以及扩展自己的用户数据；
+//   * 可选权限的运行时授权意图（`ClearOptionalPermissionGrants`
+//   已有，但没人调）；
+//   * 用户对该扩展的逐权限同意记录（chrome.permissions.request 点头过的）；
+//   * 安装代次（`SetExtensionInstallGeneration` 拒绝代次回退，不清的话重装后
+//     第一次 setGeneration 会被当成回退直接拒收，代次永远停在旧值）。
+//
+// 重装同名扩展时会读到旧数据 —— 包括旧的 DNR 规则与旧的授权，等于"卸不干净"。
+//
+// 幂等：对没装过的 id 调用是安全的（各处清理都按 id 查，查不到就跳过）。
+namespace {
+void ClearPurgeStorageArea(const std::string &extension_id, size_t area_index,
+                           base::OnceCallback<void(bool)> callback) {
+  static constexpr const char *kAreas[] = {
+      "", "/local", "/sync", "/session", "/managed", "/__arupa_internal"};
+  if (area_index == std::size(kAreas)) {
+    ClearExtensionInstallGeneration(extension_id);
+    UnregisterExtensionAction(extension_id);
+    RemoveContextMenusForExtension(extension_id);
+    LoadedExtensions().erase(extension_id);
+    const base::FilePath old_path = GetRegisteredExtensionPath(extension_id);
+    RetireExtensionPath(extension_id);
+    ForgetParsedExtension(old_path);
+    siteaudit::EndExtensionPurge(extension_id);
+    LOG(INFO) << "[arupa] 卸载清理完成 ext=" << extension_id;
+    std::move(callback).Run(true);
+    return;
+  }
+  mv3::PluginStorage::Get().ClearAsync(
+      extension_id + kAreas[area_index],
+      base::BindOnce(
+          [](std::string id, size_t next, base::OnceCallback<void(bool)> done,
+             mv3::StorageCommitResult result) {
+            if (result.status != mv3::StorageWriteResult::kOk) {
+              LOG(ERROR) << "[arupa] 卸载存储删除失败 ext=" << id << " status="
+                         << mv3::StorageWriteResultMessage(result.status);
+              std::move(done).Run(false);
+              return;
+            }
+            ClearPurgeStorageArea(id, next, std::move(done));
+          },
+          extension_id, area_index + 1, std::move(callback)));
+}
+} // namespace
+
+void PurgeExtensionData(const std::string &extension_id,
+                        base::OnceCallback<void(bool)> callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  LOG(INFO) << "[arupa] 卸载清理开始 ext=" << extension_id;
+
+  // 先立不可逆的清退边界：上下文失效回调异步到达时也不得再写审计账本。
+  siteaudit::BeginExtensionPurge(extension_id);
+
+  // 1) 上下文与在途：作废 + 从各 renderer 撤下（内部会清闹钟、静态规则集登记、
+  //    解析缓存，并清 DisabledIds）。
+  InvalidateExtensionContexts(extension_id, "扩展已被卸载");
+  UnloadFromReadyRenderersOnUi(extension_id, "随卸载撤下");
+
+  // 2) 权限；安装代次必须留到所有审计分区删除完成之后。
+  ClearOptionalPermissionGrants(extension_id);
+  ClearExtensionPermissionConsent(extension_id);
+  // R-03: 卸载同样作废内容脚本代次 —— 卸载后抵达的补注入回执不能再改页面状态。
+  InvalidateContentScriptGeneration(extension_id);
+
+  // 3) 先撤下内存 DNR，再按写入队列清扫所有审计分区与标准区。
+  mv3::ClearDynamicRules(extension_id);
+  mv3::ClearSessionRules(extension_id);
+  mv3::ClearStaticRulesets(extension_id);
+  siteaudit::ClearPartitionsForExtension(
+      extension_id,
+      base::BindOnce(
+          [](std::string id, base::OnceCallback<void(bool)> done, bool ok) {
+            if (!ok) {
+              LOG(ERROR) << "[arupa] 卸载审计分区删除失败 ext=" << id;
+              std::move(done).Run(false);
+              return;
+            }
+            ClearPurgeStorageArea(id, 0, std::move(done));
+          },
+          extension_id, std::move(callback)));
+}
+
+namespace {
+
+std::optional<base::DictValue> ReadPurgeJournal() {
+  const mv3::StorageReadResult read =
+      mv3::PluginStorage::Get().GetAllValuesChecked(kPurgeJournalArea);
+  if (read.status != mv3::StorageWriteResult::kOk) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC);
+}
+
+void PersistPurgeJournalEntry(const std::string &transaction_id,
+                              const std::string &extension_id,
+                              int64_t install_generation,
+                              const std::string &uninstall_url,
+                              const std::string &stage,
+                              base::OnceCallback<void(bool)> callback) {
+  base::DictValue entry;
+  entry.Set("version", 2);
+  entry.Set("transactionId", transaction_id);
+  entry.Set("extensionId", extension_id);
+  entry.Set("installGeneration", base::NumberToString(install_generation));
+  entry.Set("uninstallUrl", uninstall_url);
+  entry.Set("stage", stage);
+  entry.Set(
+      "updatedAtMs",
+      base::NumberToString(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  const std::optional<std::string> encoded = base::WriteJson(entry);
+  if (!encoded) {
+    std::move(callback).Run(false);
+    return;
+  }
+  mv3::PluginStorage::Get().SetValuesAsync(
+      kPurgeJournalArea, {{transaction_id, *encoded}},
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> done,
+             mv3::StorageCommitResult result) {
+            std::move(done).Run(result.status == mv3::StorageWriteResult::kOk);
+          },
+          std::move(callback)));
+}
+
+void RemovePurgeJournalEntry(const std::string &transaction_id) {
+  mv3::PluginStorage::Get().RemoveValuesAsync(
+      kPurgeJournalArea, {transaction_id},
+      base::BindOnce(
+          [](std::string transaction, mv3::StorageCommitResult result) {
+            if (result.status != mv3::StorageWriteResult::kOk) {
+              LOG(ERROR) << "[arupa][purge] journal ACK 删除失败 txn="
+                         << transaction;
+            }
+          },
+          transaction_id));
+}
+
+void NotifyReadyUninstallUrl(const std::string &extension_id,
+                             const std::string &transaction_id,
+                             int64_t install_generation,
+                             const std::string &uninstall_url) {
+  const GURL validated_url(uninstall_url);
+  if (!validated_url.is_valid() || !(validated_url.SchemeIsHTTPOrHTTPS())) {
+    LOG(ERROR) << "[arupa][purge] 丢弃非法 uninstall URL ext=" << extension_id
+               << " txn=" << transaction_id;
+    RemovePurgeJournalEntry(transaction_id);
+    return;
+  }
+  // ready 以后若同 ID 已重新安装，旧卸载页不得进入新安装生命周期。
+  if (FindLoadedExtension(extension_id) ||
+      GetExtensionInstallGeneration(extension_id) != 0) {
+    LOG(WARNING) << "[arupa][purge] 丢弃重装后的旧 uninstall URL ext="
+                 << extension_id << " txn=" << transaction_id;
+    RemovePurgeJournalEntry(transaction_id);
+    return;
+  }
+  if (!uninstall_url.empty() && UninstallObserver()) {
+    UninstallObserver()(extension_id, transaction_id, install_generation,
+                        validated_url.spec());
+  }
+}
+
+void RunPreparedPurge(const std::string &extension_id,
+                      const std::string &transaction_id,
+                      int64_t install_generation,
+                      const std::string &uninstall_url,
+                      base::OnceCallback<void(bool)> callback) {
+  PurgeExtensionData(
+      extension_id,
+      base::BindOnce(
+          [](std::string id, std::string transaction, int64_t generation,
+             std::string url, base::OnceCallback<void(bool)> done,
+             bool purged) {
+            if (!purged) {
+              PurgesInFlight().erase(id);
+              std::move(done).Run(false);
+              return;
+            }
+            PersistPurgeJournalEntry(
+                transaction, id, generation, url, "ready",
+                base::BindOnce(
+                    [](std::string id, std::string transaction,
+                       int64_t generation, std::string url,
+                       base::OnceCallback<void(bool)> done, bool persisted) {
+                      PurgesInFlight().erase(id);
+                      if (!persisted) {
+                        LOG(ERROR) << "[arupa][purge] 完成但 ready journal "
+                                      "提交失败 ext="
+                                   << id;
+                        std::move(done).Run(false);
+                        return;
+                      }
+                      if (url.empty()) {
+                        RemovePurgeJournalEntry(transaction);
+                      } else {
+                        NotifyReadyUninstallUrl(id, transaction, generation,
+                                                url);
+                      }
+                      std::move(done).Run(true);
+                    },
+                    id, transaction, generation, url, std::move(done)));
+          },
+          extension_id, transaction_id, install_generation, uninstall_url,
+          std::move(callback)));
+}
