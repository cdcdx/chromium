+void RegisterLoadedExtension(scoped_refptr<const extensions::Extension> ext) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!ext) {
+    return;
+  }
+
+  const extensions::ExtensionId id = ext->id();
+  if (siteaudit::IsExtensionPurging(id)) {
+    LOG(ERROR) << "[arupa] 扩展仍处于卸载清退窗口，拒绝重新登记 ext=" << id;
+    return;
+  }
+  const auto previous = LoadedExtensions().find(id);
+  const bool same_instance = previous != LoadedExtensions().end() &&
+                             previous->second.get() == ext.get();
+  LoadedExtensions()[id] = std::move(ext);
+  // 用户此前做出的可选权限授权在这里落地：此刻才拿得到清单, 才能核
+  // "optional_permissions 里声明过没有"。顺序无关 ——
+  // 宿主可以在扩展加载前就把授权意图交进来。
+  ApplyOptionalPermissionIntentsFor(id);
+  if (IsOptionalPermissionDesynchronized(id) &&
+      !(same_instance && IsOptionalPermissionTransactionPending(id))) {
+    SetExtensionEnabled(id, false);
+  }
+}
+
+std::vector<std::string> LoadedExtensionIds() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  std::vector<std::string> out;
+  for (const auto &[id, ext] : LoadedExtensions()) {
+    if (IsExtensionDisabled(id)) {
+      continue;
+    }
+    out.push_back(id);
+  }
+  return out;
+}
+
+scoped_refptr<const extensions::Extension>
+FindLoadedExtension(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto &m = LoadedExtensions();
+  auto it = m.find(extension_id);
+  return it == m.end() ? nullptr : it->second;
+}
+
+HostAccess CheckHostAccess(const std::string &extension_id, const GURL &url) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext) {
+    return HostAccess::kUnknownExtension;
+  }
+
+  const extensions::PermissionsData *permissions = ext->permissions_data();
+  if (permissions->IsPolicyBlockedHost(url) ||
+      permissions->IsUrlBlockedByUser(url)) {
+    return HostAccess::kDenied;
+  }
+  // 必须查询 Guard 过滤后的有效集合。直接读
+  // PermissionsData::HasHostPermission() 会重新看见 strict 档位已剥掉的
+  // <all_urls>，使 history/tabs 等二次权限校验旁路。
+  const extensions::PermissionSet kept =
+      FilterByKernelGuard(permissions->active_permissions(), ext->id());
+  return kept.HasExplicitAccessToOrigin(url) ? HostAccess::kAllowed
+                                             : HostAccess::kDenied;
+}
+
+bool GetGrantedPermissions(const std::string &extension_id,
+                           std::vector<std::string> *apis,
+                           std::vector<std::string> *origins) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext) {
+    return false;
+  }
+
+  const extensions::PermissionSet kept = FilterByKernelGuard(
+      ext->permissions_data()->active_permissions(), ext->id());
+  for (const extensions::APIPermission *p : kept.apis()) {
+    apis->push_back(p->name());
+  }
+
+  for (const URLPattern &pattern : kept.explicit_hosts()) {
+    origins->push_back(pattern.GetAsString());
+  }
+  return true;
+}
+
+mv3::DnrHostAccessPolicy
+CaptureDnrHostAccessPolicy(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  mv3::DnrHostAccessPolicy result;
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext || IsExtensionDisabled(extension_id)) {
+    result.host_permissions_always_required = true;
+    return result;
+  }
+  const extensions::PermissionsData *permissions = ext->permissions_data();
+  result.host_permissions_always_required =
+      !permissions->HasAPIPermission(
+          extensions::mojom::APIPermissionID::kDeclarativeNetRequest);
+  result.allow_file_access =
+      (ext->creation_flags() & extensions::Extension::ALLOW_FILE_ACCESS) != 0;
+  result.feedback_permission = permissions->HasAPIPermission(
+      extensions::mojom::APIPermissionID::kDeclarativeNetRequestFeedback);
+  const extensions::PermissionSet active = FilterByKernelGuard(
+      permissions->active_permissions(), extension_id);
+  const extensions::PermissionSet withheld = FilterByKernelGuard(
+      permissions->withheld_permissions(), extension_id);
+  const auto append_patterns = [](const extensions::URLPatternSet &patterns,
+                                  std::vector<std::string> *out) {
+    for (const URLPattern &pattern : patterns) {
+      out->push_back(pattern.GetAsString());
+    }
+  };
+  append_patterns(active.explicit_hosts(), &result.host_permissions);
+  append_patterns(withheld.explicit_hosts(),
+                  &result.withheld_host_permissions);
+  append_patterns(permissions->policy_blocked_hosts(),
+                  &result.blocked_host_permissions);
+  append_patterns(permissions->policy_allowed_hosts(),
+                  &result.allowed_host_permissions);
+  for (const auto &[tab_id, tab_permissions] :
+       permissions->tab_specific_permissions()) {
+    if (!tab_permissions) {
+      continue;
+    }
+    append_patterns(tab_permissions->explicit_hosts(),
+                    &result.tab_host_permissions[tab_id]);
+    if (tab_permissions->HasAPIPermission(
+            extensions::mojom::APIPermissionID::
+                kDeclarativeNetRequestFeedback)) {
+      result.feedback_tab_ids.insert(tab_id);
+    }
+  }
+  return result;
+}
+
+void RefreshHostDnrSnapshot(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!extension_id.empty() && FindLoadedExtension(extension_id) &&
+      !IsExtensionDisabled(extension_id)) {
+    ScheduleHostDnrSnapshot(extension_id);
+  }
+}
+
+bool ExtAllowsFileAccess(const extensions::Extension *ext) {
+  return ext && (ext->creation_flags() &
+                 extensions::Extension::ALLOW_FILE_ACCESS) != 0;
+}
+
+int GrantedPermissionsContain(const std::string &extension_id,
+                              const std::vector<std::string> &apis,
+                              const std::vector<std::string> &origins) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext) {
+    return -1;
+  }
+  const extensions::PermissionSet kept = FilterByKernelGuard(
+      ext->permissions_data()->active_permissions(), ext->id());
+
+  for (const std::string &want : apis) {
+    bool found = false;
+    for (const extensions::APIPermission *p : kept.apis()) {
+      if (want == p->name()) {
+        found = true;
+        break;
+      }
+    }
+    if (!found) {
+      return 0;
+    }
+  }
+
+  const bool allow_file = ExtAllowsFileAccess(ext.get());
+  for (const std::string &want : origins) {
+    if (!mv3::HostPatternsContain(kept.explicit_hosts(),
+                                  kept.scriptable_hosts(), want, allow_file)) {
+      LOG(INFO) << "[arupa][perm] contains: origin `" << want
+                << "` 不在已授予集合里(掩码已按清单口径剥过, 存="
+                << kept.explicit_hosts().size() << " 条)";
+      return 0;
+    }
+  }
+  return 1;
+}
+
+bool ExtensionOriginHasApiPermission(const GURL &origin,
+                                     const std::string &api) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!origin.SchemeIs(extensions::kExtensionScheme)) {
+    return false;
+  }
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(std::string(origin.host()));
+  if (!ext) {
+    return false;
+  }
+  const extensions::PermissionSet kept = FilterByKernelGuard(
+      ext->permissions_data()->active_permissions(), ext->id());
+  for (const extensions::APIPermission *p : kept.apis()) {
+    if (p->name() == api) {
+      return true;
+    }
+  }
+  return false;
+}
