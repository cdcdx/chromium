+
+AuditEventRoute CaptureSiteAuditRoute(content::BrowserContext *source_context,
+                                      bool off_the_record) {
+  AuditEventRoute route;
+  content::BrowserContext *kernel_context =
+      GetKernelBrowserContextForExtensions();
+  if (!source_context || !kernel_context || off_the_record ||
+      source_context->IsOffTheRecord() || kernel_context->IsOffTheRecord() ||
+      source_context->GetPath() != kernel_context->GetPath()) {
+    return route;
+  }
+  ExtCallerIdentity caller;
+  if (!BindHostRuntimeIdentity(&caller) || caller.account_scope.empty() ||
+      caller.session_epoch.empty()) {
+    LOG(WARNING) << "[arupa][audit] 事件源账号会话未绑定";
+    return route;
+  }
+  route.account_scope = caller.account_scope;
+  route.session_epoch = caller.session_epoch;
+  route.valid = true;
+  for (const std::string &ext_id : LoadedExtensionIds()) {
+    if (IsExtensionDisabled(ext_id) || !MayConsumeSiteAuditLedger(ext_id) ||
+        siteaudit::IsExtensionPurging(ext_id)) {
+      continue;
+    }
+    const std::string partition = AuditPartitionFor(caller, ext_id);
+    if (partition.empty()) {
+      continue;
+    }
+    AuditEventRouteTarget target;
+    target.extension_id = ext_id;
+    target.install_generation = GetExtensionInstallGeneration(ext_id);
+    target.partition = partition;
+    target.profile_id = ProfileIdForThisRun();
+    target.context_id = target.profile_id + ":" +
+                        base::NumberToString(target.install_generation) + ":" +
+                        route.account_scope + ":" + route.session_epoch;
+    route.targets.push_back(std::move(target));
+  }
+  return route;
+}
+
+void RecordSiteAuditEventForRoute(const AuditEventRoute &route,
+                                  const std::string &permission,
+                                  const std::string &type,
+                                  const std::string &request_origin,
+                                  const std::string &top_origin,
+                                  const std::string &result,
+                                  uint64_t event_token) {
+  // 只接受精确 origin, 否则插件不会把它归因为可信事件(与 setPermission
+  // 同判据)。
+  if (!route.valid || !IsExactOrigin(request_origin) ||
+      !IsExactOrigin(top_origin)) {
+    return;
+  }
+  ExtCallerIdentity current;
+  if (!BindHostRuntimeIdentity(&current) ||
+      current.account_scope != route.account_scope ||
+      current.session_epoch != route.session_epoch) {
+    LOG(INFO) << "[arupa][audit] 事件源会话已变化，丢弃迟到事件";
+    return;
+  }
+  // 源页面的 regular/OTR 在创建 route 时已确认；全局 incognitoActive 只是
+  // 同进程存在无痕租约，不得二次否决普通页面事件。
+  int recorded = 0;
+  for (const AuditEventRouteTarget &target : route.targets) {
+    const std::string &ext_id = target.extension_id;
+    if (!FindLoadedExtension(ext_id) || IsExtensionDisabled(ext_id) ||
+        !MayConsumeSiteAuditLedger(ext_id) ||
+        siteaudit::IsExtensionPurging(ext_id) ||
+        GetExtensionInstallGeneration(ext_id) != target.install_generation) {
+      continue;
+    }
+    base::DictValue ev;
+    ev.Set("profileId", target.profile_id);
+    ev.Set("contextId", target.context_id);
+    ev.Set("mode", "regular");
+    ev.Set("attribution", "verified");
+    ev.Set("requestOrigin", request_origin);
+    ev.Set("topOrigin", top_origin);
+    ev.Set("permission", permission);
+    ev.Set("type", type);
+    ev.Set("eventId", base::Uuid::GenerateRandomV4().AsLowercaseString());
+    ev.Set("occurredAt", base::Time::Now().InMillisecondsFSinceUnixEpoch());
+    // request/use-start/use-end 的结果为 null；result/change 才带字符串结果。
+    if (!result.empty()) {
+      ev.Set("result", result);
+    } else {
+      ev.Set("result", base::Value());
+    }
+    std::string ev_json;
+    base::JSONWriter::Write(base::Value(std::move(ev)), &ev_json);
+    // 分区未开启记录时 RecordEvent 自行 no-op, 事件源不再重复判断 enabled。
+    if (siteaudit::RecordEvent(target.partition, ev_json, event_token)) {
+      NotifySiteAuditEventsAvailable(ext_id);
+      ++recorded;
+    }
+  }
+  LOG(INFO) << "[arupa][audit] 事件源入账 permission=" << permission
+            << " type=" << type << " request=" << request_origin
+            << " top=" << top_origin << " 分区数=" << recorded;
+}
