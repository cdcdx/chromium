+std::set<ExtensionWorkerContextKey> &ColdWakeWaiting() {
+  static base::NoDestructor<std::set<ExtensionWorkerContextKey>> s;
+  return *s;
+}
+
+void OnColdWakeScanned(base::FilePath scanned_root,
+                       std::vector<ScannedExtension> items) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  RememberScan(scanned_root, items);
+
+  NotifyScanCompleted(0);
+  if (scanned_root != GetExtensionRoot()) {
+    items.clear();
+  }
+  std::set<ExtensionWorkerContextKey> want;
+  want.swap(ColdWakeWaiting());
+  content::BrowserContext *bc = GetKernelBrowserContextForExtensions();
+  if (!bc) {
+    return;
+  }
+  int started = 0;
+  for (const ScannedExtension &item : items) {
+    scoped_refptr<extensions::Extension> ext =
+        ParseAndRegisterExtension(item.dir, item.manifest_json, nullptr);
+    if (!ext) {
+      continue;
+    }
+    std::vector<ExtensionWorkerContextKey> contexts;
+    for (const ExtensionWorkerContextKey &context : want) {
+      if (context.extension_id == ext->id()) {
+        contexts.push_back(context);
+      }
+    }
+    if (contexts.empty()) {
+      continue;
+    }
+    for (const ExtensionWorkerContextKey &context : contexts) {
+      want.erase(context);
+      if (IsExtensionDisabled(ext->id()) ||
+          IsServiceWorkerRegistered(context)) {
+        continue;
+      }
+      MaybeStartExtensionServiceWorker(bc, *ext, context);
+      ++started;
+    }
+  }
+  LOG(INFO) << "[arupa][wake] 冷启动: 扫盘回来, 自己发起注册 " << started
+            << " 个(注册成功后 SW 自己起, 在等的投递随之放行)";
+  for (const ExtensionWorkerContextKey &context : want) {
+    LOG(WARNING) << "[arupa][wake] 冷启动: 扩展根下没有这个扩展 id="
+                 << context.extension_id
+                 << " book=" << TabBookName(context.book)
+                 << " —— 唤醒会在 30 秒后回 11";
+  }
+}
+
+void ColdRegisterForWake(content::BrowserContext *browser_context,
+                         const ExtensionWorkerContextKey &context) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const base::FilePath root = GetExtensionRoot();
+  if (root.empty()) {
+    LOG(WARNING) << "[arupa][wake] 冷启动: 扩展根未设, 扫不了盘 id="
+                 << context.extension_id;
+    return;
+  }
+  const bool scanning = !ColdWakeWaiting().empty();
+  ColdWakeWaiting().insert(context);
+  if (scanning) {
+    return;
+  }
+  LOG(INFO) << "[arupa][wake] 冷启动: 扩展还没注册(还没开过页面) ⇒ "
+               "自己扫盘登记并发起注册 id="
+            << context.extension_id << " book=" << TabBookName(context.book);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&ScanExtensionDirs, root),
+      base::BindOnce(&OnColdWakeScanned, root));
+}
