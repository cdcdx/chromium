+TEST_F(DnrRulesTest, RegexValidationUsesChromiumRe2BudgetAndRewriteRules) {
+  auto regex_rule = [](int id, std::string expression) {
+    base::DictValue action;
+    action.Set("type", "block");
+    base::DictValue condition;
+    condition.Set("regexFilter", std::move(expression));
+    base::DictValue rule;
+    rule.Set("id", id);
+    rule.Set("action", std::move(action));
+    rule.Set("condition", std::move(condition));
+    return rule;
+  };
+  auto submit = [&](base::DictValue rule) {
+    base::ListValue add;
+    add.Append(std::move(rule));
+    return UpdateDynamicRules(extension_id_, {}, add);
+  };
+
+  EXPECT_TRUE(submit(regex_rule(122, "[0-9]+")).ok);
+  EXPECT_FALSE(submit(regex_rule(123, "[a-9]+")).ok);
+  std::string over_budget;
+  for (int i = 0; i < 1000; ++i) {
+    over_budget += "[0-9]+";
+  }
+  const DnrUpdateOutcome too_large = submit(regex_rule(124, over_budget));
+  EXPECT_FALSE(too_large.ok);
+  EXPECT_NE(std::string::npos, too_large.error.find("2KB"));
+
+  std::string captures;
+  for (int i = 0; i < 50; ++i) {
+    captures += "(a)";
+  }
+  EXPECT_TRUE(submit(regex_rule(125, captures)).ok);
+
+  base::DictValue redirect_action;
+  redirect_action.Set("type", "redirect");
+  base::DictValue redirect;
+  redirect.Set("regexSubstitution", R"(\1)");
+  redirect_action.Set("redirect", std::move(redirect));
+  base::DictValue redirect_condition;
+  redirect_condition.Set("regexFilter", captures);
+  base::DictValue redirect_rule;
+  redirect_rule.Set("id", 126);
+  redirect_rule.Set("action", std::move(redirect_action));
+  redirect_rule.Set("condition", std::move(redirect_condition));
+  EXPECT_FALSE(submit(std::move(redirect_rule)).ok);
+}
