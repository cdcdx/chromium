+class ArupaSchemeURLLoaderFactory : public network::mojom::URLLoaderFactory {
+public:
+  static void
+  CreateOnIO(base::android::ScopedJavaGlobalRef<jobject> java_delegate,
+             mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+    new ArupaSchemeURLLoaderFactory(std::move(java_delegate),
+                                    std::move(receiver));
+  }
+
+  ArupaSchemeURLLoaderFactory(const ArupaSchemeURLLoaderFactory &) = delete;
+  ArupaSchemeURLLoaderFactory &
+  operator=(const ArupaSchemeURLLoaderFactory &) = delete;
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader, int32_t,
+      uint32_t, const network::ResourceRequest &request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag &) override {
+    JNIEnv *env = base::android::AttachCurrentThread();
+
+    std::vector<std::string> names;
+    std::vector<std::string> values;
+    AppendCallbackRequestHeaders(request, &names, &values);
+    const bool is_main_frame_doc =
+        request.is_outermost_main_frame &&
+        request.destination == network::mojom::RequestDestination::kDocument;
+    AppendDnrTrustedContext(
+        request, is_main_frame_doc, -1, "internal", -1, -1, -1, -1,
+        /*document_id=*/std::string_view(),
+        /*parent_document_id=*/std::string_view(),
+        /*document_lifecycle=*/std::string_view(),
+        /*frame_type=*/std::string_view(), &names, &values);
+
+    base::android::ScopedJavaLocalRef<jobject> resp =
+        CallShouldInterceptRequest(env, java_delegate_, request.url.spec(),
+                                   request.method, is_main_frame_doc, names,
+                                   values);
+
+    if (resp.is_null()) {
+      mojo::Remote<network::mojom::URLLoaderClient> remote_client(
+          std::move(client));
+      remote_client->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_FILE_NOT_FOUND));
+      return;
+    }
+
+    ArupaServedResponseLoader::Start(env, resp, std::move(loader),
+                                     std::move(client));
+  }
+
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+private:
+  ArupaSchemeURLLoaderFactory(
+      base::android::ScopedJavaGlobalRef<jobject> java_delegate,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      : java_delegate_(std::move(java_delegate)) {
+    receivers_.Add(this, std::move(receiver));
+    receivers_.set_disconnect_handler(base::BindRepeating(
+        &ArupaSchemeURLLoaderFactory::OnDisconnect, base::Unretained(this)));
+  }
+
+  ~ArupaSchemeURLLoaderFactory() override = default;
+
+  void OnDisconnect() {
+    if (receivers_.empty()) {
+      delete this;
+    }
+  }
+
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate_;
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> receivers_;
+};
