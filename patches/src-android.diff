+void UnloadExtensionFromIncognitoRenderers(const std::string& extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty()) {
+    return;
+  }
+  NotifyInternalExtensionContextInvalidation(extension_id,
+                                             /*incognito_only=*/true);
+  int sent = 0;
+  for (content::RenderProcessHost *host : ReadyHosts()) {
+    content::StoragePartition *partition = host->GetStoragePartition();
+    if (!partition || !partition->GetConfig().in_memory()) {
+      continue;
+    }
+    const bool had = DispatchedIds::Contains(host, extension_id);
+    DispatchedIds::Remove(host, extension_id);
+    if (!had || !host->GetChannel()) {
+      continue;
+    }
+    mojo::AssociatedRemote<extensions::mojom::Renderer> renderer;
+    host->GetChannel()->GetRemoteAssociatedInterface(&renderer);
+    if (!renderer.is_bound()) {
+      continue;
+    }
+    renderer->UnloadExtension(extension_id);
+    ++sent;
+  }
+  LOG(INFO) << "[arupa] 无痕授权撤销 id=" << extension_id << " ⇒ 仅通知 "
+            << sent << " 个内存 Renderer 卸载";
+}
