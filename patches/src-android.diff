+void UnloadFromReadyRenderersOnUi(const std::string &id,
+                                  const char *why = "已禁用") {
+  // 作废动态内容脚本/userScripts 的内存快照和在途文件校验；持久定义仅在卸载
+  // ClearPlugin 时删除，停用后重新启用会从私有区恢复。
+  ResetDynamicContentScripts(id);
+  if (OffscreenCleanup()) {
+    OffscreenCleanup()(id);
+  }
+  // 停用不等于卸载：撤掉定时器但保留定义，重新启用时恢复剩余/过期闹钟。
+  SuspendAlarmsForExtension(id);
+  // 停用/卸载期间不该再享受 unlimitedStorage 的配额放宽（重新启用时经
+  // SyncUnlimitedStorageForExtension 恢复）。
+  mv3::PluginStorage::Get().SetUnlimitedStorage(id, false);
+  // idle 的阈值与"上次通知过的状态"一并丢掉：停用的扩展不该再被空闲态变更派发，
+  // 重新启用并有监听时按当时真实状态重新起算。
+  ForgetIdleForExtension(id);
+  InvalidateHostDnrSnapshot(id);
+  // 宿主 DNR matcher 不属于 Renderer 生命周期；只清内核登记而不通知宿主，会让
+  // 已停用/卸载扩展的旧规则继续拦截普通浏览请求。使用独立内部方法撤下，宿主对它
+  // 不套无痕会话门禁（清理必须随时可达）。
+  ExtCallerIdentity lifecycle_caller;
+  lifecycle_caller.kind = ExtCallerIdentity::Kind::kProcess;
+  mv3::DnrHostRequest removal = mv3::BuildDnrHostRequest(
+      id, "[]", 0, true, GetExtensionInstallGeneration(id));
+  if (removal.ok) {
+    CallHostApiFromKernelFrom(
+        lifecycle_caller, id, "nomad.dnr.removeRules", removal.args_json,
+        base::BindOnce(
+            [](std::string extension_id,
+               mv3::DnrHostReceiptExpectation expected,
+               const std::string &result_json, const std::string &error) {
+              std::string reason;
+              if (!mv3::DnrRemoveReceiptMatches(result_json, error, expected,
+                                                &reason)) {
+                LOG(ERROR) << "[arupa][dnr] 宿主 matcher 撤下失败 ext="
+                           << extension_id << " error=" << reason;
+              }
+            },
+            id, removal.receipt));
+  }
+  // session DNR 与 Chromium 一样跨扩展 disable/enable 保留，只在进程结束、卸载
+  // 或切换扩展根时清除；停用时宿主按扩展生命周期撤下 matcher。
+  // 静态规则集的进程内登记一并撤，但保留用户选择的启用集合；
+  // 重新启用后 RegisterStaticRulesets 会过滤旧 id 并恢复合法选择。
+  mv3::UnregisterStaticRulesets(id);
+  // 解析缓存也要失效：下次重新加载必须真的重新解析并登记，不能复用旧代次。
+  ForgetParsedExtension(GetRegisteredExtensionPath(id));
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  int sent = 0;
+  for (content::RenderProcessHost *host : ReadyHosts()) {
+    const bool had = DispatchedIds::Contains(host, id);
+    DispatchedIds::Remove(host, id);
+    if (!had || !host->GetChannel()) {
+      continue;
+    }
+    mojo::AssociatedRemote<extensions::mojom::Renderer> renderer;
+    host->GetChannel()->GetRemoteAssociatedInterface(&renderer);
+    if (!renderer.is_bound()) {
+      continue;
+    }
+
+    renderer->UnloadExtension(id);
+    ++sent;
+  }
+  LOG(INFO) << "[arupa] 扩展" << why << " id=" << id << " ⇒ 通知 " << sent
+            << " 个 renderer 卸载(之后的扫描也会跳过它)";
+
+  const auto &ready_hosts = ReadyHosts();
+  if (!ready_hosts.empty()) {
+    StopExtensionServiceWorker((*ready_hosts.begin())->GetBrowserContext(), id);
+  }
+
+  BumpActionForExtension(id);
+}
