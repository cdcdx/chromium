+
+// 可信上下文键: 页面按帧树 id, Worker 按 version_id。
+std::string ContextKeyFor(const ExtCallerIdentity &who) {
+  switch (who.kind) {
+  case ExtCallerIdentity::Kind::kFrame:
+    return "page:" + base::NumberToString(who.frame_tree_node_id);
+  case ExtCallerIdentity::Kind::kWorker:
+    return "worker:" + base::NumberToString(who.worker_version_id);
+  case ExtCallerIdentity::Kind::kProcess:
+    break;
+  }
+  return std::string();
+}
+
+// 记录"哪个扩展用过这个上下文": 上下文消失时要通知的是它, 而不只是
+// 当时恰好有在途请求的那些 —— 否则宿主抱着旧窗口/租约不放。
+void RememberContextExtension(const ExtCallerIdentity &who,
+                              const std::string &extension_id) {
+  const std::string key = ContextKeyFor(who);
+  if (key.empty() || extension_id.empty()) {
+    return;
+  }
+  base::AutoLock guard(Ctx().lock);
+  Ctx().context_extensions[key].insert(extension_id);
+}
+
+std::vector<std::string> TakeContextExtensions(const ExtCallerIdentity &who) {
+  const std::string key = ContextKeyFor(who);
+  if (key.empty()) {
+    return {};
+  }
+  base::AutoLock guard(Ctx().lock);
+  auto it = Ctx().context_extensions.find(key);
+  if (it == Ctx().context_extensions.end()) {
+    return {};
+  }
+  std::vector<std::string> out(it->second.begin(), it->second.end());
+  Ctx().context_extensions.erase(it);
+  return out;
+}
+
+// 文档生命周期名: 与插件侧 sender.documentLifecycle / webNavigation
+// 的口径一致。
+const char *
+DocumentLifecycleName(content::RenderFrameHost::LifecycleState state) {
+  switch (state) {
+  case content::RenderFrameHost::LifecycleState::kPrerendering:
+    return "prerender";
+  case content::RenderFrameHost::LifecycleState::kInBackForwardCache:
+    return "cached";
+  case content::RenderFrameHost::LifecycleState::kPendingDeletion:
+    return "pending_deletion";
+  case content::RenderFrameHost::LifecycleState::kPendingCommit:
+  case content::RenderFrameHost::LifecycleState::kActive:
+    return "active";
+  }
+}
+
+// 可信身份 JSON: 调用上下文与"上下文失效"通知共用同一套字段 —— 宿主按同样的
+// 键认身份, 不必为失效通知另写一套解析。
+//
+// R-04: 字段名与插件侧的 `sender.*` 对齐 —— 原包(逐风阅读/播放器)的上下文握手按
+// sender.id/tab/frameId/documentId/url/incognito 核对, 少一个就判"上下文未确认"
+// (普通 READER_CONTEXT_UNCONFIRMED)而拒绝持久化设置。这里对页面调用方补齐:
+//   tabId     —— 宿主为该 view 声明过的插件编号(以 arupa_webview_set_tab_id
+//   登记); frameId   —— 主框架恒 0, 子框架用帧树 id(与 arupa_local_frame_host
+//   的 sender.tab 同一规则); documentId—— 按帧树 + 文档代次推出的稳定文档号(与
+//   documentToken 同值, 两个名字都给,
+//                因为内核既有消费者读 documentToken、插件侧读显式提到的
+//                documentId);
+//   url/origin—— 该帧最后一次提交的真实地址(不是宿主自报, 内核自己读的);
+//   documentLifecycle —— active/prerender/cached/pending_deletion。
+base::DictValue BuildCallerIdentityJsonFor(const ExtCallerIdentity &who,
+                                           const std::string &extension_id) {
+  base::DictValue d;
+  d.Set("profileId", ProfileIdForThisRun());
+  d.Set("extensionId", extension_id);
+  d.Set("installGeneration",
+        base::NumberToString(GetExtensionInstallGeneration(extension_id)));
+  d.Set("contextType", "unknown");
+  // 无痕身份必须按**本次调用方自身**的册报, 不能只报 profile 全局开关:
+  // Android 上进程是持久 profile(IsOffTheRecord() 恒 false), 无痕面板是逐视图
+  // 临时分区 —— 报全局会把无痕调用谎报成普通调用(R-03/R-04)。
+  d.Set("incognito", TabBookForCaller(who) == TabBook::kIncognito);
+  d.Set("userActivation", false);
+  if (who.runtime_identity_bound) {
+    d.Set("accountScope", who.account_scope);
+    d.Set("sessionEpoch", who.session_epoch);
+    d.Set("runtimeIdentityBound", true);
+  } else {
+    d.Set("runtimeIdentityBound", false);
+  }
+  switch (who.kind) {
+  case ExtCallerIdentity::Kind::kFrame: {
+    d.Set("contextType", "page");
+    // frameTreeNodeId 是稳定帧标识, documentToken 是该帧当前文档;
+    // 宿主必须同时用它们, 否则同帧导航后旧身份仍会成立(N-C02)。
+    if (who.frame_tree_node_id >= 0) {
+      d.Set("frameTreeNodeId", who.frame_tree_node_id);
+      const std::string document_id = DocumentTokenFor(who.frame_tree_node_id);
+      d.Set("documentToken", document_id);
+      // R-04: 同一个标识再给一个插件侧认的名字(documentId),
+      // 免得握手两端各读一个键。
+      d.Set("documentId", document_id);
+    }
+    content::RenderFrameHost *rfh = content::RenderFrameHost::FromID(
+        who.frame_process_id, who.frame_routing_id);
+    if (rfh) {
+      d.Set("frameToken", rfh->GetFrameToken().ToString());
+      d.Set("userActivation", rfh->HasTransientUserActivation());
+      // R-04: sender.tab / sender.frameId / sender.url / sender.origin ——
+      // 内核自己读, 不取参数、不取宿主自报,
+      // 插件据此才能确认"这条消息真的来自那个标签页的那篇文档"。
+      d.Set("frameId", rfh->IsInPrimaryMainFrame()
+                           ? 0
+                           : rfh->GetFrameTreeNodeId().value());
+      d.Set("url", rfh->GetLastCommittedURL().spec());
+      d.Set("origin", rfh->GetLastCommittedOrigin().Serialize());
+      content::WebContents *contents =
+          content::WebContents::FromRenderFrameHost(rfh);
+      const int tab_id = TabIdForWebContents(contents);
+      if (tab_id >= 0) {
+        d.Set("tabId", tab_id);
+      }
+      // 只有活动文档才能发起调用(BFCache 里的文档不会调 API), 故这里取
+      // GetLifecycleState() 是安全的 —— 别对推测性 RFH 调它。
+      if (rfh->IsActive()) {
+        d.Set("documentLifecycle",
+              DocumentLifecycleName(rfh->GetLifecycleState()));
+      }
+    } else {
+      d.Set("frameGone", true);
+    }
+    break;
+  }
+  case ExtCallerIdentity::Kind::kWorker:
+    d.Set("contextType", "serviceWorker");
+    d.Set("workerVersion", base::NumberToString(who.worker_version_id));
+    if (!who.worker_scope.empty()) {
+      d.Set("workerScope", who.worker_scope);
+    }
+    break;
+  case ExtCallerIdentity::Kind::kProcess:
+    break;
+  }
+  return d;
+}
+} // namespace
+
+std::string BuildHostEventContextJson(const std::string& extension_id) {
+  ExtCallerIdentity current;
+  if (!BindHostRuntimeIdentity(&current)) {
+    return std::string();
+  }
+  return BuildHostEventContextJson(extension_id,
+                                   current.runtime_off_the_record);
+}
+
+std::string BuildHostEventContextJson(const std::string& extension_id,
+                                      bool incognito) {
+  ExtCallerIdentity current;
+  const int64_t install_generation =
+      GetExtensionInstallGeneration(extension_id);
+  if (extension_id.empty() || !FindLoadedExtension(extension_id) ||
+      IsExtensionDisabled(extension_id) || install_generation <= 0 ||
+      !BindHostRuntimeIdentity(&current)) {
+    return std::string();
+  }
+  const auto worker_context = CurrentExtensionWorkerContext(
+      extension_id, incognito ? TabBook::kIncognito : TabBook::kRegular);
+  if (!worker_context) {
+    return std::string();
+  }
+  base::DictValue context;
+  context.Set("version", 2);
+  context.Set("profileId", ProfileIdForThisRun());
+  context.Set("extensionId", extension_id);
+  context.Set("installGeneration", base::NumberToString(install_generation));
+  context.Set("accountScope", current.account_scope);
+  context.Set("sessionEpoch", current.session_epoch);
+  context.Set("incognito", incognito);
+  {
+    base::AutoLock guard(Capabilities().lock);
+    if (!Capabilities().installed ||
+        Capabilities().profile_id != ProfileIdForThisRun() ||
+        Capabilities().account_scope != current.account_scope ||
+        Capabilities().session_epoch != current.session_epoch) {
+      return std::string();
+    }
+    context.Set("contractEpoch",
+                base::NumberToString(Capabilities().contract_epoch));
+    context.Set("contractDigest", Capabilities().contract_digest);
+  }
+  // 下面三项是宿主必须按事件生产源替换的占位值。使用字符串避免 Java long 经
+  // JSON double 往返后丢精度。
+  context.Set("source", std::string());
+  context.Set("sourceGeneration", "0");
+  context.Set("sequence", "0");
+  std::string json;
+  base::JSONWriter::Write(context, &json);
+  return json;
+}
+
+bool ValidateHostEventContext(const std::string &extension_id,
+                              const std::string &context_json,
+                              std::string *error) {
+  if (error) {
+    error->clear();
+  }
+  auto fail = [&](std::string why) {
+    if (error) {
+      *error = std::move(why);
+    }
+    return false;
+  };
+  const std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(context_json, base::JSON_PARSE_RFC);
+  if (!parsed || parsed->FindInt("version").value_or(0) != 2) {
+    return fail("event context v2 is required");
+  }
+  const std::string *profile_id = parsed->FindString("profileId");
+  const std::string *context_extension = parsed->FindString("extensionId");
+  const std::string *install_text = parsed->FindString("installGeneration");
+  const std::string *account_scope = parsed->FindString("accountScope");
+  const std::string *session_epoch = parsed->FindString("sessionEpoch");
+  const std::optional<bool> incognito = parsed->FindBool("incognito");
+  const std::string *source = parsed->FindString("source");
+  const std::string *contract_epoch_text = parsed->FindString("contractEpoch");
+  const std::string *contract_digest = parsed->FindString("contractDigest");
+  const std::string *source_generation_text =
+      parsed->FindString("sourceGeneration");
+  const std::string *sequence_text = parsed->FindString("sequence");
+  int64_t install_generation = -1;
+  int64_t source_generation = -1;
+  int64_t sequence = -1;
+  int64_t contract_epoch = -1;
+  if (!profile_id || *profile_id != ProfileIdForThisRun() ||
+      !context_extension || *context_extension != extension_id ||
+      !install_text ||
+      !base::StringToInt64(*install_text, &install_generation) ||
+      *install_text != base::NumberToString(install_generation) ||
+      install_generation <= 0 ||
+      install_generation != GetExtensionInstallGeneration(extension_id) ||
+      !account_scope || !session_epoch || !incognito || !source ||
+      !IsSafeOpaqueIdentity(*source, 64) || !source_generation_text ||
+      !base::StringToInt64(*source_generation_text, &source_generation) ||
+      source_generation <= 0 ||
+      *source_generation_text != base::NumberToString(source_generation) ||
+      !sequence_text || !base::StringToInt64(*sequence_text, &sequence) ||
+      sequence <= 0 || *sequence_text != base::NumberToString(sequence)) {
+    return fail("event context fields are invalid or stale");
+  }
+  const std::optional<HostRuntimeIdentity> current = ReadHostRuntimeIdentity();
+  if (!current || current->account_scope != *account_scope ||
+      current->session_epoch != *session_epoch) {
+    return fail("event runtime identity is stale");
+  }
+  const auto worker_context = CurrentExtensionWorkerContext(
+      extension_id, *incognito ? TabBook::kIncognito : TabBook::kRegular);
+  if (!worker_context) {
+    return fail("event target context is inactive or unauthorized");
+  }
+  if (!contract_epoch_text ||
+      !base::StringToInt64(*contract_epoch_text, &contract_epoch) ||
+      contract_epoch <= 0 ||
+      *contract_epoch_text != base::NumberToString(contract_epoch) ||
+      !contract_digest) {
+    return fail("event capability contract identity is missing");
+  }
+  {
+    base::AutoLock guard(Capabilities().lock);
+    if (!Capabilities().installed ||
+        Capabilities().contract_epoch != contract_epoch ||
+        Capabilities().contract_digest != *contract_digest ||
+        Capabilities().profile_id != *profile_id ||
+        Capabilities().account_scope != *account_scope ||
+        Capabilities().session_epoch != *session_epoch) {
+      return fail("event capability contract is stale");
+    }
+  }
+  const std::string position_key =
+      extension_id + "\n" + *profile_id + "\n" + *account_scope + "\n" +
+      *session_epoch + "\n" + (*incognito ? "incognito" : "regular") + "\n" +
+      base::NumberToString(install_generation) + "\n" + *source;
+  {
+    base::AutoLock guard(Ctx().lock);
+    auto &position = Ctx().event_source_positions[position_key];
+    if (source_generation < position.first ||
+        (source_generation == position.first && sequence <= position.second)) {
+      return fail("event source generation or sequence is stale");
+    }
+    position = {source_generation, sequence};
+  }
+  return true;
+}
+
+bool ValidateHostApiResult(const std::string &name,
+                           const std::string &result_json, std::string *error) {
+  constexpr size_t kMaxHostResultBytes = 8 * 1024 * 1024;
+  auto fail = [&](std::string why) {
+    if (error) {
+      *error = name + ": " + std::move(why);
+    }
+    return false;
+  };
+  if (result_json.size() > kMaxHostResultBytes) {
+    return fail("host result exceeds 8 MiB");
+  }
+  const std::optional<base::ListValue> parsed =
+      base::JSONReader::ReadList(result_json, base::JSON_PARSE_RFC);
+  if (!parsed || parsed->size() > 4) {
+    return fail("host result must be a JSON callback-argument array");
+  }
+  const base::Value *first = parsed->empty() ? nullptr : &(*parsed)[0];
+  auto no_result = [&] { return parsed->empty(); };
+  auto one_bool = [&] { return parsed->size() == 1 && first->is_bool(); };
+  auto one_int = [&] { return parsed->size() == 1 && first->is_int(); };
+  auto one_number = [&] {
+    return parsed->size() == 1 && (first->is_int() || first->is_double());
+  };
+  auto one_string = [&] { return parsed->size() == 1 && first->is_string(); };
+  auto one_dict = [&] { return parsed->size() == 1 && first->is_dict(); };
+  auto one_list = [&] { return parsed->size() == 1 && first->is_list(); };
+  auto list_of = [&](auto predicate) {
+    if (!one_list() || first->GetList().size() > 10000) {
+      return false;
+    }
+    for (const base::Value &value : first->GetList()) {
+      if (!predicate(value)) {
+        return false;
+      }
+    }
+    return true;
+  };
+  auto is_tab = [](const base::Value &value) {
+    const base::DictValue *tab = value.GetIfDict();
+    return tab && tab->FindInt("id") && tab->FindInt("windowId") &&
+           tab->FindBool("incognito");
+  };
+  auto is_download = [](const base::Value &value) {
+    const base::DictValue *item = value.GetIfDict();
+    if (!item || !item->FindInt("id") || !item->FindString("url") ||
+        !item->FindString("finalUrl") || !item->FindString("referrer") ||
+        !item->FindString("filename") || !item->FindBool("incognito") ||
+        !item->FindString("danger") || !item->FindString("mime") ||
+        !item->FindString("startTime") || !item->FindString("state") ||
+        !item->FindBool("paused") || !item->FindBool("canResume") ||
+        !item->FindBool("exists") || !item->FindString("byExtensionId") ||
+        !item->FindString("byExtensionName")) {
+      return false;
+    }
+    auto is_number = [&](std::string_view field) {
+      const base::Value *number = item->Find(field);
+      return number && (number->is_int() || number->is_double());
+    };
+    const std::string &state = *item->FindString("state");
+    return (state == "in_progress" || state == "interrupted" ||
+            state == "complete") &&
+           is_number("bytesReceived") && is_number("totalBytes") &&
+           is_number("fileSize");
+  };
+  auto is_bookmark = [](const base::Value &value) {
+    const base::DictValue *item = value.GetIfDict();
+    return item && item->FindString("id") && item->FindString("title");
+  };
+  auto is_history = [](const base::Value &value) {
+    const base::DictValue *item = value.GetIfDict();
+    return item && item->FindString("id") && item->FindString("url");
+  };
+  auto is_cookie = [](const base::Value &value) {
+    const base::DictValue *item = value.GetIfDict();
+    return item && item->FindString("name") && item->FindString("value") &&
+           item->FindString("domain") && item->FindString("path");
+  };
+  auto require = [&](bool ok, const char *model) {
+    return ok ? true : fail(std::string("host result violates ") + model);
+  };
+
+  if (name == "tabs.query") {
+    return require(list_of(is_tab), "Tab[] v2");
+  }
+  if (name == "tabs.create" || name == "tabs.update" ||
+      name == "tabs.duplicate") {
+    return require(first && is_tab(*first) && parsed->size() == 1, "Tab v2");
+  }
+  if (name == "tabs.move") {
+    return require((first && is_tab(*first) && parsed->size() == 1) ||
+                       list_of(is_tab),
+                   "Tab|Tab[] v2");
+  }
+  if (name == "tabs.captureVisibleTab") {
+    const base::DictValue *capture = first ? first->GetIfDict() : nullptr;
+    return require(parsed->size() == 1 && capture &&
+                       capture->FindInt("tabId") &&
+                       capture->FindString("documentUrl") &&
+                       capture->FindString("dataUrl"),
+                   "TabCapture v1");
+  }
+  if (name == "tabs.remove" || name == "tabs.goBack" ||
+      name == "tabs.goForward" || name == "search.query" ||
+      name == "management.setEnabled" || name == "management.uninstall" ||
+      name == "management.uninstallSelf" ||
+      name.starts_with("browsingData.remove")) {
+    return require(no_result(), "void result");
+  }
+  if (name.starts_with("action.set") || name == "action.enable" ||
+      name == "action.disable" || name == "action.openPopup") {
+    return require(no_result(), "void result");
+  }
+  if (name == "action.getTitle" || name == "action.getPopup" ||
+      name == "action.getBadgeText") {
+    return require(one_string(), "ActionState string");
+  }
+  if (name == "action.getBadgeBackgroundColor" ||
+      name == "action.getBadgeTextColor") {
+    return require(one_list() && first->GetList().size() == 4,
+                   "ActionState color");
+  }
+  if (name == "action.isEnabled") {
+    return require(one_bool(), "ActionState boolean");
+  }
+  if (name == "action.getUserSettings") {
+    return require(one_dict() && first->GetDict().FindBool("isOnToolbar"),
+                   "ActionState v1");
+  }
+  if (name == "contextMenus.create") {
+    // Chromium's context_menus_custom_bindings.js returns the explicit or
+    // generated item id synchronously. The host callback only confirms that
+    // the side effect committed, so its wire result is void just like
+    // update/remove/removeAll. Requiring a second id here rejects the standard
+    // custom-binding response (`[]`) after the host has already registered the
+    // item and turns a successful create into runtime.lastError.
+    return require(no_result(), "void result");
+  }
+  if (name.starts_with("contextMenus.")) {
+    return require(no_result(), "void result");
+  }
+  if (name == "downloads.download") {
+    return require(one_int(), "download id");
+  }
+  if (name == "downloads.search") {
+    return require(list_of(is_download), "DownloadItem[] v1");
+  }
+  if (name == "downloads.erase") {
+    return require(
+        list_of([](const base::Value &value) { return value.is_int(); }),
+        "download id[]");
+  }
+  if (name == "downloads.getFileIcon") {
+    return require(one_string() && first->GetString().starts_with("data:"),
+                   "download icon data URL");
+  }
+  if (name.starts_with("downloads.")) {
+    return require(no_result(), "void result");
+  }
+  if (name.starts_with("bookmarks.")) {
+    if (name == "bookmarks.create" || name == "bookmarks.update" ||
+        name == "bookmarks.move") {
+      return require(first && is_bookmark(*first) && parsed->size() == 1,
+                     "BookmarkTreeNode v1");
+    }
+    if (name == "bookmarks.remove" || name == "bookmarks.removeTree") {
+      return require(no_result(), "void result");
+    }
+    return require(list_of(is_bookmark), "BookmarkTreeNode[] v1");
+  }
+  if (name == "history.search") {
+    return require(list_of(is_history), "HistoryItem[] v1");
+  }
+  if (name == "history.getVisits") {
+    return require(list_of([](const base::Value &value) {
+                     const base::DictValue *visit = value.GetIfDict();
+                     return visit && visit->FindString("id") &&
+                            visit->FindString("visitId") &&
+                            visit->FindString("referringVisitId");
+                   }),
+                   "VisitItem[] v1");
+  }
+  if (name.starts_with("history.")) {
+    return require(no_result(), "void result");
+  }
+  if (name == "notifications.create") {
+    return require(one_string(), "notification id");
+  }
+  if (name == "notifications.update" || name == "notifications.clear") {
+    return require(one_bool(), "notification boolean");
+  }
+  if (name == "notifications.getAll") {
+    return require(one_dict(), "Notification map v1");
+  }
+  if (name == "notifications.getPermissionLevel") {
+    return require(one_string() && (first->GetString() == "granted" ||
+                                    first->GetString() == "denied"),
+                   "notification permission level");
+  }
+  if (name == "types.ChromeSetting.set" ||
+      name == "types.ChromeSetting.clear") {
+    return require(no_result(), "ChromeSetting void result");
+  }
+  if (name == "types.ChromeSetting.get") {
+    const base::DictValue *setting = first ? first->GetIfDict() : nullptr;
+    const std::string *level =
+        setting ? setting->FindString("levelOfControl") : nullptr;
+    const bool valid_level =
+        level && (*level == "not_controllable" ||
+                  *level == "controlled_by_other_extensions" ||
+                  *level == "controllable_by_this_extension" ||
+                  *level == "controlled_by_this_extension");
+    return require(parsed->size() == 1 && setting &&
+                       setting->FindDict("value") && valid_level &&
+                       setting->FindBool("incognitoSpecific").has_value(),
+                   "ChromeSetting result v1");
+  }
+  if (name == "identity.getProfileUserInfo") {
+    return require(one_dict() && first->GetDict().FindString("email") &&
+                       first->GetDict().FindString("id"),
+                   "IdentityProfile v1");
+  }
+  if (name == "identity.launchWebAuthFlow" ||
+      name == "identity.getRedirectURL") {
+    return require(one_string(), "identity URL");
+  }
+  if (name == "i18n.getAcceptLanguages") {
+    return require(list_of([](const base::Value &value) {
+                     return value.is_string() && !value.GetString().empty() &&
+                            value.GetString().size() <= 64;
+                   }),
+                   "LocaleList v1");
+  }
+  if (name.starts_with("sessions.")) {
+    if (name == "sessions.restore") {
+      return require(!first || first->is_dict(), "Session v1");
+    }
+    return require(list_of([](const base::Value &value) {
+                     const base::DictValue *session = value.GetIfDict();
+                     return session && (session->FindDict("tab") ||
+                                        session->FindDict("window"));
+                   }),
+                   "Session[] v1");
+  }
+  if (name.starts_with("declarativeContent.")) {
+    return require(name.ends_with("getRules") ? one_list() : no_result(),
+                   "DeclarativeRule v1");
+  }
+  if (name == "system.cpu.getInfo") {
+    return require(one_dict() && first->GetDict().FindInt("numOfProcessors"),
+                   "CpuInfo v1");
+  }
+  if (name == "system.memory.getInfo") {
+    const base::DictValue *memory = first ? first->GetIfDict() : nullptr;
+    return require(parsed->size() == 1 && memory && memory->Find("capacity") &&
+                       memory->Find("availableCapacity"),
+                   "MemoryInfo v1");
+  }
+  if (name.starts_with("cookies.")) {
+    if (name == "cookies.get" || name == "cookies.set") {
+      return require(parsed->size() == 1 &&
+                         (first->is_none() || is_cookie(*first)),
+                     "Cookie|null v1");
+    }
+    if (name == "cookies.getAll") {
+      return require(list_of(is_cookie), "Cookie[] v1");
+    }
+    if (name == "cookies.getAllCookieStores") {
+      return require(one_list(), "CookieStore[] v1");
+    }
+    return require(parsed->size() == 1 &&
+                       (first->is_none() || first->is_dict()),
+                   "cookie operation result v1");
+  }
+  if (name.starts_with("storage.sync.") ||
+      name.starts_with("storage.managed.")) {
+    if (name.ends_with(".get")) {
+      return require(one_dict(), "storage object v1");
+    }
+    if (name.ends_with(".getKeys")) {
+      return require(
+          list_of([](const base::Value &value) { return value.is_string(); }),
+          "storage key[] v1");
+    }
+    if (name.ends_with(".getBytesInUse")) {
+      return require(one_number(), "storage byte count");
+    }
+    if (name.starts_with("storage.sync.")) {
+      const base::DictValue *commit = first ? first->GetIfDict() : nullptr;
+      const std::string *commit_id =
+          commit ? commit->FindString("commitId") : nullptr;
+      const std::string *revision_text =
+          commit ? commit->FindString("revision") : nullptr;
+      int64_t revision = 0;
+      return require(
+          parsed->size() == 1 && commit && commit_id &&
+              IsSafeOpaqueIdentity(*commit_id, 128) && revision_text &&
+              base::StringToInt64(*revision_text, &revision) && revision > 0 &&
+              *revision_text == base::NumberToString(revision) &&
+              commit->FindBool("conflict") &&
+              commit->FindString("accountScope") &&
+              commit->FindString("sessionEpoch"),
+          "StorageSync commit v2");
+    }
+    return require(no_result(), "void result");
+  }
+  if (name == "nomad.invoke" || name == "nomadTransfer.invoke" ||
+      name == "nomadTransfer.capabilities") {
+    return require(one_dict(), "product Envelope");
+  }
+  if (name == "nomadTransfer.ack") {
+    return require(one_bool(), "ack boolean");
+  }
+  if (name == "extension.isAllowedIncognitoAccess" ||
+      name == "extension.isAllowedFileSchemeAccess") {
+    return require(one_bool(), "extension access boolean");
+  }
+  if (name == "windows.update") {
+    return require(one_dict() && first->GetDict().FindInt("id") &&
+                       first->GetDict().FindBool("incognito"),
+                   "Window v1");
+  }
+  if (name == "nomad.dnr.applyDynamicRules" ||
+      name == "nomad.dnr.removeRules") {
+    const base::DictValue *receipt = first ? first->GetIfDict() : nullptr;
+    return require(parsed->size() == 1 && receipt &&
+                       receipt->FindInt("contractVersion") &&
+                       receipt->FindString("interception") &&
+                       receipt->FindString("extensionId") &&
+                       receipt->FindString("rulesSha256"),
+                   "DnrApplyReceipt v2");
+  }
+  if (name == "declarativeNetRequest.setExtensionActionOptions") {
+    return require(no_result(), "void result");
+  }
+  auto is_matched_rule = [](const base::Value &value) {
+    const base::DictValue *rule = value.GetIfDict();
+    const std::optional<int> rule_id = rule ? rule->FindInt("ruleId")
+                                             : std::nullopt;
+    const std::string *ruleset_id =
+        rule ? rule->FindString("rulesetId") : nullptr;
+    return rule_id && *rule_id > 0 && ruleset_id && !ruleset_id->empty();
+  };
+  if (name == "declarativeNetRequest.testMatchOutcome") {
+    const base::DictValue *result = first ? first->GetIfDict() : nullptr;
+    const base::ListValue *matches =
+        result ? result->FindList("matchedRules") : nullptr;
+    bool valid = parsed->size() == 1 && matches && matches->size() <= 10000;
+    if (valid) {
+      valid = std::ranges::all_of(*matches, is_matched_rule);
+    }
+    return require(valid, "DnrTestMatchOutcome v1");
+  }
+  if (name == "nomad.dnr.isRegexSupported") {
+    const base::DictValue *result = first ? first->GetIfDict() : nullptr;
+    const std::optional<bool> supported =
+        result ? result->FindBool("isSupported") : std::nullopt;
+    const std::string *reason = result ? result->FindString("reason") : nullptr;
+    const bool valid_reason = reason &&
+                              (*reason == "syntaxError" ||
+                               *reason == "memoryLimitExceeded");
+    return require(parsed->size() == 1 && supported &&
+                       (*supported ? !reason : valid_reason),
+                   "DnrRegexSupport v1");
+  }
+  if (name == "nomad.dnr.getMatchedRules") {
+    const base::DictValue *result = first ? first->GetIfDict() : nullptr;
+    const base::ListValue *matches =
+        result ? result->FindList("rulesMatchedInfo") : nullptr;
+    bool valid = parsed->size() == 1 && matches && matches->size() <= 10000;
+    if (valid) {
+      valid = std::ranges::all_of(*matches, [&](const base::Value &value) {
+        const base::DictValue *info = value.GetIfDict();
+        const base::Value *time = info ? info->Find("timeStamp") : nullptr;
+        const base::Value *rule = info ? info->Find("rule") : nullptr;
+        return info && rule && is_matched_rule(*rule) &&
+               time && (time->is_int() || time->is_double()) &&
+               info->FindInt("tabId").has_value();
+      });
+    }
+    return require(valid, "DnrMatchedRules v1");
+  }
+  if (name.starts_with("contentSettings.")) {
+    if (name.ends_with(".get")) {
+      const base::DictValue *state = first ? first->GetIfDict() : nullptr;
+      const std::string *setting =
+          state ? state->FindString("setting") : nullptr;
+      const std::string *restriction =
+          state ? state->FindString("systemRestriction") : nullptr;
+      return require(parsed->size() == 1 && state && setting &&
+                         mv3::IsSupportedContentSetting(*setting) &&
+                         restriction &&
+                         (*restriction == "none" || *restriction == "blocked" ||
+                          *restriction == "unknown"),
+                     "ContentSetting host state v2");
+    }
+    if (name.ends_with("ResourceIdentifiers")) {
+      return require(parsed->size() == 1 && first->is_list(),
+                     "ContentSetting identifiers v1");
+    }
+    return require(no_result(), "void result");
+  }
+  if (name.starts_with("nomad.siteSettings.")) {
+    const base::DictValue *setting = first ? first->GetIfDict() : nullptr;
+    return require(parsed->size() == 1 && setting &&
+                       setting->FindString("setting"),
+                   "ContentSetting host state v1");
+  }
+  if (name.starts_with("nomad.sitePermissionAudit.")) {
+    return require(one_dict(), "site permission audit host result");
+  }
+  return fail("no registered host result validator");
+}
