+namespace {
+
+void AppendWebTransportDnrContext(content::RenderFrameHost *frame,
+                                  bool incognito,
+                                  const url::Origin &initiator,
+                                  std::vector<std::string> *names,
+                                  std::vector<std::string> *values) {
+  content::WebContents *web_contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  content::RenderFrameHost *parent =
+      frame ? frame->GetParentOrOuterDocument() : nullptr;
+  AppendDnrTrustedContextValues(
+      "webtransport", initiator.opaque() ? "null" : initiator.Serialize(),
+      TabIdForWebContents(web_contents), incognito ? "incognito" : "regular",
+      frame ? frame->GetFrameTreeNodeId().value() : -1,
+      parent ? parent->GetFrameTreeNodeId().value() : -1, FrameIdOf(frame),
+      FrameIdOf(parent), DocumentIdOf(frame), DocumentIdOf(parent),
+      DocumentLifecycleOf(frame), FrameTypeOf(frame), names, values);
+}
+
+base::android::ScopedJavaLocalRef<jobject> CallWebTransportDnr(
+    JNIEnv *env,
+    content::RenderFrameHost *frame,
+    const GURL &url,
+    const std::vector<std::string> &names,
+    const std::vector<std::string> &values) {
+  content::WebContents *web_contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate =
+      GetKernelViewJavaDelegate(web_contents);
+  return java_delegate.is_null()
+             ? CallProcessDnrInterceptor(env, url.spec(), "CONNECT", names,
+                                         values)
+             : CallShouldInterceptRequest(env, java_delegate, url.spec(),
+                                          "CONNECT", false, names, values);
+}
