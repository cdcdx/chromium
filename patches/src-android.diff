+WebResponseInfo
+SnapshotWebResponse(const network::mojom::URLResponseHeadPtr &head) {
+  WebResponseInfo response;
+  if (!head) {
+    return response;
+  }
+  response.from_cache = head->was_fetched_via_cache;
+  response.ip = head->remote_endpoint.address().ToString();
+  if (head->headers) {
+    response.status_code = head->headers->response_code();
+    response.status_line = head->headers->GetStatusLine();
+    size_t cursor = 0;
+    std::string name;
+    std::string value;
+    while (head->headers->EnumerateHeaderLines(&cursor, &name, &value)) {
+      response.headers.emplace_back(name, value);
+    }
+  }
+  return response;
+}
+
+class ArupaObservingURLLoader : public network::mojom::URLLoaderClient,
+                                public network::mojom::URLLoader {
+public:
+  static mojo::PendingRemote<network::mojom::URLLoaderClient>
+  Wrap(WebRequestInfo info, int originating_process_id,
+       int32_t network_request_id, bool observe_request,
+       bool track_auth_metadata, std::optional<base::DictValue> body,
+       std::vector<std::pair<std::string, std::string>> request_headers,
+       std::vector<DnrHeaderModification> response_header_modifications,
+       base::android::ScopedJavaGlobalRef<jobject> java_delegate,
+       int frame_tree_node_id, int parent_frame_tree_node_id,
+       network::ResourceRequest resource_request, uint32_t options,
+       net::MutableNetworkTrafficAnnotationTag traffic_annotation,
+       mojo::PendingRemote<network::mojom::URLLoaderFactory> restart_factory,
+       mojo::PendingReceiver<network::mojom::URLLoader> *loader,
+       mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    auto *self = new ArupaObservingURLLoader(
+        std::move(info), originating_process_id, network_request_id,
+        observe_request, track_auth_metadata, std::move(body),
+        std::move(request_headers), std::move(response_header_modifications),
+        std::move(java_delegate), frame_tree_node_id,
+        parent_frame_tree_node_id, std::move(resource_request), options,
+        traffic_annotation, std::move(restart_factory),
+        std::move(*loader), std::move(client));
+    *loader = self->target_loader_.BindNewPipeAndPassReceiver();
+    mojo::PendingRemote<network::mojom::URLLoaderClient> remote =
+        self->receiver_.BindNewPipeAndPassRemote();
+    self->InstallDisconnectHandlers();
+    return remote;
+  }
+
+  ArupaObservingURLLoader(const ArupaObservingURLLoader &) = delete;
+  ArupaObservingURLLoader &operator=(const ArupaObservingURLLoader &) = delete;
+
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    real_client_->OnReceiveEarlyHints(std::move(hints));
+  }
+
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> cached_metadata) override {
+    ApplyResponseHeaderModifications(response_header_modifications_, head.get());
+    if (!ApplyResponseDnr(head.get())) {
+      return;
+    }
+    if (IssueDnrResponseRedirect(&head)) {
+      return;
+    }
+    response_ = SnapshotWebResponse(head);
+    if (observe_request_) {
+      DispatchWebRequestHeadersReceived(info_, response_);
+      DispatchWebRequestResponseStarted(info_, response_);
+    }
+    real_client_->OnReceiveResponse(std::move(head), std::move(body),
+                                    std::move(cached_metadata));
+  }
+
+  void OnReceiveRedirect(const net::RedirectInfo &redirect_info,
+                         network::mojom::URLResponseHeadPtr head) override {
+    ApplyResponseHeaderModifications(response_header_modifications_, head.get());
+    if (!ApplyResponseDnr(head.get())) {
+      return;
+    }
+    if (IssueDnrResponseRedirect(&head)) {
+      return;
+    }
+    response_ = SnapshotWebResponse(head);
+    if (observe_request_) {
+      DispatchWebRequestHeadersReceived(info_, response_);
+      DispatchWebRequestBeforeRedirect(info_, response_, redirect_info.new_url);
+    }
+    pending_redirect_ = redirect_info;
+    real_client_->OnReceiveRedirect(redirect_info, std::move(head));
+  }
+
+  void OnUploadProgress(int64_t current, int64_t total,
+                        OnUploadProgressCallback callback) override {
+    real_client_->OnUploadProgress(current, total, std::move(callback));
+  }
+
+  void OnTransferSizeUpdated(int32_t transfer_size_diff) override {
+    real_client_->OnTransferSizeUpdated(transfer_size_diff);
+  }
+
+  void OnComplete(const network::URLLoaderCompletionStatus &status) override {
+    if (blocked_) {
+      return;
+    }
+    if (!reported_) {
+      reported_ = true;
+      if (observe_request_) {
+        if (status.error_code == net::OK) {
+          DispatchWebRequestCompleted(info_, response_);
+        } else {
+          DispatchWebRequestErrorOccurred(
+              info_, net::ErrorToString(status.error_code));
+        }
+      }
+    }
+    ForgetAuthMetadata();
+    real_client_->OnComplete(status);
+  }
+
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams headers,
+                      const std::optional<GURL> &new_url) override {
+    if (pending_redirect_) {
+      GURL effective_url = new_url.value_or(pending_redirect_->new_url);
+      if (info_.method != pending_redirect_->new_method) {
+        request_body_.reset();
+      }
+      info_.method = pending_redirect_->new_method;
+      net::HttpRequestHeaders current_headers;
+      for (const auto &[name, value] : request_headers_) {
+        current_headers.SetHeader(name, value);
+      }
+      net::HttpRequestHeaders cors_exempt_headers;
+      headers.Apply(current_headers, cors_exempt_headers);
+      PassThroughInstruction instruction;
+      if (!EvaluateBeforeRequestDnr(effective_url, info_.method,
+                                    current_headers, &instruction)) {
+        return;
+      }
+      ApplyRequestHeaderModifications(instruction.request_headers,
+                                      &current_headers);
+      for (const DnrHeaderModification &modification :
+           instruction.request_headers) {
+        if (modification.operation == "remove") {
+          headers.removed_headers.push_back(modification.header);
+          headers.modified_headers.RemoveHeader(modification.header);
+        } else if (std::optional<std::string> value =
+                       current_headers.GetHeader(modification.header)) {
+          headers.modified_headers.SetHeader(modification.header, *value);
+        }
+      }
+      if (IsSupportedDnrRedirect(instruction.redirect_url)) {
+        effective_url = instruction.redirect_url;
+        if (effective_url.SchemeIs(extensions::kExtensionScheme) ||
+            effective_url.SchemeIs(url::kDataScheme) ||
+            effective_url.SchemeIsFile()) {
+          restart_on_follow_redirect_ = true;
+        }
+      }
+      response_header_modifications_ =
+          std::move(instruction.response_headers);
+      request_headers_.clear();
+      for (const auto &header : current_headers.GetHeaderVector()) {
+        request_headers_.emplace_back(header.key, header.value);
+      }
+      net::RedirectInfo effective_redirect = *pending_redirect_;
+      effective_redirect.new_url = effective_url;
+      resource_request_.headers = current_headers;
+      resource_request_.cors_exempt_headers = cors_exempt_headers;
+      if (resource_request_.method != effective_redirect.new_method) {
+        resource_request_.request_body = nullptr;
+      }
+      resource_request_.UpdateOnRedirect(effective_redirect);
+      info_.url = effective_url;
+      pending_redirect_.reset();
+      response_ = {};
+      if (track_auth_metadata_) {
+        RegisterWebRequestMetadata(originating_process_id_, network_request_id_,
+                                   info_);
+      }
+      if (observe_request_) {
+        DispatchWebRequestBeforeRequest(info_, request_body_ ? &*request_body_
+                                                             : nullptr);
+        DispatchWebRequestBeforeSendHeaders(info_, request_headers_);
+        DispatchWebRequestSendHeaders(info_, request_headers_);
+      }
+      if (restart_on_follow_redirect_) {
+        RestartAfterRedirect(std::move(headers));
+      } else {
+        target_loader_->FollowRedirect(std::move(headers), effective_url);
+      }
+      return;
+    }
+    target_loader_->FollowRedirect(std::move(headers), new_url);
+  }
+
+  void SetPriority(net::RequestPriority priority,
+                   int32_t intra_priority_value) override {
+    target_loader_->SetPriority(priority, intra_priority_value);
+  }
+
+private:
+  ArupaObservingURLLoader(
+      WebRequestInfo info, int originating_process_id,
+      int32_t network_request_id, bool observe_request,
+      bool track_auth_metadata, std::optional<base::DictValue> body,
+      std::vector<std::pair<std::string, std::string>> request_headers,
+      std::vector<DnrHeaderModification> response_header_modifications,
+      base::android::ScopedJavaGlobalRef<jobject> java_delegate,
+      int frame_tree_node_id, int parent_frame_tree_node_id,
+      network::ResourceRequest resource_request, uint32_t options,
+      net::MutableNetworkTrafficAnnotationTag traffic_annotation,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> restart_factory,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client)
+      : info_(std::move(info)), originating_process_id_(originating_process_id),
+        network_request_id_(network_request_id),
+        observe_request_(observe_request),
+        track_auth_metadata_(track_auth_metadata),
+        request_body_(std::move(body)),
+        request_headers_(std::move(request_headers)),
+        response_header_modifications_(
+            std::move(response_header_modifications)),
+        java_delegate_(std::move(java_delegate)),
+        frame_tree_node_id_(frame_tree_node_id),
+        parent_frame_tree_node_id_(parent_frame_tree_node_id),
+        resource_request_(std::move(resource_request)), options_(options),
+        traffic_annotation_(traffic_annotation),
+        restart_factory_(std::move(restart_factory)),
+        loader_receiver_(this, std::move(loader)),
+        real_client_(std::move(client)) {}
+
+  ~ArupaObservingURLLoader() override = default;
+
+  bool EvaluateBeforeRequestDnr(
+      const GURL &url, std::string_view method,
+      const net::HttpRequestHeaders &request_headers,
+      PassThroughInstruction *instruction) {
+    std::vector<std::string> names;
+    std::vector<std::string> values;
+    for (const auto &header : request_headers.GetHeaderVector()) {
+      if (!IsDnrInternalHeader(header.key)) {
+        names.push_back(header.key);
+        values.push_back(header.value);
+      }
+    }
+    AppendDnrTrustedContextValues(
+        info_.type, info_.initiator, info_.tab_id,
+        info_.incognito ? "incognito" : "regular", frame_tree_node_id_,
+        parent_frame_tree_node_id_, info_.frame_id, info_.parent_frame_id,
+        info_.document_id, info_.parent_document_id, info_.document_lifecycle,
+        info_.frame_type, &names, &values);
+    JNIEnv *env = base::android::AttachCurrentThread();
+    base::android::ScopedJavaLocalRef<jobject> response =
+        java_delegate_.is_null()
+            ? CallProcessDnrInterceptor(env, url.spec(), method, names, values)
+            : CallShouldInterceptRequest(env, java_delegate_, url.spec(),
+                                         std::string(method),
+                                         info_.type == "main_frame",
+                                         names, values);
+    if (response.is_null()) {
+      *instruction = {};
+      return true;
+    }
+    if (!Java_ArupaWebResourceResponse_getPassThrough(env, response)) {
+      BlockRequest();
+      return false;
+    }
+    *instruction = ReadPassThroughInstruction(env, response);
+    return true;
+  }
+
+  void BlockRequest() {
+    blocked_ = true;
+    reported_ = true;
+    if (observe_request_) {
+      DispatchWebRequestErrorOccurred(
+          info_, net::ErrorToString(net::ERR_BLOCKED_BY_CLIENT));
+    }
+    ForgetAuthMetadata();
+    target_loader_.reset();
+    real_client_->OnComplete(
+        network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+  }
+
+  bool IssueDnrResponseRedirect(
+      network::mojom::URLResponseHeadPtr *head) {
+    if (!response_dnr_redirect_.is_valid()) {
+      return false;
+    }
+    const GURL destination = std::exchange(response_dnr_redirect_, GURL());
+    net::RedirectInfo redirect = net::RedirectInfo::ComputeRedirectInfo(
+        resource_request_.method, resource_request_.url,
+        resource_request_.site_for_cookies,
+        resource_request_.update_first_party_url_on_redirect
+            ? net::RedirectInfo::FirstPartyURLPolicy::UPDATE_URL_ON_REDIRECT
+            : net::RedirectInfo::FirstPartyURLPolicy::NEVER_CHANGE_URL,
+        resource_request_.referrer_policy, resource_request_.referrer.spec(),
+        resource_request_.request_initiator,
+        static_cast<int>(net::RedirectUtil::ResponseCode::REDIRECT_307_TEMPORARY_REDIRECT),
+        destination, std::nullopt,
+        /*insecure_scheme_was_upgraded=*/false,
+        /*copy_fragment=*/false);
+    (*head)->headers = net::RedirectUtil::SynthesizeRedirectHeaders(
+        destination,
+        net::RedirectUtil::ResponseCode::REDIRECT_307_TEMPORARY_REDIRECT,
+        "Declarative Net Request", resource_request_.headers);
+    response_ = SnapshotWebResponse(*head);
+    if (observe_request_) {
+      DispatchWebRequestHeadersReceived(info_, response_);
+      DispatchWebRequestBeforeRedirect(info_, response_, destination);
+    }
+    pending_redirect_ = redirect;
+    restart_on_follow_redirect_ = true;
+    receiver_.set_disconnect_handler(base::OnceClosure());
+    receiver_.reset();
+    target_loader_.reset();
+    real_client_->OnReceiveRedirect(redirect, std::move(*head));
+    return true;
+  }
+
+  void RestartAfterRedirect(network::HttpRequestHeadersUpdateParams) {
+    restart_on_follow_redirect_ = false;
+    if (!restart_factory_ &&
+        !resource_request_.url.SchemeIs(extensions::kExtensionScheme) &&
+        !resource_request_.url.SchemeIs(url::kDataScheme) &&
+        !resource_request_.url.SchemeIsFile()) {
+      BlockRequest();
+      return;
+    }
+    target_loader_.reset();
+    receiver_.reset();
+    mojo::PendingReceiver<network::mojom::URLLoader> loader =
+        target_loader_.BindNewPipeAndPassReceiver();
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client =
+        receiver_.BindNewPipeAndPassRemote();
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &ArupaObservingURLLoader::Finish, base::Unretained(this)));
+    if (resource_request_.url.SchemeIs(url::kDataScheme)) {
+      ArupaServedResponseLoader::StartData(
+          resource_request_.url, resource_request_.method, std::move(loader),
+          std::move(client));
+      return;
+    }
+    if (resource_request_.url.SchemeIsFile()) {
+      content::CreateFileURLLoaderBypassingSecurityChecks(
+          resource_request_, std::move(loader), std::move(client), nullptr,
+          /*allow_directory_listing=*/false);
+      return;
+    }
+    network::mojom::URLLoaderFactory *factory = restart_factory_.get();
+    if (resource_request_.url.SchemeIs(extensions::kExtensionScheme)) {
+      extension_redirect_factory_.Bind(CreateExtensionURLLoaderFactory());
+      factory = extension_redirect_factory_.get();
+    }
+    if (!factory) {
+      BlockRequest();
+      return;
+    }
+    factory->CreateLoaderAndStart(
+        std::move(loader), network_request_id_, options_, resource_request_,
+        std::move(client), traffic_annotation_);
+  }
+
+  bool ApplyResponseDnr(network::mojom::URLResponseHead* head) {
+    if (!head || !head->headers) {
+      return true;
+    }
+    std::vector<std::string> names;
+    std::vector<std::string> values;
+    size_t cursor = 0;
+    std::string name;
+    std::string value;
+    while (head->headers->EnumerateHeaderLines(&cursor, &name, &value)) {
+      if (!IsDnrInternalHeader(name)) {
+        names.push_back(name);
+        values.push_back(value);
+      }
+    }
+    names.emplace_back(kDnrStageHeader);
+    values.emplace_back("headersReceived");
+    AppendDnrTrustedContextValues(
+        info_.type, info_.initiator, info_.tab_id,
+        info_.incognito ? "incognito" : "regular", frame_tree_node_id_,
+        parent_frame_tree_node_id_, info_.frame_id, info_.parent_frame_id,
+        info_.document_id, info_.parent_document_id, info_.document_lifecycle,
+        info_.frame_type, &names, &values);
+    JNIEnv* env = base::android::AttachCurrentThread();
+    base::android::ScopedJavaLocalRef<jobject> response =
+        java_delegate_.is_null()
+            ? CallProcessDnrInterceptor(env, info_.url.spec(), info_.method,
+                                        names, values)
+            : CallShouldInterceptRequest(env, java_delegate_, info_.url.spec(),
+                                         info_.method,
+                                         info_.type == "main_frame", names,
+                                         values);
+    if (response.is_null()) {
+      return true;
+    }
+    if (!Java_ArupaWebResourceResponse_getPassThrough(env, response)) {
+      BlockRequest();
+      return false;
+    }
+    PassThroughInstruction instruction =
+        ReadPassThroughInstruction(env, response);
+    if (IsSupportedDnrRedirect(instruction.redirect_url)) {
+      response_dnr_redirect_ = instruction.redirect_url;
+    }
+    ApplyResponseHeaderModifications(instruction.response_headers, head);
+    return true;
+  }
+
+  void InstallDisconnectHandlers() {
+    loader_receiver_.set_disconnect_handler(base::BindOnce(
+        &ArupaObservingURLLoader::Finish, base::Unretained(this)));
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &ArupaObservingURLLoader::Finish, base::Unretained(this)));
+    real_client_.set_disconnect_handler(base::BindOnce(
+        &ArupaObservingURLLoader::Finish, base::Unretained(this)));
+  }
+
+  void Finish() {
+    if (!reported_) {
+      reported_ = true;
+      if (observe_request_) {
+        DispatchWebRequestErrorOccurred(info_,
+                                        net::ErrorToString(net::ERR_ABORTED));
+      }
+    }
+    ForgetAuthMetadata();
+    delete this;
+  }
+
+  void ForgetAuthMetadata() {
+    if (!track_auth_metadata_) {
+      return;
+    }
+    ForgetWebRequestMetadata(originating_process_id_, network_request_id_);
+    track_auth_metadata_ = false;
+  }
+
+  WebRequestInfo info_;
+  const int originating_process_id_;
+  const int32_t network_request_id_;
+  const bool observe_request_;
+  bool track_auth_metadata_;
+  std::optional<base::DictValue> request_body_;
+  std::vector<std::pair<std::string, std::string>> request_headers_;
+  std::vector<DnrHeaderModification> response_header_modifications_;
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate_;
+  const int frame_tree_node_id_;
+  const int parent_frame_tree_node_id_;
+  network::ResourceRequest resource_request_;
+  const uint32_t options_;
+  const net::MutableNetworkTrafficAnnotationTag traffic_annotation_;
+  mojo::Remote<network::mojom::URLLoaderFactory> restart_factory_;
+  mojo::Remote<network::mojom::URLLoaderFactory> extension_redirect_factory_;
+  WebResponseInfo response_;
+  std::optional<net::RedirectInfo> pending_redirect_;
+  GURL response_dnr_redirect_;
+  mojo::Receiver<network::mojom::URLLoader> loader_receiver_;
+  mojo::Remote<network::mojom::URLLoader> target_loader_;
+  mojo::Receiver<network::mojom::URLLoaderClient> receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> real_client_;
+  bool reported_ = false;
+  bool blocked_ = false;
+  bool restart_on_follow_redirect_ = false;
+};
+
+#endif // BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+
+class ArupaProxyingURLLoaderFactory : public network::mojom::URLLoaderFactory {
+public:
+  static void
+  CreateOnIO(base::android::ScopedJavaGlobalRef<jobject> java_delegate,
+             int tab_id, std::string partition, int originating_process_id,
+             int frame_id, int parent_frame_id, std::string document_id,
+             std::string parent_document_id, std::string document_lifecycle,
+             std::string frame_type, int frame_tree_node_id,
+             int parent_frame_tree_node_id,
+             mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+             mojo::PendingRemote<network::mojom::URLLoaderFactory> target) {
+    new ArupaProxyingURLLoaderFactory(
+        std::move(java_delegate), tab_id, std::move(partition),
+        originating_process_id, frame_id, parent_frame_id,
+        std::move(document_id), std::move(parent_document_id),
+        std::move(document_lifecycle), std::move(frame_type),
+        frame_tree_node_id, parent_frame_tree_node_id, std::move(receiver),
+        std::move(target));
+  }
+
+  ArupaProxyingURLLoaderFactory(const ArupaProxyingURLLoaderFactory &) = delete;
+  ArupaProxyingURLLoaderFactory &
+  operator=(const ArupaProxyingURLLoaderFactory &) = delete;
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader>, int32_t, uint32_t,
+      const network::ResourceRequest &,
+      mojo::PendingRemote<network::mojom::URLLoaderClient>,
+      const net::MutableNetworkTrafficAnnotationTag &) override {}
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id, uint32_t options, network::ResourceRequest &request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag &traffic_annotation)
+      override {
+    JNIEnv *env = base::android::AttachCurrentThread();
+
+    std::vector<std::string> names;
+    std::vector<std::string> values;
+    AppendCallbackRequestHeaders(request, &names, &values);
+
+    const bool is_main_frame_doc =
+        request.is_outermost_main_frame &&
+        request.destination == network::mojom::RequestDestination::kDocument;
+    AppendDnrTrustedContext(request, is_main_frame_doc, tab_id_, partition_,
+                            frame_tree_node_id_, parent_frame_tree_node_id_,
+                            frame_id_, parent_frame_id_, document_id_,
+                            parent_document_id_, document_lifecycle_, frame_type_,
+                            &names, &values);
+
+    // 文档请求有对应 WebView delegate，可执行宿主拦截/DNR；Service Worker
+    // 子资源没有页面归属，只安装下面的 webRequest 只读观察链，不能随意借用
+    // 某个页面 delegate 伪造 per-view 宿主决策。
+    base::android::ScopedJavaLocalRef<jobject> resp;
+    if (!java_delegate_.is_null()) {
+      resp = CallShouldInterceptRequest(env, java_delegate_, request.url.spec(),
+                                        request.method, is_main_frame_doc,
+                                        names, values);
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+    } else {
+      resp = CallProcessDnrInterceptor(env, request.url.spec(), request.method,
+                                       names, values);
+#endif
+    }
+
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+    PassThroughInstruction instruction;
+    const bool pass_through =
+        !resp.is_null() &&
+        Java_ArupaWebResourceResponse_getPassThrough(env, resp);
+    if (pass_through) {
+      instruction = ReadPassThroughInstruction(env, resp);
+      ApplyRequestHeaderModifications(instruction.request_headers,
+                                      &request.headers);
+      if (IsSupportedDnrRedirect(instruction.redirect_url)) {
+        // Changing ResourceRequest.url before the network factory sees it is a
+        // true internal redirect: method/body survive, unlike a synthesized
+        // 302.
+        request.url = instruction.redirect_url;
+      }
+    }
+#else
+    const bool pass_through = false;
+#endif
+
+    if (resp.is_null() || pass_through) {
+      if (!target_factory_) {
+        return;
+      }
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+      const bool observe_request = AnyWebRequestListeners();
+      const bool track_auth_metadata = AnyWebRequestAuthListeners();
+      // Keep the response-stage DNR callback installed even when webRequest has no listeners;
+      // responseHeaders/excludedResponseHeaders cannot be resolved before network headers arrive.
+      if (request.url.SchemeIsHTTPOrHTTPS()) {
+        WebRequestInfo info;
+        info.request_id = NextWebRequestId();
+        info.url = request.url;
+        info.method = request.method;
+        info.type = DnrResourceType(request, is_main_frame_doc);
+        info.tab_id = tab_id_;
+        info.frame_id = frame_id_;
+        info.parent_frame_id = parent_frame_id_;
+        info.document_id = document_id_;
+        info.parent_document_id = parent_document_id_;
+        info.document_lifecycle = document_lifecycle_;
+        info.frame_type = frame_type_;
+        info.initiator = request.request_initiator
+                             ? request.request_initiator->Serialize()
+                             : "null";
+        info.incognito = partition_ == "incognito";
+        info.is_cors_preflight =
+            request.method == "OPTIONS" &&
+            request.headers.HasHeader("Access-Control-Request-Method");
+        std::vector<std::pair<std::string, std::string>> request_headers;
+        for (const auto &header : request.headers.GetHeaderVector()) {
+          request_headers.emplace_back(header.key, header.value);
+        }
+        std::optional<base::DictValue> request_body;
+        if (observe_request && AnyWebRequestBodyListeners()) {
+          request_body = SnapshotWebRequestBody(request);
+        }
+        if (observe_request) {
+          DispatchWebRequestBeforeRequest(info, request_body ? &*request_body
+                                                             : nullptr);
+          DispatchWebRequestBeforeSendHeaders(info, request_headers);
+          DispatchWebRequestSendHeaders(info, request_headers);
+        }
+        if (track_auth_metadata) {
+          RegisterWebRequestMetadata(originating_process_id_, request_id, info);
+        }
+        client = ArupaObservingURLLoader::Wrap(
+            std::move(info), originating_process_id_, request_id,
+            observe_request, track_auth_metadata, std::move(request_body),
+            std::move(request_headers), std::move(instruction.response_headers),
+            java_delegate_, frame_tree_node_id_, parent_frame_tree_node_id_,
+            request, options, traffic_annotation, CloneTargetFactoryForRestart(),
+            &loader, std::move(client));
+      }
+#endif
+      if (request.url.SchemeIs(extensions::kExtensionScheme)) {
+        mojo::Remote<network::mojom::URLLoaderFactory> extension_factory(
+            CreateExtensionURLLoaderFactory());
+        extension_factory->CreateLoaderAndStart(
+            std::move(loader), request_id, options, request, std::move(client),
+            traffic_annotation);
+      } else if (request.url.SchemeIs(url::kDataScheme)) {
+        ArupaServedResponseLoader::StartData(
+            request.url, request.method, std::move(loader), std::move(client));
+      } else if (request.url.SchemeIsFile()) {
+        content::CreateFileURLLoaderBypassingSecurityChecks(
+            request, std::move(loader), std::move(client), nullptr,
+            /*allow_directory_listing=*/false);
+      } else {
+        target_factory_->CreateLoaderAndStart(
+            std::move(loader), request_id, options, request, std::move(client),
+            traffic_annotation);
+      }
+      return;
+    }
+
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+    if (AnyWebRequestListeners() && request.url.SchemeIsHTTPOrHTTPS()) {
+      WebRequestInfo info;
+      info.request_id = NextWebRequestId();
+      info.url = request.url;
+      info.method = request.method;
+      info.type = DnrResourceType(request, is_main_frame_doc);
+      info.tab_id = tab_id_;
+      info.frame_id = frame_id_;
+      info.parent_frame_id = parent_frame_id_;
+      info.document_id = document_id_;
+      info.parent_document_id = parent_document_id_;
+      info.document_lifecycle = document_lifecycle_;
+      info.frame_type = frame_type_;
+      info.initiator = request.request_initiator
+                           ? request.request_initiator->Serialize()
+                           : "null";
+      info.incognito = partition_ == "incognito";
+      info.is_cors_preflight =
+          request.method == "OPTIONS" &&
+          request.headers.HasHeader("Access-Control-Request-Method");
+      std::vector<std::pair<std::string, std::string>> request_headers;
+      for (const auto &header : request.headers.GetHeaderVector()) {
+        request_headers.emplace_back(header.key, header.value);
+      }
+      std::optional<base::DictValue> request_body;
+      if (AnyWebRequestBodyListeners()) {
+        request_body = SnapshotWebRequestBody(request);
+      }
+      DispatchWebRequestBeforeRequest(info,
+                                      request_body ? &*request_body : nullptr);
+      DispatchWebRequestBeforeSendHeaders(info, request_headers);
+      DispatchWebRequestSendHeaders(info, request_headers);
+      client = ArupaObservingURLLoader::Wrap(
+          std::move(info), originating_process_id_, request_id,
+          /*observe_request=*/true, /*track_auth_metadata=*/false,
+          std::move(request_body), std::move(request_headers), {},
+          java_delegate_, frame_tree_node_id_, parent_frame_tree_node_id_,
+          request, options, traffic_annotation, CloneTargetFactoryForRestart(),
+          &loader, std::move(client));
+    }
+#endif
+    ArupaServedResponseLoader::Start(env, resp, std::move(loader),
+                                     std::move(client));
+  }
+
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override {
+    proxy_receivers_.Add(this, std::move(receiver));
+  }
+
+private:
+  mojo::PendingRemote<network::mojom::URLLoaderFactory>
+  CloneTargetFactoryForRestart() {
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> remote;
+    if (target_factory_) {
+      target_factory_->Clone(remote.InitWithNewPipeAndPassReceiver());
+    }
+    return remote;
+  }
+
+  ArupaProxyingURLLoaderFactory(
+      base::android::ScopedJavaGlobalRef<jobject> java_delegate, int tab_id,
+      std::string partition, int originating_process_id, int frame_id,
+      int parent_frame_id, std::string document_id,
+      std::string parent_document_id, std::string document_lifecycle,
+      std::string frame_type, int frame_tree_node_id,
+      int parent_frame_tree_node_id,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target)
+      : java_delegate_(std::move(java_delegate)), tab_id_(tab_id),
+        partition_(std::move(partition)),
+        originating_process_id_(originating_process_id), frame_id_(frame_id),
+        parent_frame_id_(parent_frame_id), document_id_(std::move(document_id)),
+        parent_document_id_(std::move(parent_document_id)),
+        document_lifecycle_(std::move(document_lifecycle)),
+        frame_type_(std::move(frame_type)),
+        frame_tree_node_id_(frame_tree_node_id),
+        parent_frame_tree_node_id_(parent_frame_tree_node_id) {
+    proxy_receivers_.Add(this, std::move(receiver));
+    proxy_receivers_.set_disconnect_handler(
+        base::BindRepeating(&ArupaProxyingURLLoaderFactory::OnProxyDisconnect,
+                            base::Unretained(this)));
+    target_factory_.Bind(std::move(target));
+    target_factory_.set_disconnect_handler(
+        base::BindOnce(&ArupaProxyingURLLoaderFactory::OnTargetDisconnect,
+                       base::Unretained(this)));
+  }
+
+  ~ArupaProxyingURLLoaderFactory() override = default;
+
+  void OnProxyDisconnect() {
+    if (proxy_receivers_.empty()) {
+      delete this;
+    }
+  }
+
+  void OnTargetDisconnect() {
+    target_factory_.reset();
+    if (proxy_receivers_.empty()) {
+      delete this;
+    }
+  }
+
+  base::android::ScopedJavaGlobalRef<jobject> java_delegate_;
+#if BUILDFLAG(ARUPA_ENABLE_EXTENSIONS)
+  const int tab_id_;
+#else
+  const int tab_id_ = -1;
+#endif
+  const std::string partition_;
+  const int originating_process_id_;
+  const int frame_id_;
+  const int parent_frame_id_;
+  const std::string document_id_;
+  const std::string parent_document_id_;
+  const std::string document_lifecycle_;
+  const std::string frame_type_;
+  const int frame_tree_node_id_;
+  const int parent_frame_tree_node_id_;
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> proxy_receivers_;
+  mojo::Remote<network::mojom::URLLoaderFactory> target_factory_;
+};
