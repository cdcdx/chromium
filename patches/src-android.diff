+base::DictValue RendererHostCapabilityManifestData() {
+  base::DictValue injected;
+  const std::optional<HostRuntimeIdentity> current = ReadHostRuntimeIdentity();
+  base::AutoLock guard(Capabilities().lock);
+  base::ListValue members;
+  if (current && Capabilities().installed &&
+      Capabilities().profile_id == ProfileIdForThisRun() &&
+      Capabilities().account_scope == current->account_scope &&
+      Capabilities().session_epoch == current->session_epoch) {
+    for (const std::string &method : Capabilities().methods) {
+      if (IsRendererHostCapabilityMethod(method)) {
+        members.Append(method);
+      }
+      for (const RendererHostCapabilityDependency &dependency :
+           kRendererHostCapabilityDependencies) {
+        if (dependency.host_method == method) {
+          members.Append(dependency.renderer_member);
+        }
+      }
+    }
+    for (const auto &event_capability : Capabilities().events) {
+      const std::string &event = event_capability.first;
+      if (IsRendererHostCapabilityEvent(event)) {
+        members.Append(event);
+      }
+      if (event == "storage.onChanged") {
+        members.Append("storage.sync.onChanged");
+        members.Append("storage.managed.onChanged");
+      }
+    }
+    injected.Set(kHostCapabilityManifestEpochKey,
+                 base::NumberToString(Capabilities().contract_epoch));
+    injected.Set(kHostCapabilityManifestDigestKey,
+                 Capabilities().contract_digest);
+  }
+  injected.Set(kHostCapabilityManifestMembersKey, std::move(members));
+  return injected;
+}
