+namespace {
+int64_t BumpDocumentGeneration(int frame_tree_node_id) {
+  base::AutoLock guard(Ctx().lock);
+  int64_t &gen = Ctx().frame_doc_generation[frame_tree_node_id];
+  ++gen;
