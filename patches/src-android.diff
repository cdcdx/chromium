+int64_t FrameDocumentGeneration(int frame_tree_node_id) {
+  if (frame_tree_node_id < 0) {
+    return 0;
+  }
+  base::AutoLock guard(Ctx().lock);
+  auto it = Ctx().frame_doc_generation.find(frame_tree_node_id);
+  return it == Ctx().frame_doc_generation.end() ? 0 : it->second;
+}
