+base::DictValue BlockRule(int id, const std::string& url_filter) {
+  base::DictValue action;
+  action.Set("type", "block");
+  base::DictValue condition;
+  condition.Set("urlFilter", url_filter);
+  base::DictValue rule;
+  rule.Set("id", id);
+  rule.Set("action", std::move(action));
+  rule.Set("condition", std::move(condition));
+  return rule;
+}
