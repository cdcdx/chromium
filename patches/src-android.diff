+
+size_t CountDisabledStaticRules(const base::DictValue& rulesets) {
+  size_t total = 0;
+  for (const auto [ruleset_id, value] : rulesets) {
+    (void)ruleset_id;
+    if (const base::ListValue* ids = value.GetIfList()) {
+      std::set<int> unique;
+      for (const base::Value& id : *ids) {
+        unique.insert(id.GetInt());
+      }
+      total += unique.size();
+    }
+  }
+  return total;
+}
+
+// 读一个规则集文件并逐条校验。失败返回 nullopt（调用方据此跳过该规则集）。
+std::optional<StaticRegistry::CachedRuleset> LoadRulesetFile(
+    const std::string& extension_id,
+    const StaticRulesetInfo& info) {
+  base::FilePath dir;
+  {
+    base::AutoLock guard(Statics().lock);
+    auto it = Statics().dirs.find(extension_id);
+    if (it == Statics().dirs.end()) {
+      return std::nullopt;
+    }
+    dir = it->second;
+  }
+  const base::FilePath path =
+      dir.Append(base::FilePath::FromUTF8Unsafe(info.path));
+  if (!dir.IsParent(path)) {
+    LOG(WARNING) << "[arupa][dnr] 规则集路径越界, 跳过 id=" << info.id
+                 << " path=" << info.path;
+    return std::nullopt;
+  }
+  const base::TimeTicks began = base::TimeTicks::Now();
+  std::string raw;
+  if (!base::ReadFileToString(path, &raw)) {
+    LOG(WARNING) << "[arupa][dnr] 规则集文件读不到, 跳过 id=" << info.id
+                 << " path=" << info.path;
+    return std::nullopt;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(raw, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_list()) {
+    LOG(WARNING) << "[arupa][dnr] 规则集不是 JSON 数组, 跳过 id=" << info.id;
+    return std::nullopt;
+  }
+  if (parsed->GetList().size() > static_cast<size_t>(kMaxStaticRules)) {
+    LOG(WARNING) << "[arupa][dnr] 单个静态规则集超过可索引上限, 整集跳过 id="
+                 << info.id << " count=" << parsed->GetList().size()
+                 << " limit=" << kMaxStaticRules << " ext=" << extension_id;
+    return std::nullopt;
+  }
+  // 逐条校验。与上游一致：**跳过**不合法的规则而不是让整个规则集失效 ——
+  // AdBlockPlus 这类包的规则集里混着 regex 规则，整集丢弃会让其余几万条
+  // 本来能用的规则一起不生效。跳过了多少条要明说（不能假装它们生效了）。
+  base::ListValue kept;
+  int skipped = 0;
+  int regex_kept = 0;
+  std::set<int> rule_ids;
+  for (auto& item : std::move(*parsed).TakeList()) {
+    const base::DictValue* rule = item.GetIfDict();
+    if (!rule) {
+      ++skipped;
+      continue;
+    }
+    if (!ValidateRule(*rule).empty()) {
+      ++skipped;
+      continue;
+    }
+    const std::optional<int> rule_id = rule->FindInt("id");
+    if (!rule_id || !rule_ids.insert(*rule_id).second) {
+      ++skipped;
+      continue;
+    }
+    // 正则规则限量(宿主侧无 host 预筛, 逐条跑正则)。
+    if (RuleUsesRegex(*rule)) {
+      if (regex_kept >= kMaxRegexRules) {
+        ++skipped;
+        continue;
+      }
+      ++regex_kept;
+    }
+    kept.Append(std::move(item));
+  }
+  LOG(INFO) << "[arupa][dnr] 规则集已读 id=" << info.id
+            << " 可用=" << kept.size() << " (其中 regex=" << regex_kept << ")"
+            << " 跳过=" << skipped
+            << " 耗时=" << (base::TimeTicks::Now() - began).InMilliseconds()
+            << "ms ext=" << extension_id;
+  if (skipped > 0) {
+    LOG(WARNING) << "[arupa][dnr] 规则集 " << info.id << " 有 " << skipped
+                 << " 条规则被跳过(不合法 / 超长正则 / 超出 regex 限量 "
+                 << kMaxRegexRules << ") ext=" << extension_id;
+  }
+  return StaticRegistry::CachedRuleset{std::move(kept), skipped, regex_kept};
+}
+
+std::optional<StaticRegistry::CachedRuleset> GetCachedRuleset(
+    const std::string& extension_id,
+    const StaticRulesetInfo& info) {
+  {
+    base::AutoLock guard(Statics().lock);
+    auto cached = Statics().cache.find(CacheKey(extension_id, info.id));
+    if (cached != Statics().cache.end()) {
+      return StaticRegistry::CachedRuleset{cached->second.rules.Clone(),
+                                           cached->second.skipped_rules,
+                                           cached->second.regex_rules};
+    }
+  }
+  std::optional<StaticRegistry::CachedRuleset> loaded =
+      LoadRulesetFile(extension_id, info);
+  if (!loaded) {
+    return std::nullopt;
+  }
+  {
+    base::AutoLock guard(Statics().lock);
+    auto& cached = Statics().cache[CacheKey(extension_id, info.id)];
+    cached.rules = loaded->rules.Clone();
+    cached.skipped_rules = loaded->skipped_rules;
+    cached.regex_rules = loaded->regex_rules;
+  }
+  return loaded;
+}
+
+size_t StaticRuleLimitForExtension(const std::string& extension_id) {
+  base::AutoLock guard(Statics().lock);
+  size_t used_by_others = 0;
+  for (const auto& [id, allocation] : Statics().global_allocations) {
+    if (id != extension_id) {
+      used_by_others += allocation;
+    }
+  }
+  const size_t shared_available =
+      used_by_others >= static_cast<size_t>(kGlobalStaticRulePool)
+          ? 0u
+          : static_cast<size_t>(kGlobalStaticRulePool) - used_by_others;
+  return static_cast<size_t>(kGuaranteedMinimumStaticRules) +
+         shared_available;
+}
+
+void CommitStaticRuleAllocation(const std::string& extension_id,
+                                size_t indexed_rule_count) {
+  const size_t allocation =
+      indexed_rule_count > static_cast<size_t>(kGuaranteedMinimumStaticRules)
+          ? indexed_rule_count -
+                static_cast<size_t>(kGuaranteedMinimumStaticRules)
+          : 0u;
+  base::AutoLock guard(Statics().lock);
+  Statics().global_allocations[extension_id] = allocation;
+}
+
+std::optional<std::string> ValidateEnabledStaticRuleBudgets(
+    const std::string& extension_id,
+    const std::vector<std::string>& enabled_ids) {
+  const std::vector<StaticRulesetInfo> declared =
+      ListStaticRulesets(extension_id);
+  size_t indexed_total = 0;
+  int regex_total = 0;
+  const size_t static_rule_limit = StaticRuleLimitForExtension(extension_id);
+  for (const std::string& id : enabled_ids) {
+    auto info = std::ranges::find(declared, id, &StaticRulesetInfo::id);
+    if (info == declared.end()) {
+      return "Invalid ruleset id: " + id;
+    }
+    std::optional<StaticRegistry::CachedRuleset> ruleset =
+        GetCachedRuleset(extension_id, *info);
+    if (!ruleset) {
+      return "Failed to load ruleset: " + id;
+    }
+    indexed_total += ruleset->rules.size();
+    regex_total += ruleset->regex_rules;
+    if (indexed_total > static_rule_limit) {
+      return "Number of enabled static rules exceeds the available rule count.";
+    }
+    if (regex_total > kMaxRegexRules) {
+      return "Number of enabled static regex rules exceeds the limit of " +
+             base::NumberToString(kMaxRegexRules) + ".";
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+int RegisterStaticRulesets(const std::string& extension_id,
+                           const base::FilePath& extension_dir,
+                           const base::DictValue& manifest) {
+  if (extension_id.empty() || extension_dir.empty()) {
+    return 0;
+  }
+  const base::DictValue* dnr = manifest.FindDict("declarative_net_request");
+  if (!dnr) {
+    return 0;
+  }
+  const base::ListValue* resources = dnr->FindList("rule_resources");
+  if (!resources || resources->empty()) {
+    return 0;
+  }
+  std::vector<StaticRulesetInfo> sets;
+  for (const auto& item : *resources) {
+    const base::DictValue* entry = item.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+    const std::string* id = entry->FindString("id");
+    const std::string* path = entry->FindString("path");
+    if (!id || id->empty() || !path || path->empty()) {
+      LOG(WARNING) << "[arupa][dnr] rule_resources 条目缺 id/path, 跳过 ext="
+                   << extension_id;
+      continue;
+    }
+    if (static_cast<int>(sets.size()) >= kMaxStaticRulesets) {
+      LOG(WARNING) << "[arupa][dnr] rule_resources 超过 " << kMaxStaticRulesets
+                   << " 个, 后面的丢弃 ext=" << extension_id;
+      break;
+    }
+    StaticRulesetInfo info;
+    info.id = *id;
+    info.path = *path;
+    // 上游默认 enabled=true，只有显式写 false 才算默认关闭。
+    info.enabled_by_default = entry->FindBool("enabled").value_or(true);
+    sets.push_back(std::move(info));
+  }
+  if (sets.empty()) {
+    return 0;
+  }
+
+  {
+    base::AutoLock guard(Statics().lock);
+    // 同 id 扩展升级/重载时规则文件可能已变；旧缓存不能跨
+    // 安装代次沿用，否则 updateStaticRules 重建的仍是旧规则快照。
+    auto previous = Statics().sets.find(extension_id);
+    if (previous != Statics().sets.end()) {
+      for (const auto& info : previous->second) {
+        Statics().cache.erase(CacheKey(extension_id, info.id));
+      }
+    }
+    Statics().sets[extension_id] = sets;
+    Statics().dirs[extension_id] = extension_dir;
+  }
+
+  // 升级后已从 manifest 删掉的 ruleset 不应继续占用 5000 条禁用
+  // 额度。损坏的旧值则保留，让 get/update 显式报读取失败，不把
+  // “数据坏了”伪装成“没有禁用规则”。
+  auto disabled = ReadDisabledStaticRules(extension_id);
+  if (!disabled) {
+    LOG(ERROR)
+        << "[arupa][dnr] 旧的静态规则禁用集合损坏, 已保留并拒绝伪装空集 ext="
+        << extension_id;
+  } else {
+    std::vector<std::string> stale;
+    for (const auto [ruleset_id, value] : *disabled) {
+      (void)value;
+      if (std::ranges::find(sets, ruleset_id, &StaticRulesetInfo::id) ==
+          sets.end()) {
+        stale.emplace_back(ruleset_id);
+      }
+    }
+    for (const std::string& ruleset_id : stale) {
+      disabled->Remove(ruleset_id);
+    }
+    if (!stale.empty()) {
+      WriteDisabledStaticRulesAsync(
+          extension_id, *disabled,
+          base::BindOnce(
+              [](std::string id, bool committed) {
+                if (!committed) {
+                  LOG(ERROR)
+                      << "[arupa][dnr] 过期静态规则禁用集合清理落盘失败 ext="
+                      << id;
+                }
+              },
+              extension_id));
+    }
+  }
+
+  // 启用集合：已持久化的以持久化为准（用户运行时切换过），否则按 manifest
+  // 默认。
+  std::vector<std::string> enabled;
+  const StorageReadResult state_read =
+      PluginStorage::Get().GetAllValuesChecked(extension_id);
+  if (state_read.status != StorageWriteResult::kOk) {
+    LOG(ERROR) << "[arupa][dnr] 静态启用集合存储不可读 ext=" << extension_id;
+    return -1;
+  }
+  const auto state =
+      base::JSONReader::ReadDict(state_read.values_json, base::JSON_PARSE_RFC);
+  if (!state) {
+    LOG(ERROR) << "[arupa][dnr] 静态启用集合存储结构损坏 ext=" << extension_id;
+    return -1;
+  }
+  const base::Value* stored = state->Find(kDnrStaticEnabledKey);
+  if (stored) {
+    if (!stored->is_list() || !StringListToVector(stored, &enabled) ||
+        enabled.size() != stored->GetList().size()) {
+      LOG(ERROR) << "[arupa][dnr] 静态启用集合损坏, 不覆盖默认值 ext="
+                 << extension_id;
+      return -1;
+    }
+  } else {
+    for (const auto& s : sets) {
+      if (s.enabled_by_default) {
+        enabled.push_back(s.id);
+      }
+    }
+  }
+  // 过滤掉已经不在 manifest 里的旧 id。
+  std::vector<std::string> valid;
+  for (const auto& id : enabled) {
+    if (std::ranges::find(sets, id, &StaticRulesetInfo::id) != sets.end()) {
+      valid.push_back(id);
+    }
+  }
+  if (static_cast<int>(valid.size()) > kMaxEnabledStaticRulesets) {
+    valid.resize(kMaxEnabledStaticRulesets);
+  }
+  LOG(INFO) << "[arupa][dnr] 静态规则集已登记 ext=" << extension_id
+            << " 声明=" << sets.size() << " 启用=" << valid.size();
+  return static_cast<int>(sets.size());
+}
+
+std::vector<StaticRulesetInfo> ListStaticRulesets(
+    const std::string& extension_id) {
+  base::AutoLock guard(Statics().lock);
+  auto it = Statics().sets.find(extension_id);
+  return it == Statics().sets.end() ? std::vector<StaticRulesetInfo>()
+                                    : it->second;
+}
+
+std::optional<std::vector<std::string>> ReadEnabledRulesetIds(
+    const std::string& extension_id) {
+  const StorageReadResult read =
+      PluginStorage::Get().GetAllValuesChecked(extension_id);
+  if (read.status != StorageWriteResult::kOk) {
+    return std::nullopt;
+  }
+  const auto values =
+      base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC);
+  if (!values) {
+    return std::nullopt;
+  }
+  const base::Value* stored = values->Find(kDnrStaticEnabledKey);
+  std::vector<std::string> out;
+  if (!stored) {
+    for (const auto& info : ListStaticRulesets(extension_id)) {
+      if (info.enabled_by_default) {
+        out.push_back(info.id);
+      }
+    }
+    return out;
+  }
+  if (!StringListToVector(stored, &out) || !stored->is_list() ||
+      out.size() != stored->GetList().size()) {
+    return std::nullopt;
+  }
+  const auto declared = ListStaticRulesets(extension_id);
+  if (!declared.empty()) {
+    out.erase(std::remove_if(out.begin(), out.end(),
+                             [&](const std::string& id) {
+                               return std::ranges::find(
+                                          declared, id,
+                                          &StaticRulesetInfo::id) ==
+                                      declared.end();
+                             }),
+              out.end());
+  }
+  return out;
+}
+
+std::vector<std::string> GetEnabledRulesetIds(const std::string& extension_id) {
+  return ReadEnabledRulesetIds(extension_id)
+      .value_or(std::vector<std::string>());
+}
+
+bool ReplaceEnabledRulesetIds(const std::string& extension_id,
+                              const std::vector<std::string>& enabled_ids) {
+  if (extension_id.empty()) {
+    return false;
+  }
+  base::ListValue list;
+  for (const std::string& id : enabled_ids) {
+    list.Append(id);
+  }
+  std::optional<std::string> json = base::WriteJson(list);
+  return json &&
+         PluginStorage::Get().SetValue(extension_id, kDnrStaticEnabledKey,
+                                       *json) == StorageWriteResult::kOk;
+}
+
+void ReplaceEnabledRulesetIdsAsync(const std::string& extension_id,
+                                   const std::vector<std::string>& enabled_ids,
+                                   DnrStorageCallback callback) {
+  if (extension_id.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  base::ListValue list;
+  for (const std::string& id : enabled_ids) {
+    list.Append(id);
+  }
+  std::optional<std::string> json = base::WriteJson(list);
+  if (!json) {
+    std::move(callback).Run(false);
+    return;
+  }
+  PluginStorage::Get().SetValuesAsync(
+      extension_id, {{kDnrStaticEnabledKey, std::move(*json)}},
+      base::BindOnce(
+          [](DnrStorageCallback done, StorageCommitResult result) {
+            std::move(done).Run(result.status == StorageWriteResult::kOk);
+          },
+          std::move(callback)));
+}
+
+namespace {
+RulesetUpdateOutcome PrepareEnabledRulesets(
+    const std::string& extension_id,
+    const std::vector<std::string>& enable_ids,
+    const std::vector<std::string>& disable_ids) {
+  RulesetUpdateOutcome out;
+  if (extension_id.empty()) {
+    out.error = "updateEnabledRulesets: 扩展 id 为空";
+    return out;
+  }
+  const std::vector<StaticRulesetInfo> declared =
+      ListStaticRulesets(extension_id);
+  if (declared.empty()) {
+    out.error =
+        "updateEnabledRulesets: 这个扩展没有声明任何静态规则集"
+        "(manifest 的 declarative_net_request.rule_resources)";
+    return out;
+  }
+  auto known = [&](const std::string& id) {
+    return std::ranges::find(declared, id, &StaticRulesetInfo::id) !=
+           declared.end();
+  };
+  for (const auto& id : enable_ids) {
+    if (!known(id)) {
+      out.error = "Invalid ruleset id: " + id;
+      return out;
+    }
+  }
+  for (const auto& id : disable_ids) {
+    if (!known(id)) {
+      out.error = "Invalid ruleset id: " + id;
+      return out;
+    }
+  }
+
+  const auto stored = ReadEnabledRulesetIds(extension_id);
+  if (!stored) {
+    out.error = "updateEnabledRulesets: 已存启用集合不可读";
+    out.storage_error = true;
+    return out;
+  }
+  std::vector<std::string> current = *stored;
+  std::vector<std::string> next;
+  for (const auto& id : current) {
+    if (std::ranges::find(disable_ids, id) == disable_ids.end()) {
+      next.push_back(id);
+    }
+  }
+  for (const auto& id : enable_ids) {
+    if (std::ranges::find(next, id) == next.end()) {
+      next.push_back(id);
+    }
+  }
+  if (static_cast<int>(next.size()) > kMaxEnabledStaticRulesets) {
+    out.error = "Number of enabled rulesets exceeds the limit of " +
+                base::NumberToString(kMaxEnabledStaticRulesets) + ".";
+    return out;
+  }
+  if (const std::optional<std::string> budget_error =
+          ValidateEnabledStaticRuleBudgets(extension_id, next)) {
+    out.error = *budget_error;
+    return out;
+  }
+
+  out.ok = true;
+  out.enabled = std::move(next);
+  return out;
+}
+}  // namespace
+
+RulesetUpdateOutcome UpdateEnabledRulesets(
+    const std::string& extension_id,
+    const std::vector<std::string>& enable_ids,
+    const std::vector<std::string>& disable_ids) {
+  RulesetUpdateOutcome out =
+      PrepareEnabledRulesets(extension_id, enable_ids, disable_ids);
+  if (!out.ok) {
+    return out;
+  }
+  if (!ReplaceEnabledRulesetIds(extension_id, out.enabled)) {
+    out.ok = false;
+    out.storage_error = true;
+    out.error = "updateEnabledRulesets: 序列化或存储接受失败";
+    return out;
+  }
+  LOG(INFO) << "[arupa][dnr] 静态规则集启用集合已更新 ext=" << extension_id
+            << " 启用=" << out.enabled.size();
+  return out;
+}
+
+void UpdateEnabledRulesetsAsync(const std::string& extension_id,
+                                const std::vector<std::string>& enable_ids,
+                                const std::vector<std::string>& disable_ids,
+                                RulesetUpdateCallback callback) {
+  RulesetUpdateOutcome out =
+      PrepareEnabledRulesets(extension_id, enable_ids, disable_ids);
+  if (!out.ok) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  base::ListValue list;
+  for (const std::string& id : out.enabled) {
+    list.Append(id);
+  }
+  std::optional<std::string> json = base::WriteJson(list);
+  if (!json) {
+    out.ok = false;
+    out.error = "updateEnabledRulesets: 序列化失败";
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  PluginStorage::Get().SetValuesAsync(
+      extension_id, {{kDnrStaticEnabledKey, std::move(*json)}},
+      base::BindOnce(
+          [](RulesetUpdateOutcome outcome, RulesetUpdateCallback done,
+             StorageCommitResult result) {
+            if (result.status != StorageWriteResult::kOk) {
+              outcome.ok = false;
+              outcome.storage_error = true;
+              outcome.error = std::string("updateEnabledRulesets: ") +
+                              StorageWriteResultMessage(result.status);
+            }
+            std::move(done).Run(std::move(outcome));
+          },
+          std::move(out), std::move(callback)));
+}
+
+std::vector<int> GetDisabledStaticRuleIds(const std::string& extension_id,
+                                          const std::string& ruleset_id,
+                                          std::string* error) {
+  if (!HasStaticRuleset(extension_id, ruleset_id)) {
+    if (error) {
+      *error = "Invalid ruleset id: " + ruleset_id;
+    }
+    return {};
+  }
+  auto stored = ReadDisabledStaticRules(extension_id);
+  if (!stored) {
+    if (error) {
+      *error = "disabled static rule storage is corrupted";
+    }
+    return {};
+  }
+  const base::ListValue* ids = stored->FindList(ruleset_id);
+  if (!ids) {
+    return {};
+  }
+  std::set<int> unique;
+  for (const base::Value& value : *ids) {
+    unique.insert(value.GetInt());
+  }
+  return std::vector<int>(unique.begin(), unique.end());
+}
+
+bool ReplaceDisabledStaticRuleIds(const std::string& extension_id,
+                                  const std::string& ruleset_id,
+                                  const std::vector<int>& disabled_rule_ids) {
+  if (extension_id.empty() || ruleset_id.empty()) {
+    return false;
+  }
+  auto stored = ReadDisabledStaticRules(extension_id);
+  if (!stored) {
+    return false;
+  }
+  if (disabled_rule_ids.empty()) {
+    stored->Remove(ruleset_id);
+  } else {
+    base::ListValue ids;
+    std::set<int> unique(disabled_rule_ids.begin(), disabled_rule_ids.end());
+    for (int id : unique) {
+      ids.Append(id);
+    }
+    stored->Set(ruleset_id, std::move(ids));
+  }
+  return WriteDisabledStaticRules(extension_id, *stored);
+}
+
+void ReplaceDisabledStaticRuleIdsAsync(
+    const std::string& extension_id,
+    const std::string& ruleset_id,
+    const std::vector<int>& disabled_rule_ids,
+    DnrStorageCallback callback) {
+  if (extension_id.empty() || ruleset_id.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto stored = ReadDisabledStaticRules(extension_id);
+  if (!stored) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (disabled_rule_ids.empty()) {
+    stored->Remove(ruleset_id);
+  } else {
+    base::ListValue ids;
+    std::set<int> unique(disabled_rule_ids.begin(), disabled_rule_ids.end());
+    for (int id : unique) {
+      ids.Append(id);
+    }
+    stored->Set(ruleset_id, std::move(ids));
+  }
+  WriteDisabledStaticRulesAsync(extension_id, *stored, std::move(callback));
+}
+
+namespace {
+struct PreparedStaticRuleUpdate {
+  StaticRuleUpdateOutcome outcome;
+  std::optional<base::DictValue> stored;
+};
+
+PreparedStaticRuleUpdate PrepareStaticRules(
+    const std::string& extension_id,
+    const std::string& ruleset_id,
+    const std::vector<int>& disable_rule_ids,
+    const std::vector<int>& enable_rule_ids) {
+  PreparedStaticRuleUpdate prepared;
+  StaticRuleUpdateOutcome& out = prepared.outcome;
+  std::string read_error;
+  const std::vector<int> current =
+      GetDisabledStaticRuleIds(extension_id, ruleset_id, &read_error);
+  if (!read_error.empty()) {
+    out.storage_error =
+        read_error == "disabled static rule storage is corrupted";
+    out.error = std::move(read_error);
+    return prepared;
+  }
+
+  std::set<int> disabled(current.begin(), current.end());
+  const std::set<int> requested_disabled(disable_rule_ids.begin(),
+                                         disable_rule_ids.end());
+  for (int id : enable_rule_ids) {
+    if (!requested_disabled.contains(id)) {
+      disabled.erase(id);
+    }
+  }
+  disabled.insert(requested_disabled.begin(), requested_disabled.end());
+  out.disabled.assign(disabled.begin(), disabled.end());
+  out.changed = out.disabled != current;
+  if (!out.changed) {
+    out.ok = true;
+    return prepared;
+  }
+
+  auto stored = ReadDisabledStaticRules(extension_id);
+  if (!stored) {
+    out.storage_error = true;
+    out.error = "disabled static rule storage is corrupted";
+    return prepared;
+  }
+  base::ListValue ids;
+  for (int id : out.disabled) {
+    ids.Append(id);
+  }
+  if (ids.empty()) {
+    stored->Remove(ruleset_id);
+  } else {
+    stored->Set(ruleset_id, std::move(ids));
+  }
+  if (CountDisabledStaticRules(*stored) >
+      static_cast<size_t>(kMaxDisabledStaticRules)) {
+    out.error =
+        "The number of disabled static rules exceeds the disabled rule count "
+        "limit.";
+    return prepared;
+  }
+  out.ok = true;
+  prepared.stored = std::move(*stored);
+  return prepared;
+}
+}  // namespace
+
+StaticRuleUpdateOutcome UpdateStaticRules(
+    const std::string& extension_id,
+    const std::string& ruleset_id,
+    const std::vector<int>& disable_rule_ids,
+    const std::vector<int>& enable_rule_ids) {
+  PreparedStaticRuleUpdate prepared = PrepareStaticRules(
+      extension_id, ruleset_id, disable_rule_ids, enable_rule_ids);
+  StaticRuleUpdateOutcome out = std::move(prepared.outcome);
+  if (!out.ok || !out.changed) {
+    return out;
+  }
+  if (!WriteDisabledStaticRules(extension_id, *prepared.stored)) {
+    out.ok = false;
+    out.storage_error = true;
+    out.error = "failed to persist disabled static rules";
+    return out;
+  }
+  LOG(INFO) << "[arupa][dnr] 静态规则禁用集合已更新 ext=" << extension_id
+            << " ruleset=" << ruleset_id << " disabled=" << out.disabled.size();
+  return out;
+}
+
+void UpdateStaticRulesAsync(const std::string& extension_id,
+                            const std::string& ruleset_id,
+                            const std::vector<int>& disable_rule_ids,
+                            const std::vector<int>& enable_rule_ids,
+                            StaticRuleUpdateCallback callback) {
+  PreparedStaticRuleUpdate prepared = PrepareStaticRules(
+      extension_id, ruleset_id, disable_rule_ids, enable_rule_ids);
+  if (!prepared.outcome.ok || !prepared.outcome.changed) {
+    std::move(callback).Run(std::move(prepared.outcome));
+    return;
+  }
+  WriteDisabledStaticRulesAsync(
+      extension_id, *prepared.stored,
+      base::BindOnce(
+          [](StaticRuleUpdateOutcome outcome, StaticRuleUpdateCallback done,
+             bool committed) {
+            if (!committed) {
+              outcome.ok = false;
+              outcome.storage_error = true;
+              outcome.error = "failed to persist disabled static rules";
+            }
+            std::move(done).Run(std::move(outcome));
+          },
+          std::move(prepared.outcome), std::move(callback)));
+}
+
+namespace {
+DnrSnapshotResult BuildStaticRulesSnapshot(const std::string& extension_id) {
+  base::AutoLock snapshot_guard(Statics().snapshot_lock);
+  DnrSnapshotResult result;
+  if (extension_id.empty()) {
+    result.error_code = "DNR_EXTENSION_ID_EMPTY";
+    return result;
+  }
+  const std::vector<StaticRulesetInfo> declared =
+      ListStaticRulesets(extension_id);
+  result.declared_rulesets = static_cast<int>(declared.size());
+  const StorageReadResult read =
+      PluginStorage::Get().GetAllValuesChecked(extension_id);
+  if (read.status != StorageWriteResult::kOk) {
+    result.error_code = "DNR_STORAGE_UNREADABLE";
+    return result;
+  }
+  std::optional<base::DictValue> state =
+      base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC);
+  if (!state) {
+    result.error_code = "DNR_STORAGE_UNREADABLE";
+    return result;
+  }
+  std::vector<std::string> enabled;
+  if (const base::Value* stored = state->Find(kDnrStaticEnabledKey)) {
+    const base::ListValue* list = stored->GetIfList();
+    if (!list) {
+      result.error_code = "DNR_ENABLED_RULESETS_CORRUPT";
+      return result;
+    }
+    for (const base::Value& item : *list) {
+      const std::string* id = item.GetIfString();
+      if (!id) {
+        result.error_code = "DNR_ENABLED_RULESETS_CORRUPT";
+        return result;
+      }
+      enabled.push_back(*id);
+    }
+  } else {
+    for (const auto& info : declared) {
+      if (info.enabled_by_default) {
+        enabled.push_back(info.id);
+      }
+    }
+  }
+  result.enabled_rulesets = static_cast<int>(enabled.size());
+  base::ListValue merged;
+  int active_total = 0;
+  int indexed_total = 0;
+  int regex_total = 0;
+  const size_t static_rule_limit = StaticRuleLimitForExtension(extension_id);
+  for (const auto& id : enabled) {
+    auto it = std::ranges::find(declared, id, &StaticRulesetInfo::id);
+    if (it == declared.end()) {
+      result.error_code = "DNR_ENABLED_RULESET_MISSING";
+      result.error_ruleset_id = id;
+      return result;
+    }
+    std::optional<StaticRegistry::CachedRuleset> loaded =
+        GetCachedRuleset(extension_id, *it);
+    if (!loaded) {
+      result.error_code = "DNR_RULESET_UNREADABLE";
+      result.error_ruleset_id = id;
+      return result;
+    }
+    StaticRegistry::CachedRuleset loaded_rules = std::move(*loaded);
+    result.skipped_rules += loaded_rules.skipped_rules;
+    const int next_indexed_total =
+        indexed_total + static_cast<int>(loaded_rules.rules.size());
+    const int next_regex_total = regex_total + loaded_rules.regex_rules;
+    // 启动/重载时与 Chromium 一致：按 manifest 顺序优先保留较早的完整
+    // ruleset，跨过共享规则池或累计 regex 上限的整个 ruleset 不装载。
+    // 不能截断 ruleset，否则扩展看到“已启用”却只有其中一部分规则生效。
+    if (static_cast<size_t>(next_indexed_total) > static_rule_limit ||
+        next_regex_total > kMaxRegexRules) {
+      result.truncated = true;
+      LOG(WARNING) << "[arupa][dnr] 静态规则集因累计预算未装载 id=" << id
+                   << " indexed=" << next_indexed_total << "/"
+                   << static_rule_limit << " regex=" << next_regex_total
+                   << "/" << kMaxRegexRules << " ext=" << extension_id;
+      continue;
+    }
+    indexed_total = next_indexed_total;
+    regex_total = next_regex_total;
+    ++result.loaded_rulesets;
+    std::string disabled_error;
+    const std::vector<int> disabled_ids =
+        GetDisabledStaticRuleIds(extension_id, id, &disabled_error);
+    if (!disabled_error.empty()) {
+      result.error_code = "DNR_DISABLED_RULES_CORRUPT";
+      result.error_ruleset_id = id;
+      return result;
+    }
+    result.disabled_rules += static_cast<int>(disabled_ids.size());
+    const std::set<int> disabled(disabled_ids.begin(), disabled_ids.end());
+    const int ruleset_priority =
+        static_cast<int>(std::distance(declared.begin(), it)) + 1;
+    base::ListValue active;
+    for (auto& rule : loaded_rules.rules) {
+      base::DictValue* dict = rule.GetIfDict();
+      const std::optional<int> rule_id =
+          dict ? dict->FindInt("id") : std::nullopt;
+      if (!rule_id || !disabled.contains(*rule_id)) {
+        if (dict) {
+          // 仅进入宿主执行快照的私有元数据；扩展查询 API 不返回静态规则内容。
+          // 命中反馈借它区分不同静态 ruleset 内可重复的 rule id。
+          dict->Set("_arupaRulesetId", id);
+          // Chromium 用 manifest 顺序生成递增的内部 RulesetID；同优先级、
+          // 同动作规则由更大的 RulesetID 决胜。
+          dict->Set("_arupaRulesetPriority", ruleset_priority);
+        }
+        active.Append(std::move(rule));
+      }
+    }
+    for (auto& rule : active) {
+      merged.Append(std::move(rule));
+    }
+    active_total += static_cast<int>(active.size());
+  }
+  std::optional<std::string> json = base::WriteJson(merged);
+  if (!json) {
+    result.error_code = "DNR_SERIALIZATION_FAILED";
+    return result;
+  }
+  result.ok = true;
+  result.rules_json = std::move(*json);
+  result.indexed_rule_count = indexed_total;
+  result.rule_count = active_total;
+  CommitStaticRuleAllocation(extension_id,
+                             static_cast<size_t>(indexed_total));
+  return result;
+}
+}  // namespace
+
+std::string GetStaticRulesJson(const std::string& extension_id) {
+  DnrSnapshotResult result = BuildStaticRulesSnapshot(extension_id);
+  return result.ok ? result.rules_json : "[]";
+}
+
+int GetAvailableStaticRuleCount(const std::string& extension_id) {
+  const DnrSnapshotResult snapshot = BuildStaticRulesSnapshot(extension_id);
+  if (!snapshot.ok) {
+    return -1;
+  }
+  const size_t own_enabled =
+      static_cast<size_t>(snapshot.indexed_rule_count);
+  size_t global_used = 0;
+  size_t own_allocation = 0;
+  {
+    base::AutoLock guard(Statics().lock);
+    for (const auto& [id, allocation] : Statics().global_allocations) {
+      global_used += allocation;
+      if (id == extension_id) {
+        own_allocation = allocation;
+      }
+    }
+  }
+  const size_t unallocated =
+      global_used >= static_cast<size_t>(kGlobalStaticRulePool)
+          ? 0u
+          : static_cast<size_t>(kGlobalStaticRulePool) - global_used;
+  const size_t available_allocation = unallocated + own_allocation;
+  const size_t guaranteed_free =
+      own_enabled >= static_cast<size_t>(kGuaranteedMinimumStaticRules)
+          ? 0u
+          : static_cast<size_t>(kGuaranteedMinimumStaticRules) - own_enabled;
+  const size_t used_global =
+      own_enabled > static_cast<size_t>(kGuaranteedMinimumStaticRules)
+          ? own_enabled - static_cast<size_t>(kGuaranteedMinimumStaticRules)
+          : 0u;
+  const size_t available = guaranteed_free +
+                           (available_allocation >= used_global
+                                ? available_allocation - used_global
+                                : 0u);
+  return static_cast<int>(std::min(
+      available, static_cast<size_t>(std::numeric_limits<int>::max())));
+}
+
+DnrSnapshotResult BuildEffectiveRulesSnapshot(const std::string& extension_id) {
+  DnrSnapshotResult result = BuildStaticRulesSnapshot(extension_id);
+  if (!result.ok) {
+    return result;
+  }
+  if (!DynamicRulesStorageIntact(extension_id)) {
+    result.ok = false;
+    result.error_code = "DNR_DYNAMIC_STORAGE_UNREADABLE";
+    result.rules_json.clear();
+    return result;
+  }
+  base::ListValue merged;
+  auto append = [&](const std::string& json, const char* fallback_ruleset_id,
+                    int fallback_ruleset_priority) -> bool {
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+    if (!parsed || !parsed->is_list()) {
+      return false;
+    }
+    for (auto& item : std::move(*parsed).TakeList()) {
+      if (base::DictValue* rule = item.GetIfDict()) {
+        if (!rule->FindString("_arupaRulesetId")) {
+          rule->Set("_arupaRulesetId", fallback_ruleset_id);
+        }
+        if (!rule->FindInt("_arupaRulesetPriority")) {
+          rule->Set("_arupaRulesetPriority", fallback_ruleset_priority);
+        }
+      }
+      merged.Append(std::move(item));
+    }
+    return true;
+  };
+  if (!append(result.rules_json, "_static", 1) ||
+      !append(GetDynamicRulesJson(extension_id), "_dynamic", 0) ||
+      !append(GetSessionRulesJson(extension_id), "_session", -1)) {
+    result.ok = false;
+    result.error_code = "DNR_SNAPSHOT_INVALID";
+    result.rules_json.clear();
+    return result;
+  }
+  std::optional<std::string> json = base::WriteJson(merged);
+  if (!json) {
+    result.ok = false;
+    result.error_code = "DNR_SERIALIZATION_FAILED";
+    result.rules_json.clear();
+    return result;
+  }
+  result.rule_count = static_cast<int>(merged.size());
+  result.rules_json = std::move(*json);
+  return result;
+}
+
+DnrHostRequest BuildDnrHostRequest(const std::string& extension_id,
+                                   const std::string& rules_json,
+                                   int rule_count,
+                                   bool remove,
+                                   int64_t install_generation,
+                                   const DnrHostAccessPolicy& access_policy) {
+  DnrHostRequest out;
+  const std::optional<base::Value> rules =
+      base::JSONReader::Read(rules_json, base::JSON_PARSE_RFC);
+  if (extension_id.empty() || !rules || !rules->is_list() || rule_count < 0 ||
+      install_generation < 0 ||
+      static_cast<size_t>(rule_count) != rules->GetList().size() ||
+      (remove && rule_count != 0)) {
+    return out;
+  }
+  static const base::NoDestructor<std::string> kernel_epoch(
+      base::Uuid::GenerateRandomV4().AsLowercaseString());
+  static std::atomic<int64_t> next_serial{0};
+  out.receipt.extension_id = extension_id;
+  out.receipt.partition = "regular";
+  out.receipt.operation = remove ? "remove" : "apply";
+  out.receipt.kernel_epoch = *kernel_epoch;
+  out.receipt.operation_serial =
+      base::NumberToString(next_serial.fetch_add(1) + 1);
+  out.receipt.rules_sha256 = base::HexEncode(crypto::SHA256HashString(rules_json));
+  out.receipt.rule_count = rule_count;
+  base::DictValue payload;
+  payload.Set("contractVersion", 2);
+  payload.Set("operation", out.receipt.operation);
+  payload.Set("extensionId", out.receipt.extension_id);
+  payload.Set("partition", out.receipt.partition);
+  payload.Set("kernelEpoch", out.receipt.kernel_epoch);
+  payload.Set("operationSerial", out.receipt.operation_serial);
+  payload.Set("installGeneration", base::NumberToString(install_generation));
+  payload.Set("hostPermissionsAlwaysRequired",
+              access_policy.host_permissions_always_required);
+  payload.Set("allowFileAccess", access_policy.allow_file_access);
+  payload.Set("feedbackPermission", access_policy.feedback_permission);
+  const auto strings = [](const std::vector<std::string>& values) {
+    base::ListValue list;
+    for (const std::string& value : values) {
+      list.Append(value);
+    }
+    return list;
+  };
+  payload.Set("hostPermissions", strings(access_policy.host_permissions));
+  payload.Set("withheldHostPermissions",
+              strings(access_policy.withheld_host_permissions));
+  payload.Set("blockedHostPermissions",
+              strings(access_policy.blocked_host_permissions));
+  payload.Set("allowedHostPermissions",
+              strings(access_policy.allowed_host_permissions));
+  base::DictValue tab_permissions;
+  for (const auto& [tab_id, patterns] :
+       access_policy.tab_host_permissions) {
+    tab_permissions.Set(base::NumberToString(tab_id), strings(patterns));
+  }
+  payload.Set("tabHostPermissions", std::move(tab_permissions));
+  base::ListValue feedback_tabs;
+  for (int tab_id : access_policy.feedback_tab_ids) {
+    feedback_tabs.Append(tab_id);
+  }
+  payload.Set("feedbackTabIds", std::move(feedback_tabs));
+  payload.Set("rulesSha256", out.receipt.rules_sha256);
+  payload.Set("ruleCount", rule_count);
+  payload.Set("rulesJson", rules_json);
+  base::ListValue args;
+  args.Append(std::move(payload));
+  out.ok = base::JSONWriter::Write(base::Value(std::move(args)), &out.args_json);
+  return out;
+}
+
+static bool DnrReceiptMatches(const std::string& receipt_json,
+                       const std::string& host_error,
+                       const DnrHostReceiptExpectation& expected,
+                       const char* expected_state,
+                       std::string* reason) {
+  if (!host_error.empty()) {
+    *reason = host_error;
+    return false;
+  }
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(receipt_json, base::JSON_PARSE_RFC);
+  const base::ListValue* list =
+      parsed && parsed->is_list() ? &parsed->GetList() : nullptr;
+  const base::DictValue* receipt =
+      list && list->size() == 1 ? (*list)[0].GetIfDict() : nullptr;
+  const std::string* active =
+      receipt ? receipt->FindString("interception") : nullptr;
+  const std::optional<int> count =
+      receipt ? receipt->FindInt("ruleCount") : std::nullopt;
+  const std::optional<int> version =
+      receipt ? receipt->FindInt("contractVersion") : std::nullopt;
+  const std::string* epoch =
+      receipt ? receipt->FindString("kernelEpoch") : nullptr;
+  const std::string* serial =
+      receipt ? receipt->FindString("operationSerial") : nullptr;
+  const std::string* digest =
+      receipt ? receipt->FindString("rulesSha256") : nullptr;
+  const std::string* extension_id =
+      receipt ? receipt->FindString("extensionId") : nullptr;
+  const std::string* partition =
+      receipt ? receipt->FindString("partition") : nullptr;
+  const std::string* operation =
+      receipt ? receipt->FindString("operation") : nullptr;
+  if (!version || *version != 2 || !active || *active != expected_state || !count ||
+      *count < 0 || *count != expected.rule_count || !epoch ||
+      *epoch != expected.kernel_epoch || !serial ||
+      *serial != expected.operation_serial || !digest ||
+      *digest != expected.rules_sha256 || !extension_id ||
+      *extension_id != expected.extension_id || !partition ||
+      *partition != expected.partition || !operation ||
+      *operation != expected.operation) {
+    *reason = "DNR_APPLY_RECEIPT_MISMATCH";
+    return false;
+  }
+  return true;
+}
+
+bool DnrApplyReceiptMatches(const std::string& receipt_json,
+                            const std::string& host_error,
+                            const DnrHostReceiptExpectation& expected,
+                            std::string* reason) {
+  return DnrReceiptMatches(receipt_json, host_error, expected, "active", reason);
+}
+
+bool DnrRemoveReceiptMatches(const std::string& receipt_json,
+                             const std::string& host_error,
+                             const DnrHostReceiptExpectation& expected,
+                             std::string* reason) {
+  return DnrReceiptMatches(receipt_json, host_error, expected, "inactive", reason);
+}
+
+std::string GetEffectiveRulesJson(const std::string& extension_id) {
+  DnrSnapshotResult result = BuildEffectiveRulesSnapshot(extension_id);
+  return result.ok ? result.rules_json : "[]";
+}
+
+void UnregisterStaticRulesets(const std::string& extension_id) {
+  if (extension_id.empty()) {
+    return;
+  }
+  {
+    base::AutoLock guard(Statics().lock);
+    for (const auto& info : Statics().sets[extension_id]) {
+      Statics().cache.erase(CacheKey(extension_id, info.id));
+    }
+    Statics().sets.erase(extension_id);
+    Statics().dirs.erase(extension_id);
+    Statics().global_allocations.erase(extension_id);
+  }
+  LOG(INFO) << "[arupa][dnr] 静态规则集进程登记已撤下 ext=" << extension_id;
+}
+
+void ClearStaticRulesets(const std::string& extension_id) {
+  if (extension_id.empty()) {
+    return;
+  }
+  UnregisterStaticRulesets(extension_id);
+  PluginStorage::Get().RemoveValue(extension_id, kDnrStaticManifestKey);
+  PluginStorage::Get().RemoveValue(extension_id, kDnrStaticEnabledKey);
+  PluginStorage::Get().RemoveValue(extension_id, kDnrStaticDisabledKey);
+  LOG(INFO) << "[arupa][dnr] 静态规则集持久化选择清空已排队 ext="
+            << extension_id;
+}
