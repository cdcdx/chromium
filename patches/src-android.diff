+
+// MV3 动态规则（declarativeNetRequest）的宿主侧权威规则集：校验 → 合并 →
+// 持久化。
+//
+// 分工：内核持有并校验规则（谁改了什么、id
+// 唯一性、限额、查询/更新/移除语义与存储清理），
+// 能否**真的拦住请求**由宿主引擎回执决定（见 plugin/arupa_ext_api_host.cc 的
+// `declarativeNetRequest.*` 路由）。规则落在 PluginStorage 的保留键里 →
+// 清数据/卸载即归零。
+//
+// 未实现的能力必须显式拒绝而不能静默扩大规则。生产 matcher 与这里共享完整动作、
+// 条件、正则和重定向协议；tabIds 仅允许 session rules，与 Chromium 的作用域一致。
+inline constexpr char kDnrDynamicRulesKey[] = "__dnr_dynamic_rules_v1";
+
+// 内核认领的 declarativeNetRequest 方法 —— **唯一权威表**。
+//
+// 三处必须一致，出包门禁 scripts/kernel_capability.py 会把它们逐项比出来：
+//   1. 这张表（内核自认的支持面，也是"不支持的方法"错误文案的来源）；
+//   2. plugin/api/declarative_net_request.json 的 functions（对外声明）；
+//   3. plugin/arupa_ext_api_host.cc 的分发（运行期真正走得到）。
+//
+// 为什么要有这张表：2026-10-13 实测发现
+// getEnabledRulesets/updateEnabledRulesets
+// 的业务实现早就写好（HandleKernelOwnedDnr 里分支齐全），但分发只接了
+// getDynamicRules/updateDynamicRules，于是运行期一律回 "not supported in this
+// browser" —— 静态规则集（逐风净化 62277 条网络规则里的 29403 条 CSS
+// 所在的那些）
+// 因此整条主链被阻断（S-04）。**声明有、实现有、分发没有**这类漏接，只能靠"同一份
+// 事实被三处引用 + 门禁比对"来根治，光加断言是补不住的。
+inline constexpr const char* kSupportedDnrMethods[] = {
+    "getDynamicRules",    "updateDynamicRules",
+    "getSessionRules",    "updateSessionRules",
+    "getEnabledRulesets", "updateEnabledRulesets",
+    "updateStaticRules",  "getDisabledRuleIds",
+    "isRegexSupported",   "getAvailableStaticRuleCount",
+    "getMatchedRules",    "setExtensionActionOptions",
+    "testMatchOutcome",
+};
+
+// 规则 priority 的下限（Chrome 同口径：缺省 1，显式给出时必须 >= 1）。
+// 越界不拒绝的话，客户端按"我设了 9"排布、引擎按 1 排序 ——
+// 又一处"说得出但做不到"。
+inline constexpr int kMinRulePriority = 1;
+
+// 与 Chrome 动态规则同口径的上限。
+//
+// 2026-10-12 从 5000 放宽到 30000（当时沿用旧的 combined 口径）：当时
+// 静态规则集还没解析，AdBlockPlus 这类插件只能把几万条规则塞进 dynamic，5000 条
+// 远远不够，而 UpdateDynamicRules 是原子校验 —— 超限整批拒绝，插件拿到的是"一条
+// 都没生效"。2026-10-13 静态规则集已落地（见下面 kMaxStaticRules
+// 段），但这里**保持 30000
+// 不动**：它已经是发出去的契约数字，插件按它排布规则，缩回来会让既有规则集
+// 突然超限。M154 起 dynamic/session 分别限额，session 见 kMaxSessionRules。
+inline constexpr int kMaxDynamicRules = 30000;
+
+// Chromium M154 已把 dynamic/session 条数预算拆开；旧的 combined 常量已废弃。
+// Android 过去已经把 combined=30000 发出去，schema 继续保留这个废弃兼容值，
+// 真实校验分别使用下面两个当前常量。regex 预算仍按上游在两类间共享。
+inline constexpr int kLegacyMaxDynamicAndSessionRules = 5000;
+inline constexpr int kMaxSessionRules = 5000;
+inline constexpr int kMaxUnsafeDynamicRules = 5000;
+inline constexpr int kMaxUnsafeSessionRules = 5000;
+inline constexpr int kMaxRegexRules = 1000;
+
+// Chromium/Edge 对每条已编译 RE2 程序使用 2 KiB 内存预算，而不是按源码
+// 字符数裁切。源码很短的巨大重复也会超限，长但可压缩的表达式则不应误拒。
+inline constexpr size_t kMaxRegexFilterLength = 2048;  // 旧契约名，值等于字节预算。
+inline constexpr int kDnrRegexMaxMemoryBytes = 2 * 1024;
+
+// ── 静态规则集（manifest 的 declarative_net_request.rule_resources）──────────
+//
+// AdBlockPlus 这类插件的正解：规则随包分发，不入 storage、不占 dynamic 配额。
+// 此前内核**完全不解析** rule_resources，它们只能把几万条规则塞进 dynamic rules
+// （上限 30000 且原子校验），超限就是整批拒绝。
+// 30,000 是“每个扩展保证可用的最低额度”，不是硬上限。M154 另有每 profile
+// 300,000 条共享静态池，因此单扩展规则文件的可接受上界是两者之和。旧实现把
+// GUARANTEED_MINIMUM_STATIC_RULES 当上限，逐风 62,277 条规则会从跨线的整个
+// ruleset 起被静默丢弃。
+inline constexpr int kGuaranteedMinimumStaticRules = 30000;
+inline constexpr int kGlobalStaticRulePool = 300000;
+// 单扩展静态规则硬上限 = 保证可用额度 + 每 profile 共享池。
+// 写成字面量（而非 kGuaranteedMinimumStaticRules + kGlobalStaticRulePool），
+// 否则门禁脚本的 constexpr 常量解析器只认单行字面量、会把 kMaxStaticRules
+// 解析成 None，导致「声明与实现不同源」门禁误拒出包。
+inline constexpr int kMaxStaticRules = 330000;
+inline constexpr int kMaxEnabledStaticRulesets =
+    50;  // MAX_NUMBER_OF_ENABLED_STATIC_RULESETS
+inline constexpr int kMaxStaticRulesets = 100;  // MAX_NUMBER_OF_STATIC_RULESETS
+inline constexpr int kMaxDisabledStaticRules =
+    5000;  // MAX_NUMBER_OF_DISABLED_STATIC_RULES
