+struct ScannedExtension {
+  base::FilePath dir;
+  std::string manifest_json;
+};
+
+std::vector<ScannedExtension> ScanExtensionDirs(const base::FilePath &root) {
+  std::vector<ScannedExtension> out;
+
+  const int64_t rej_token = BeginScanRejections();
+  base::FileEnumerator dirs(root, false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath d = dirs.Next(); !d.empty(); d = dirs.Next()) {
+    ScannedExtension item;
+    if (!base::ReadFileToString(d.AppendASCII("manifest.json"),
+                                &item.manifest_json)) {
+      continue;
+    }
+
+    {
+      std::optional<base::Value> parsed = base::JSONReader::Read(
+          item.manifest_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS |
+                                  base::JSON_ALLOW_TRAILING_COMMAS);
+      if (!parsed || !parsed->is_dict()) {
+        NoteScanRejected(rej_token, d, "manifest.json 不是合法 JSON 对象");
+        continue;
+      }
+      std::string l10n_error;
+      if (!extension_l10n_util::LocalizeExtension(
+              d, &parsed->GetDict(),
+              extension_l10n_util::GetGzippedMessagesPermissionForLocation(
+                  extensions::mojom::ManifestLocation::kUnpacked),
+              &l10n_error)) {
+        LOG(WARNING) << "[arupa][ext] 本地化失败, **拒装**(FB-A057) dir="
+                     << d.AsUTF8Unsafe() << " err=" << l10n_error;
+        NoteScanRejected(rej_token, d,
+                         "本地化失败, 拒装(FB-A057): " + l10n_error);
+        continue;
+      }
+      std::string localized;
+      if (!base::JSONWriter::Write(parsed->GetDict(), &localized)) {
+        LOG(WARNING) << "[arupa][ext] 本地化后写回失败, 跳过 dir="
+                     << d.AsUTF8Unsafe();
+        NoteScanRejected(rej_token, d, "本地化后写回失败");
+        continue;
+      }
+      item.manifest_json = std::move(localized);
+    }
+
+    item.dir = d;
+    out.push_back(std::move(item));
+  }
+  CommitScanRejections(rej_token);
+  return out;
+}
