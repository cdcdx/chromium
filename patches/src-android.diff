+bool ReplyManagementValue(mojom::ExtApiHost::CallCallback &callback,
+                          base::Value value) {
+  base::ListValue result;
+  result.Append(std::move(value));
+  std::string json;
+  if (!base::JSONWriter::Write(result, &json)) {
+    std::move(callback).Run(std::string(),
+                            "management: result serialization failed");
+    return true;
+  }
+  std::move(callback).Run(json, std::string());
+  return true;
+}
+
+bool HandleKernelOwnedManagement(const ExtCallerIdentity &who,
+                                 const std::string &caller_id,
+                                 const std::string &name,
+                                 const std::string &args_json,
+                                 mojom::ExtApiHost::CallCallback &callback) {
+  if (!name.starts_with("management.")) {
+    return false;
+  }
+  const auto caller = FindLoadedExtension(caller_id);
+  if (!caller || IsExtensionDisabled(caller_id)) {
+    std::move(callback).Run(std::string(), name + ": extension unavailable");
+    return true;
+  }
+  const bool consent =
+      GrantedPermissionsContain(caller_id, {"management"}, {}) == 1 &&
+      HasExtensionPermissionConsent(caller_id, "management");
+  const auto args = base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+
+  if (name == "management.getSelf") {
+    return ReplyManagementValue(
+        callback, base::Value(BuildManagementExtensionInfo(*caller)));
+  }
+  if (name == "management.getAll") {
+    if (!consent) {
+      std::move(callback).Run(std::string(),
+                              name + ": management consent required");
+      return true;
+    }
+    base::ListValue extensions;
+    for (const std::string &id : LoadedExtensionIds()) {
+      const auto extension = FindLoadedExtension(id);
+      if (extension) {
+        extensions.Append(BuildManagementExtensionInfo(*extension));
+      }
+    }
+    return ReplyManagementValue(callback, base::Value(std::move(extensions)));
+  }
+  if (name == "management.get" ||
+      name == "management.getPermissionWarningsById") {
+    const std::string *target_id =
+        args && !args->empty() ? (*args)[0].GetIfString() : nullptr;
+    if (!target_id || target_id->empty()) {
+      std::move(callback).Run(std::string(), name + ": extension id required");
+      return true;
+    }
+    if (*target_id != caller_id && !consent) {
+      std::move(callback).Run(std::string(),
+                              name + ": management consent required");
+      return true;
+    }
+    const auto target = FindLoadedExtension(*target_id);
+    if (!target) {
+      std::move(callback).Run(std::string(),
+                              name + ": no such extension: " + *target_id);
+      return true;
+    }
+    return name == "management.get"
+               ? ReplyManagementValue(
+                     callback,
+                     base::Value(BuildManagementExtensionInfo(*target)))
+               : ReplyManagementValue(callback,
+                                      base::Value(ManagementWarnings(*target)));
+  }
+  if (name == "management.getPermissionWarningsByManifest") {
+    const std::string *manifest_json =
+        args && !args->empty() ? (*args)[0].GetIfString() : nullptr;
+    const auto manifest =
+        manifest_json
+            ? base::JSONReader::ReadDict(*manifest_json, base::JSON_PARSE_RFC)
+            : std::optional<base::DictValue>();
+    if (!manifest) {
+      std::move(callback).Run(std::string(), name + ": invalid manifest JSON");
+      return true;
+    }
+    std::u16string parse_error;
+    scoped_refptr<extensions::Extension> extension =
+        extensions::Extension::Create(
+            base::FilePath(),
+            extensions::mojom::ManifestLocation::kInvalidLocation, *manifest,
+            extensions::Extension::NO_FLAGS, &parse_error);
+    if (!extension) {
+      std::move(callback).Run(std::string(),
+                              name + ": " + base::UTF16ToUTF8(parse_error));
+      return true;
+    }
+    return ReplyManagementValue(callback,
+                                base::Value(ManagementWarnings(*extension)));
+  }
+
+  if (name == "management.uninstallSelf") {
+    CallHostApiFromKernelFrom(who, caller_id, name, args_json,
+                              std::move(callback));
+    return true;
+  }
+  if (name == "management.setEnabled" || name == "management.uninstall") {
+    if (!consent) {
+      std::move(callback).Run(std::string(),
+                              name + ": management consent required");
+      return true;
+    }
+    const std::string *target_id =
+        args && !args->empty() ? (*args)[0].GetIfString() : nullptr;
+    if (!target_id || !FindLoadedExtension(*target_id)) {
+      std::move(callback).Run(std::string(), name + ": invalid extension id");
+      return true;
+    }
+    if (name == "management.setEnabled") {
+      if (!args || args->size() < 2 || !(*args)[1].is_bool()) {
+        std::move(callback).Run(std::string(),
+                                name + ": enabled boolean required");
+        return true;
+      }
+      const std::string target = *target_id;
+      const bool enabled = (*args)[1].GetBool();
+      const bool old_enabled = !IsExtensionDisabled(target);
+      const int64_t target_generation = GetExtensionInstallGeneration(target);
+      if (target_generation <= 0) {
+        std::move(callback).Run(
+            std::string(),
+            "management.setEnabled: target install generation unavailable");
+        return true;
+      }
+      // 宿主调用可能改变 Android 侧持久状态；所有内核可判定的拒绝条件必须在
+      // 发给宿主之前完成，不能让宿主成功后再由本地早退并伪装成失败。
+      if (enabled && IsOptionalPermissionDesynchronized(target)) {
+        std::move(callback).Run(
+            std::string(), "management.setEnabled: optional permission state "
+                           "desynchronized");
+        return true;
+      }
+      CallHostApiFromKernelFrom(
+          who, caller_id, name, args_json,
+          base::BindOnce(
+              [](ExtCallerIdentity who, std::string caller_id,
+                 std::string target, int64_t target_generation, bool enabled,
+                 bool old_enabled, mojom::ExtApiHost::CallCallback done,
+                 const std::string &result_json, const std::string &error) {
+                if (!error.empty()) {
+                  std::move(done).Run(std::string(), error);
+                  return;
+                }
+                auto freeze_for_reconciliation =
+                    [&](std::string reason) mutable {
+                      {
+                        base::AutoLock guard(S().lock);
+                        S().reconciliation_required.insert(
+                            caller_id + "\nmanagement.setEnabled");
+                        S().reconciliation_required.insert(
+                            "*\nmanagement.setEnabled");
+                      }
+                      std::move(done).Run(std::string(), std::move(reason));
+                    };
+                if (GetExtensionInstallGeneration(target) !=
+                    target_generation) {
+                  freeze_for_reconciliation(
+                      "management.setEnabled: target install generation "
+                      "changed after host apply; frozen for reconciliation");
+                  return;
+                }
+                auto fail_with_compensation = [&](std::string reason) mutable {
+                  if (GetExtensionInstallGeneration(target) !=
+                      target_generation) {
+                    freeze_for_reconciliation(
+                        std::move(reason) +
+                        "; target install generation changed; old transaction "
+                        "must not compensate the new installation");
+                    return;
+                  }
+                  base::ListValue rollback_args;
+                  rollback_args.Append(target);
+                  rollback_args.Append(old_enabled);
+                  std::string rollback_json;
+                  base::JSONWriter::Write(rollback_args, &rollback_json);
+                  CallHostApiFromKernelFrom(
+                      who, caller_id, "management.setEnabled", rollback_json,
+                      base::BindOnce(
+                          [](std::string caller_id, std::string target,
+                             int64_t target_generation, std::string reason,
+                             mojom::ExtApiHost::CallCallback done,
+                             const std::string &,
+                             const std::string &compensation_error) {
+                            if (!compensation_error.empty() ||
+                                GetExtensionInstallGeneration(target) !=
+                                    target_generation) {
+                              {
+                                base::AutoLock guard(S().lock);
+                                S().reconciliation_required.insert(
+                                    caller_id + "\nmanagement.setEnabled");
+                                S().reconciliation_required.insert(
+                                    "*\nmanagement.setEnabled");
+                              }
+                              reason +=
+                                  compensation_error.empty()
+                                      ? "; target install generation changed "
+                                        "during compensation; member frozen "
+                                        "for reconciliation"
+                                      : "; host compensation failed; member "
+                                        "frozen for reconciliation";
+                            }
+                            std::move(done).Run(std::string(), reason);
+                          },
+                          caller_id, target, target_generation,
+                          std::move(reason), std::move(done)));
+                };
+                const auto extension = FindLoadedExtension(target);
+                if (!extension) {
+                  fail_with_compensation(
+                      "management.setEnabled: target disappeared");
+                  return;
+                }
+                const ExtensionEnableResult transition =
+                    SetExtensionEnabledWithResult(target, enabled);
+                if (transition.status ==
+                    ExtensionEnableStatus::
+                        kOptionalPermissionStateDesynchronized) {
+                  fail_with_compensation(
+                      "management.setEnabled: optional permission state "
+                      "desynchronized");
+                  return;
+                }
+                if (transition.status ==
+                        ExtensionEnableStatus::kWrongSequence ||
+                    transition.status ==
+                        ExtensionEnableStatus::kInvalidExtensionId) {
+                  fail_with_compensation(
+                      "management.setEnabled: state transition unavailable");
+                  return;
+                }
+                if (transition.enabled != enabled) {
+                  fail_with_compensation(
+                      "management.setEnabled: native state does not match "
+                      "the committed host state");
+                  return;
+                }
+                // The Android lifecycle facade applies the native transition before its
+                // host callback resolves. In that normal path this reconciliation call is
+                // idempotent (transition.changed=false), but Chrome still owes exactly one
+                // management event for the logical old->new transition.
+                if (old_enabled != enabled) {
+                  DispatchManagementEvent(
+                      enabled ? "management.onEnabled"
+                              : "management.onDisabled",
+                      BuildManagementExtensionInfo(*extension));
+                }
+                std::move(done).Run(result_json.empty() ? "[]" : result_json,
+                                    std::string());
+              },
+              who, caller_id, target, target_generation, enabled, old_enabled,
+              std::move(callback)));
+      return true;
+    }
+    CallHostApiFromKernelFrom(who, caller_id, name, args_json,
+                              std::move(callback));
+    return true;
+  }
+
+  std::move(callback).Run(std::string(), name + ": unsupported on Android");
+  return true;
+}
