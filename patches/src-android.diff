+void FontCache::SetArupaFontsAllowlist(const String& csv) {
+  Vector<String>& list = ArupaFontsAllowlistStorage();
+  list.clear();
+  if (csv.empty()) {
+    return;
+  }
+  Vector<String> parts = csv.Split(static_cast<UChar>(','));
+  for (const String& p : parts) {
+    String f = p.StripWhiteSpace().ToAsciiLower();
+    if (!f.empty()) {
+      list.push_back(f);
+    }
+  }
+}
+bool FontCache::ArupaFontAllowed(const AtomicString& family) {
+  const Vector<String>& list = ArupaFontsAllowlistStorage();
+  if (list.empty() || family.empty()) {
+    return true;
+  }
+  const String family_lower = family.GetString().ToAsciiLower();
+  for (const String& f : list) {
+    if (f == family_lower) {
+      return true;
+    }
+  }
+  return false;
+}
 
