+void SetExtApiCancelListenerRegistered(bool registered) {
+  S().cancel_registered = registered;
+  bool installed_cancellation_contract = false;
+  if (!registered) {
+    base::AutoLock guard(Capabilities().lock);
+    installed_cancellation_contract =
+        Capabilities().installed && Capabilities().cancellation;
+  }
+  if (installed_cancellation_contract) {
+    std::string ignored;
+    SetExtApiCapabilitiesJson(std::string(), &ignored);
+  }
+  LOG(WARNING) << "[arupa][extapi] 在途作废通知 "
+               << (registered ? "已登记" : "已撤销");
+}
+
+void RespondExtApi(int request_id, const std::string &result_json,
+                   const std::string &error) {
+  std::optional<Pending> p = TakePending(request_id);
+  if (!p) {
+    LOG(WARNING) << "[arupa][extapi] 收到未知 request_id=" << request_id
+                 << " 的答复 —— 多半是宿主答了两次, 或超时之后才答";
+    return;
+  }
+  scoped_refptr<base::SequencedTaskRunner> seq = p->seq;
+  if (!seq->RunsTasksInCurrentSequence()) {
+    seq->PostTask(FROM_HERE, base::BindOnce(&RunPending, std::move(*p),
+                                            result_json, error));
+    return;
+  }
+  RunPending(std::move(*p), result_json, error);
+}
+
+bool AcknowledgeExtensionApiCancellation(
+    int request_id, bool side_effect_prevented,
+    const std::string &terminal_result_json,
+    const std::string &terminal_error) {
+  State::CancelledRequest cancelled;
+  {
+    base::AutoLock guard(S().lock);
+    auto it = S().cancelled.find(request_id);
+    if (it == S().cancelled.end()) {
+      return false;
+    }
+    cancelled = std::move(it->second);
+    S().cancelled.erase(it);
+    const std::string reconciliation_key =
+        cancelled.extension_id + "\n" + cancelled.name;
+    if (!side_effect_prevented) {
+      S().reconciliation_required.insert(reconciliation_key);
+    } else if (HostMethodMayHaveExternalSideEffect(cancelled.name)) {
+      bool another_unresolved = false;
+      for (const auto &item : S().cancelled) {
+        const State::CancelledRequest &other = item.second;
+        if (other.extension_id == cancelled.extension_id &&
+            other.name == cancelled.name) {
+          another_unresolved = true;
+          break;
+        }
+      }
+      if (!another_unresolved) {
+        S().reconciliation_required.erase(reconciliation_key);
+      }
+    }
+  }
+  if (!side_effect_prevented) {
+    std::string validation_error;
+    const bool terminal_shape_valid =
+        !terminal_error.empty() ||
+        ValidateHostApiResult(cancelled.name, terminal_result_json,
+                              &validation_error);
+    LOG(ERROR) << "[arupa][extapi] 取消未能阻止副作用 id=" << request_id
+               << " ext=" << cancelled.extension_id
+               << " method=" << cancelled.name
+               << " terminalShapeValid=" << terminal_shape_valid
+               << " —— 已冻结该成员，等待更高 contractEpoch 对账";
+  }
+  return true;
+}
+
+void SetApiTimeoutOverride(const std::string &name_prefix, int seconds) {
+  if (name_prefix.empty()) {
+    return;
+  }
+  base::AutoLock guard(Ctx().lock);
+  if (seconds > 0) {
+    Ctx().timeout_override[name_prefix] = seconds;
+  } else {
+    Ctx().timeout_override.erase(name_prefix);
+  }
+  LOG(INFO) << "[arupa][extapi] 应答时限覆盖 " << name_prefix << " = "
+            << seconds << "s";
+}
+
+void CancelPendingForExtension(const std::string &extension_id,
+                               const std::string &reason) {
+  if (extension_id.empty()) {
+    return;
+  }
+  CancelTaken(TakePendingWhere(base::BindRepeating(
+                  [](const std::string &id, const Pending &p) {
+                    return p.extension_id == id;
+                  },
+                  extension_id)),
+              reason);
+}
