+void AppendDnrTrustedContextValues(std::string_view resource_type,
+                                   std::string_view initiator, int tab_id,
+                                   std::string_view partition,
+                                   int frame_tree_node_id,
+                                   int parent_frame_tree_node_id,
+                                   int frame_id, int parent_frame_id,
+                                   std::string_view document_id,
+                                   std::string_view parent_document_id,
+                                   std::string_view document_lifecycle,
+                                   std::string_view frame_type,
+                                   std::vector<std::string> *names,
+                                   std::vector<std::string> *values) {
+  names->emplace_back(kDnrResourceTypeHeader);
+  values->emplace_back(resource_type);
+  names->emplace_back(kDnrInitiatorHeader);
+  values->emplace_back(initiator);
+  names->emplace_back(kDnrTabIdHeader);
+  values->push_back(base::NumberToString(tab_id));
+  names->emplace_back(kDnrPartitionHeader);
+  values->emplace_back(partition);
+  names->emplace_back(kDnrFrameTreeNodeIdHeader);
+  values->push_back(base::NumberToString(frame_tree_node_id));
+  names->emplace_back(kDnrParentFrameTreeNodeIdHeader);
+  values->push_back(base::NumberToString(parent_frame_tree_node_id));
+  names->emplace_back(kDnrFrameIdHeader);
+  values->push_back(base::NumberToString(frame_id));
+  names->emplace_back(kDnrParentFrameIdHeader);
+  values->push_back(base::NumberToString(parent_frame_id));
+  names->emplace_back(kDnrDocumentIdHeader);
+  values->emplace_back(document_id);
+  names->emplace_back(kDnrParentDocumentIdHeader);
+  values->emplace_back(parent_document_id);
+  names->emplace_back(kDnrDocumentLifecycleHeader);
+  values->emplace_back(document_lifecycle);
+  names->emplace_back(kDnrFrameTypeHeader);
+  values->emplace_back(frame_type);
+}
+
+void AppendDnrTrustedContext(const network::ResourceRequest &request,
+                             bool is_main_frame, int tab_id,
+                             std::string_view partition, int frame_tree_node_id,
+                             int parent_frame_tree_node_id,
+                             int frame_id, int parent_frame_id,
+                             std::string_view document_id,
+                             std::string_view parent_document_id,
+                             std::string_view document_lifecycle,
+                             std::string_view frame_type,
+                             std::vector<std::string> *names,
+                             std::vector<std::string> *values) {
+  const std::string resource_type = DnrResourceType(request, is_main_frame);
+  const std::string initiator = request.request_initiator
+                                    ? request.request_initiator->Serialize()
+                                    : "null";
+  AppendDnrTrustedContextValues(resource_type, initiator, tab_id, partition,
+                                frame_tree_node_id, parent_frame_tree_node_id,
+                                frame_id, parent_frame_id, document_id,
+                                parent_document_id, document_lifecycle,
+                                frame_type, names, values);
+}
