+void InvalidateExtensionContexts(const std::string &extension_id,
+                                 const std::string &reason) {
+  if (extension_id.empty()) {
+    return;
+  }
+  NotifyInternalExtensionContextInvalidation(extension_id,
+                                             /*incognito_only=*/false);
+  CancelPendingForExtension(extension_id, reason);
+  // 窗口与唤醒待办也必须一起清退: 旧身份的租约不能继续跑业务, 停用扩展的
+  // 待办不该在重启后被重投(N-C03/N-C06)。
+  const uint64_t audit_event_token = siteaudit::NewEventToken();
+  PostToUi(base::BindOnce(
+      [](std::string ext, std::string why, uint64_t event_token) {
+        CancelPageCapturesForExtension(ext);
+        worker_window::RevokeAllForExtension(ext, why);
+        nomadtransfer::ClearForExtension(ext);
+        // 独立审计账本: 上下文失效(停用/卸载/重装/装机代次变化)留下审计事件。
+        ExtCallerIdentity caller;
+        if (!BindHostRuntimeIdentity(&caller) ||
+            caller.runtime_off_the_record) {
+          return;
+        }
+        const std::string partition = AuditPartitionFor(caller, ext);
+        base::DictValue ev;
+        ev.Set("kind", "context-invalidated");
+        ev.Set("reason", why);
+        std::string ev_json;
+        base::JSONWriter::Write(base::Value(std::move(ev)), &ev_json);
+        siteaudit::RecordEvent(partition, ev_json, event_token);
+      },
+      extension_id, reason, audit_event_token));
+  base::DictValue d;
+  ExtCallerIdentity current_identity;
+  const bool identity_bound = BindHostRuntimeIdentity(&current_identity);
+  d.Set("profileId", ProfileIdForThisRun());
+  d.Set("extensionId", extension_id);
+  d.Set("installGeneration",
+        base::NumberToString(GetExtensionInstallGeneration(extension_id)));
+  d.Set("contextType", "unknown");
+  d.Set("incognito", identity_bound ? current_identity.runtime_off_the_record
+                                    : RunningOffTheRecord());
+  d.Set("runtimeIdentityBound", identity_bound);
+  if (identity_bound) {
+    d.Set("accountScope", current_identity.account_scope);
+    d.Set("sessionEpoch", current_identity.session_epoch);
+  }
+  d.Set("scope", "extension");
+  std::string json;
+  base::JSONWriter::Write(base::Value(std::move(d)), &json);
+  ReportContextInvalidated(extension_id, json, reason);
+}
+
+void OnFrameDocumentCommitted(int frame_tree_node_id) {
+  if (frame_tree_node_id < 0) {
+    return;
+  }
+  const int64_t generation = BumpDocumentGeneration(frame_tree_node_id);
+
+  // 指向旧文档的在途请求一律作废: 新文档不能继承旧文档的答复。
+  struct Affected {
+    std::string extension_id;
+    ExtCallerIdentity who;
+  };
+  std::vector<Affected> affected;
+  auto taken = TakePendingWhere(base::BindRepeating(
+      [](int ftn, const Pending &p) {
+        return p.who.kind == ExtCallerIdentity::Kind::kFrame &&
+               p.who.frame_tree_node_id == ftn;
+      },
+      frame_tree_node_id));
+  for (auto &kv : taken) {
+    affected.push_back(Affected{kv.second.extension_id, kv.second.who});
+  }
+  CancelTaken(std::move(taken), "页面已导航到新文档");
+
+  const std::string token = base::NumberToString(frame_tree_node_id) + "-" +
+                            base::NumberToString(generation);
+  for (const Affected &a : affected) {
+    base::DictValue d = BuildCallerIdentityJsonFor(a.who, a.extension_id);
+    d.Set("frameTreeNodeId", frame_tree_node_id);
+    d.Set("documentToken", token);
+    d.Set("scope", "frame");
+    std::string json;
+    base::JSONWriter::Write(base::Value(std::move(d)), &json);
+    ReportContextInvalidated(a.extension_id, json,
+                             "页面已导航到新文档(代次 " +
+                                 base::NumberToString(generation) + ")");
+  }
+  LOG(INFO) << "[arupa][ctx] 文档已替换 ftn=" << frame_tree_node_id
+            << " 代次=" << generation << " 作废在途=" << affected.size();
+}
+
+void CallHostApiFromKernelFrom(
+    const ExtCallerIdentity &who, const std::string &extension_id,
+    const std::string &name, const std::string &args_json,
+    base::OnceCallback<void(const std::string &, const std::string &)>
+        callback) {
+  // 扩展业务与内核控制调用都携带可信上下文。旧的无上下文处理器不得成为
+  // 注册时序异常时的隐式降级通道；在创建 pending/计时器前就拒绝。
+  if (!S().registered_ctx) {
+    std::move(callback).Run(std::string(), "HOST_CONTEXT_HANDLER_REQUIRED");
+    return;
+  }
+  if (GetExtensionInstallGeneration(extension_id) <= 0) {
+    std::move(callback).Run(std::string(),
+                            "HOST_INSTALL_GENERATION_REQUIRED:" + name);
+    return;
+  }
+  if (!HostSupportsExtApiMethod(name)) {
+    std::move(callback).Run(std::string(), "HOST_CAPABILITY_REQUIRED:" + name);
+    return;
+  }
+  if (HostMethodMayHaveExternalSideEffect(name)) {
+    bool cancellation_supported = false;
+    {
+      base::AutoLock guard(Capabilities().lock);
+      cancellation_supported = Capabilities().cancellation;
+    }
+    if (!cancellation_supported || !S().cancel_registered) {
+      std::move(callback).Run(std::string(),
+                              name + ": HOST_CANCELLATION_ACK_REQUIRED");
+      return;
+    }
+    bool reconciliation_required = false;
+    {
+      base::AutoLock guard(S().lock);
+      reconciliation_required =
+          S().reconciliation_required.contains(extension_id + "\n" + name) ||
+          S().reconciliation_required.contains("*\n" + name);
+    }
+    if (reconciliation_required) {
+      std::move(callback).Run(std::string(),
+                              name + ": HOST_RECONCILIATION_REQUIRED");
+      return;
+    }
+  }
+  // 长时 API: 授权流程 / 权限确认 / 下载以及 DNR 宿主规则快照都要等异步回包,
+  // MV3 后台 SW 会在等待期间被 idle 策略回收, 回包就没人接了。这里借用
+  // 窗口保活(引用计数 + kDoesNotTimeout), 回包/超时/取消一律归还 —— 与桌面端
+  // arupa_ext_api_host.cc 的 StartingExternalRequest 同一意图, 不同实现
+  // (安卓侧已有 AcquireWindowKeepAlive)。
+  const bool needs_keepalive =
+      (name == "identity.launchWebAuthFlow" || name == "permissions.request" ||
+       name == "downloads.download" || name == "nomad.dnr.applyDynamicRules" ||
+       name == "management.setEnabled" || name == "management.uninstall" ||
+       name == "management.uninstallSelf") &&
+      who.kind == ExtCallerIdentity::Kind::kWorker;
+  if (needs_keepalive) {
+    const bool acquired = AcquireWindowKeepAlive(who.worker_version_id);
+    if (!acquired) {
+      LOG(WARNING) << "[arupa][extapi] " << name
+                   << " 拿不到窗口保活; 继续转宿主(回包时 SW 可能已被回收)";
+    }
+    callback = base::BindOnce(
+        [](base::OnceCallback<void(const std::string &, const std::string &)>
+               inner,
+           int64_t version, bool release_keepalive,
+           const std::string &result_json, const std::string &error) {
+          if (release_keepalive) {
+            ReleaseWindowKeepAlive(version);
+          }
+          std::move(inner).Run(result_json, error);
+        },
+        std::move(callback), who.worker_version_id, acquired);
+  }
+
+  scoped_refptr<base::SequencedTaskRunner> here =
+      base::SequencedTaskRunner::GetCurrentDefault();
+  int id = 0;
+  bool over_capacity = false;
+  {
+    base::AutoLock guard(S().lock);
+    size_t in_flight = 0;
+    for (const auto &kv : S().pending) {
+      if (kv.second.extension_id == extension_id) {
+        ++in_flight;
+      }
+    }
+    if (in_flight >= kMaxPendingPerExtension) {
+      over_capacity = true;
+    } else {
+      id = S().next_id++;
+      S().pending.emplace(id, Pending{std::move(callback), name, args_json,
+                                      here, extension_id, who});
+    }
+  }
+  if (over_capacity) {
+    // 宿主被反压时必须立刻知道"是内核没接", 不能静默排队(与宿主侧
+    // maxInFlight=64 / HOST_BUSY 同一语义)。
+    LOG(WARNING) << "[arupa][extapi] 拒收 " << name << " ext=" << extension_id
+                 << " —— 该扩展在途调用已达上限 " << kMaxPendingPerExtension;
+    std::move(callback).Run(std::string(),
+                            name + ": HOST_BUSY(内核侧在途调用已达上限 " +
+                                base::NumberToString(kMaxPendingPerExtension) +
+                                ", 稍后重试)");
+    return;
+  }
+  LOG(INFO) << "[arupa][extapi] → 宿主 " << name << " ext=" << extension_id
+            << " id=" << id;
+
+  here->PostDelayedTask(FROM_HERE, base::BindOnce(&OnTimeout, id),
+                        TimeoutFor(name));
+
+  const std::string ctx =
+      BuildTrustedContextJsonFor(who, extension_id, name, id);
+  NotifyExtensionApiCallCtx(id, extension_id, name, args_json, ctx);
+}
+
+void ArupaExtApiHost::Create(
+    content::RenderProcessHost *process,
+    mojo::PendingReceiver<mojom::ExtApiHost> receiver) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<ArupaExtApiHost>(
+          process ? process->GetID().GetUnsafeValue() : -1),
+      std::move(receiver));
+}
+
+void ArupaExtApiHost::CreateForFrame(
+    content::RenderFrameHost *frame,
+    mojo::PendingAssociatedReceiver<mojom::ExtApiHost> receiver) {
+  if (!frame) {
+    return;
+  }
+  ExtCallerIdentity who;
+  who.kind = ExtCallerIdentity::Kind::kFrame;
+  who.frame_process_id = frame->GetProcess()->GetDeprecatedID();
+  who.frame_routing_id = frame->GetRoutingID();
+  // 帧树 id 跨 RFH 重建稳定 —— 宿主用它把"窗口/文档"钉在真实帧上。
+  who.frame_tree_node_id =
+      static_cast<int>(frame->GetFrameTreeNodeId().value());
+  // 第一次见到该帧时建立文档代次, 保证 documentToken 从 1 开始而不是 0。
+  if (FrameDocumentGeneration(who.frame_tree_node_id) == 0) {
+    BumpDocumentGeneration(who.frame_tree_node_id);
+  }
+  if (BindHostRuntimeIdentity(&who)) {
+    who.runtime_off_the_record =
+        TabBookForWebContents(content::WebContents::FromRenderFrameHost(
+            frame)) == TabBook::kIncognito;
+  }
+  auto *host = new ArupaExtApiHost(who.frame_process_id, who);
+  mojo::MakeSelfOwnedAssociatedReceiver(std::unique_ptr<ArupaExtApiHost>(host),
+                                        std::move(receiver));
+}
+
+void ArupaExtApiHost::CreateForWorker(
+    const content::ServiceWorkerVersionBaseInfo &version_info,
+    mojo::PendingAssociatedReceiver<mojom::ExtApiHost> receiver) {
+  const auto worker_context = ExtensionWorkerContextForVersion(version_info);
+  if (!worker_context) {
+    LOG(ERROR) << "[arupa][extapi] 拒绝无法识别所属册的 Worker scope="
+               << version_info.scope;
+    return;
+  }
+  const auto current = CurrentExtensionWorkerContext(
+      worker_context->extension_id, worker_context->book);
+  if (!current || !(*current == *worker_context)) {
+    LOG(WARNING) << "[arupa][extapi] 拒绝过期无痕 Worker scope="
+                 << version_info.scope;
+    return;
+  }
+  ExtCallerIdentity who;
+  who.kind = ExtCallerIdentity::Kind::kWorker;
+  who.worker_version_id = version_info.version_id;
+  who.worker_scope = version_info.scope.spec();
+  who.runtime_incognito_generation = worker_context->incognito_generation;
+  BindHostRuntimeIdentity(&who);
+  who.runtime_off_the_record = worker_context->book == TabBook::kIncognito;
+  mojo::MakeSelfOwnedAssociatedReceiver(
+      std::make_unique<ArupaExtApiHost>(
+          static_cast<int>(version_info.process_id.GetUnsafeValue()), who),
+      std::move(receiver));
+}
+
+ArupaExtApiHost::ArupaExtApiHost(int render_process_id,
+                                 const ExtCallerIdentity &who)
+    : render_process_id_(render_process_id), who_(who) {}
+
+ArupaExtApiHost::ArupaExtApiHost(int render_process_id)
+    : render_process_id_(render_process_id) {}
+
+ArupaExtApiHost::~ArupaExtApiHost() {
+  if (who_.kind == ExtCallerIdentity::Kind::kProcess) {
+    return;
+  }
+  const ExtCallerIdentity who = who_;
+  CancelTaken(
+      TakePendingWhere(base::BindRepeating(
+          [](const ExtCallerIdentity &gone, const Pending &p) {
+            if (p.who.kind != gone.kind) {
+              return false;
+            }
+            return gone.kind == ExtCallerIdentity::Kind::kFrame
+                       ? (p.who.frame_process_id == gone.frame_process_id &&
+                          p.who.frame_routing_id == gone.frame_routing_id)
+                       : p.who.worker_version_id == gone.worker_version_id;
+          },
+          who)),
+      who.kind == ExtCallerIdentity::Kind::kFrame
+          ? "发起调用的页面已关闭"
+          : "发起调用的 Service Worker 已停止");
+
+  // 光作废在途还不够: 用过这个上下文的扩展必须被告知"上下文没了",
+  // 否则宿主的窗口/租约/持久工作会挂在已消失的帧或 Worker 上(N-C02/N-C06)。
+  const std::vector<std::string> extensions = TakeContextExtensions(who);
+  const bool is_frame = who.kind == ExtCallerIdentity::Kind::kFrame;
+  const char *reason =
+      is_frame ? "发起调用的页面已关闭" : "发起调用的 Service Worker 已停止";
+  for (const std::string &extension_id : extensions) {
+    base::DictValue ctx = BuildCallerIdentityJsonFor(who, extension_id);
+    ctx.Set("scope", is_frame ? "frame" : "worker");
+    std::string json;
+    base::JSONWriter::Write(base::Value(std::move(ctx)), &json);
+    ReportContextInvalidated(extension_id, json, reason);
+  }
+}
+
+bool ArupaExtApiHost::CallerMayActAs(const std::string &extension_id) const {
+  if (extension_id.empty()) {
+    return false;
+  }
+  switch (who_.kind) {
+  case ExtCallerIdentity::Kind::kFrame: {
+    content::RenderFrameHost *rfh = content::RenderFrameHost::FromID(
+        who_.frame_process_id, who_.frame_routing_id);
+    if (!rfh) {
+      return false;
+    }
+    const url::Origin origin = rfh->GetLastCommittedOrigin();
+    return origin.scheme() == extensions::kExtensionScheme &&
+           origin.host() == extension_id;
+  }
+  case ExtCallerIdentity::Kind::kWorker: {
+    const GURL scope(who_.worker_scope);
+    return scope.SchemeIs(extensions::kExtensionScheme) &&
+           scope.host() == extension_id;
+  }
+  case ExtCallerIdentity::Kind::kProcess:
+    return render_process_id_ >= 0 &&
+           content::ChildProcessSecurityPolicy::GetInstance()
+               ->CanAccessDataForOrigin(
+                   render_process_id_,
+                   url::Origin::Create(
+                       GURL(std::string(extensions::kExtensionScheme) + "://" +
+                            extension_id + "/")));
+  }
+  return false;
+}
+
+void ArupaExtApiHost::Call(const std::string &extension_id,
+                           const std::string &name,
+                           const std::string &args_json,
+                           CallCallback callback) {
+  if (!CallerMayActAs(extension_id)) {
+    LOG(ERROR) << "[arupa][extapi] 拒绝: 调用方不属于扩展 " << extension_id
+               << " (" << name << ")";
+    std::move(callback).Run(std::string(),
+                            name + ": caller is not a context of extension " +
+                                extension_id);
+    return;
+  }
+  bool incognito_call = false;
+  if (who_.kind == ExtCallerIdentity::Kind::kWorker) {
+    incognito_call = who_.runtime_incognito_generation != 0;
+  } else if (who_.kind == ExtCallerIdentity::Kind::kFrame) {
+    incognito_call = TabBookForCaller(who_) == TabBook::kIncognito;
+  } else if (content::RenderProcessHost *process =
+                 content::RenderProcessHost::FromID(render_process_id_)) {
+    content::StoragePartition *partition = process->GetStoragePartition();
+    incognito_call = partition && partition->GetConfig().in_memory();
+  }
+  if (incognito_call && !IsExtensionIncognitoAccessAllowed(extension_id)) {
+    LOG(WARNING) << "[arupa][extapi] 拒绝已撤销/未授权的无痕调用 ext="
+                 << extension_id << " api=" << name;
+    std::move(callback).Run(std::string(),
+                            name + ": extension is not allowed in incognito");
+    return;
+  }
+  if (who_.kind == ExtCallerIdentity::Kind::kWorker &&
+      !who_.runtime_identity_bound) {
+    if (!BindHostRuntimeIdentity(&who_)) {
+      LOG(WARNING) << "[arupa][extapi] 拒绝未绑定账号会话的 Worker 调用 ext="
+                   << extension_id << " api=" << name;
+      std::move(callback).Run(std::string(),
+                              name + ": host runtime identity unavailable");
+      return;
+    }
+    who_.runtime_off_the_record = who_.runtime_incognito_generation != 0;
+  }
+  if (who_.runtime_identity_bound && !HostRuntimeIdentityStillCurrent(who_)) {
+    LOG(WARNING) << "[arupa][extapi] 拒绝旧账号/无痕会话调用 ext="
+                 << extension_id << " api=" << name;
+    std::move(callback).Run(
+        std::string(), name + ": runtime identity changed; recreate context");
+    return;
+  }
+  if (who_.kind == ExtCallerIdentity::Kind::kProcess &&
+      (IsHostOwnedApi(name) || HasApiPrefix(name, "action.") ||
+       name == "windows.update")) {
+    LOG(ERROR) << "[arupa][extapi] 拒绝: " << name
+               << " 只接受扩展页面或 Service Worker 的调用";
+    std::move(callback).Run(
+        std::string(),
+        name + ": requires an extension page or service worker context");
+    return;
+  }
+  // 扩展页可能早于宿主登录身份创建。与 native host 的逐次开通道一致，
+  // 审计直调在真实调用时补绑定本页身份；不能借用后台 Worker 的身份。
+  if (who_.kind == ExtCallerIdentity::Kind::kFrame &&
+      !who_.runtime_identity_bound &&
+      (HasApiPrefix(name, "sitePermissionAudit.") ||
+       HasApiPrefix(name, "nomad.sitePermissionAudit."))) {
+    content::RenderFrameHost *frame = content::RenderFrameHost::FromID(
+        who_.frame_process_id, who_.frame_routing_id);
+    content::WebContents *contents =
+        frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+    if (contents && BindHostRuntimeIdentity(&who_)) {
+      who_.runtime_off_the_record =
+          TabBookForWebContents(contents) == TabBook::kIncognito;
+    }
+  }
+  // 身份已验: 记下"这个扩展用过这个上下文", 上下文消失(关页/停 Worker/
+  // 导航换文档)时才能精确通知宿主清退它的窗口与在途工作。
+  RememberContextExtension(who_, extension_id);
+  if (who_.kind == ExtCallerIdentity::Kind::kFrame) {
+    // 页面所属册由 WebContents 决定，不能依赖宿主身份 JSON 是否已经就绪；否则
+    // 无痕扩展页的宿主回包会按普通册净化。
+    who_.runtime_off_the_record = TabBookForCaller(who_) == TabBook::kIncognito;
+  }
+  if (HasApiPrefix(name, "offscreen.") || name == "runtime.getContexts") {
+    if (who_.kind == ExtCallerIdentity::Kind::kProcess) {
+      std::move(callback).Run(
+          std::string(),
+          name + ": requires an extension page or service worker");
+      return;
+    }
+    if (HasApiPrefix(name, "offscreen.") &&
+        GrantedPermissionsContain(extension_id, {"offscreen"}, {}) != 1) {
+      std::move(callback).Run(std::string(),
+                              name + ": offscreen permission required");
+      return;
+    }
+    content::RenderProcessHost *caller_process =
+        content::RenderProcessHost::FromID(render_process_id_);
+    content::BrowserContext *browser_context =
+        caller_process ? caller_process->GetBrowserContext() : nullptr;
+    content::StoragePartition *default_partition =
+        browser_context ? browser_context->GetDefaultStoragePartition()
+                        : nullptr;
+    if (!caller_process || !default_partition ||
+        caller_process->GetStoragePartition() != default_partition) {
+      std::move(callback).Run(
+          std::string(),
+          name + ": extension contexts unavailable in this partition");
+      return;
+    }
+    if (who_.kind == ExtCallerIdentity::Kind::kFrame) {
+      content::RenderFrameHost *frame = content::RenderFrameHost::FromID(
+          who_.frame_process_id, who_.frame_routing_id);
+      if (IsOffscreenFrame(frame)) {
+        // 上游 feature 只向 privileged_extension 暴露管理/枚举入口；
+        // offscreen_extension 本身只能使用 runtime 消息等白名单 API。
+        std::move(callback).Run(
+            std::string(), name + ": unavailable in an offscreen document");
+        return;
+      }
+    }
+    HandleOffscreenApi(browser_context, extension_id, name, args_json,
+                       callback);
+    return;
+  }
+  if (HandleKernelOwnedRuntime(extension_id, name, args_json, callback)) {
+    return;
+  }
+  if (HandleKernelOwnedAction(who_, extension_id, name, args_json, callback)) {
+    return;
+  }
+  if (HandleKernelOwnedCookies(render_process_id_, extension_id, name,
+                               args_json, callback)) {
+    return;
+  }
+  if (HandleKernelOwnedAlarms(extension_id, name, args_json, callback)) {
+    return;
+  }
+  // chrome.idle：内核闭环（空闲信号来自 //ui/base/idle 的 Android
+  // IdleDetector， 不是内核自己编的计时器）。少了这条，chrome.idle.queryState
+  // 会落到 "not supported in this browser"。
+  if (HandleKernelOwnedIdle(extension_id, name, args_json, callback)) {
+    return;
+  }
+  if (HandleKernelOwnedWebNavigation(name, args_json, TabBookForCaller(who_),
+                                     callback)) {
+    return;
+  }
+  if (HandleKernelPageCapture(render_process_id_, TabBookForCaller(who_),
+                              extension_id, name, args_json, callback)) {
+    return;
+  }
+  if (HandleKernelOwnedExtension(who_, extension_id, name, args_json,
+                                 callback)) {
+    return;
+  }
+  if (HasApiPrefix(name, "browsingData.")) {
+    if (who_.kind == ExtCallerIdentity::Kind::kProcess) {
+      std::move(callback).Run(
+          std::string(),
+          name + ": requires an extension page or service worker");
+      return;
+    }
+    if (GrantedPermissionsContain(extension_id, {"browsingData"}, {}) != 1) {
+      std::move(callback).Run(std::string(),
+                              name + ": browsingData permission required");
+      return;
+    }
+    content::RenderProcessHost *caller_process =
+        content::RenderProcessHost::FromID(render_process_id_);
+    content::BrowserContext *browser_context =
+        caller_process ? caller_process->GetBrowserContext() : nullptr;
+    if (!caller_process || !browser_context ||
+        browser_context->IsOffTheRecord() ||
+        caller_process->GetStoragePartition()->GetConfig().in_memory()) {
+      std::move(callback).Run(std::string(),
+                              name + ": unavailable in a private partition");
+      return;
+    }
+    const bool dedicated_host_clear = name == "browsingData.removeHistory" ||
+                                      name == "browsingData.removeFormData" ||
+                                      name == "browsingData.removeDownloads";
+    if (dedicated_host_clear) {
+      CallHostApiFromKernelFrom(who_, extension_id, name, args_json,
+                                std::move(callback));
+      return;
+    }
+    if (name == "browsingData.remove") {
+      auto parsed = base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+      const base::DictValue *options =
+          parsed && !parsed->empty() ? (*parsed)[0].GetIfDict() : nullptr;
+      const base::DictValue *requested =
+          parsed && parsed->size() > 1 ? (*parsed)[1].GetIfDict() : nullptr;
+      if (options && requested) {
+        for (auto [type, selected] : *requested) {
+          if (!selected.is_bool()) {
+            std::move(callback).Run(std::string(),
+                                    "browsing_data_type_invalid");
+            return;
+          }
+          if (!selected.GetBool()) {
+            continue;
+          }
+          if (type == "history" || type == "formData" ||
+              type == "downloads") {
+            continue;
+          }
+          if (type != "appcache" && type != "cache" &&
+                     type != "cacheStorage" && type != "cookies" &&
+                     type != "fileSystems" && type != "indexedDB" &&
+                     type != "localStorage" && type != "pluginData" &&
+                     type != "serviceWorkers" && type != "webSQL" &&
+                     type != "passwords" &&
+                     type != "serverBoundCertificates") {
+            std::move(callback).Run(std::string(),
+                                    "browsing_data_type_unsupported");
+            return;
+          }
+        }
+        // 宿主阶段先把 operation 与历史删除墓碑持久化，再做幂等删除；成功后进入
+        // 内核阶段。进程中断时原 JS callback 本就不会存活，宿主会恢复自己的阶段，
+        // 调用方重试则安全地补跑两边，不再出现“混合类型一律拒绝”的替代语义。
+        base::DictValue host_types;
+        base::DictValue kernel_types = requested->Clone();
+        for (const char *type : {"history", "formData", "downloads"}) {
+          if (requested->FindBool(type).value_or(false)) {
+            host_types.Set(type, true);
+          }
+          kernel_types.Remove(type);
+        }
+        if (!host_types.empty()) {
+          base::ListValue host_args;
+          host_args.Append(options->Clone());
+          host_args.Append(std::move(host_types));
+          base::ListValue kernel_args;
+          kernel_args.Append(options->Clone());
+          kernel_args.Append(std::move(kernel_types));
+          std::string host_json;
+          std::string kernel_json;
+          base::JSONWriter::Write(host_args, &host_json);
+          base::JSONWriter::Write(kernel_args, &kernel_json);
+          CallHostApiFromKernelFrom(
+              who_, extension_id, name, host_json,
+              base::BindOnce(
+                  [](content::BrowserContext *browser_context,
+                     std::string extension_id, std::string kernel_json,
+                     mojom::ExtApiHost::CallCallback done, const std::string &,
+                     const std::string &error) {
+                    if (!error.empty()) {
+                      std::move(done).Run(std::string(), error);
+                      return;
+                    }
+                    auto kernel_args = base::JSONReader::ReadList(
+                        kernel_json, base::JSON_PARSE_RFC);
+                    const base::DictValue *types =
+                        kernel_args && kernel_args->size() > 1
+                            ? (*kernel_args)[1].GetIfDict()
+                            : nullptr;
+                    if (!types || types->empty()) {
+                      std::move(done).Run("[]", std::string());
+                      return;
+                    }
+                    if (!HandleKernelBrowsingDataApi(
+                            browser_context, extension_id,
+                            "browsingData.remove", kernel_json, done)) {
+                      std::move(done).Run(std::string(),
+                                          "browsingData.remove: kernel "
+                                          "transaction unavailable");
+                    }
+                  },
+                  browser_context, extension_id, std::move(kernel_json),
+                  std::move(callback)));
+          return;
+        }
+      }
+    }
+    if (!HandleKernelBrowsingDataApi(browser_context, extension_id, name,
+                                     args_json, callback)) {
+      std::move(callback).Run(std::string(),
+                              name + ": not supported on Android");
+    }
+    return;
+  }
+  // 净化(S-01/S-04): declarativeNetRequest 一族的查询/更新都在内核, 生效与否由
+  // 宿主引擎回执决定。
+  //
+  // 2026-10-13 修(S-04 主链阻断): 这里以前**只**列了 getDynamicRules /
+  // updateDynamicRules 两个名字, 于是 getEnabledRulesets /
+  // updateEnabledRulesets 明明在 HandleKernelOwnedDnr 里实现齐全,
+  // 运行期却一路掉到文件末尾的
+  // "...not supported in this browser" —— 静态规则集启停整条主链因此不可达
+  // （逐风净化 0.4.8 里默认关闭的 CSS 规则集没有途径被打开）。
+  // 改成按命名空间整体移交: 认领面由 mv3::kSupportedDnrMethods 唯一声明,
+  // 不认识的方法在 HandleKernelOwnedDnr 里回 E_DNR_UNSUPPORTED_METHOD(可机读),
+  // 比掉到通用兜底文案好。三处一致性由 scripts/kernel_capability.py 门禁比对。
+  if (HasApiPrefix(name, "declarativeNetRequest.")) {
+    HandleKernelOwnedDnr(who_, extension_id, name, args_json,
+                         std::move(callback));
+    return;
+  }
+  // 站点内容设置(T-05): camera/microphone/location 的读改写转发宿主
+  // SitePermissions。
+  if (HasApiPrefix(name, "contentSettings.")) {
+    HandleKernelOwnedContentSettings(who_, extension_id, name, args_json,
+                                     std::move(callback));
+    return;
+  }
+  if (HandleKernelOwnedManagement(who_, extension_id, name, args_json,
+                                  callback)) {
+    return;
+  }
+
+  if (name == "webRequestInternal.eventHandled") {
+    HandleWebRequestAuthResponse(who_, extension_id, args_json);
+    std::move(callback).Run("[]", std::string());
+    return;
+  }
+
+  if (HandleSitePermissionAudit(who_, extension_id, name, args_json,
+                                callback)) {
+    return;
+  }
+  // chrome.identity.launchWebAuthFlow：
+  //   interactive=false ⇒ 内核用离屏 WebContents 静默换取 token（不需要 UI）；
+  //   interactive=true  ⇒ 返回 false，继续往下走转宿主承载授权页。
+  if (name == "identity.launchWebAuthFlow") {
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+    const base::ListValue *call_args =
+        parsed && parsed->is_list() ? &parsed->GetList() : nullptr;
+    const base::DictValue *details = (call_args && !call_args->empty())
+                                         ? (*call_args)[0].GetIfDict()
+                                         : nullptr;
+    const std::string *auth_url =
+        details ? details->FindString("url") : nullptr;
+    if (!auth_url || auth_url->empty()) {
+      std::move(callback).Run(
+          std::string(), "identity.launchWebAuthFlow: details.url is required");
+      return;
+    }
+    const bool interactive = details->FindBool("interactive").value_or(false);
+    const bool abort_on_load =
+        details->FindBool("abortOnLoadForNonInteractive").value_or(true);
+    base::TimeDelta timeout;
+    if (const std::optional<int> ms =
+            details->FindInt("timeoutMsForNonInteractive")) {
+      timeout = base::Milliseconds(*ms);
+    }
+    content::BrowserContext *bc = nullptr;
+    if (who_.kind == ExtCallerIdentity::Kind::kWorker ||
+        who_.kind == ExtCallerIdentity::Kind::kProcess) {
+      bc = GetKernelBrowserContextForExtensions();
+    } else {
+      if (auto *rfh = content::RenderFrameHost::FromID(who_.frame_process_id,
+                                                       who_.frame_routing_id)) {
+        bc = rfh->GetBrowserContext();
+      }
+    }
+    if (LaunchWebAuthFlow(bc, extension_id, *auth_url, interactive,
+                          abort_on_load, timeout, callback)) {
+      return;
+    }
+    // interactive=true：走下面的宿主路由。
+  }
+  // 注入脚本(逐风阅读 chrome.scripting.executeScript / insertCSS / removeCSS)。
+  if (HasApiPrefix(name, "scripting.")) {
+    HandleKernelOwnedScripting(render_process_id_, extension_id, name,
+                               args_json, callback);
+    return;
+  }
+  // 用户脚本注册、程序化注入及 USER_SCRIPT world 配置均由内核处理。
+  if (HasApiPrefix(name, "userScripts.")) {
+    HandleKernelOwnedUserScripts(render_process_id_, extension_id, name,
+                                 args_json, callback);
+    return;
+  }
+  // 可选权限(逐风留痕 chrome.permissions.request)。
+  if (HasApiPrefix(name, "permissions.")) {
+    HandleKernelOwnedPermissions(who_, extension_id, name, args_json, callback);
+    return;
+  }
+  // windows.update(focused:true) 必须让 Android 宿主真实前置
+  // BrowserActivity，不能由 内核伪造
+  // focused=true。仍先经过上面的可信调用方/运行时身份校验。
+  if (name == "windows.update") {
+    if (IsExtensionDisabled(extension_id)) {
+      std::move(callback).Run(std::string(), name + ": 扩展已停用");
+      return;
+    }
+    CallHostApiFromKernelFrom(who_, extension_id, name, args_json,
+                              std::move(callback));
+    return;
+  }
+  // 其余窗口寻址由内核的单窗口模型回答，窗口编号与册的权威数据在标签注册表里。
+  if (HasApiPrefix(name, "windows.")) {
+    HandleKernelOwnedWindows(extension_id, name, args_json,
+                             TabBookForCaller(who_), callback);
+    return;
+  }
+  // 标签寻址：内核回答 get/getCurrent/reload；query/create/update 返回 false
+  // 后走 宿主真实标签 UI，回包仍由内核按编号、分册和权限二次净化。
+  if (HasApiPrefix(name, "tabs.")) {
+    if (HandleKernelOwnedTabs(who_, extension_id, name, args_json, callback)) {
+      return;
+    }
+    std::string validation_error;
+    if (!ValidateHostTabsRequest(who_, extension_id, name, args_json,
+                                 &validation_error)) {
+      std::move(callback).Run(std::string(), validation_error);
+      return;
+    }
+    if (name == "tabs.captureVisibleTab") {
+      // 宿主先声明当前活动标签，内核用真实 WebContents 与
+      // activeTab/<all_urls> 权限预授权；实际截图回包还要经过 TabCapture v1
+      // 信封复核，覆盖查询到截图之间切换标签或导航的竞态。
+      base::ListValue query_args;
+      base::DictValue query;
+      query.Set("active", true);
+      query.Set("currentWindow", true);
+      query_args.Append(std::move(query));
+      std::string query_json;
+      base::JSONWriter::Write(query_args, &query_json);
+      CallHostApiFromKernelFrom(
+          who_, extension_id, "tabs.query", query_json,
+          base::BindOnce(
+              [](ExtCallerIdentity who, std::string extension_id,
+                 std::string capture_args, mojom::ExtApiHost::CallCallback done,
+                 const std::string &query_result, const std::string &error) {
+                if (!error.empty()) {
+                  std::move(done).Run(std::string(), error);
+                  return;
+                }
+                std::string authorization_error;
+                if (!AuthorizeHostVisibleTabCapture(
+                        extension_id, who.runtime_off_the_record, query_result,
+                        &authorization_error)) {
+                  std::move(done).Run(std::string(), authorization_error);
+                  return;
+                }
+                CallHostApiFromKernelFrom(who, extension_id,
+                                          "tabs.captureVisibleTab",
+                                          capture_args, std::move(done));
+              },
+              who_, extension_id, args_json, std::move(callback)));
+      return;
+    }
+  }
+
+  if (name == "search.query") {
+    if (GrantedPermissionsContain(extension_id, {"search"}, {}) != 1) {
+      std::move(callback).Run(std::string(),
+                              "search.query: search permission required");
+      return;
+    }
+    auto args = base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+    base::DictValue *query =
+        args && !args->empty() ? (*args)[0].GetIfDict() : nullptr;
+    const std::string *text = query ? query->FindString("text") : nullptr;
+    if (!query || !text) {
+      std::move(callback).Run(std::string(),
+                              "search.query: queryInfo.text is required");
+      return;
+    }
+    if (query->FindString("disposition") && query->FindInt("tabId")) {
+      std::move(callback).Run(
+          std::string(),
+          "search.query: tabId and disposition are mutually exclusive");
+      return;
+    }
+    if (query->FindString("disposition") &&
+        *query->FindString("disposition") == "NEW_WINDOW") {
+      // Android has a single browser-window model. The documented product
+      // fallback is a foreground new tab, never a fake second window.
+      query->Set("disposition", "NEW_TAB");
+    }
+    std::string normalized_args;
+    base::JSONWriter::Write(*args, &normalized_args);
+    CallHostApiFromKernelFrom(who_, extension_id, name, normalized_args,
+                              std::move(callback));
+    return;
+  }
+
+  if (IsHostOwnedApi(name)) {
+    if (IsExtensionDisabled(extension_id)) {
+      std::move(callback).Run(std::string(), name + ": 扩展已停用");
+      return;
+    }
+    const char *required_permission = nullptr;
+    if (HasApiPrefix(name, "sessions.")) {
+      required_permission = "sessions";
+    } else if (name == "downloads.open") {
+      required_permission = "downloads.open";
+    } else if (HasApiPrefix(name, "downloads.")) {
+      required_permission = "downloads";
+    } else if (HasApiPrefix(name, "history.")) {
+      required_permission = "history";
+    } else if (HasApiPrefix(name, "bookmarks.")) {
+      required_permission = "bookmarks";
+    } else if (HasApiPrefix(name, "notifications.")) {
+      required_permission = "notifications";
+    } else if (HasApiPrefix(name, "identity.")) {
+      required_permission = "identity";
+    } else if (HasApiPrefix(name, "declarativeContent.")) {
+      required_permission = "declarativeContent";
+    } else if (HasApiPrefix(name, "system.cpu.")) {
+      required_permission = "system.cpu";
+    } else if (HasApiPrefix(name, "system.memory.")) {
+      required_permission = "system.memory";
+    } else if (HasApiPrefix(name, "storage.sync.") ||
+               HasApiPrefix(name, "storage.managed.")) {
+      required_permission = "storage";
+    }
+    if (required_permission &&
+        GrantedPermissionsContain(extension_id, {required_permission}, {}) !=
+            1) {
+      std::move(callback).Run(std::string(), name + ": " + required_permission +
+                                                 " permission required");
+      return;
+    }
+    if ((name == "system.cpu.getInfo" || name == "system.memory.getInfo") &&
+        !HasExtensionPermissionConsent(extension_id, required_permission)) {
+      std::move(callback).Run(
+          std::string(),
+          name + ": independent high-risk hardware-info consent required");
+      return;
+    }
+    if (name == "system.cpu.getInfo" || name == "system.memory.getInfo") {
+      LOG(INFO) << "[arupa][privacy-audit] high-risk hardware-info call "
+                << "extension=" << extension_id << " method=" << name
+                << " installGeneration="
+                << GetExtensionInstallGeneration(extension_id)
+                << " consent=granted";
+    }
+    CallHostApiFromKernelFrom(who_, extension_id, name, args_json,
+                              std::move(callback));
+    return;
+  }
+  std::move(callback).Run(std::string(),
+                          name + ": not supported in this browser");
+}
+
+// 丢弃该扩展的安装代次（卸载时必须调）。
+//
+// SetExtensionInstallGeneration 拒绝代次回退，而宿主重装同一个扩展时通常从 1
+// 重新开始编号 —— 不先把旧代次清掉，重装后的第一次 setGeneration 会被当成"回退"
+// 直接拒收，于是代次永远停在旧值。
+void ClearExtensionInstallGeneration(const std::string &extension_id) {
+  if (extension_id.empty()) {
+    return;
+  }
+  bool erased = false;
+  {
+    base::AutoLock guard(Ctx().lock);
+    erased = Ctx().generation.erase(extension_id) > 0;
+    const std::string prefix = extension_id + "\n";
+    std::erase_if(Ctx().event_source_positions, [&](const auto &item) {
+      return item.first.starts_with(prefix);
+    });
+    std::erase_if(Ctx().storage_revisions, [&](const auto &item) {
+      return item.first.starts_with(prefix);
+    });
+    std::erase_if(Ctx().storage_commit_ids, [&](const std::string &item) {
+      return item.starts_with(prefix);
+    });
+  }
+  if (erased) {
+    LOG(INFO) << "[arupa][extapi] 安装代次已清除 ext=" << extension_id;
+  }
+}
+
+void SetExtensionInstallGeneration(const std::string &extension_id,
+                                   int64_t generation) {
+  if (extension_id.empty() || generation <= 0) {
+    LOG(WARNING) << "[arupa][extapi] 安装代次拒收: id 为空或代次不是正数";
+    return;
+  }
+  bool bumped = false;
+  {
+    base::AutoLock guard(Ctx().lock);
+    auto it = Ctx().generation.find(extension_id);
+    if (it != Ctx().generation.end() && generation < it->second) {
+      LOG(ERROR) << "[arupa][extapi] 安装代次**回退**被拒 ext=" << extension_id
+                 << " 现有=" << it->second << " 来的=" << generation;
+      return;
+    }
+    bumped = it != Ctx().generation.end() && generation > it->second;
+    Ctx().generation[extension_id] = generation;
+    LOG(INFO) << "[arupa][extapi] 安装代次 ext=" << extension_id << " = "
+              << generation;
+  }
+  if (bumped) {
+    // 装机代次一变, 旧代次的在途调用、窗口与租约全部作废, 并通知宿主。
+    InvalidateExtensionContexts(extension_id,
+                                "扩展安装代次已变(旧代次的调用一律作废)");
+    // 可选权限授权也属于"旧代次"的用户决定: 重装后必须重新授权, 不能沿用。
+    ClearOptionalPermissionGrants(extension_id);
+  }
+}
+
+void ArupaExtApiHost::AckResponse(const std::string &extension_id,
+                                  const std::string &request_uuid) {
+  if (!CallerMayActAs(extension_id)) {
+    return;
+  }
+  AcknowledgePageCapture(render_process_id_, extension_id, request_uuid);
+}
+
+int64_t GetExtensionInstallGeneration(const std::string &extension_id) {
+  base::AutoLock guard(Ctx().lock);
+  auto it = Ctx().generation.find(extension_id);
+  return it == Ctx().generation.end() ? 0 : it->second;
+}
+
+namespace {
+struct ConsentStore {
+  base::Lock lock;
+  std::set<std::string> granted;
+  std::set<std::string> loaded_extensions;
+  std::set<std::string> restore_errors;
+  std::map<std::string, uint64_t> pending_updates;
+  uint64_t next_update = 0;
+  uint64_t root_generation = 0;
+};
+ConsentStore &Consents() {
+  static base::NoDestructor<ConsentStore> s;
+  return *s;
+}
+
+constexpr char kPermissionConsentsKey[] = "permission_consents_v1";
+
+std::string ConsentStorageId(const std::string &extension_id) {
+  return extension_id + "/__arupa_internal";
+}
+
+bool EnsureConsentsLoadedLocked(const std::string &extension_id) {
+  const uint64_t current_root =
+      mv3::PluginStorage::Get().CurrentRootGeneration();
+  if (Consents().root_generation != current_root) {
+    Consents().granted.clear();
+    Consents().loaded_extensions.clear();
+    Consents().restore_errors.clear();
+    Consents().pending_updates.clear();
+    Consents().root_generation = current_root;
+  }
+  if (!Consents().loaded_extensions.insert(extension_id).second) {
+    return !Consents().restore_errors.contains(extension_id);
+  }
+  const mv3::StorageReadResult read =
+      mv3::PluginStorage::Get().GetAllValuesChecked(
+          ConsentStorageId(extension_id));
+  const auto values =
+      read.status == mv3::StorageWriteResult::kOk
+          ? base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC)
+          : std::optional<base::DictValue>();
+  if (!values) {
+    Consents().restore_errors.insert(extension_id);
+    LOG(ERROR) << "[arupa][consent] 持久账本不可读 ext=" << extension_id;
+    return false;
+  }
+  const base::Value *stored = values->Find(kPermissionConsentsKey);
+  if (!stored) {
+    return true;
+  }
+  const base::ListValue *permissions = stored->GetIfList();
+  if (!permissions) {
+    Consents().restore_errors.insert(extension_id);
+    LOG(ERROR) << "[arupa][consent] 持久账本损坏 ext=" << extension_id;
+    return false;
+  }
+  for (const base::Value &value : *permissions) {
+    if (!value.is_string() || value.GetString().empty()) {
+      Consents().restore_errors.insert(extension_id);
+      return false;
+    }
+  }
+  for (const base::Value &value : *permissions) {
+    Consents().granted.insert(extension_id + "\n" + value.GetString());
+  }
+  return true;
+}
+} // namespace
+
+// 丢弃该扩展的全部"用户已同意"记录（卸载时必须调）。
+//
+// 不清的后果：用户卸载扩展 → 重装同名扩展 → 权限同意记录还在，
+// chrome.permissions.request 不再弹窗直接授予 —— 用户根本没再同意过一次。
+void ClearExtensionPermissionConsent(const std::string &extension_id) {
+  if (extension_id.empty()) {
+    return;
+  }
+  const std::string prefix = extension_id + "\n";
+  size_t erased = 0;
+  {
+    base::AutoLock guard(Consents().lock);
+    for (auto it = Consents().granted.begin();
+         it != Consents().granted.end();) {
+      if (it->compare(0, prefix.size(), prefix) == 0) {
+        it = Consents().granted.erase(it);
+        ++erased;
+      } else {
+        ++it;
+      }
+    }
+    Consents().loaded_extensions.erase(extension_id);
+    Consents().restore_errors.erase(extension_id);
+    Consents().pending_updates.erase(extension_id);
+  }
+  // 磁盘清理由 PurgeExtensionData 的有序 ClearAsync 统一确认，不能在这里
+  // 用旧 RemoveValue 排队并误称已清干净。
+  LOG(INFO) << "[arupa][consent] 已清除 ext=" << extension_id << " 的 "
+            << erased << " 条同意记录";
+}
+
+void SetExtensionPermissionConsent(const std::string &extension_id,
+                                   const std::string &permission,
+                                   bool granted) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (extension_id.empty() || permission.empty()) {
+    return;
+  }
+  if (IsOptionalPermissionTransactionPending(extension_id) ||
+      siteaudit::IsExtensionPurging(extension_id)) {
+    LOG(ERROR)
+        << "[arupa][consent] 扩展权限事务或卸载清理进行中，拒绝并发写入 ext="
+        << extension_id;
+    return;
+  }
+  std::vector<std::string> next;
+  uint64_t token = 0;
+  {
+    base::AutoLock guard(Consents().lock);
+    if (!EnsureConsentsLoadedLocked(extension_id) ||
+        Consents().pending_updates.contains(extension_id)) {
+      LOG(ERROR) << "[arupa][consent] 持久账本不可用或已有写入 ext="
+                 << extension_id;
+      return;
+    }
+    const std::string prefix = extension_id + "\n";
+    for (const std::string &key : Consents().granted) {
+      if (key.starts_with(prefix)) {
+        next.push_back(key.substr(prefix.size()));
+      }
+    }
+    auto it = std::find(next.begin(), next.end(), permission);
+    // Replaying the same host-side decision is a common part of every enable
+    // attempt.  Treat it as an idempotent read: scheduling an empty storage
+    // write would publish a transient pending state, and the immediately
+    // following SetExtensionEnabled() would then fail closed with
+    // kOptionalPermissionStateDesynchronized.  In particular, a disabled
+    // extension could never be enabled again because every retry created a
+    // fresh pending write before checking enablement.
+    if ((granted && it != next.end()) || (!granted && it == next.end())) {
+      return;
+    }
+    if (granted && it == next.end()) {
+      next.push_back(permission);
+    } else if (!granted && it != next.end()) {
+      next.erase(it);
+    }
+    token = ++Consents().next_update;
+    Consents().pending_updates[extension_id] = token;
+  }
+  base::ListValue list;
+  for (const std::string &item : next) {
+    list.Append(item);
+  }
+  const auto json = base::WriteJson(list);
+  if (!json) {
+    base::AutoLock guard(Consents().lock);
+    Consents().pending_updates.erase(extension_id);
+    LOG(ERROR) << "[arupa][consent] 用户授权序列化失败 ext=" << extension_id;
+    return;
+  }
+  mv3::PluginStorage::Get().SetValuesAsync(
+      ConsentStorageId(extension_id), {{kPermissionConsentsKey, *json}},
+      base::BindOnce(
+          [](std::string id, uint64_t token, std::vector<std::string> next,
+             mv3::StorageCommitResult result) {
+            base::AutoLock guard(Consents().lock);
+            auto pending = Consents().pending_updates.find(id);
+            if (pending == Consents().pending_updates.end() ||
+                pending->second != token) {
+              return;
+            }
+            Consents().pending_updates.erase(pending);
+            if (result.status != mv3::StorageWriteResult::kOk) {
+              LOG(ERROR) << "[arupa][consent] 用户授权持久化失败 ext=" << id
+                         << " reason="
+                         << mv3::StorageWriteResultMessage(result.status);
+              return;
+            }
+            const std::string prefix = id + "\n";
+            for (auto it = Consents().granted.begin();
+                 it != Consents().granted.end();) {
+              it =
+                  it->starts_with(prefix) ? Consents().granted.erase(it) : ++it;
+            }
+            for (const std::string &permission : next) {
+              Consents().granted.insert(prefix + permission);
+            }
+          },
+          extension_id, token, std::move(next)));
+}
+
+bool HasExtensionPermissionConsent(const std::string &extension_id,
+                                   const std::string &permission) {
+  base::AutoLock guard(Consents().lock);
+  if (!EnsureConsentsLoadedLocked(extension_id)) {
+    return false;
+  }
+  return Consents().granted.count(extension_id + "\n" + permission) > 0;
+}
+
+bool GetExtensionPermissionConsents(const std::string &extension_id,
+                                    std::vector<std::string> *permissions) {
+  base::AutoLock guard(Consents().lock);
+  if (!EnsureConsentsLoadedLocked(extension_id) ||
+      Consents().pending_updates.contains(extension_id)) {
+    return false;
+  }
+  permissions->clear();
+  const std::string prefix = extension_id + "\n";
+  for (const std::string &key : Consents().granted) {
+    if (key.starts_with(prefix)) {
+      permissions->push_back(key.substr(prefix.size()));
+    }
+  }
+  return true;
+}
+
+void ReplaceExtensionPermissionConsents(
+    const std::string &extension_id,
+    const std::vector<std::string> &permissions) {
+  base::AutoLock guard(Consents().lock);
+  const std::string prefix = extension_id + "\n";
+  for (auto it = Consents().granted.begin(); it != Consents().granted.end();) {
+    it = it->starts_with(prefix) ? Consents().granted.erase(it) : ++it;
+  }
+  for (const std::string &permission : permissions) {
+    Consents().granted.insert(prefix + permission);
+  }
+  Consents().loaded_extensions.insert(extension_id);
+  Consents().restore_errors.erase(extension_id);
+}
+
+// 外部可见入口（声明在 arupa_ext_api_host.h）。实现本体在上面的匿名 namespace
+// 里 （DispatchSiteAuditMethodImpl），匿名 namespace
+// 的函数是内部链接，链接期满足不了 其它 TU 对 arupa::DispatchSiteAuditMethod
+// 的引用，所以这里补一层外部链接的转发。
+bool DispatchSiteAuditMethod(const ExtCallerIdentity &who,
+                             const std::string &extension_id,
+                             const std::string &name,
+                             const std::string &args_json,
+                             mojom::ExtApiHost::CallCallback &callback,
+                             bool require_audit_consent) {
+  return DispatchSiteAuditMethodImpl(who, extension_id, name, args_json,
+                                     callback, require_audit_consent);
+}
+
+namespace {
+
+// 能消费独立审计账本的扩展: 清单授予 nomadSitePermissionAudit(旧包),
+// 或经宿主授予 逐权限同意(留痕 0.4.5 起移除清单权限, 改走标准 native messaging
+// + 逐权限同意)。 两路取并集, 否则新包拿不到事件。
+bool MayConsumeSiteAuditLedger(const std::string &extension_id) {
+  const bool explicitly_consented =
+      GrantedPermissionsContain(extension_id,
+                                {"nomadSitePermissionAudit"}, {}) == 1 &&
+      HasExtensionPermissionConsent(extension_id,
+                                    "nomadSitePermissionAudit");
+  const bool trusted_native =
+      IsTrustedSiteAuditConsumer(extension_id) &&
+      GrantedPermissionsContain(extension_id, {"nativeMessaging"}, {}) == 1;
+  return explicitly_consented || trusted_native;
+}
