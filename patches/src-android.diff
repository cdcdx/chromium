+        px[0] = ArupaClampByte(px[0] + n);
+        px[1] = ArupaClampByte(px[1] + n);
+        px[2] = ArupaClampByte(px[2] + n);
+      }
+    }
+  }
+  sk_sp<SkImage> retained =
+      SkImages::RasterFromData(info, std::move(data), row_bytes);
+  if (!retained)
+    return nullptr;
+  SkPixmap retained_pixmap;
+  if (!retained->peekPixels(&retained_pixmap))
+    return nullptr;
+  std::unique_ptr<ImageDataBuffer> buffer =
+      base::WrapUnique(new ImageDataBuffer(retained_pixmap));
+  buffer->retained_image_ = std::move(retained);
+  if (!buffer->IsValid())
+    return nullptr;
+  return buffer;
+}
