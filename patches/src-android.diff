+void PostToUi(base::OnceClosure task) {
+  if (OnUiThread()) {
+    std::move(task).Run();
+    return;
+  }
+  content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE, std::move(task));
+}
+
+void ReportContextInvalidated(const std::string &extension_id,
+                              const std::string &context_json,
+                              const std::string &reason) {
+  PostToUi(base::BindOnce(
+      [](std::string ext, std::string ctx, std::string why) {
+        // 不唤醒刚停止的 Worker（否则停止→唤醒可形成循环）；仍通知存活的
+        // 扩展页与 Worker，让它们重读可信身份，不信任通知载荷。
+        NotifySiteAuditContextChanged(ext);
+        if (!ContextObserver().cb) {
+          VLOG(1) << "[arupa][ctx] 上下文失效但宿主没登记观察者 ext=" << ext
+                  << " 原因=" << why;
+          return;
+        }
+        LOG(INFO) << "[arupa][ctx] 上下文失效 ext=" << ext << " 原因=" << why;
+        ContextObserver().cb(ContextObserver().user, ext.c_str(), ctx.c_str(),
+                             why.c_str());
+      },
+      extension_id, context_json, reason));
+}
