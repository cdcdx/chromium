+} // namespace
+
+// 净化(S-01): declarativeNetRequest 动态规则。
+//
+// 分工: 查询/校验/持久化在内核(arupa_dnr_rules, 规则集权威在这里);
+// 能不能真的拦住请求 由宿主拦截引擎说了算。updateDynamicRules
+// 只有拿到宿主"已生效"的有界回执才算成功;
+// 引擎没接通就明确失败(并把刚写入的规则回滚), 绝不返回"成功但一条都不命中"。
+bool HandleKernelOwnedDnr(const ExtCallerIdentity &who,
+                          const std::string &extension_id,
+                          const std::string &name, const std::string &args_json,
+                          mojom::ExtApiHost::CallCallback callback) {
+  const bool is_dynamic_update =
+      name == "declarativeNetRequest.updateDynamicRules";
+  const bool is_session_update =
+      name == "declarativeNetRequest.updateSessionRules";
+  const bool is_runtime_update = is_dynamic_update || is_session_update;
+  const bool is_rules_update =
+      is_runtime_update ||
+      name == "declarativeNetRequest.updateEnabledRulesets" ||
+      name == "declarativeNetRequest.updateStaticRules";
+  // 持久化和快照构建也可能比宿主回包更久。保活覆盖整笔 DNR 事务，而不是
+  // 只覆盖最后的 nomad.dnr.applyDynamicRules；补偿结束后才归还。
+  if (is_rules_update && who.kind == ExtCallerIdentity::Kind::kWorker) {
+    const bool acquired = AcquireWindowKeepAlive(who.worker_version_id);
+    if (!acquired) {
+      LOG(WARNING) << "[arupa][dnr] 拿不到事务保活 ext=" << extension_id
+                   << " api=" << name;
+    }
+    callback = base::BindOnce(
+        [](mojom::ExtApiHost::CallCallback inner, int64_t version,
+           bool release_keepalive, const std::string &result_json,
+           const std::string &error) {
+          if (release_keepalive) {
+            ReleaseWindowKeepAlive(version);
+          }
+          std::move(inner).Run(result_json, error);
+        },
+        std::move(callback), who.worker_version_id, acquired);
+  }
+
+  if (!is_runtime_update) {
+    if (name == "declarativeNetRequest.setExtensionActionOptions") {
+      const auto parsed =
+          base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+      const base::DictValue *options =
+          parsed && !parsed->empty() ? (*parsed)[0].GetIfDict() : nullptr;
+      if (!options || (!options->Find("displayActionCountAsBadgeText") &&
+                       !options->Find("tabUpdate"))) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrValidation,
+                     name + ": options must change the display preference or "
+                            "a tab action count"));
+        return true;
+      }
+      if (const base::Value *display =
+              options->Find("displayActionCountAsBadgeText");
+          display && !display->is_bool()) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               name + ": displayActionCountAsBadgeText must "
+                                      "be a boolean"));
+        return true;
+      }
+      if (const base::Value *tab_update = options->Find("tabUpdate")) {
+        const base::DictValue *update = tab_update->GetIfDict();
+        if (!update || !update->FindInt("tabId") ||
+            !update->FindInt("increment")) {
+          RunDnrFailure(std::move(callback),
+                        DnrError(kDnrErrValidation,
+                                 name + ": tabUpdate requires integer tabId "
+                                        "and increment"));
+          return true;
+        }
+      }
+      if (!mv3::DnrEngineAvailable()) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrEngine, name + ": production matcher unavailable"));
+        return true;
+      }
+      const std::optional<bool> display =
+          options->FindBool("displayActionCountAsBadgeText");
+      if (!display) {
+        CallHostApiFromKernelFrom(who, extension_id, name, args_json,
+                                  std::move(callback));
+        return true;
+      }
+      base::DictValue persisted;
+      persisted.Set("displayActionCountAsBadgeText", *display);
+      const auto encoded = base::WriteJson(persisted);
+      if (!encoded) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrValidation,
+                     name + ": failed to serialize persisted preference"));
+        return true;
+      }
+      const std::string storage_id = extension_id + "/__arupa_internal";
+      const std::string previous =
+          mv3::PluginStorage::Get().GetValue(storage_id, kDnrActionOptionsKey);
+      // 先提交内核事实，再让宿主应用；宿主失败/超时则把旧值补偿回去。过去是
+      // 先宿主、后存储，磁盘失败会留下无法恢复的 split-brain。
+      mv3::PluginStorage::Get().SetValuesAsync(
+          storage_id, {{kDnrActionOptionsKey, *encoded}},
+          base::BindOnce(
+              [](ExtCallerIdentity who, std::string extension_id,
+                 std::string args_json, std::string storage_id,
+                 std::string previous, mojom::ExtApiHost::CallCallback done,
+                 mv3::StorageCommitResult persisted) {
+                if (persisted.status != mv3::StorageWriteResult::kOk) {
+                  std::move(done).Run(
+                      std::string(),
+                      "declarativeNetRequest.setExtensionActionOptions: "
+                      "persistence failed before host apply: " +
+                          std::string(mv3::StorageWriteResultMessage(
+                              persisted.status)));
+                  return;
+                }
+                CallHostApiFromKernelFrom(
+                    who, extension_id,
+                    "declarativeNetRequest.setExtensionActionOptions",
+                    args_json,
+                    base::BindOnce(
+                        [](std::string extension_id, std::string storage_id,
+                           std::string previous,
+                           mojom::ExtApiHost::CallCallback done,
+                           const std::string &result_json,
+                           const std::string &error) {
+                          if (error.empty()) {
+                            std::move(done).Run("[]", std::string());
+                            return;
+                          }
+                          auto rollback_done = base::BindOnce(
+                              [](std::string extension_id,
+                                 mojom::ExtApiHost::CallCallback done,
+                                 std::string host_error,
+                                 mv3::StorageCommitResult rollback) {
+                                if (rollback.status !=
+                                    mv3::StorageWriteResult::kOk) {
+                                  InvalidateHostDnrSnapshotReconciled(
+                                      extension_id);
+                                  {
+                                    base::AutoLock guard(S().lock);
+                                    S().reconciliation_required.insert(
+                                        extension_id +
+                                        "\ndeclarativeNetRequest."
+                                        "setExtensionActionOptions");
+                                  }
+                                  host_error +=
+                                      "; persistence compensation failed: " +
+                                      std::string(
+                                          mv3::StorageWriteResultMessage(
+                                              rollback.status));
+                                }
+                                std::move(done).Run(std::string(), host_error);
+                              },
+                              extension_id, std::move(done), error);
+                          if (previous.empty()) {
+                            mv3::PluginStorage::Get().RemoveValuesAsync(
+                                storage_id, {kDnrActionOptionsKey},
+                                std::move(rollback_done));
+                          } else {
+                            mv3::PluginStorage::Get().SetValuesAsync(
+                                storage_id, {{kDnrActionOptionsKey, previous}},
+                                std::move(rollback_done));
+                          }
+                        },
+                        extension_id, storage_id, previous, std::move(done)));
+              },
+              who, extension_id, args_json, storage_id, previous,
+              std::move(callback)));
+      return true;
+    }
+
+    if (name == "declarativeNetRequest.testMatchOutcome") {
+      const auto extension = FindLoadedExtension(extension_id);
+      if (!extension ||
+          !extensions::Manifest::IsUnpackedLocation(extension->location())) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               name + ": only unpacked extensions may call "
+                                      "this development API"));
+        return true;
+      }
+      const auto parsed =
+          base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+      const base::DictValue *details =
+          parsed && !parsed->empty() ? (*parsed)[0].GetIfDict() : nullptr;
+      const std::string *url = details ? details->FindString("url") : nullptr;
+      const std::string *type = details ? details->FindString("type") : nullptr;
+      if (!url || !GURL(*url).is_valid() || !type || type->empty()) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               name + ": valid url and request type required"));
+        return true;
+      }
+      if (!mv3::DnrEngineAvailable()) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrEngine, name + ": production matcher unavailable"));
+        return true;
+      }
+      CallHostApiFromKernelFrom(who, extension_id, name, args_json,
+                                std::move(callback));
+      return true;
+    }
+
+    // 与真正执行规则的 Android/Kotlin Regex 使用同一检查器，不能在 C++ 侧拿
+    // RE2 近似后声称支持（两者方言不同）。
+    if (name == "declarativeNetRequest.isRegexSupported") {
+      CallHostApiFromKernelFrom(who, extension_id, "nomad.dnr.isRegexSupported",
+                                args_json, std::move(callback));
+      return true;
+    }
+
+    if (name == "declarativeNetRequest.getMatchedRules") {
+      std::optional<int> tab_id;
+      std::optional<base::Value> args =
+          base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+      const base::ListValue *list =
+          args && args->is_list() ? &args->GetList() : nullptr;
+      if (list && !list->empty() && (*list)[0].is_dict()) {
+        tab_id = (*list)[0].GetDict().FindInt("tabId");
+      }
+      if (!HasDnrFeedbackPermission(extension_id, tab_id)) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrValidation,
+                     "declarativeNetRequest.getMatchedRules: "
+                     "declarativeNetRequestFeedback permission required"));
+        return true;
+      }
+      CallHostApiFromKernelFrom(who, extension_id, "nomad.dnr.getMatchedRules",
+                                args_json, std::move(callback));
+      return true;
+    }
+
+    if (name == "declarativeNetRequest.getAvailableStaticRuleCount") {
+      base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+          base::BindOnce(&mv3::GetAvailableStaticRuleCount, extension_id),
+          base::BindOnce(
+              [](mojom::ExtApiHost::CallCallback callback, int available) {
+                if (available < 0) {
+                  RunDnrFailure(
+                      std::move(callback),
+                      DnrError(
+                          kDnrErrStorage,
+                          "getAvailableStaticRuleCount: 静态规则状态不可读"));
+                  return;
+                }
+                base::ListValue result;
+                result.Append(available);
+                std::string out;
+                base::JSONWriter::Write(base::Value(std::move(result)), &out);
+                std::move(callback).Run(out, std::string());
+              },
+              std::move(callback)));
+      return true;
+    }
+
+    // ---- getEnabledRulesets: 内核自答(启用集合由内核持有, 见
+    // mv3/arupa_dnr_rules) ----
+    if (name == "declarativeNetRequest.getEnabledRulesets") {
+      const auto enabled = mv3::ReadEnabledRulesetIds(extension_id);
+      if (!enabled) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrStorage, "getEnabledRulesets: 启用集合不可读"));
+        return true;
+      }
+      const std::string read_error = DnrReadBlockReason(
+          extension_id, !enabled->empty(), "getEnabledRulesets");
+      if (!read_error.empty()) {
+        RunDnrFailure(std::move(callback), read_error);
+        return true;
+      }
+      base::ListValue call_args;
+      base::ListValue ids;
+      for (const auto &id : *enabled) {
+        ids.Append(id);
+      }
+      call_args.Append(std::move(ids));
+      std::string out;
+      base::JSONWriter::Write(base::Value(std::move(call_args)), &out);
+      std::move(callback).Run(out, std::string());
+      return true;
+    }
+
+    // ---- updateEnabledRulesets: 切启用集合, 再把整份生效规则推给宿主 ----
+    if (name == "declarativeNetRequest.updateEnabledRulesets") {
+      std::optional<base::Value> parsed =
+          base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+      const base::ListValue *call_args =
+          parsed && parsed->is_list() ? &parsed->GetList() : nullptr;
+      const base::DictValue *options = (call_args && !call_args->empty())
+                                           ? (*call_args)[0].GetIfDict()
+                                           : nullptr;
+      if (!options) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               "declarativeNetRequest.updateEnabledRulesets: "
+                               "缺少 options 参数"));
+        return true;
+      }
+      if (!mv3::DnrEngineAvailable()) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(
+                kDnrErrEngine,
+                "declarativeNetRequest.updateEnabledRulesets: 本机还没有可用的"
+                "拦截引擎, 规则未生效(引擎接入后重试即可)。"));
+        return true;
+      }
+      if (!BeginDnrUpdate(extension_id)) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(DnrDesynchronized(extension_id)
+                                   ? kDnrErrDesynchronized
+                                   : kDnrErrBusy,
+                               "declarativeNetRequest.updateEnabledRulesets: "
+                               "等待完整快照重建或当前规则回执"));
+        return true;
+      }
+      std::vector<std::string> enable_ids;
+      std::vector<std::string> disable_ids;
+      if (const base::ListValue *list = options->FindList("enableRulesetIds")) {
+        for (const auto &v : *list) {
+          if (const std::string *s = v.GetIfString()) {
+            enable_ids.push_back(*s);
+          }
+        }
+      }
+      if (const base::ListValue *list =
+              options->FindList("disableRulesetIds")) {
+        for (const auto &v : *list) {
+          if (const std::string *s = v.GetIfString()) {
+            disable_ids.push_back(*s);
+          }
+        }
+      }
+      const auto before_enabled = mv3::ReadEnabledRulesetIds(extension_id);
+      if (!before_enabled) {
+        FinishDnrUpdate(extension_id);
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrStorage, "updateEnabledRulesets: 启用集合不可读"));
+        return true;
+      }
+      mv3::UpdateEnabledRulesetsAsync(
+          extension_id, enable_ids, disable_ids,
+          base::BindOnce(&OnEnabledRulesetsCommitted, who, extension_id,
+                         *before_enabled, std::move(callback)));
+      return true;
+    }
+
+    if (name == "declarativeNetRequest.getDisabledRuleIds") {
+      const auto parsed =
+          base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+      const base::DictValue *options =
+          parsed && !parsed->empty() ? (*parsed)[0].GetIfDict() : nullptr;
+      const std::string *ruleset_id =
+          options ? options->FindString("rulesetId") : nullptr;
+      if (!ruleset_id || ruleset_id->empty()) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               "declarativeNetRequest.getDisabledRuleIds: "
+                               "options.rulesetId 必须是非空字符串"));
+        return true;
+      }
+      std::string query_error;
+      const std::vector<int> disabled = mv3::GetDisabledStaticRuleIds(
+          extension_id, *ruleset_id, &query_error);
+      if (!query_error.empty()) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(query_error == "disabled static rule storage is corrupted"
+                         ? kDnrErrStorage
+                         : kDnrErrRuleset,
+                     "declarativeNetRequest.getDisabledRuleIds: " +
+                         query_error));
+        return true;
+      }
+      base::ListValue ids;
+      for (int id : disabled) {
+        ids.Append(id);
+      }
+      base::ListValue result;
+      result.Append(std::move(ids));
+      std::string out;
+      base::JSONWriter::Write(base::Value(std::move(result)), &out);
+      std::move(callback).Run(out, std::string());
+      return true;
+    }
+
+    if (name == "declarativeNetRequest.updateStaticRules") {
+      const auto parsed =
+          base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+      const base::DictValue *options =
+          parsed && !parsed->empty() ? (*parsed)[0].GetIfDict() : nullptr;
+      const std::string *ruleset_id =
+          options ? options->FindString("rulesetId") : nullptr;
+      if (!ruleset_id || ruleset_id->empty()) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               "declarativeNetRequest.updateStaticRules: "
+                               "options.rulesetId 必须是非空字符串"));
+        return true;
+      }
+      auto read_ids = [&](const char *key, std::vector<int> *out) {
+        const base::Value *value = options->Find(key);
+        if (!value) {
+          return true;
+        }
+        const base::ListValue *list = value->GetIfList();
+        if (!list) {
+          return false;
+        }
+        for (const base::Value &item : *list) {
+          const std::optional<int> id = item.GetIfInt();
+          if (!id) {
+            return false;
+          }
+          out->push_back(*id);
+        }
+        return true;
+      };
+      std::vector<int> disable_ids;
+      std::vector<int> enable_ids;
+      if (!read_ids("disableRuleIds", &disable_ids) ||
+          !read_ids("enableRuleIds", &enable_ids)) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               "declarativeNetRequest.updateStaticRules: "
+                               "disableRuleIds/enableRuleIds 必须只包含整数"));
+        return true;
+      }
+      if (!BeginDnrUpdate(extension_id)) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(DnrDesynchronized(extension_id)
+                                   ? kDnrErrDesynchronized
+                                   : kDnrErrBusy,
+                               "declarativeNetRequest.updateStaticRules: "
+                               "等待完整快照重建或当前规则回执"));
+        return true;
+      }
+      std::string before_error;
+      const std::vector<int> before_disabled = mv3::GetDisabledStaticRuleIds(
+          extension_id, *ruleset_id, &before_error);
+      if (!before_error.empty()) {
+        FinishDnrUpdate(extension_id);
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(before_error == "disabled static rule storage is corrupted"
+                         ? kDnrErrStorage
+                         : kDnrErrRuleset,
+                     "declarativeNetRequest.updateStaticRules: " +
+                         before_error));
+        return true;
+      }
+
+      // Chromium 对空更新、重复更新直接成功；对当前未启用的
+      // ruleset 只更新持久化选择，等它下次启用时再进 matcher。
+      std::set<int> next_disabled(before_disabled.begin(),
+                                  before_disabled.end());
+      const std::set<int> requested_disabled(disable_ids.begin(),
+                                             disable_ids.end());
+      for (int id : enable_ids) {
+        if (!requested_disabled.contains(id)) {
+          next_disabled.erase(id);
+        }
+      }
+      next_disabled.insert(requested_disabled.begin(),
+                           requested_disabled.end());
+      if (std::vector<int>(next_disabled.begin(), next_disabled.end()) ==
+          before_disabled) {
+        FinishDnrUpdate(extension_id);
+        std::move(callback).Run("[]", std::string());
+        return true;
+      }
+      const auto enabled_rulesets = mv3::ReadEnabledRulesetIds(extension_id);
+      if (!enabled_rulesets) {
+        FinishDnrUpdate(extension_id);
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrStorage, "updateStaticRules: 启用集合不可读"));
+        return true;
+      }
+      const bool changes_effective_snapshot =
+          std::ranges::find(*enabled_rulesets, *ruleset_id) !=
+          enabled_rulesets->end();
+      if (changes_effective_snapshot && !mv3::DnrEngineAvailable()) {
+        FinishDnrUpdate(extension_id);
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrEngine,
+                               "declarativeNetRequest.updateStaticRules: "
+                               "本机还没有可用的拦截引擎, 规则未生效"));
+        return true;
+      }
+      mv3::UpdateStaticRulesAsync(
+          extension_id, *ruleset_id, disable_ids, enable_ids,
+          base::BindOnce(&OnStaticRulesCommitted, who, extension_id,
+                         *ruleset_id, before_disabled,
+                         changes_effective_snapshot, std::move(callback)));
+      return true;
+    }
+
+    // ---- getDynamicRules: 只答动态规则(静态规则不在这个 API 的契约里) ----
+    //
+    // 只读查询在确实没有规则时仍可回答空集合；已有规则则需要当前引擎代次的
+    // 快照回执，且在事务未完成或失同步时不能把存储快照冒充为实际生效状态。
+    if (name == "declarativeNetRequest.getDynamicRules") {
+      // 存储读不出来时必须报错，不能回 []：回 [] 等于告诉插件"你没有规则"，
+      // 插件会重新下发，而真实原因（存储损坏）永远看不见（S-03
+      // 回读失败可识别）。
+      if (!mv3::DynamicRulesStorageIntact(extension_id)) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrStorage,
+                     "declarativeNetRequest.getDynamicRules: 已存规则读不出来"
+                     "(存储损坏), 无法确认当前规则状态"));
+        return true;
+      }
+      const std::string dynamic_json = mv3::GetDynamicRulesJson(extension_id);
+      const std::string read_error = DnrReadBlockReason(
+          extension_id, dynamic_json != "[]", "getDynamicRules");
+      if (!read_error.empty()) {
+        RunDnrFailure(std::move(callback), read_error);
+        return true;
+      }
+      std::string out;
+      std::string error;
+      if (!mv3::BuildDnrRulesQueryResult(dynamic_json, args_json, &out,
+                                         &error)) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrValidation,
+                     "declarativeNetRequest.getDynamicRules: " + error));
+        return true;
+      }
+      std::move(callback).Run(out, std::string());
+      return true;
+    }
+
+    if (name == "declarativeNetRequest.getSessionRules") {
+      const std::string session_json = mv3::GetSessionRulesJson(extension_id);
+      const std::string read_error = DnrReadBlockReason(
+          extension_id, session_json != "[]", "getSessionRules");
+      if (!read_error.empty()) {
+        RunDnrFailure(std::move(callback), read_error);
+        return true;
+      }
+      std::string out;
+      std::string error;
+      if (!mv3::BuildDnrRulesQueryResult(session_json, args_json, &out,
+                                         &error)) {
+        RunDnrFailure(
+            std::move(callback),
+            DnrError(kDnrErrValidation,
+                     "declarativeNetRequest.getSessionRules: " + error));
+        return true;
+      }
+      std::move(callback).Run(out, std::string());
+      return true;
+    }
+
+    // 走到这里 = declarativeNetRequest 里内核不认识的方法。必须明确报错：
+    // 以前这里无条件返回动态规则，getSessionRules / getMatchedRules
+    // 这类没实现的
+    // 方法会拿到一份"看起来正常"的动态规则，插件以为拿到了想要的东西 ——
+    // 假保护。 支持面直接取
+    // mv3::kSupportedDnrMethods（唯一权威表）：文案不再是一份手抄的
+    // 方法清单，改这张表就等于改这里，出包门禁再拿它跟 schema 比对。
+    std::string supported;
+    for (const char *method : mv3::kSupportedDnrMethods) {
+      if (!supported.empty()) {
+        supported += " / ";
+      }
+      supported += method;
+    }
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(
+            kDnrErrUnsupported,
+            name +
+                ": 内核认识 declarativeNetRequest 这一族, 但**不认识这个方法**"
+                "(现支持: " +
+                supported + ")"));
+    return true;
+  }
+
+  if (!mv3::DnrEngineAvailable()) {
+    LOG(WARNING) << "[arupa][dnr] 规则引擎尚未接通, 拒绝更新 ext="
+                 << extension_id;
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(kDnrErrEngine, name + ": 本机还没有可用的拦截引擎, "
+                                       "规则未生效(引擎接入后重试即可)。"));
+    return true;
+  }
+
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+  const base::ListValue *call_args =
+      parsed && parsed->is_list() ? &parsed->GetList() : nullptr;
+  const base::DictValue *options = (call_args && !call_args->empty())
+                                       ? (*call_args)[0].GetIfDict()
+                                       : nullptr;
+  if (!options) {
+    RunDnrFailure(std::move(callback),
+                  DnrError(kDnrErrValidation, name + ": 缺少 options 参数"));
+    return true;
+  }
+
+  std::vector<int> remove_ids;
+  const base::Value *remove_value = options->Find("removeRuleIds");
+  if (remove_value && !remove_value->is_list()) {
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(kDnrErrValidation, name + ": removeRuleIds 必须是整数数组"));
+    return true;
+  }
+  if (const base::ListValue *list = options->FindList("removeRuleIds")) {
+    for (const base::Value &v : *list) {
+      if (!v.is_int()) {
+        RunDnrFailure(std::move(callback),
+                      DnrError(kDnrErrValidation,
+                               name + ": removeRuleIds 必须是整数数组"));
+        return true;
+      }
+      remove_ids.push_back(v.GetInt());
+    }
+  }
+  base::ListValue empty_rules;
+  const base::Value *add_value = options->Find("addRules");
+  if (add_value && !add_value->is_list()) {
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(kDnrErrValidation, name + ": addRules 必须是规则数组"));
+    return true;
+  }
+  const base::ListValue *add_rules = options->FindList("addRules");
+  if (!BeginDnrUpdate(extension_id)) {
+    RunDnrFailure(std::move(callback),
+                  DnrError(DnrDesynchronized(extension_id)
+                               ? kDnrErrDesynchronized
+                               : kDnrErrBusy,
+                           name + ": 等待完整快照重建或当前规则回执"));
+    return true;
+  }
+  const std::string before = is_dynamic_update
+                                 ? mv3::GetDynamicRulesJson(extension_id)
+                                 : mv3::GetSessionRulesJson(extension_id);
+  if (is_dynamic_update) {
+    mv3::UpdateDynamicRulesAsync(
+        extension_id, remove_ids, add_rules ? *add_rules : empty_rules,
+        base::BindOnce(&OnDynamicRulesCommitted, who, extension_id, before,
+                       std::move(callback)));
+    return true;
+  }
+  const mv3::DnrUpdateOutcome outcome = mv3::UpdateSessionRules(
+      extension_id, remove_ids, add_rules ? *add_rules : empty_rules);
+  if (!outcome.ok) {
+    FinishDnrUpdate(extension_id);
+    // 错误分类由内核给出（storage_error），不靠调用方匹配中文文案（S-03）。
+    RunDnrFailure(
+        std::move(callback),
+        DnrError(outcome.storage_error ? kDnrErrStorage : kDnrErrValidation,
+                 name + ": " + outcome.error));
+    return true;
+  }
+
+  // 把**整份生效规则**推给宿主引擎(宿主按扩展替换自己的规则集), 等有界回执。
+  // 生效规则 = 静态规则集 + 动态规则 + session 规则。任何一类更新都推整份快照，
+  // 避免宿主只替换其中一类后误删另外两类。
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&BuildEffectiveDnrPushJson, extension_id,
+                     CaptureDnrHostAccessPolicy(extension_id)),
+      base::BindOnce(&PushRuntimeRulesSnapshot, is_dynamic_update, who,
+                     extension_id, before, std::move(callback)));
+  return true;
+}
+
+// 站点内容设置变更广播（K5）：把「一份站点设置被改写」投给所有持有
+// contentSettings 权限的 已装扩展 —— 与 cookies.onChanged / webNavigation.*
+// 同一条唤醒派发口径（SW 挂起时排队唤醒， 不静默丢弃）。事件源是**内核侧经本
+// API 的改写**：set/clear 成功回执后触发。宿主 UI / 系统
+// 权限变化引起的改动当前没有回传内核，故不在事件之列（不虚报覆盖面）。
+void DispatchContentSettingsChanged(const std::string &content_type,
+                                    const mv3::ContentSettingsTarget &target,
+                                    const std::string &setting) {
+  base::DictValue details;
+  details.Set("type", content_type);
+  details.Set("primaryPattern", target.primary_pattern);
+  // 本端一个 origin 一份设置：secondary 就是 primary 自身。
+  details.Set("secondaryPattern", target.primary_pattern);
+  base::DictValue identifier;
+  identifier.Set("id", target.resource);
+  details.Set("resourceIdentifier", std::move(identifier));
+  // 无痕没有独立设置表，事件只描述普通册。
+  details.Set("incognito", false);
+  details.Set("setting", setting);
+
+  int delivered = 0, queued = 0;
+  for (const std::string &ext_id : LoadedExtensionIds()) {
+    if (GrantedPermissionsContain(ext_id, {"contentSettings"}, {}) != 1) {
+      continue;
+    }
+    base::ListValue args;
+    args.Append(details.Clone());
+    const int rc = WakeDispatchToAllActiveServiceWorkers(
+        ext_id, "contentSettings.onChanged", args.Clone(), false);
+    if (rc == kExtEventDelivered) {
+      ++delivered;
+    } else if (rc == kExtEventQueued) {
+      ++queued;
+    }
+  }
+  LOG(INFO) << "[arupa][contentsettings] onChanged origin=" << target.origin
+            << " resource=" << target.resource << " setting=" << setting
+            << " · SW 送达 " << delivered << " · 排队唤醒 " << queued;
+}
+
+struct OwnedContentSettingRule {
+  std::string ledger_key;
+  std::string content_type;
+  mv3::ContentSettingsTarget target;
+  std::string previous_setting;
+  std::string applied_setting;
+};
+
+std::set<std::string> &ContentSettingMutationsInFlight() {
+  static base::NoDestructor<std::set<std::string>> operations;
+  return *operations;
+}
+
+bool AcquireContentSettingMutation(const std::string &extension_id,
+                                   const std::string &content_type,
+                                   mojom::ExtApiHost::CallCallback *callback) {
+  const std::string key = extension_id + "\n" + content_type;
+  if (!ContentSettingMutationsInFlight().insert(key).second) {
+    return false;
+  }
+  *callback = base::BindOnce(
+      [](std::string key, mojom::ExtApiHost::CallCallback done,
+         const std::string &result, const std::string &error) {
+        ContentSettingMutationsInFlight().erase(key);
+        std::move(done).Run(result, error);
+      },
+      key, std::move(*callback));
+  return true;
+}
+
+std::string ContentSettingsLedgerStorageId(const std::string &extension_id) {
+  return extension_id + "/__arupa_internal";
+}
+
+std::string ContentSettingsLedgerKey(std::string_view content_type,
+                                     std::string_view origin) {
+  return std::string(kContentSettingsOwnershipKey) + ":" +
+         base::HexEncodeLower(crypto::SHA256HashString(
+             std::string(content_type) + "\n" + std::string(origin)));
+}
+
+std::optional<base::DictValue>
+ReadContentSettingsLedger(const std::string &extension_id) {
+  const mv3::StorageReadResult read =
+      mv3::PluginStorage::Get().GetAllValuesChecked(
+          ContentSettingsLedgerStorageId(extension_id));
+  const std::optional<base::DictValue> parsed =
+      read.status == mv3::StorageWriteResult::kOk
+          ? base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC)
+          : std::nullopt;
+  if (!parsed) {
+    LOG(ERROR) << "[arupa][contentsettings] 所有权账本损坏 ext="
+               << extension_id;
+    return std::nullopt;
+  }
+  base::DictValue ledger;
+  const std::string prefix = std::string(kContentSettingsOwnershipKey) + ":";
+  for (const auto [key, value] : *parsed) {
+    if (!key.starts_with(prefix)) {
+      continue;
+    }
+    if (!value.is_dict()) {
+      LOG(ERROR) << "[arupa][contentsettings] 所有权账本条目损坏 ext="
+                 << extension_id;
+      return std::nullopt;
+    }
+    ledger.Set(key, value.Clone());
+  }
+  return ledger;
+}
+
+void PersistContentSettingsLedgerEntry(
+    const std::string &extension_id, const std::string &ledger_key,
+    base::DictValue entry,
+    base::OnceCallback<void(mv3::StorageWriteResult)> callback) {
+  const std::optional<std::string> encoded = base::WriteJson(entry);
+  if (!encoded) {
+    std::move(callback).Run(mv3::StorageWriteResult::kSerializationFailed);
+    return;
+  }
+  mv3::PluginStorage::Get().SetValuesAsync(
+      ContentSettingsLedgerStorageId(extension_id), {{ledger_key, *encoded}},
+      base::BindOnce(
+          [](base::OnceCallback<void(mv3::StorageWriteResult)> done,
+             mv3::StorageCommitResult result) {
+            std::move(done).Run(result.status);
+          },
+          std::move(callback)));
+}
+
+std::string
+BuildContentSettingsHostArgs(const mv3::ContentSettingsTarget &target,
+                             const std::string *setting) {
+  base::DictValue request;
+  request.Set("requestOrigin", target.origin);
+  request.Set("permission", target.resource);
+  if (setting) {
+    request.Set("setting", *setting);
+  }
+  base::ListValue args;
+  args.Append(std::move(request));
+  std::string json;
+  base::JSONWriter::Write(base::Value(std::move(args)), &json);
+  return json;
+}
+
+bool ParseContentSettingsHostState(const std::string &result_json,
+                                   std::string *setting,
+                                   std::string *restriction,
+                                   std::string *error) {
+  const std::optional<base::ListValue> values =
+      base::JSONReader::ReadList(result_json, base::JSON_PARSE_RFC);
+  const base::DictValue *state =
+      values && values->size() == 1 ? (*values)[0].GetIfDict() : nullptr;
+  const std::string *raw_setting =
+      state ? state->FindString("setting") : nullptr;
+  const std::string *raw_restriction =
+      state ? state->FindString("systemRestriction") : nullptr;
+  if (!raw_setting || !mv3::IsSupportedContentSetting(*raw_setting) ||
+      !raw_restriction ||
+      (*raw_restriction != "none" && *raw_restriction != "blocked" &&
+       *raw_restriction != "unknown")) {
+    if (error) {
+      *error = "宿主站点设置回包的 setting/systemRestriction 枚举无效";
+    }
+    return false;
+  }
+  *setting = *raw_setting;
+  *restriction = *raw_restriction;
+  return true;
+}
+
+using ContentSettingReadCallback =
+    base::OnceCallback<void(std::string, std::string, std::string)>;
+
+void ReadContentSettingFromHost(const ExtCallerIdentity &who,
+                                const std::string &extension_id,
+                                const mv3::ContentSettingsTarget &target,
+                                ContentSettingReadCallback callback) {
+  CallHostApiFromKernelFrom(
+      who, extension_id, "contentSettings.get",
+      BuildContentSettingsHostArgs(target, nullptr),
+      base::BindOnce(
+          [](ContentSettingReadCallback done, const std::string &result_json,
+             const std::string &error) {
+            if (!error.empty()) {
+              std::move(done).Run(std::string(), std::string(), error);
+              return;
+            }
+            std::string setting;
+            std::string restriction;
+            std::string parse_error;
+            if (!ParseContentSettingsHostState(result_json, &setting,
+                                               &restriction, &parse_error)) {
+              std::move(done).Run(std::string(), std::string(), parse_error);
+              return;
+            }
+            std::move(done).Run(std::move(setting), std::move(restriction),
+                                std::string());
+          },
+          std::move(callback)));
+}
+
+void WriteContentSettingToHost(const ExtCallerIdentity &who,
+                               const std::string &extension_id,
+                               const mv3::ContentSettingsTarget &target,
+                               const std::string &setting,
+                               base::OnceCallback<void(std::string)> callback) {
+  CallHostApiFromKernelFrom(
+      who, extension_id, "contentSettings.set",
+      BuildContentSettingsHostArgs(target, &setting),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::string)> done, const std::string &,
+             const std::string &error) { std::move(done).Run(error); },
+          std::move(callback)));
+}
+
+void FreezeContentSettingsForReconciliation(const std::string &extension_id) {
+  base::AutoLock guard(S().lock);
+  S().reconciliation_required.insert(extension_id + "\ncontentSettings.set");
+  S().reconciliation_required.insert(extension_id + "\ncontentSettings.clear");
+}
+
+struct ContentSettingSetTransaction {
+  ExtCallerIdentity who;
+  std::string extension_id;
+  std::string content_type;
+  mv3::ContentSettingsTarget target;
+  std::string desired_setting;
+  std::string previous_setting;
+  std::string applied_setting;
+  int64_t install_generation = 0;
+  mojom::ExtApiHost::CallCallback callback;
+};
+
+void FailContentSettingSetWithCompensation(
+    std::unique_ptr<ContentSettingSetTransaction> tx, std::string reason) {
+  if (GetExtensionInstallGeneration(tx->extension_id) !=
+      tx->install_generation) {
+    FreezeContentSettingsForReconciliation(tx->extension_id);
+    std::move(tx->callback)
+        .Run(std::string(),
+             std::move(reason) +
+                 "; 扩展安装代次已变化，禁止旧事务补偿写并冻结等待对账");
+    return;
+  }
+  WriteContentSettingToHost(
+      tx->who, tx->extension_id, tx->target, tx->previous_setting,
+      base::BindOnce(
+          [](std::unique_ptr<ContentSettingSetTransaction> tx,
+             std::string reason, std::string compensation_error) {
+            if (!compensation_error.empty()) {
+              FreezeContentSettingsForReconciliation(tx->extension_id);
+              reason += "; 宿主补偿失败，已冻结 contentSettings: " +
+                        compensation_error;
+            }
+            std::move(tx->callback).Run(std::string(), std::move(reason));
+          },
+          std::move(tx), std::move(reason)));
+}
+
+void CommitOwnedContentSetting(
+    std::unique_ptr<ContentSettingSetTransaction> tx) {
+  if (GetExtensionInstallGeneration(tx->extension_id) !=
+      tx->install_generation) {
+    FreezeContentSettingsForReconciliation(tx->extension_id);
+    std::move(tx->callback)
+        .Run(std::string(),
+             "contentSettings.set: 持久化前扩展已重装，旧事务已冻结等待对账");
+    return;
+  }
+  std::optional<base::DictValue> ledger =
+      ReadContentSettingsLedger(tx->extension_id);
+  if (!ledger) {
+    FailContentSettingSetWithCompensation(
+        std::move(tx), "contentSettings.set: 所有权账本不可读");
+    return;
+  }
+  const std::string ledger_key =
+      ContentSettingsLedgerKey(tx->content_type, tx->target.origin);
+  std::string original_setting = tx->previous_setting;
+  if (const base::DictValue *existing = ledger->FindDict(ledger_key)) {
+    const std::string *generation = existing->FindString("installGeneration");
+    const std::string *previous = existing->FindString("previousSetting");
+    if (generation &&
+        *generation == base::NumberToString(tx->install_generation) &&
+        previous && mv3::IsSupportedContentSetting(*previous)) {
+      original_setting = *previous;
+    }
+  }
+  base::DictValue entry;
+  entry.Set("version", 2);
+  entry.Set("installGeneration", base::NumberToString(tx->install_generation));
+  entry.Set("contentType", tx->content_type);
+  entry.Set("origin", tx->target.origin);
+  entry.Set("permission", tx->target.resource);
+  entry.Set("primaryPattern", tx->target.primary_pattern);
+  entry.Set("scope", "regular");
+  entry.Set("previousSetting", original_setting);
+  entry.Set("appliedSetting", tx->applied_setting);
+  PersistContentSettingsLedgerEntry(
+      tx->extension_id, ledger_key, std::move(entry),
+      base::BindOnce(
+          [](std::unique_ptr<ContentSettingSetTransaction> tx,
+             mv3::StorageWriteResult result) {
+            if (result != mv3::StorageWriteResult::kOk) {
+              FailContentSettingSetWithCompensation(
+                  std::move(tx),
+                  "contentSettings.set: 所有权账本持久化失败: " +
+                      std::string(mv3::StorageWriteResultMessage(result)));
+              return;
+            }
+            if (GetExtensionInstallGeneration(tx->extension_id) !=
+                tx->install_generation) {
+              const std::string ledger_key =
+                  ContentSettingsLedgerKey(tx->content_type, tx->target.origin);
+              mv3::PluginStorage::Get().RemoveValuesAsync(
+                  ContentSettingsLedgerStorageId(tx->extension_id),
+                  {ledger_key},
+                  base::BindOnce(
+                      [](std::unique_ptr<ContentSettingSetTransaction> tx,
+                         mv3::StorageCommitResult cleanup) {
+                        std::string reason =
+                            "contentSettings.set: 持久化期间扩展已重装，"
+                            "禁止旧事务补偿写并冻结等待对账";
+                        FreezeContentSettingsForReconciliation(
+                            tx->extension_id);
+                        if (cleanup.status != mv3::StorageWriteResult::kOk) {
+                          reason += "; 旧代次账本清理失败，已冻结对账";
+                        }
+                        std::move(tx->callback)
+                            .Run(std::string(), std::move(reason));
+                      },
+                      std::move(tx)));
+              return;
+            }
+            DispatchContentSettingsChanged(tx->content_type, tx->target,
+                                           tx->applied_setting);
+            std::move(tx->callback).Run("[]", std::string());
+          },
+          std::move(tx)));
+}
+
+void BeginOwnedContentSettingSet(const ExtCallerIdentity &who,
+                                 const std::string &extension_id,
+                                 const std::string &content_type,
+                                 const mv3::ContentSettingsTarget &target,
+                                 const std::string &desired_setting,
+                                 mojom::ExtApiHost::CallCallback callback) {
+  auto tx = std::make_unique<ContentSettingSetTransaction>();
+  tx->who = who;
+  tx->extension_id = extension_id;
+  tx->content_type = content_type;
+  tx->target = target;
+  tx->desired_setting = desired_setting;
+  tx->install_generation = GetExtensionInstallGeneration(extension_id);
+  tx->callback = std::move(callback);
+  ReadContentSettingFromHost(
+      tx->who, tx->extension_id, tx->target,
+      base::BindOnce(
+          [](std::unique_ptr<ContentSettingSetTransaction> tx,
+             std::string previous, std::string, std::string error) {
+            if (!error.empty()) {
+              std::move(tx->callback).Run(std::string(), std::move(error));
+              return;
+            }
+            tx->previous_setting = std::move(previous);
+            WriteContentSettingToHost(
+                tx->who, tx->extension_id, tx->target, tx->desired_setting,
+                base::BindOnce(
+                    [](std::unique_ptr<ContentSettingSetTransaction> tx,
+                       std::string error) {
+                      if (!error.empty()) {
+                        std::move(tx->callback)
+                            .Run(std::string(), std::move(error));
+                        return;
+                      }
+                      ReadContentSettingFromHost(
+                          tx->who, tx->extension_id, tx->target,
+                          base::BindOnce(
+                              [](std::unique_ptr<ContentSettingSetTransaction>
+                                     tx,
+                                 std::string applied, std::string,
+                                 std::string error) {
+                                if (!error.empty() ||
+                                    applied != tx->desired_setting) {
+                                  FailContentSettingSetWithCompensation(
+                                      std::move(tx),
+                                      !error.empty()
+                                          ? std::move(error)
+                                          : "contentSettings.set: "
+                                            "宿主回读值与请求不一致");
+                                  return;
+                                }
+                                tx->applied_setting = std::move(applied);
+                                CommitOwnedContentSetting(std::move(tx));
+                              },
+                              std::move(tx)));
+                    },
+                    std::move(tx)));
+          },
+          std::move(tx)));
+}
+
+struct ContentSettingClearTransaction {
+  ExtCallerIdentity who;
+  std::string extension_id;
+  int64_t install_generation = 0;
+  std::vector<OwnedContentSettingRule> rules;
+  size_t next = 0;
+  mojom::ExtApiHost::CallCallback callback;
+};
+
+void ContinueOwnedContentSettingClear(
+    std::unique_ptr<ContentSettingClearTransaction> tx) {
+  if (GetExtensionInstallGeneration(tx->extension_id) !=
+      tx->install_generation) {
+    std::move(tx->callback)
+        .Run(std::string(), "contentSettings.clear: 扩展已在清理期间重装");
+    return;
+  }
+  if (tx->next == tx->rules.size()) {
+    std::move(tx->callback).Run("[]", std::string());
+    return;
+  }
+  const OwnedContentSettingRule &rule = tx->rules[tx->next];
+  WriteContentSettingToHost(
+      tx->who, tx->extension_id, rule.target, rule.previous_setting,
+      base::BindOnce(
+          [](std::unique_ptr<ContentSettingClearTransaction> tx,
+             std::string error) {
+            const OwnedContentSettingRule &rule = tx->rules[tx->next];
+            if (!error.empty()) {
+              std::move(tx->callback).Run(std::string(), std::move(error));
+              return;
+            }
+            if (GetExtensionInstallGeneration(tx->extension_id) !=
+                tx->install_generation) {
+              FreezeContentSettingsForReconciliation(tx->extension_id);
+              std::move(tx->callback)
+                  .Run(std::string(),
+                       "contentSettings.clear: 清理期间扩展已重装，禁止旧事务"
+                       "补偿写并冻结等待对账");
+              return;
+            }
+            mv3::PluginStorage::Get().RemoveValuesAsync(
+                ContentSettingsLedgerStorageId(tx->extension_id),
+                {rule.ledger_key},
+                base::BindOnce(
+                    [](std::unique_ptr<ContentSettingClearTransaction> tx,
+                       mv3::StorageCommitResult commit) {
+                      const OwnedContentSettingRule &rule = tx->rules[tx->next];
+                      const mv3::StorageWriteResult result = commit.status;
+                      if (result != mv3::StorageWriteResult::kOk) {
+                        if (GetExtensionInstallGeneration(tx->extension_id) !=
+                            tx->install_generation) {
+                          FreezeContentSettingsForReconciliation(
+                              tx->extension_id);
+                          std::move(tx->callback)
+                              .Run(std::string(),
+                                   "contentSettings.clear: 所有权账本提交失败"
+                                   "且扩展已重装，禁止旧事务补偿写并冻结等待对"
+                                   "账");
+                          return;
+                        }
+                        WriteContentSettingToHost(
+                            tx->who, tx->extension_id, rule.target,
+                            rule.applied_setting,
+                            base::BindOnce(
+                                [](std::unique_ptr<
+                                       ContentSettingClearTransaction>
+                                       tx,
+                                   mv3::StorageWriteResult result,
+                                   std::string compensation_error) {
+                                  if (!compensation_error.empty()) {
+                                    FreezeContentSettingsForReconciliation(
+                                        tx->extension_id);
+                                  }
+                                  std::move(tx->callback)
+                                      .Run(
+                                          std::string(),
+                                          "contentSettings.clear: "
+                                          "所有权账本提交失败: " +
+                                              std::string(
+                                                  mv3::
+                                                      StorageWriteResultMessage(
+                                                          result)) +
+                                              (compensation_error.empty()
+                                                   ? std::string()
+                                                   : "; "
+                                                     "宿主补偿失败，已冻结对"
+                                                     "账"));
+                                },
+                                std::move(tx), result));
+                        return;
+                      }
+                      if (GetExtensionInstallGeneration(tx->extension_id) !=
+                          tx->install_generation) {
+                        FreezeContentSettingsForReconciliation(
+                            tx->extension_id);
+                        std::move(tx->callback)
+                            .Run(std::string(),
+                                 "contentSettings.clear: "
+                                 "账本提交期间扩展已重装，已冻结等待对账");
+                        return;
+                      }
+                      DispatchContentSettingsChanged(rule.content_type,
+                                                     rule.target,
+                                                     rule.previous_setting);
+                      ++tx->next;
+                      ContinueOwnedContentSettingClear(std::move(tx));
+                    },
+                    std::move(tx)));
+          },
+          std::move(tx)));
+}
+
+void BeginOwnedContentSettingClear(const ExtCallerIdentity &who,
+                                   const std::string &extension_id,
+                                   const std::string &content_type,
+                                   mojom::ExtApiHost::CallCallback callback) {
+  auto tx = std::make_unique<ContentSettingClearTransaction>();
+  tx->who = who;
+  tx->extension_id = extension_id;
+  tx->install_generation = GetExtensionInstallGeneration(extension_id);
+  tx->callback = std::move(callback);
+  std::optional<base::DictValue> ledger =
+      ReadContentSettingsLedger(extension_id);
+  if (!ledger) {
+    std::move(tx->callback)
+        .Run(std::string(), "contentSettings.clear: 所有权账本不可读");
+    return;
+  }
+  for (const auto [key, value] : *ledger) {
+    const base::DictValue *entry = value.GetIfDict();
+    const std::string *generation =
+        entry ? entry->FindString("installGeneration") : nullptr;
+    const std::string *type =
+        entry ? entry->FindString("contentType") : nullptr;
+    const std::string *origin = entry ? entry->FindString("origin") : nullptr;
+    const std::string *permission =
+        entry ? entry->FindString("permission") : nullptr;
+    const std::string *pattern =
+        entry ? entry->FindString("primaryPattern") : nullptr;
+    const std::string *previous =
+        entry ? entry->FindString("previousSetting") : nullptr;
+    const std::string *applied =
+        entry ? entry->FindString("appliedSetting") : nullptr;
+    if (!generation ||
+        *generation != base::NumberToString(tx->install_generation) || !type ||
+        *type != content_type || !origin || !permission || !pattern ||
+        !previous || !applied || !mv3::IsSupportedContentSetting(*previous) ||
+        !mv3::IsSupportedContentSetting(*applied)) {
+      continue;
+    }
+    OwnedContentSettingRule rule;
+    rule.ledger_key = key;
+    rule.content_type = *type;
+    rule.target.origin = *origin;
+    rule.target.resource = *permission;
+    rule.target.primary_pattern = *pattern;
+    rule.previous_setting = *previous;
+    rule.applied_setting = *applied;
+    tx->rules.push_back(std::move(rule));
+  }
+  ContinueOwnedContentSettingClear(std::move(tx));
+}
+
+// 站点内容设置（T-05）：camera/microphone/location 的读改写。
+//
+// 内核负责三件事：校验标准 API 的
+// details（资源类型/模式/scope）、逐次核对扩展的 contentSettings 权限、把
+// (origin, permission[, setting]) 转发给宿主 SitePermissions ——
+// 那正是真实摄像头/麦克风/定位请求读的**同一份存储**，所以读到的是实际会生效的取值。
+// 宿主还会回 systemRestriction（Android 运行时权限是否给了）：站点设 allow
+// 而系统没给时 get 返回
+// block，不虚报"已允许"（T-05：不可选能力缺失可以，虚报不行）。
+bool HandleKernelOwnedContentSettings(
+    const ExtCallerIdentity &who, const std::string &extension_id,
+    const std::string &name, const std::string &args_json,
+    mojom::ExtApiHost::CallCallback callback) {
+  static constexpr std::string_view kPrefix = "contentSettings.";
+  if (!HasApiPrefix(name, kPrefix)) {
+    return false;
+  }
+  const std::string method = name.substr(kPrefix.size());
+  auto fail = [&callback, &method](const std::string &why) {
+    std::move(callback).Run(std::string(),
+                            "contentSettings." + method + ": " + why);
+  };
+
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext || !ext->permissions_data()) {
+    fail("扩展未加载");
+    return true;
+  }
+  if (!ext->permissions_data()->HasAPIPermission(
+          extensions::mojom::APIPermissionID::kContentSettings)) {
+    fail("该扩展没有 contentSettings 权限（清单未声明或未被授予）");
+    return true;
+  }
+  // 本端只有一份（普通）站点设置存储：无痕调用不读也不写 ——
+  // 否则改了普通册的设置却 以为改的是无痕（root
+  // 因四/五同一口径：宁可明确失败，也不做看不出效果的写）。
+  if (TabBookForCaller(who) == TabBook::kIncognito) {
+    fail("无痕下不读写站点设置（本端只有普通站点设置一份存储）");
+    return true;
+  }
+
+  auto reply_args = [&callback](base::ListValue args) {
+    std::string json;
+    base::JSONWriter::Write(base::Value(std::move(args)), &json);
+    std::move(callback).Run(json, std::string());
+  };
+
+  if (method != "get" && method != "set" && method != "clear") {
+    if (method != "getResourceIdentifiers") {
+      fail("内核不支持这个方法");
+      return true;
+    }
+  }
+
+  std::optional<base::ListValue> args =
+      base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+  // Chromium renderer 的 ContentSetting 自定义类型会把 property 对应的 pref
+  // name 插在参数首位：contentSettings.camera.get(details) 最终是
+  // contentSettings.get("media-stream-camera", details)。过去的 Android schema
+  // 错把 get/set 暴露成 namespace 顶层函数，逐风留痕使用的标准属性对象实际是
+  // undefined。
+  const std::string *content_type = nullptr;
+  const base::DictValue *details = nullptr;
+  if (args) {
+    for (const base::Value &value : *args) {
+      if (!content_type && value.is_string()) {
+        content_type = &value.GetString();
+      } else if (!details && value.is_dict()) {
+        details = &value.GetDict();
+      }
+    }
+  }
+  const char *resource =
+      content_type ? mv3::ContentSettingsResourceForType(*content_type)
+                   : nullptr;
+  if (!args || !content_type) {
+    fail("缺少 ContentSetting 类型");
+    return true;
+  }
+  if (!resource) {
+    // Standard types not owned by the kernel SitePermissions backend are
+    // delegated only when the Android host explicitly advertises the exact
+    // contentSettings member and ContentSetting data-model version.
+    CallHostApiFromKernelFrom(who, extension_id, name, args_json,
+                              std::move(callback));
+    return true;
+  }
+
+  if (method == "getResourceIdentifiers") {
+    base::ListValue call_args;
+    call_args.Append(mv3::ContentSettingsResourceIdentifiers());
+    reply_args(std::move(call_args));
+    return true;
+  }
+  if (method == "clear") {
+    if (!AcquireContentSettingMutation(extension_id, *content_type,
+                                       &callback)) {
+      fail("同一扩展与 ContentSetting 类型已有变更在途");
+      return true;
+    }
+    BeginOwnedContentSettingClear(who, extension_id, *content_type,
+                                  std::move(callback));
+    return true;
+  }
+  if (!details) {
+    fail("缺少 details 参数");
+    return true;
+  }
+  if (details->Find("resourceIdentifier")) {
+    fail("camera/microphone/location 不支持 resourceIdentifier 子类型");
+    return true;
+  }
+  base::DictValue normalized = details->Clone();
+  base::DictValue identifier;
+  identifier.Set("id", resource);
+  normalized.Set("resourceIdentifier", std::move(identifier));
+  if (method == "get") {
+    auto exact_pattern = [](const std::string *value,
+                            std::string *pattern) -> bool {
+      if (!value) {
+        return false;
+      }
+      const GURL url(*value);
+      if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+        return false;
+      }
+      const url::Origin origin = url::Origin::Create(url);
+      if (origin.opaque()) {
+        return false;
+      }
+      *pattern = origin.Serialize() + "/*";
+      return true;
+    };
+    std::string primary_pattern;
+    if (!exact_pattern(details->FindString("primaryUrl"), &primary_pattern)) {
+      fail("primaryUrl 必须是有效的 http/https URL");
+      return true;
+    }
+    normalized.Set("primaryPattern", primary_pattern);
+    if (const std::string *secondary = details->FindString("secondaryUrl")) {
+      std::string secondary_pattern;
+      if (!exact_pattern(secondary, &secondary_pattern)) {
+        fail("secondaryUrl 必须是有效的 http/https URL");
+        return true;
+      }
+      normalized.Set("secondaryPattern", secondary_pattern);
+    }
+  }
+
+  mv3::ContentSettingsTarget target;
+  std::string parse_error;
+  if (!mv3::ParseContentSettingsTarget(normalized, &target, &parse_error)) {
+    fail(parse_error);
+    return true;
+  }
+
+  if (method == "set") {
+    const std::string *value = normalized.FindString("setting");
+    if (!value) {
+      fail("缺少 setting");
+      return true;
+    }
+    if (!mv3::IsSupportedContentSetting(*value)) {
+      fail("setting 仅支持 allow|block|ask（收到 " + *value + "）");
+      return true;
+    }
+    if (!AcquireContentSettingMutation(extension_id, *content_type,
+                                       &callback)) {
+      fail("同一扩展与 ContentSetting 类型已有变更在途");
+      return true;
+    }
+    BeginOwnedContentSettingSet(who, extension_id, *content_type, target,
+                                *value, std::move(callback));
+    return true;
+  }
+  ReadContentSettingFromHost(
+      who, extension_id, target,
+      base::BindOnce(
+          [](mojom::ExtApiHost::CallCallback done, std::string setting,
+             std::string restriction, std::string error) {
+            if (!error.empty()) {
+              std::move(done).Run(std::string(), std::move(error));
+              return;
+            }
+            if (setting == "allow" && restriction != "none") {
+              setting = "block";
+            }
+            base::ListValue result;
+            result.Append(base::DictValue().Set("setting", setting));
+            std::string json;
+            base::JSONWriter::Write(base::Value(std::move(result)), &json);
+            std::move(done).Run(json, std::string());
+          },
+          std::move(callback)));
+  return true;
+}
+
+bool HandleKernelOwnedRuntime(const std::string &extension_id,
+                              const std::string &name,
+                              const std::string &args_json,
+                              mojom::ExtApiHost::CallCallback &callback) {
+  if (name == "runtime.getPlatformInfo") {
+    base::DictValue info;
+    info.Set("os", "android");
+#if defined(ARCH_CPU_ARM64)
+    info.Set("arch", "arm64");
+    info.Set("nacl_arch", "arm");
+#elif defined(ARCH_CPU_ARMEL)
+    info.Set("arch", "arm");
+    info.Set("nacl_arch", "arm");
+#elif defined(ARCH_CPU_X86_64)
+    info.Set("arch", "x86-64");
+    info.Set("nacl_arch", "x86-64");
+#elif defined(ARCH_CPU_X86)
+    info.Set("arch", "x86-32");
+    info.Set("nacl_arch", "x86-32");
+#else
+    info.Set("arch", "unknown");
+    info.Set("nacl_arch", "unknown");
+#endif
+    base::ListValue result;
+    result.Append(std::move(info));
+    std::string json;
+    base::JSONWriter::Write(result, &json);
+    std::move(callback).Run(json, std::string());
+    return true;
+  }
+  if (name != "runtime.setUninstallURL") {
+    return false;
+  }
+  auto reply = [&callback](const std::string &error) {
+    std::string json;
+    base::JSONWriter::Write(base::Value(base::ListValue()), &json);
+    std::move(callback).Run(error.empty() ? json : std::string(), error);
+  };
+
+  std::optional<base::ListValue> args =
+      base::JSONReader::ReadList(args_json, base::JSON_PARSE_RFC);
+  std::string url;
+  if (args && !args->empty() && (*args)[0].is_string()) {
+    url = (*args)[0].GetString();
+  }
+
+  if (!url.empty()) {
+    const GURL g(url);
+    if (!g.is_valid() || !(g.SchemeIs("http") || g.SchemeIs("https"))) {
+      reply(name + ": 只支持 http/https 的卸载页(收到 " + url +
+            ") —— 别的 scheme 一律拒: "
+            "那是把一个**卸载之后仍会执行**的东西交给扩展");
+      return true;
+    }
+  }
+  if (!FindLoadedExtension(extension_id)) {
+    reply(name + ": unknown extension (" + extension_id + ")");
+    return true;
+  }
+
+  auto committed = base::BindOnce(
+      [](std::string id, std::string persisted_url,
+         mojom::ExtApiHost::CallCallback done,
+         mv3::StorageCommitResult result) {
+        if (result.status != mv3::StorageWriteResult::kOk) {
+          std::move(done).Run(
+              std::string(),
+              "runtime.setUninstallURL: 持久化失败: " +
+                  std::string(mv3::StorageWriteResultMessage(result.status)));
+          return;
+        }
+        if (!FindLoadedExtension(id) || IsExtensionDisabled(id) ||
+            !SetActionUninstallUrl(id, persisted_url)) {
+          std::move(done).Run(
+              std::string(), "runtime.setUninstallURL: 扩展在持久化期间已失效");
+          return;
+        }
+        std::move(done).Run("[]", std::string());
+      },
+      extension_id, url, std::move(callback));
+  const std::string storage_id = extension_id + "/__arupa_internal";
+  if (url.empty()) {
+    mv3::PluginStorage::Get().RemoveValuesAsync(
+        storage_id, {kRuntimeUninstallUrlKey}, std::move(committed));
+    return true;
+  }
+  const std::optional<std::string> encoded = base::WriteJson(base::Value(url));
+  if (!encoded) {
+    // 理论上字符串不会序列化失败；仍保持确定错误，禁止无效成功。
+    std::move(committed).Run(mv3::StorageCommitResult{
+        .status = mv3::StorageWriteResult::kSerializationFailed});
+    return true;
+  }
+  mv3::PluginStorage::Get().SetValuesAsync(
+      storage_id, {{kRuntimeUninstallUrlKey, *encoded}}, std::move(committed));
+  return true;
+}
