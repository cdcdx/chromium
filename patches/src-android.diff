+}  // namespace
+
+namespace {
+struct PreparedDynamicRules {
+  DnrUpdateOutcome outcome;
+  std::string json;
+};
+
+PreparedDynamicRules PrepareDynamicRules(
+    const std::string& extension_id,
+    const std::vector<int>& remove_rule_ids,
+    const base::ListValue& add_rules) {
+  PreparedDynamicRules prepared;
+  DnrUpdateOutcome& out = prepared.outcome;
+  if (extension_id.empty()) {
+    out.error = "updateDynamicRules: 扩展 id 为空";
+    return prepared;
+  }
+
+  std::optional<base::ListValue> stored = ReadStoredRules(extension_id);
+  if (!stored) {
+    out.error = "updateDynamicRules: 已存规则不可读";
+    out.storage_error = true;
+    return prepared;
+  }
+
+  base::ListValue merged;
+  out =
+      MergeRuntimeRules("dynamic", *stored, SessionRulesSnapshot(extension_id),
+                        kMaxDynamicRules, kMaxUnsafeDynamicRules,
+                        remove_rule_ids, add_rules, &merged);
+  if (!out.ok) {
+    return prepared;
+  }
+
+  std::optional<std::string> json = base::WriteJson(merged);
+  if (!json) {
+    out.ok = false;
+    out.error = "updateDynamicRules: 规则序列化失败";
+    return prepared;
+  }
+  prepared.json = std::move(*json);
+  return prepared;
+}
+}  // namespace
+
+DnrUpdateOutcome UpdateDynamicRules(const std::string& extension_id,
+                                    const std::vector<int>& remove_rule_ids,
+                                    const base::ListValue& add_rules) {
+  PreparedDynamicRules prepared =
+      PrepareDynamicRules(extension_id, remove_rule_ids, add_rules);
+  DnrUpdateOutcome out = std::move(prepared.outcome);
+  if (!out.ok) {
+    return out;
+  }
+  if (PluginStorage::Get().SetValue(extension_id, kDnrDynamicRulesKey,
+                                    prepared.json) != StorageWriteResult::kOk) {
+    out.ok = false;
+    out.storage_error = true;
+    out.error = "updateDynamicRules: 规则存储未接受写入";
+    return out;
+  }
+  LOG(INFO) << "[arupa][dnr] 动态规则更新已排队 ext=" << extension_id
+            << " 移除=" << remove_rule_ids.size()
+            << " 新增=" << add_rules.size() << " 现有=" << out.rule_count;
+  return out;
+}
+
+void UpdateDynamicRulesAsync(const std::string& extension_id,
+                             const std::vector<int>& remove_rule_ids,
+                             const base::ListValue& add_rules,
+                             DnrUpdateCallback callback) {
+  PreparedDynamicRules prepared =
+      PrepareDynamicRules(extension_id, remove_rule_ids, add_rules);
+  if (!prepared.outcome.ok) {
+    std::move(callback).Run(std::move(prepared.outcome));
+    return;
+  }
+  std::map<std::string, std::string> items;
+  items.emplace(kDnrDynamicRulesKey, std::move(prepared.json));
+  PluginStorage::Get().SetValuesAsync(
+      extension_id, std::move(items),
+      base::BindOnce(
+          [](DnrUpdateOutcome outcome, DnrUpdateCallback done,
+             StorageCommitResult commit) {
+            if (commit.status != StorageWriteResult::kOk) {
+              outcome.ok = false;
+              outcome.storage_error = true;
+              outcome.error = std::string("updateDynamicRules: ") +
+                              StorageWriteResultMessage(commit.status);
+            }
+            std::move(done).Run(std::move(outcome));
+          },
+          std::move(prepared.outcome), std::move(callback)));
+}
+
+std::string GetDynamicRulesJson(const std::string& extension_id) {
+  if (extension_id.empty()) {
+    return "[]";
+  }
+  std::optional<base::ListValue> stored = ReadStoredRules(extension_id);
+  if (!stored) {
+    return "[]";
+  }
+  std::optional<std::string> json = base::WriteJson(*stored);
+  return json.value_or("[]");
+}
+
+bool BuildDnrRulesQueryResult(const std::string& rules_json,
+                              const std::string& args_json,
+                              std::string* result_json,
+                              std::string* error) {
+  std::optional<base::Value> parsed_rules =
+      base::JSONReader::Read(rules_json, base::JSON_PARSE_RFC);
+  if (!parsed_rules || !parsed_rules->is_list()) {
+    *error = "规则快照不是数组";
+    return false;
+  }
+
+  std::optional<base::Value> parsed_args =
+      base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+  const base::ListValue* args =
+      parsed_args && parsed_args->is_list() ? &parsed_args->GetList() : nullptr;
+  if (!args) {
+    *error = "调用参数不是数组";
+    return false;
+  }
+  if (args->size() > 1) {
+    *error = "filter 参数过多";
+    return false;
+  }
+
+  base::ListValue filtered;
+  if (args->empty() || (*args)[0].is_none()) {
+    filtered = std::move(*parsed_rules).TakeList();
+  } else {
+    const base::DictValue* filter = (*args)[0].GetIfDict();
+    if (!filter) {
+      *error = "filter 必须是对象";
+      return false;
+    }
+    const base::Value* ids_value = filter->Find("ruleIds");
+    if (ids_value && !ids_value->is_list()) {
+      *error = "filter.ruleIds 必须是数组";
+      return false;
+    }
+    const base::ListValue* ids = ids_value ? ids_value->GetIfList() : nullptr;
+    if (!ids) {
+      filtered = std::move(*parsed_rules).TakeList();
+    } else {
+      std::set<int> wanted;
+      for (const base::Value& value : *ids) {
+        std::optional<int> id = value.GetIfInt();
+        if (!id) {
+          *error = "filter.ruleIds 必须只包含整数";
+          return false;
+        }
+        wanted.insert(*id);
+      }
+      for (const base::Value& value : parsed_rules->GetList()) {
+        const base::DictValue* rule = value.GetIfDict();
+        const std::optional<int> id = rule ? rule->FindInt("id") : std::nullopt;
+        if (id && wanted.contains(*id)) {
+          filtered.Append(value.Clone());
+        }
+      }
+    }
+  }
+
+  base::ListValue call_args;
+  call_args.Append(std::move(filtered));
+  return base::JSONWriter::Write(base::Value(std::move(call_args)),
+                                 result_json);
+}
