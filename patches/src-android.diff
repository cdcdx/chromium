+bool HandleKernelOwnedWebNavigation(const std::string &name,
+                                    const std::string &args_json,
+                                    TabBook caller_book,
+                                    mojom::ExtApiHost::CallCallback &callback) {
+  const bool all = (name == "webNavigation.getAllFrames");
+  if (!all && name != "webNavigation.getFrame") {
+    return false;
+  }
+  std::optional<base::Value> args =
+      base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+  const base::ListValue *arr =
+      args && args->is_list() ? &args->GetList() : nullptr;
+  const base::DictValue *d =
+      (arr && !arr->empty()) ? (*arr)[0].GetIfDict() : nullptr;
+  if (!d) {
+    std::move(callback).Run(std::string(), name + ": details 必须是对象");
+    return true;
+  }
+
+  const std::optional<int> tab_id = d ? d->FindInt("tabId") : std::nullopt;
+  if (d->Find("tabId") && !tab_id) {
+    std::move(callback).Run(std::string(), name + ": `tabId` 必须是整数");
+    return true;
+  }
+  if (tab_id && *tab_id < 0) {
+    std::move(callback).Run(std::string(), name + ": `tabId` 不能为负数");
+    return true;
+  }
+  const std::optional<int> frame_id = d->FindInt("frameId");
+  if (d->Find("frameId") && !frame_id) {
+    std::move(callback).Run(std::string(), name + ": `frameId` 必须是整数");
+    return true;
+  }
+  if (frame_id && *frame_id < 0) {
+    std::move(callback).Run(std::string(), name + ": `frameId` 不能为负数");
+    return true;
+  }
+  const std::string *document_id = d->FindString("documentId");
+  if (d->Find("documentId") && (!document_id || document_id->empty())) {
+    std::move(callback).Run(std::string(),
+                            name + ": `documentId` 必须是非空字符串");
+    return true;
+  }
+
+  if (all && !tab_id) {
+    std::move(callback).Run(std::string(), name + ": 缺 `tabId`");
+    return true;
+  }
+  if (!all && !tab_id && !document_id) {
+    std::move(callback).Run(std::string(),
+                            name + ": 至少需要 `tabId` 或 `documentId`");
+    return true;
+  }
+
+  content::WebContents *wc = nullptr;
+  if (tab_id) {
+    wc = arupa::FindWebContentsByTabIdInBook(*tab_id, caller_book);
+  }
+  if (tab_id && !wc) {
+    arupa::TabBook owner = arupa::TabBook::kRegular;
+    const bool owned_by_other_book =
+        arupa::BookForTabId(*tab_id, &owner) && owner != caller_book;
+    std::move(callback).Run(
+        std::string(),
+        name + ": tabId=" + base::NumberToString(*tab_id) +
+            (owned_by_other_book
+                 ? std::string(" 属于") + arupa::TabBookName(owner) +
+                       "册, 而本次调用来自" + arupa::TabBookName(caller_book) +
+                       "册 —— 不跨册查询(请按当前册重查 tabId)"
+                 : (arupa::WasTabIdRetired(*tab_id)
+                        ? " 的标签页**已经关了**(请重新建页或重查)"
+                        : " **不是一个我们认识的标签页**(実从未声明过)")));
+    return true;
+  }
+
+  content::RenderFrameHost *document_frame = nullptr;
+  int resolved_tab_id = tab_id.value_or(-1);
+  const std::string requested_document_id =
+      document_id ? *document_id : std::string();
+  auto find_document_in_page = [&](content::WebContents *page) {
+    page->ForEachRenderFrameHost([&](content::RenderFrameHost *candidate) {
+      if (!document_frame && DocumentIdOf(candidate) == requested_document_id) {
+        document_frame = candidate;
+      }
+    });
+  };
+  if (!all && document_id) {
+    if (wc) {
+      find_document_in_page(wc);
+    } else {
+      arupa::ForEachRegisteredPage([&](int candidate_tab_id, TabBook book,
+                                       content::WebContents *candidate_page) {
+        if (document_frame || book != caller_book) {
+          return;
+        }
+        find_document_in_page(candidate_page);
+        if (document_frame) {
+          wc = candidate_page;
+          resolved_tab_id = candidate_tab_id;
+        }
+      });
+    }
+  }
+
+  auto one = [](content::RenderFrameHost *rfh) {
+    base::DictValue f;
+    f.Set("frameId", arupa::FrameIdOf(rfh));
+    f.Set("documentId", arupa::DocumentIdOf(rfh));
+    content::RenderFrameHost *parent = rfh->GetParentOrOuterDocument();
+    if (parent) {
+      f.Set("parentDocumentId", arupa::DocumentIdOf(parent));
+    }
+    f.Set("parentFrameId", parent ? arupa::FrameIdOf(parent) : -1);
+    f.Set("url", rfh->GetLastCommittedURL().spec());
+    f.Set("processId", static_cast<int>(rfh->GetProcess()->GetDeprecatedID()));
+
+    f.Set("documentLifecycle", arupa::DocumentLifecycleOf(rfh));
+    f.Set("frameType", arupa::FrameTypeOf(rfh));
+    f.Set("errorOccurred", !rfh->IsRenderFrameLive());
+    return f;
+  };
+
+  base::ListValue result;
+  if (all) {
+    base::ListValue frames;
+    wc->ForEachRenderFrameHost([&](content::RenderFrameHost *rfh) {
+      if (rfh) {
+        frames.Append(one(rfh));
+      }
+    });
+    result.Append(std::move(frames));
+  } else {
+    content::RenderFrameHost *rfh =
+        document_id ? document_frame
+                    : arupa::FrameById(wc, frame_id.value_or(0));
+    if (rfh && frame_id && arupa::FrameIdOf(rfh) != *frame_id) {
+      rfh = nullptr;
+    }
+
+    if (rfh) {
+      result.Append(one(rfh));
+    } else {
+      result.Append(base::Value());
+    }
+  }
+  std::string json;
+  base::JSONWriter::Write(base::Value(std::move(result)), &json);
+  LOG(INFO) << "[arupa][extapi] " << name << " tabId=" << resolved_tab_id
+            << " → " << (all ? "帧列表" : "单帧");
+  std::move(callback).Run(json, std::string());
+  return true;
+}
