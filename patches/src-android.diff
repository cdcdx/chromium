+#include "third_party/blink/renderer/modules/webcodecs/arupa_codec_whitelist.h"
+#include <string>
+#include <vector>
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+namespace blink {
+bool ArupaIsCodecInWhitelist(const String& whitelist, const String& codec) {
+  if (whitelist.empty() || codec.empty()) {
+    return false;
+  }
+  const std::string ct = base::ToLowerASCII(codec.Utf8());
+  const std::vector<std::string> parts = base::SplitString(
+      base::ToLowerASCII(whitelist.Utf8()), ",", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  for (const std::string& p : parts) {
+    if (p.empty()) {
+      continue;
+    }
+    if (ct.find(p) != std::string::npos || p.find(ct) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+}
