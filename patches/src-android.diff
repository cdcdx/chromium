+namespace {
+
+extensions::PermissionSet MakeSet(const std::vector<std::string> &apis,
+                                  const std::vector<std::string> &origins,
+                                  const char *what) {
+  extensions::APIPermissionSet api_set;
+  const extensions::PermissionsInfo *info =
+      extensions::PermissionsInfo::GetInstance();
+  for (const std::string &name : apis) {
+    const extensions::APIPermissionInfo *pi = info->GetByName(name);
+    if (!pi) {
+      LOG(WARNING) << "[arupa][perm] " << what
+                   << ": **本内核没有注册**的权限名 `" << name
+                   << "` —— 丢掉(不是\"上游没有这个权限\")";
+      continue;
+    }
+    api_set.insert(pi->id());
+  }
+  extensions::URLPatternSet host_set;
+  for (const std::string &o : origins) {
+    URLPattern pattern(extensions::Extension::kValidHostPermissionSchemes);
+    if (pattern.Parse(o) != URLPattern::ParseResult::kSuccess) {
+      LOG(WARNING) << "[arupa][perm] " << what << ": 解析不出来的 origin `" << o
+                   << "` —— 丢掉";
+      continue;
+    }
+    host_set.AddPattern(pattern);
+  }
+  return extensions::PermissionSet(
+      std::move(api_set), extensions::ManifestPermissionSet(),
+      std::move(host_set), extensions::URLPatternSet());
+}
+
+} // namespace
+
+bool FilterGrantablePermissions(const std::string &extension_id,
+                                const std::vector<std::string> &apis,
+                                const std::vector<std::string> &origins,
+                                std::vector<std::string> *out_apis,
+                                std::vector<std::string> *out_origins) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext) {
+    return false;
+  }
+
+  const extensions::PermissionSet &optional =
+      extensions::PermissionsParser::GetOptionalPermissions(ext.get());
+  const extensions::PermissionSet want = MakeSet(apis, origins, "request");
+
+  extensions::APIPermissionSet ok_apis;
+  for (const extensions::APIPermission *p : want.apis()) {
+    if (!optional.apis().count(p->id())) {
+      LOG(WARNING) << "[arupa][perm] request: `" << p->name()
+                   << "` **清单的 optional_permissions 里没有** ⇒ 不给, "
+                      "也不去打扰用户(弹了也没用)";
+      continue;
+    }
+    ok_apis.insert(p->Clone());
+  }
+  for (const URLPattern &pattern : want.explicit_hosts()) {
+    if (!optional.explicit_hosts().ContainsPattern(pattern)) {
+      LOG(WARNING) << "[arupa][perm] request: origin `" << pattern.GetAsString()
+                   << "` **清单的 optional_permissions 里没有** ⇒ 不给";
+      continue;
+    }
+    out_origins->push_back(pattern.GetAsString());
+  }
+
+  const extensions::PermissionSet candidate(
+      std::move(ok_apis), extensions::ManifestPermissionSet(),
+      extensions::URLPatternSet(), extensions::URLPatternSet());
+  const extensions::PermissionSet kept =
+      FilterByKernelGuard(candidate, extension_id);
+  for (const extensions::APIPermission *p : kept.apis()) {
+    out_apis->push_back(p->name());
+  }
+  return true;
+}
+
+bool ApplyPermissionChange(const std::string &extension_id, bool grant,
+                           const std::vector<std::string> &apis,
+                           const std::vector<std::string> &origins) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext) {
+    return false;
+  }
+  const extensions::PermissionsData *pd = ext->permissions_data();
+  const extensions::PermissionSet delta =
+      MakeSet(apis, origins, grant ? "grant" : "remove");
+  if (delta.IsEmpty()) {
+    LOG(WARNING) << "[arupa][perm] " << (grant ? "授予" : "撤销")
+                 << ": 一条都没解析出来 ⇒ 什么都没做 ext=" << extension_id;
+    return false;
+  }
+
+  std::unique_ptr<const extensions::PermissionSet> next;
+  if (grant) {
+    next =
+        extensions::PermissionSet::CreateUnion(pd->active_permissions(), delta);
+  } else {
+    const extensions::PermissionSet &required =
+        extensions::PermissionsParser::GetRequiredPermissions(ext.get());
+
+    std::unique_ptr<const extensions::PermissionSet> removable =
+        extensions::PermissionSet::CreateDifference(delta, required);
+    if (removable->IsEmpty()) {
+      LOG(WARNING) << "[arupa][perm] 撤销: 要撤的全是清单里**必需**的权限 ⇒ "
+                      "什么都没做 ext="
+                   << extension_id;
+      return false;
+    }
+    next = extensions::PermissionSet::CreateDifference(pd->active_permissions(),
+                                                       *removable);
+  }
+
+  std::unique_ptr<const extensions::PermissionSet> withheld =
+      std::make_unique<extensions::PermissionSet>(
+          ClonePermissions(pd->withheld_permissions()));
+  pd->SetPermissions(std::move(next), std::move(withheld));
+
+  // alarms 可以是 optional permission。授权后应立即恢复持久闹钟；撤销后必须
+  // 立即取消在途 timer，不能等下一次到期回调才发现权限已消失。
+  if (ext->permissions_data()->HasAPIPermission("alarms")) {
+    RestoreAlarmsForExtension(extension_id);
+  } else {
+    SuspendAlarmsForExtension(extension_id);
+  }
+
+  // unlimitedStorage 同样可以是 optional permission：授权后要立刻放开
+  // storage.local 的总量上限，撤销后要立刻收回（下次写入就会按 10MB
+  // 拒绝，而不是继续放行）。
+  SyncUnlimitedStorageForExtension(extension_id);
+
+  int pushed = 0;
+  for (content::RenderProcessHost *host : ReadyHosts()) {
+    if (!host->GetChannel()) {
+      continue;
+    }
+    mojo::AssociatedRemote<extensions::mojom::Renderer> renderer;
+    host->GetChannel()->GetRemoteAssociatedInterface(&renderer);
+    if (!renderer.is_bound()) {
+      continue;
+    }
+
+    renderer->UpdatePermissions(
+        extension_id,
+        FilterByKernelGuard(ext->permissions_data()->active_permissions(),
+                            ext->id()),
+        ClonePermissions(ext->permissions_data()->withheld_permissions()),
+
+        ext->permissions_data()->policy_blocked_hosts(),
+        ext->permissions_data()->policy_allowed_hosts(),
+        ext->permissions_data()->UsesDefaultPolicyHostRestrictions());
+    // Chromium M154 的 renderer 还用独立状态控制 userScripts binding；只更新
+    // PermissionSet 不会让 API 出现/消失。两条消息走同一 associated channel，
+    // 因而在下面重发 USER_SCRIPT 快照前已按新权限刷新 binding。
+    renderer->SetUserScriptsAllowed(
+        extension_id, ext->permissions_data()->HasAPIPermission("userScripts"));
+    // userScripts 可作为 optional permission 授予/撤销；UpdatePermissions 不会
+    // 替换 UserScriptSet，需重发完整快照才能立即移除或恢复 USER_SCRIPT 脚本。
+    if (DispatchedIds::Contains(host, extension_id)) {
+      DispatchContentScripts(host, *ext);
+    }
+    ++pushed;
+  }
+  LOG(WARNING) << "[arupa][perm] **" << (grant ? "授予" : "撤销")
+               << "了** ext=" << extension_id << " api=" << apis.size()
+               << " origin=" << origins.size() << " ⇒ 推回 " << pushed
+               << " 个 renderer";
+  RefreshHostDnrSnapshot(extension_id);
+  return true;
+}
