+
+bool ReadStringList(const base::DictValue &dict, const char *key,
+                    std::vector<std::string> *out) {
+  const base::ListValue *values = dict.FindList(key);
+  if (!values) {
+    return false;
+  }
+  for (const base::Value &value : *values) {
+    const std::string *item = value.GetIfString();
+    if (!item || item->empty()) {
+      return false;
+    }
+    out->push_back(*item);
+  }
+  return true;
+}
+
+// Optional permission
+// 是用户授权结果，必须跨浏览器重启恢复。这里仍保存按时间排序的 grant/revoke
+// 意图，因为撤销可以只覆盖一部分权限；加载后按原顺序重放即可得到与请求时
+// 一致的最终权限集。
+bool EnsureOptionalIntentsLoadedLocked(const extensions::ExtensionId &id) {
+  const uint64_t current_root =
+      mv3::PluginStorage::Get().CurrentRootGeneration();
+  if (OptionalIntentRootGeneration() != current_root) {
+    OptionalIntents().clear();
+    LoadedOptionalIntentIds().clear();
+    OptionalIntentRestoreErrors().clear();
+    PendingOptionalTransactions().clear();
+    DesynchronizedOptionalPermissionIds().clear();
+    OptionalIntentRootGeneration() = current_root;
+  }
+  if (!LoadedOptionalIntentIds().insert(id).second) {
+    return !OptionalIntentRestoreErrors().contains(id);
+  }
+  const mv3::StorageReadResult read =
+      mv3::PluginStorage::Get().GetAllValuesChecked(InternalStorageId(id));
+  const auto values =
+      read.status == mv3::StorageWriteResult::kOk
+          ? base::JSONReader::ReadDict(read.values_json, base::JSON_PARSE_RFC)
+          : std::optional<base::DictValue>();
+  if (!values) {
+    OptionalIntentRestoreErrors().insert(id);
+    LOG(ERROR) << "[arupa][perm] 可选权限持久账本不可读 ext=" << id;
+    return false;
+  }
+  const base::Value *stored = values->Find(kOptionalPermissionIntentsKey);
+  if (!stored) {
+    return true;
+  }
+  const base::ListValue *intents_list = stored->GetIfList();
+  if (!intents_list) {
+    OptionalIntentRestoreErrors().insert(id);
+    LOG(ERROR) << "[arupa][perm] 可选权限持久账本损坏 ext=" << id;
+    return false;
+  }
+  std::vector<OptionalPermissionIntent> intents;
+  for (const base::Value &value : *intents_list) {
+    const base::DictValue *dict = value.GetIfDict();
+    if (!dict) {
+      OptionalIntentRestoreErrors().insert(id);
+      return false;
+    }
+    OptionalPermissionIntent intent;
+    const auto grant = dict->FindBool("grant");
+    if (!grant) {
+      OptionalIntentRestoreErrors().insert(id);
+      return false;
+    }
+    intent.grant = *grant;
+    if (!ReadStringList(*dict, "apis", &intent.apis) ||
+        !ReadStringList(*dict, "origins", &intent.origins)) {
+      OptionalIntentRestoreErrors().insert(id);
+      return false;
+    }
+    if (!intent.apis.empty() || !intent.origins.empty()) {
+      intents.push_back(std::move(intent));
+    }
+  }
+  OptionalIntents()[id] = std::move(intents);
+  return true;
+}
+
+std::optional<std::string>
+SerializeOptionalIntents(const std::vector<OptionalPermissionIntent> &intents) {
+  base::ListValue values;
+  for (const OptionalPermissionIntent &intent : intents) {
+    base::DictValue dict;
+    dict.Set("grant", intent.grant);
+    base::ListValue apis;
+    for (const std::string &api : intent.apis) {
+      apis.Append(api);
+    }
+    dict.Set("apis", std::move(apis));
+    base::ListValue origins;
+    for (const std::string &origin : intent.origins) {
+      origins.Append(origin);
+    }
+    dict.Set("origins", std::move(origins));
+    values.Append(std::move(dict));
+  }
+  return base::WriteJson(values);
+}
+
+std::optional<std::string>
+SerializeConsentList(const std::vector<std::string> &consents) {
+  base::ListValue values;
+  for (const std::string &permission : consents) {
+    values.Append(permission);
+  }
+  return base::WriteJson(values);
+}
+
+bool Contains(const std::vector<std::string> &values,
+              const std::string &value) {
+  return std::find(values.begin(), values.end(), value) != values.end();
+}
+
+// 应用一条意图：先按清单的 optional_permissions 过滤，再落到扩展权限集（并推回
+// renderer）。
+void ApplyOptionalIntent(const extensions::ExtensionId &id,
+                         const OptionalPermissionIntent &intent,
+                         OptionalPermissionResult *out) {
+  std::vector<std::string> ok_apis;
+  std::vector<std::string> ok_origins;
+  if (!FilterGrantablePermissions(id, intent.apis, intent.origins, &ok_apis,
+                                  &ok_origins)) {
+    // 扩展没加载（竞态：登记时还在，应用时就没了）—— 意图留着，下次加载再生效。
+    return;
+  }
+  for (const std::string &api : intent.apis) {
+    if (!Contains(ok_apis, api)) {
+      out->rejected.push_back(api);
+    }
+  }
+  for (const std::string &origin : intent.origins) {
+    if (!Contains(ok_origins, origin)) {
+      out->rejected.push_back(origin);
+    }
+  }
+  if (ok_apis.empty() && ok_origins.empty()) {
+    LOG(WARNING) << "[arupa][perm] 可选权限" << (intent.grant ? "授予" : "撤销")
+                 << "被拒: 清单 optional_permissions 里没声明 ext=" << id;
+    return;
+  }
+  if (!ApplyPermissionChange(id, intent.grant, ok_apis, ok_origins)) {
+    LOG(WARNING) << "[arupa][perm] 可选权限" << (intent.grant ? "授予" : "撤销")
+                 << "应用失败 ext=" << id;
+    out->code = 4;
+    return;
+  }
+  out->applied.insert(out->applied.end(), ok_apis.begin(), ok_apis.end());
+  out->applied.insert(out->applied.end(), ok_origins.begin(), ok_origins.end());
+}
+
+void ApplyOptionalPermissionIntentsFor(const extensions::ExtensionId &id) {
+  std::vector<OptionalPermissionIntent> pending;
+  bool restore_failed = false;
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    if (!EnsureOptionalIntentsLoadedLocked(id)) {
+      DesynchronizedOptionalPermissionIds().insert(id);
+      restore_failed = true;
+    } else {
+      auto it = OptionalIntents().find(id);
+      if (it == OptionalIntents().end() || it->second.empty()) {
+        return;
+      }
+      pending = it->second;
+    }
+  }
+  if (restore_failed) {
+    SetExtensionEnabled(id, false);
+    return;
+  }
+  OptionalPermissionResult r;
+  for (const OptionalPermissionIntent &intent : pending) {
+    ApplyOptionalIntent(id, intent, &r);
+  }
+  LOG(WARNING) << "[arupa][perm] 扩展加载后落地可选权限意图 ext=" << id
+               << " 生效=" << r.applied.size() << " 拒绝=" << r.rejected.size();
+}
+
+struct OptionalTransaction {
+  std::string id;
+  int64_t install_generation = 0;
+  uint64_t storage_root_generation = 0;
+  uint64_t token = 0;
+  bool grant = false;
+  scoped_refptr<const extensions::Extension> extension;
+  std::vector<std::string> actual_apis;
+  std::vector<std::string> actual_origins;
+  std::vector<OptionalPermissionIntent> next_intents;
+  std::vector<std::string> next_consents;
+  std::string old_intents_json;
+  std::string old_consents_json;
+  OptionalPermissionResult result;
+  OptionalPermissionCallback callback;
+};
+
+bool OptionalTransactionStillCurrent(const OptionalTransaction &tx) {
+  bool token_current = false;
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    const auto pending = PendingOptionalTransactions().find(tx.id);
+    token_current = pending != PendingOptionalTransactions().end() &&
+                    pending->second == tx.token;
+  }
+  return token_current &&
+         GetExtensionInstallGeneration(tx.id) == tx.install_generation &&
+         mv3::PluginStorage::Get().CurrentRootGeneration() ==
+             tx.storage_root_generation &&
+         FindLoadedExtension(tx.id).get() == tx.extension.get() &&
+         !IsExtensionDisabled(tx.id);
+}
+
+bool OptionalTransactionOwnsStorage(const OptionalTransaction &tx) {
+  bool token_current = false;
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    const auto pending = PendingOptionalTransactions().find(tx.id);
+    token_current = pending != PendingOptionalTransactions().end() &&
+                    pending->second == tx.token;
+  }
+  return token_current &&
+         GetExtensionInstallGeneration(tx.id) == tx.install_generation &&
+         mv3::PluginStorage::Get().CurrentRootGeneration() ==
+             tx.storage_root_generation &&
+         !siteaudit::IsExtensionPurging(tx.id);
+}
+
+void FinishOptionalTransaction(std::unique_ptr<OptionalTransaction> tx,
+                               int code) {
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    auto pending = PendingOptionalTransactions().find(tx->id);
+    if (pending != PendingOptionalTransactions().end() &&
+        pending->second == tx->token) {
+      PendingOptionalTransactions().erase(pending);
+    }
+  }
+  tx->result.code = code;
+  std::move(tx->callback).Run(std::move(tx->result));
+}
+
+void OnOptionalRollbackCommitted(std::unique_ptr<OptionalTransaction> tx,
+                                 mv3::StorageCommitResult result) {
+  if (!OptionalTransactionOwnsStorage(*tx)) {
+    FinishOptionalTransaction(std::move(tx), kOptionalUnavailable);
+    return;
+  }
+  if (result.status != mv3::StorageWriteResult::kOk) {
+    {
+      base::AutoLock guard(OptionalIntentLock());
+      DesynchronizedOptionalPermissionIds().insert(tx->id);
+    }
+    LOG(ERROR) << "[arupa][perm] 权限应用失败且补偿提交失败，已冻结扩展 ext="
+               << tx->id
+               << " reason=" << mv3::StorageWriteResultMessage(result.status);
+    SetExtensionEnabled(tx->id, false);
+    FinishOptionalTransaction(std::move(tx), kOptionalDesynchronized);
+    return;
+  }
+  FinishOptionalTransaction(std::move(tx), kOptionalApplyFailed);
+}
+
+void RollbackOptionalRecords(std::unique_ptr<OptionalTransaction> tx) {
+  const std::string storage_id = InternalStorageId(tx->id);
+  std::map<std::string, std::string> values = {
+      {kOptionalPermissionIntentsKey, tx->old_intents_json},
+      {"permission_consents_v1", tx->old_consents_json}};
+  mv3::PluginStorage::Get().SetValuesAsync(
+      storage_id, std::move(values),
+      base::BindOnce(&OnOptionalRollbackCommitted, std::move(tx)));
+}
+
+void OnOptionalRecordsCommitted(std::unique_ptr<OptionalTransaction> tx,
+                                mv3::StorageCommitResult result) {
+  if (!OptionalTransactionStillCurrent(*tx)) {
+    if (result.status == mv3::StorageWriteResult::kOk &&
+        OptionalTransactionOwnsStorage(*tx)) {
+      RollbackOptionalRecords(std::move(tx));
+    } else {
+      FinishOptionalTransaction(std::move(tx), kOptionalUnavailable);
+    }
+    return;
+  }
+  if (result.status != mv3::StorageWriteResult::kOk) {
+    FinishOptionalTransaction(std::move(tx), kOptionalPersistFailed);
+    return;
+  }
+  if (!ApplyPermissionChange(tx->id, tx->grant, tx->actual_apis,
+                             tx->actual_origins)) {
+    RollbackOptionalRecords(std::move(tx));
+    return;
+  }
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    OptionalIntents()[tx->id] = std::move(tx->next_intents);
+  }
+  ReplaceExtensionPermissionConsents(tx->id, tx->next_consents);
+  tx->result.applied = tx->actual_apis;
+  tx->result.applied.insert(tx->result.applied.end(),
+                            tx->actual_origins.begin(),
+                            tx->actual_origins.end());
+  FinishOptionalTransaction(std::move(tx), kOptionalApplied);
+}
+
+} // namespace
+
+bool IsOptionalPermissionDesynchronized(const std::string &extension_id) {
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    if (!EnsureOptionalIntentsLoadedLocked(extension_id) ||
+        DesynchronizedOptionalPermissionIds().contains(extension_id) ||
+        OptionalIntentRestoreErrors().contains(extension_id) ||
+        PendingOptionalTransactions().contains(extension_id)) {
+      return true;
+    }
+  }
+  std::vector<std::string> consents;
+  return !GetExtensionPermissionConsents(extension_id, &consents);
+}
+
+bool IsOptionalPermissionTransactionPending(const std::string &extension_id) {
+  base::AutoLock guard(OptionalIntentLock());
+  return PendingOptionalTransactions().contains(extension_id);
+}
+
+void ClearOptionalPermissionGrants(const std::string &extension_id) {
+  if (extension_id.empty()) {
+    return;
+  }
+  base::AutoLock guard(OptionalIntentLock());
+  const bool erased = OptionalIntents().erase(extension_id) > 0;
+  LoadedOptionalIntentIds().erase(extension_id);
+  OptionalIntentRestoreErrors().erase(extension_id);
+  PendingOptionalTransactions().erase(extension_id);
+  DesynchronizedOptionalPermissionIds().erase(extension_id);
+  // PurgeExtensionData 的有序 ClearAsync 负责磁盘清理，不能在这里排旧式删除。
+  if (erased) {
+    LOG(WARNING)
+        << "[arupa][perm] 清空可选权限意图(装机代次已变, 重装后须重新授权) ext="
+        << extension_id;
+  }
+}
+
+void SetOptionalPermissionGrantAsync(
+    const std::string &extension_id, bool grant,
+    const std::vector<std::string> &apis,
+    const std::vector<std::string> &origins,
+    const std::vector<std::string> &consent_on_success,
+    OptionalPermissionCallback callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  OptionalPermissionResult result;
+  if (extension_id.empty() || (apis.empty() && origins.empty())) {
+    result.code = kOptionalInvalidInput;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  const auto extension = FindLoadedExtension(extension_id);
+  if (!extension || IsExtensionDisabled(extension_id) ||
+      IsOptionalPermissionDesynchronized(extension_id) ||
+      siteaudit::IsExtensionPurging(extension_id)) {
+    result.code = kOptionalUnavailable;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  std::vector<std::string> old_consents;
+  if (!GetExtensionPermissionConsents(extension_id, &old_consents)) {
+    result.code = kOptionalPersistFailed;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  std::vector<std::string> eligible_apis;
+  std::vector<std::string> eligible_origins;
+  if (!FilterGrantablePermissions(extension_id, apis, origins, &eligible_apis,
+                                  &eligible_origins)) {
+    result.code = kOptionalUnavailable;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  for (const std::string &api : apis) {
+    if (!Contains(eligible_apis, api)) {
+      result.rejected.push_back(api);
+    }
+  }
+  for (const std::string &origin : origins) {
+    if (!Contains(eligible_origins, origin)) {
+      result.rejected.push_back(origin);
+    }
+  }
+  if (eligible_apis.empty() && eligible_origins.empty()) {
+    result.code = kOptionalNotDeclared;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  const extensions::PermissionSet candidate =
+      MakeSet(eligible_apis, eligible_origins, "optional transaction");
+  std::unique_ptr<extensions::PermissionSet> delta;
+  if (grant) {
+    delta = extensions::PermissionSet::CreateDifference(
+        candidate, extension->permissions_data()->active_permissions());
+  } else {
+    const auto removable = extensions::PermissionSet::CreateDifference(
+        candidate,
+        extensions::PermissionsParser::GetRequiredPermissions(extension.get()));
+    delta = extensions::PermissionSet::CreateIntersection(
+        *removable, extension->permissions_data()->active_permissions());
+  }
+  if (!delta || delta->IsEmpty()) {
+    result.code = kOptionalNoChange;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  auto tx = std::make_unique<OptionalTransaction>();
+  tx->id = extension_id;
+  tx->grant = grant;
+  tx->extension = extension;
+  tx->install_generation = GetExtensionInstallGeneration(extension_id);
+  tx->storage_root_generation =
+      mv3::PluginStorage::Get().CurrentRootGeneration();
+  tx->result = std::move(result);
+  tx->callback = std::move(callback);
+  for (const extensions::APIPermission *api : delta->apis()) {
+    tx->actual_apis.push_back(api->name());
+  }
+  for (const URLPattern &origin : delta->explicit_hosts()) {
+    tx->actual_origins.push_back(origin.GetAsString());
+  }
+  tx->next_consents = old_consents;
+  if (grant) {
+    for (const std::string &permission : consent_on_success) {
+      if ((Contains(tx->actual_apis, permission) ||
+           Contains(tx->actual_origins, permission)) &&
+          !Contains(tx->next_consents, permission)) {
+        tx->next_consents.push_back(permission);
+      }
+    }
+  }
+  std::vector<OptionalPermissionIntent> old_intents;
+  bool blocked = false;
+  {
+    base::AutoLock guard(OptionalIntentLock());
+    if (!EnsureOptionalIntentsLoadedLocked(extension_id) ||
+        PendingOptionalTransactions().contains(extension_id)) {
+      blocked = true;
+    } else {
+      old_intents = OptionalIntents()[extension_id];
+      tx->next_intents = old_intents;
+      tx->next_intents.push_back(
+          OptionalPermissionIntent{grant, tx->actual_apis, tx->actual_origins});
+      tx->token = ++NextOptionalTransactionToken();
+      PendingOptionalTransactions()[extension_id] = tx->token;
+    }
+  }
+  if (blocked) {
+    FinishOptionalTransaction(std::move(tx), kOptionalPersistFailed);
+    return;
+  }
+  const auto old_intents_json = SerializeOptionalIntents(old_intents);
+  const auto next_intents_json = SerializeOptionalIntents(tx->next_intents);
+  const auto old_consents_json = SerializeConsentList(old_consents);
+  const auto next_consents_json = SerializeConsentList(tx->next_consents);
+  if (!old_intents_json || !next_intents_json || !old_consents_json ||
+      !next_consents_json) {
+    FinishOptionalTransaction(std::move(tx), kOptionalPersistFailed);
+    return;
+  }
+  tx->old_intents_json = *old_intents_json;
+  tx->old_consents_json = *old_consents_json;
+  mv3::PluginStorage::Get().SetValuesAsync(
+      InternalStorageId(extension_id),
+      {{kOptionalPermissionIntentsKey, *next_intents_json},
+       {"permission_consents_v1", *next_consents_json}},
+      base::BindOnce(&OnOptionalRecordsCommitted, std::move(tx)));
+}
+
+OptionalPermissionResult
+SetOptionalPermissionGrant(const std::string &extension_id, bool grant,
+                           const std::vector<std::string> &apis,
+                           const std::vector<std::string> &origins) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  OptionalPermissionResult r;
+  r.code = kOptionalLegacySyncRejected;
+  r.rejected = apis;
+  r.rejected.insert(r.rejected.end(), origins.begin(), origins.end());
+  LOG(ERROR) << "[arupa][perm] 同步 JNI 授权无法等待持久提交，已拒绝 ext="
+             << extension_id << " grant=" << grant;
+  return r;
+}
+
+SiteAccessResult SetExtensionSiteAccess(const std::string &extension_id,
+                                        const std::string &site, bool granted) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  SiteAccessResult r;
+  if (extension_id.empty()) {
+    r.code = 3;
+    return r;
+  }
+  const std::string host = SitePattern(site);
+  if (host.empty()) {
+    LOG(WARNING) << "[arupa][site] 站点写法不认识 `" << site
+                 << "` —— 收 a.com · *.a.com · 清单原文(如 *://*.a.com/*) · "
+                    "<all_urls>; **什么都没改**";
+    r.code = 2;
+    return r;
+  }
+  auto &reg = RevokedSites();
+  if (granted) {
+    auto it = reg.find(extension_id);
+    if (it != reg.end()) {
+      it->second.erase(host);
+      if (it->second.empty()) {
+        reg.erase(it);
+      }
+    }
+  } else {
+    reg[extension_id].insert(host);
+  }
+
+  scoped_refptr<const extensions::Extension> ext =
+      FindLoadedExtension(extension_id);
+  if (!ext) {
+    LOG(INFO) << "[arupa][site] ext=" << extension_id << " 还没装载 ⇒ "
+              << (granted ? "授权" : "撤销") << " " << host
+              << " **已记下**, 装载时生效";
+    r.code = 1;
+    return r;
+  }
+  ApplySiteBlocksTo(*ext);
+  const extensions::PermissionsData *pd = ext->permissions_data();
+
+  std::set<content::BrowserContext *> contexts;
+  int pushed = 0;
+  for (content::RenderProcessHost *host_p : ReadyHosts()) {
+    contexts.insert(host_p->GetBrowserContext());
+    if (!host_p->GetChannel()) {
+      continue;
+    }
+    mojo::AssociatedRemote<extensions::mojom::Renderer> renderer;
+    host_p->GetChannel()->GetRemoteAssociatedInterface(&renderer);
+    if (!renderer.is_bound()) {
+      continue;
+    }
+    renderer->UpdatePermissions(
+        extension_id, FilterByKernelGuard(pd->active_permissions(), ext->id()),
+        ClonePermissions(pd->withheld_permissions()),
+        pd->policy_blocked_hosts(), pd->policy_allowed_hosts(),
+        pd->UsesDefaultPolicyHostRestrictions());
+    ++pushed;
+  }
+  for (content::BrowserContext *ctx : contexts) {
+    PushCorsBypassForExtension(ctx, *ext);
+  }
+
+  if (!granted) {
+    std::set<int> tabs;
+    std::unique_ptr<content::RenderWidgetHostIterator> widgets(
+        content::RenderWidgetHost::GetRenderWidgetHosts());
+    while (content::RenderWidgetHost *w = widgets->GetNextHost()) {
+      content::RenderViewHost *rvh = content::RenderViewHost::From(w);
+      content::WebContents *wc =
+          rvh ? content::WebContents::FromRenderViewHost(rvh) : nullptr;
+      if (!wc) {
+        continue;
+      }
+      const GURL u = wc->GetLastCommittedURL();
+      URLPattern revoked(URLPattern::SCHEME_HTTP | URLPattern::SCHEME_HTTPS);
+      if (!u.SchemeIsHTTPOrHTTPS() ||
+          revoked.Parse(host) != URLPattern::ParseResult::kSuccess ||
+          !revoked.MatchesURL(u)) {
+        continue;
+      }
+      const int tab = TabIdForWebContents(wc);
+      if (tab != -1) {
+        tabs.insert(tab);
+      }
+    }
+    r.reload_tab_ids.assign(tabs.begin(), tabs.end());
+  }
+  LOG(WARNING) << "[arupa][site] ext=" << extension_id << " **"
+               << (granted ? "授权" : "撤销") << "了** " << host << " ⇒ 推回 "
+               << pushed << " 个 renderer / " << contexts.size()
+               << " 个 context 的 CORS 名单"
+               << (granted ? std::string()
+                           : " · 开着它的标签页 " +
+                                 base::NumberToString(r.reload_tab_ids.size()) +
+                                 " 个(刷不刷由宿主定)");
+  RefreshHostDnrSnapshot(extension_id);
+  r.code = 0;
+  return r;
+}
+
+std::vector<std::string> RevokedSitesFor(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto it = RevokedSites().find(extension_id);
+  if (it == RevokedSites().end()) {
+    return {};
+  }
+  return std::vector<std::string>(it->second.begin(), it->second.end());
+}
+
+std::vector<content::RenderProcessHost *>
+ProcessesWithExtension(const std::string &extension_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  std::vector<content::RenderProcessHost *> out;
+  if (IsExtensionDisabled(extension_id)) {
+    return out;
+  }
+  for (content::RenderProcessHost *host : ReadyHosts()) {
+    if (DispatchedIds::Contains(host, extension_id)) {
+      out.push_back(host);
+    }
+  }
+  return out;
+}
+
+bool IsExtensionDisabled(const std::string &extension_id) {
+  base::AutoLock guard(DisabledLock());
+  return DisabledIds().count(extension_id) > 0;
+}
+
+bool HasReadyRenderer() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return !ReadyHosts().empty();
+}
+
+std::vector<base::FilePath> LastScannedDirs() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  std::vector<base::FilePath> out;
+  if (!Cache().valid) {
+    return out;
+  }
+  for (const ScannedExtension &item : Cache().items) {
+    out.push_back(item.dir);
+  }
+  return out;
