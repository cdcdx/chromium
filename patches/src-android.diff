+TEST_F(DnrRulesTest, ApplyReceiptRequiresExactCountAndShape) {
+  DnrHostAccessPolicy access_policy;
+  access_policy.host_permissions_always_required = true;
+  access_policy.allow_file_access = true;
+  access_policy.feedback_permission = true;
+  access_policy.host_permissions = {"https://active.example/*"};
+  access_policy.withheld_host_permissions = {"https://withheld.example/*"};
+  access_policy.blocked_host_permissions = {"https://blocked.example/*"};
+  access_policy.allowed_host_permissions = {"https://allowed.example/*"};
+  access_policy.tab_host_permissions.emplace(
+      7, std::vector<std::string>{"https://tab.example/*"});
+  access_policy.feedback_tab_ids.insert(7);
+  const DnrHostRequest request = BuildDnrHostRequest(
+      extension_id_, R"([{"id":1},{"id":2}])", 2, false,
+      /*install_generation=*/42, access_policy);
+  ASSERT_TRUE(request.ok);
+  const std::optional<base::Value> request_args =
+      base::JSONReader::Read(request.args_json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(request_args && request_args->is_list());
+  ASSERT_EQ(request_args->GetList().size(), 1u);
+  const base::DictValue* request_body = request_args->GetList()[0].GetIfDict();
+  ASSERT_TRUE(request_body);
+  ASSERT_TRUE(request_body->FindString("extensionId"));
+  ASSERT_TRUE(request_body->FindString("partition"));
+  ASSERT_TRUE(request_body->FindString("operation"));
+  EXPECT_EQ(*request_body->FindString("extensionId"),
+            request.receipt.extension_id);
+  EXPECT_EQ(*request_body->FindString("partition"),
+            request.receipt.partition);
+  EXPECT_EQ(*request_body->FindString("operation"),
+            request.receipt.operation);
+  EXPECT_EQ("42", *request_body->FindString("installGeneration"));
+  EXPECT_TRUE(
+      request_body->FindBool("hostPermissionsAlwaysRequired").value_or(false));
+  EXPECT_TRUE(request_body->FindBool("allowFileAccess").value_or(false));
+  EXPECT_TRUE(request_body->FindBool("feedbackPermission").value_or(false));
+  ASSERT_EQ(1u, request_body->FindList("hostPermissions")->size());
+  EXPECT_EQ("https://active.example/*",
+            (*request_body->FindList("hostPermissions"))[0].GetString());
+  ASSERT_EQ(1u, request_body->FindList("withheldHostPermissions")->size());
+  ASSERT_EQ(1u, request_body->FindList("blockedHostPermissions")->size());
+  ASSERT_EQ(1u, request_body->FindList("allowedHostPermissions")->size());
+  const base::DictValue* tab_permissions =
+      request_body->FindDict("tabHostPermissions");
+  ASSERT_TRUE(tab_permissions);
+  ASSERT_EQ(1u, tab_permissions->FindList("7")->size());
+  EXPECT_EQ("https://tab.example/*",
+            (*tab_permissions->FindList("7"))[0].GetString());
+  ASSERT_EQ(1u, request_body->FindList("feedbackTabIds")->size());
+  EXPECT_EQ(7, (*request_body->FindList("feedbackTabIds"))[0].GetInt());
+  base::DictValue active;
+  active.Set("contractVersion", 2);
+  active.Set("interception", "active");
+  active.Set("ruleCount", 2);
+  active.Set("extensionId", request.receipt.extension_id);
+  active.Set("partition", request.receipt.partition);
+  active.Set("operation", request.receipt.operation);
+  active.Set("kernelEpoch", request.receipt.kernel_epoch);
+  active.Set("operationSerial", request.receipt.operation_serial);
+  active.Set("rulesSha256", request.receipt.rules_sha256);
+  base::ListValue receipt;
+  receipt.Append(active.Clone());
+  const std::string valid = base::WriteJson(receipt).value();
+  std::string reason;
+  EXPECT_TRUE(DnrApplyReceiptMatches(valid, "", request.receipt, &reason));
+  EXPECT_FALSE(DnrApplyReceiptMatches(valid, "host rejected", request.receipt,
+                                      &reason));
+  active.Set("ruleCount", 1);
+  receipt.clear();
+  receipt.Append(active.Clone());
+  EXPECT_FALSE(DnrApplyReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      request.receipt, &reason));
+  active.Set("ruleCount", 2);
+  active.Set("rulesSha256", "same-count-but-old-snapshot");
+  receipt.clear();
+  receipt.Append(active.Clone());
+  EXPECT_FALSE(DnrApplyReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      request.receipt, &reason));
+  active.Set("rulesSha256", request.receipt.rules_sha256);
+  active.Set("extensionId", "another-extension");
+  receipt.clear();
+  receipt.Append(active.Clone());
+  EXPECT_FALSE(DnrApplyReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      request.receipt, &reason));
+  active.Set("extensionId", request.receipt.extension_id);
+  active.Set("partition", "incognito");
+  receipt.clear();
+  receipt.Append(active.Clone());
+  EXPECT_FALSE(DnrApplyReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      request.receipt, &reason));
+  active.Set("partition", request.receipt.partition);
+  active.Set("operation", "remove");
+  receipt.clear();
+  receipt.Append(active.Clone());
+  EXPECT_FALSE(DnrApplyReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      request.receipt, &reason));
+  active.Set("operation", request.receipt.operation);
+  EXPECT_FALSE(DnrApplyReceiptMatches("[]", "", request.receipt, &reason));
+  EXPECT_FALSE(DnrApplyReceiptMatches(
+      R"([{"interception":"active","ruleCount":2}])", "",
+      request.receipt, &reason));
+  const DnrHostRequest removal =
+      BuildDnrHostRequest(extension_id_, "[]", 0, true);
+  ASSERT_TRUE(removal.ok);
+  active.Set("interception", "inactive");
+  active.Set("ruleCount", 0);
+  active.Set("operation", removal.receipt.operation);
+  active.Set("kernelEpoch", removal.receipt.kernel_epoch);
+  active.Set("operationSerial", removal.receipt.operation_serial);
+  active.Set("rulesSha256", removal.receipt.rules_sha256);
+  receipt.clear();
+  receipt.Append(active.Clone());
+  EXPECT_TRUE(DnrRemoveReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      removal.receipt, &reason));
+  EXPECT_FALSE(DnrApplyReceiptMatches(base::WriteJson(receipt).value(), "",
+                                      removal.receipt, &reason));
+}
