+class ArupaServedResponseLoader : public network::mojom::URLLoader {
+public:
+  static void
+  StartData(const GURL &url, std::string_view method,
+            mojo::PendingReceiver<network::mojom::URLLoader> loader,
+            mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    std::string mime;
+    std::string charset;
+    std::string data;
+    scoped_refptr<net::HttpResponseHeaders> headers;
+    const net::Error result = net::DataURL::BuildResponse(
+        url, method, &mime, &charset, &data, &headers);
+    if (result != net::OK) {
+      mojo::Remote<network::mojom::URLLoaderClient> client_remote(
+          std::move(client));
+      client_remote->OnComplete(network::URLLoaderCompletionStatus(result));
+      return;
+    }
+
+    auto head = network::mojom::URLResponseHead::New();
+    head->headers = std::move(headers);
+    head->mime_type = std::move(mime);
+    head->charset = std::move(charset);
+    head->content_length = static_cast<int64_t>(data.size());
+    head->request_start = base::TimeTicks::Now();
+    head->response_start = base::TimeTicks::Now();
+    std::vector<uint8_t> body(data.begin(), data.end());
+    new ArupaServedResponseLoader(std::move(head), std::move(body),
+                                  std::move(loader), std::move(client));
+  }
+
+  static void
+  Start(JNIEnv *env, const base::android::JavaRef<jobject> &resp,
+        mojo::PendingReceiver<network::mojom::URLLoader> loader,
+        mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    int status = Java_ArupaWebResourceResponse_getStatusCode(env, resp);
+    if (status < 100 || status > 599) {
+      status = 200;
+    }
+    std::string reason = base::android::ConvertJavaStringToUTF8(
+        env, Java_ArupaWebResourceResponse_getReasonPhrase(env, resp));
+    if (reason.empty()) {
+      reason = "OK";
+    }
+    std::string mime = base::android::ConvertJavaStringToUTF8(
+        env, Java_ArupaWebResourceResponse_getMimeType(env, resp));
+    std::string charset = base::android::ConvertJavaStringToUTF8(
+        env, Java_ArupaWebResourceResponse_getEncoding(env, resp));
+
+    std::string status_line = base::NumberToString(status) + " " + reason;
+    std::string content_type = mime;
+    if (!mime.empty() && !charset.empty()) {
+      content_type += "; charset=" + charset;
+    }
+    std::vector<std::string> hnames;
+    std::vector<std::string> hvalues;
+    base::android::AppendJavaStringArrayToStringVector(
+        env, Java_ArupaWebResourceResponse_getHeaderNames(env, resp), &hnames);
+    base::android::AppendJavaStringArrayToStringVector(
+        env, Java_ArupaWebResourceResponse_getHeaderValues(env, resp),
+        &hvalues);
+
+    net::HttpResponseHeaders::Builder builder(net::HttpVersion(1, 1),
+                                              status_line);
+    if (!mime.empty()) {
+      builder.AddHeader("Content-Type", content_type);
+    }
+    const size_t pairs = std::min(hnames.size(), hvalues.size());
+    for (size_t i = 0; i < pairs; ++i) {
+      builder.AddHeader(hnames[i], hvalues[i]);
+    }
+
+    std::vector<uint8_t> body;
+    base::android::ScopedJavaLocalRef<jbyteArray> jdata =
+        Java_ArupaWebResourceResponse_getData(env, resp);
+    if (!jdata.is_null()) {
+      base::android::JavaByteArrayToByteVector(env, jdata, &body);
+    }
+
+    auto head = network::mojom::URLResponseHead::New();
+    head->headers = builder.Build();
+    head->mime_type = mime;
+    head->charset = charset;
+    head->content_length = static_cast<int64_t>(body.size());
+    head->request_start = base::TimeTicks::Now();
+    head->response_start = base::TimeTicks::Now();
+
+    new ArupaServedResponseLoader(std::move(head), std::move(body),
+                                  std::move(loader), std::move(client));
+  }
+
+  ArupaServedResponseLoader(const ArupaServedResponseLoader &) = delete;
+  ArupaServedResponseLoader &
+  operator=(const ArupaServedResponseLoader &) = delete;
+
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams,
+                      const std::optional<GURL> &) override {}
+  void SetPriority(net::RequestPriority, int32_t) override {}
+
+private:
+  ArupaServedResponseLoader(
+      network::mojom::URLResponseHeadPtr head, std::vector<uint8_t> body,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client)
+      : receiver_(this, std::move(loader)), client_(std::move(client)),
+        body_(std::move(body)) {
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &ArupaServedResponseLoader::OnDisconnect, base::Unretained(this)));
+
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    if (mojo::CreateDataPipe(nullptr, producer, consumer) != MOJO_RESULT_OK) {
+      client_->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_INSUFFICIENT_RESOURCES));
+      return;
+    }
+    client_->OnReceiveResponse(std::move(head), std::move(consumer),
+                               std::nullopt);
+
+    auto data_producer =
+        std::make_unique<mojo::DataPipeProducer>(std::move(producer));
+    mojo::DataPipeProducer *raw_producer = data_producer.get();
+    base::span<const char> span(reinterpret_cast<const char *>(body_.data()),
+                                body_.size());
+    raw_producer->Write(
+        std::make_unique<mojo::StringDataSource>(
+            span, mojo::StringDataSource::AsyncWritingMode::
+                      STRING_STAYS_VALID_UNTIL_COMPLETION),
+        base::BindOnce(&ArupaServedResponseLoader::OnBodyWritten,
+                       base::Unretained(this), std::move(data_producer)));
+  }
+
+  ~ArupaServedResponseLoader() override = default;
+
+  void OnBodyWritten(std::unique_ptr<mojo::DataPipeProducer> producer,
+                     MojoResult result) {
+    network::URLLoaderCompletionStatus status;
+    status.error_code = (result == MOJO_RESULT_OK) ? net::OK : net::ERR_FAILED;
+    status.decoded_body_length = base::ByteSize(body_.size());
+    status.encoded_body_length = base::ByteSize(body_.size());
+    if (client_) {
+      client_->OnComplete(status);
+    }
+  }
+
+  void OnDisconnect() { delete this; }
+
+  mojo::Receiver<network::mojom::URLLoader> receiver_;
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  std::vector<uint8_t> body_;
+};
