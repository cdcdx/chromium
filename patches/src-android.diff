+
+// 宿主拒绝新快照时恢复旧 session rules。只接受规则数组；空字符串表示清空。
+bool ReplaceSessionRulesJson(const std::string& extension_id,
+                             const std::string& rules_json);
+
+// 停用、卸载或换扩展根时清掉当前进程的临时规则。
+void ClearSessionRules(const std::string& extension_id);
+
