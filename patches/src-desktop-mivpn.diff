+MivpnService::Reply::Reply(Callback callback) : callback(std::move(callback)) {}
+MivpnService::Reply::~Reply() = default;
+
+MivpnService::MivpnService() = default;
+MivpnService::~MivpnService() {
+  Shutdown();
+}
+
+MivpnService& MivpnService::Get() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<MivpnService> service;
+  return *service;
+}
+
+uint64_t MivpnService::RegisterCaller(CallerCheck check) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return shutdown_ ? 0 : requests_.RegisterCaller(std::move(check));
+}
+
+void MivpnService::RetireCaller(uint64_t caller) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  requests_.RetireCaller(caller);
+}
+
+void MivpnService::Deliver(scoped_refptr<Reply> reply, Outcome outcome) {
+  if (!reply->callback)
+    return;
+  switch (outcome) {
+    case Outcome::kCompleted:
+      break;
+    case Outcome::kForbidden:
+      reply->error = "FORBIDDEN";
+      break;
+    case Outcome::kTimeout:
+      reply->error = "TIMEOUT";
+      break;
+    case Outcome::kSuperseded:
+      reply->error = "SUPERSEDED";
+      break;
+    case Outcome::kUnavailable:
+      reply->error = "SDK_UNAVAILABLE";
+      break;
+  }
+  if (!reply->error.empty())
+    reply->arguments.clear();
+  const bool success = reply->error.empty();
+  std::move(reply->callback).Run(success, std::move(reply->arguments), reply->error);
+}
+
+void MivpnService::ForwardOutcome(base::WeakPtr<MivpnService> owner,
+                                 scoped_refptr<Reply> reply, Outcome outcome) {
+  if (owner) {
+    owner->OnRequestOutcome(std::move(reply), outcome);
+    return;
+  }
+  Deliver(std::move(reply), Outcome::kUnavailable);
+}
+
+void MivpnService::OnRequestOutcome(scoped_refptr<Reply> reply, Outcome outcome) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (reply->token)
+    RetireMutationRequest(*reply->token, outcome);
+  // A finite API deadline also retires a silent Utility; resetting Mojo alone
+  // is not cancellation of a synchronous SDK call or proof of process exit.
+  if (alive && outcome == Outcome::kTimeout)
+    OnUtilityLost();
+  Deliver(std::move(reply), outcome);
+}
+
+void MivpnService::FinishUnavailableVersion(Reply& reply) {
+  base::DictValue version;
+  version.Set("apiVersion", "2");
+  version.Set("sdkAvailable", false);
+  version.Set("errorCode", "SDK_UNAVAILABLE");
+  reply.arguments.Append(std::move(version));
+}
+
+void MivpnService::FinishUnavailableStatus(Reply& reply) {
+  base::DictValue status;
+  status.Set("state", "ERROR_BLOCKED");
+  status.Set("sdkAvailable", false);
+  status.Set("generation", 0);
+  status.Set("errorCode", "SDK_UNAVAILABLE");
+  reply.arguments.Append(std::move(status));
+}
+
+void MivpnService::Request(uint64_t caller, std::string_view name,
+                           const base::ListValue& arguments, Callback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!callback)
+    return;
+  if (shutdown_) {
+    std::move(callback).Run(false, base::ListValue(), "SDK_UNAVAILABLE");
+    return;
+  }
+  using Kind = MivpnServiceRequests::Kind;
+  Kind kind = Kind::kStatus;
+  if (name == "mivpn.getVersion")
+    kind = Kind::kVersion;
+  else if (name == "mivpn.connect")
+    kind = Kind::kConnect;
+  else if (name == "mivpn.switchNode")
+    kind = Kind::kSwitch;
+  else if (name == "mivpn.disconnect")
+    kind = Kind::kDisconnect;
+
+  auto reply = base::MakeRefCounted<Reply>(std::move(callback));
+  const auto alive = weak_factory_.GetWeakPtr();
+  const auto token = BeginRequest(kind, caller, reply);
+  if (!alive || !token)
+    return;
+  // Revalidate within the service, without retaining or cloning RequestParams.
+  const auto error = MivpnPrivateArgumentsError(name, arguments);
+  if (!error.empty()) {
+    reply->error = std::string(error);
+    requests_.Complete(*token);
+    return;
+  }
+  if (kind == Kind::kVersion) {
+    if (!EnsureUtility()) {
+      FinishUnavailableVersion(*reply);
+      requests_.Complete(*token);
+      return;
+    }
+    remote_->GetVersion(base::BindOnce(
+        &MivpnService::OnVersion, alive, *token, std::move(reply)));
+    return;
+  }
+  if (kind == Kind::kStatus) {
+    if (!remote_.is_bound() || runtime_faulted_ || shutdown_) {
+      FinishUnavailableStatus(*reply);
+      requests_.Complete(*token);
+      return;
+    }
+    remote_->GetStatus(base::BindOnce(
+        &MivpnService::OnStatus, alive, *token, std::move(reply)));
+    return;
+  }
+  // Product Node admission and the mutation lifecycle are a separate slice.
+  // Never launch/execute a node or claim Disconnect success through this gate.
+  reply->error = "SDK_UNAVAILABLE";
+  requests_.Complete(*token);
+}
+
+std::optional<MivpnService::Token> MivpnService::BeginRequest(
+    MivpnServiceRequests::Kind kind, uint64_t caller, scoped_refptr<Reply> reply) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  const auto token = requests_.Begin(
+      kind, caller, base::BindOnce(&MivpnService::ForwardOutcome, alive, reply));
+  if (!alive || !token)
+    return std::nullopt;
+  reply->token = token;
+  return token;
+}
+
+bool MivpnService::PrepareListenerForRequest(
+    Token token, RuntimeIdentity identity, std::string node_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (shutdown_ || runtime_faulted_ || listener_ || mutation_ ||
+      node_id.empty() || node_id.size() > 128 ||
+      node_id.find('\0') != std::string::npos ||
+      !remote_.is_bound() || !remote_.is_connected() ||
+      !MatchesLiveOwnedProcess(identity) ||
+      (product_connect_ &&
+       (!MatchesProductConnect(token, identity) || !product_connect_->sdk_available ||
+        GetMivpnProductGeneration() != product_connect_->generation)) ||
+      !requests_.ValidateForCommit(token, MivpnServiceRequests::Kind::kConnect) ||
+      !alive || shutdown_ || runtime_faulted_ || listener_ || mutation_ ||
+      !remote_.is_bound() || !remote_.is_connected() ||
+      !MatchesLiveOwnedProcess(identity) ||
+      (product_connect_ &&
+       (!MatchesProductConnect(token, identity) || !product_connect_->sdk_available ||
+        GetMivpnProductGeneration() != product_connect_->generation)))
+    return false;
+  auto lease = MivpnListenerLease::Create(
+      {token.operation_epoch, identity.utility_generation,
+       identity.listener_lease_generation}, utility_process_.Duplicate());
+  if (!lease || !MatchesLiveOwnedProcess(identity))
+    return false;
+  const auto endpoint = net::IPEndPoint(net::IPAddress::IPv4Localhost(),
+                                       lease->endpoint().port);
+  listener_.emplace(ListenerBinding{token, identity, std::move(lease),
+                                   endpoint, std::move(node_id)});
+  return true;
+}
+
+bool MivpnService::MatchesListenerBinding(
+    Token token, RuntimeIdentity identity, ListenerPhase phase) const {
+  return listener_ && !listener_->retired && listener_->token == token &&
+         listener_->identity == identity && listener_->phase == phase;
+}
+
+bool MivpnService::HasCurrentProductNodeBinding() const {
+  return !listener_ || !listener_->product_generation ||
+      GetMivpnProductGeneration() == listener_->product_generation;
+}
+
+bool MivpnService::ValidateListenerForRequest(
+    Token token, RuntimeIdentity identity, ListenerPhase phase) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!MatchesListenerBinding(token, identity, phase))
+    return false;
+  if (!HasCurrentProductNodeBinding()) {
+    RetireListenerRequest(token);
+    return false;
+  }
+  const bool allowed = !shutdown_ && !runtime_faulted_ &&
+      remote_.is_bound() && remote_.is_connected() &&
+      MatchesLiveOwnedProcess(identity) &&
+      requests_.ValidateForCommit(token, MivpnServiceRequests::Kind::kConnect);
+  if (!alive)
+    return false;
+  // No reference or cached permission survives arbitrary CallerCheck code.
+  if (!allowed || shutdown_ || runtime_faulted_ ||
+      !remote_.is_bound() || !remote_.is_connected() ||
+      !MatchesLiveOwnedProcess(identity) || !HasCurrentProductNodeBinding()) {
+    if (MatchesListenerBinding(token, identity, phase))
+      RetireListenerRequest(token);
+    return false;
+  }
+  return MatchesListenerBinding(token, identity, phase);
+}
+
+std::optional<network::TransferableSocket> MivpnService::TakeListenerForRequest(
+    Token token, RuntimeIdentity identity) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!ValidateListenerForRequest(token, identity, ListenerPhase::kReady))
+    return std::nullopt;
+  auto transfer = listener_->lease->TakeForTransfer(
+      {token.operation_epoch, identity.utility_generation,
+       identity.listener_lease_generation});
+  if (!transfer) {
+    RetireListenerRequest(token);
+    return std::nullopt;
+  }
+  // Consumed before IPC and never retried, including failed duplication/import.
+  listener_->phase = ListenerPhase::kAwaitingAck;
+  return transfer;
+}
+
+bool MivpnService::StartListenerImportForRequest(
+    Token token, RuntimeIdentity identity) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto transfer = TakeListenerForRequest(token, identity);
+  if (!transfer)
+    return false;
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!ValidateListenerForRequest(token, identity, ListenerPhase::kAwaitingAck) ||
+      !alive)
+    return false;
+  // No TakeSocket in Browser. ACK has no remote identity/endpoint: bind only
+  // the Browser's captured full request/runtime pair, not response fields.
+  remote_->SetPreboundListener(identity.listener_lease_generation,
+      std::move(*transfer), base::BindOnce(&MivpnService::OnPreboundListenerAck,
+                                          alive, token, identity));
+  return true;
+}
+
+void MivpnService::OnPreboundListenerAck(
+    Token token, RuntimeIdentity identity, bool success,
+    const std::string& error) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto before_ack = weak_factory_.GetWeakPtr();
+  if (!ValidateListenerForRequest(token, identity, ListenerPhase::kAwaitingAck)) {
+    if (before_ack)
+      AbortProductConnect(token, identity);
+    return;
+  }
+  if (!success || !error.empty() || mutation_) {
+    // Retire before any request callback; don't expose arbitrary remote errors.
+    RetireListenerRequest(token);
+    OnUtilityLost();
+    return;
+  }
+  // Legacy private fixtures may stop at the armed gate. An admitted product
+  // startup alone continues through its own exact, single-use Node handoff.
+  if (!runtime_commit_.ArmConnect(identity, token.operation_epoch,
+                                 listener_->endpoint, listener_->node_id)) {
+    RetireListenerRequest(token);
+    OnUtilityLost();
+    return;
+  }
+  mutation_ = MutationBinding{token, identity};
+  listener_->phase = ListenerPhase::kAcknowledged;
+  if (!MatchesProductConnect(token, identity) ||
+      product_connect_->phase != ProductConnectBinding::Phase::kAwaitingAck)
+    return;
+  // Detach before arbitrary caller code; retirement cannot replace this Node.
+  // The owned mutable JSON is wiped even if dispatch destroys the service.
+  auto product = std::move(product_connect_);
+  const auto alive = weak_factory_.GetWeakPtr();
+  auto node = base::JSONReader::Read(product->json, base::JSON_PARSE_RFC, 16);
+  if (listener_->product_generation != product->generation || !node ||
+      !StartProductConnectForRequest(token, identity, *node)) {
+    if (alive && MatchesMutation(token, identity))
+      OnUtilityLost();
+  }
+}
+
+void MivpnService::RetireListenerRequest(Token token) {
+  if (!listener_ || listener_->token != token || listener_->retired)
+    return;
+  listener_->retired = true;
+  listener_->lease->Cancel({token.operation_epoch,
+                           listener_->identity.utility_generation,
+                           listener_->identity.listener_lease_generation});
+  // Cancel cannot undo a transfer. Keep the exact lease/process association.
+}
+
+bool MivpnService::ValidateConnectForRequest(
+    Token token, RuntimeIdentity identity, ListenerPhase phase) {
+  if (!MatchesMutation(token, identity))
+    return false;
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!ValidateListenerForRequest(token, identity, phase)) {
+    if (alive && MatchesMutation(token, identity) && listener_ &&
+        listener_->token == token && listener_->identity == identity &&
+        listener_->retired)
+      RetireMutationRequest(token, Outcome::kUnavailable);
+    return false;
+  }
+  return MatchesMutation(token, identity) &&
+         MatchesListenerBinding(token, identity, phase);
+}
+
+bool MivpnService::StartProductLaunchForRequest(
+    Token token, const base::Value& node) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_ || runtime_faulted_ || listener_ || mutation_ || product_connect_ ||
+      requests_.IsValidatingCommit())
+    return false;
+  const auto generation = MatchMivpnProductNode(node);
+  if (!generation)
+    return false;
+  auto json = EncodeMivpnPrivateNode(node);
+  if (!json)
+    return false;
+  PrivateMutationJsonWiper wipe{&*json};
+  // Capture all caller data before any CallerCheck. Only this service owns it;
+  // no RequestParams, Value reference or renderer operation ID is retained.
+  product_connect_ = std::make_unique<ProductConnectBinding>(
+      token, *generation, std::move(*json), *node.GetDict().FindString("id"));
+  const auto alive = weak_factory_.GetWeakPtr();
+  const bool allowed = requests_.ValidateForCommit(
+      token, MivpnServiceRequests::Kind::kConnect);
+  if (!alive)
+    return false;
+  if (!allowed) {
+    if (product_connect_ && product_connect_->token == token)
+      product_connect_.reset();
+    return false;
+  }
+  if (!product_connect_ || product_connect_->token != token)
+    return false;
+  if (shutdown_ || runtime_faulted_ || listener_ || mutation_ ||
+      GetMivpnProductGeneration() != generation) {
+    product_connect_.reset();
+    return false;
+  }
+  const bool available = EnsureUtility();
+  if (!alive)
+    return false;
+  if (!product_connect_ || product_connect_->token != token)
+    return false;
+  if (!available) {
+    product_connect_.reset();
+    return false;
+  }
+  const auto identity = owned_runtime_identity_ ? owned_runtime_identity_ :
+                                                pending_launch_identity_;
+  if (!identity)
+    return AbortProductConnect(token, product_connect_->identity);
+  product_connect_->identity = *identity;
+  if (!ValidateProductConnect(token, *identity) || !alive)
+    return false;
+  remote_->GetVersion(base::BindOnce(&MivpnService::OnProductVersion,
+                                    alive, token, *identity));
+  return true;
+}
+
+bool MivpnService::MatchesProductConnect(
+    Token token, RuntimeIdentity identity) const {
+  return product_connect_ && product_connect_->token == token &&
+      product_connect_->identity == identity;
+}
+
+bool MivpnService::AbortProductConnect(Token token, RuntimeIdentity identity) {
+  if (!MatchesProductConnect(token, identity))
+    return false;
+  product_connect_.reset();
+  // This only retires the Browser's actual owned process, never a PID lookup.
+  // Existing exit/file-lease barriers and failure overlays remain in force.
+  OnUtilityLost();
+  return false;
+}
+
+bool MivpnService::ValidateProductConnect(
+    Token token, RuntimeIdentity identity) {
+  if (!MatchesProductConnect(token, identity))
+    return false;
+  const auto generation = product_connect_->generation;
+  if (shutdown_ || runtime_faulted_ || !remote_.is_bound() ||
+      !remote_.is_connected() || GetMivpnProductGeneration() != generation)
+    return AbortProductConnect(token, identity);
+  const auto alive = weak_factory_.GetWeakPtr();
+  const bool allowed = requests_.ValidateForCommit(
+      token, MivpnServiceRequests::Kind::kConnect);
+  if (!alive || !MatchesProductConnect(token, identity))
+    return false;
+  if (!allowed || shutdown_ || runtime_faulted_ || !remote_.is_bound() ||
+      !remote_.is_connected() || GetMivpnProductGeneration() != generation)
+    return AbortProductConnect(token, identity);
+  return true;
+}
+
+void MivpnService::OnProductVersion(
+    Token token, RuntimeIdentity identity, mivpn::mojom::VersionInfoPtr version) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!MatchesProductConnect(token, identity) ||
+      product_connect_->phase != ProductConnectBinding::Phase::kWaitingPrerequisites ||
+      product_connect_->sdk_available)
+    return;
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (requests_.IsValidatingCommit()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+        base::BindOnce(&MivpnService::OnProductVersion, alive, token, identity,
+                       std::move(version)));
+    return;
+  }
+  if (!ValidateProductConnect(token, identity) || !alive)
+    return;
+  if (!version || !version->sdk_available || version->api_version != 2 ||
+      !version->error_code.empty()) {
+    AbortProductConnect(token, identity);
+    return;
+  }
+  product_connect_->sdk_available = true;
+  ContinueProductConnect(token, identity);
+}
+
+void MivpnService::ContinueProductConnect(Token token, RuntimeIdentity identity) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!MatchesProductConnect(token, identity) ||
+      product_connect_->phase != ProductConnectBinding::Phase::kWaitingPrerequisites ||
+      !product_connect_->sdk_available)
+    return;
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (requests_.IsValidatingCommit()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+        base::BindOnce(&MivpnService::ContinueProductConnect, alive, token, identity));
+    return;
+  }
+  if (!ValidateProductConnect(token, identity) || !alive)
+    return;
+  // Capability may arrive before the launch callback. Only the held, live
+  // process from that callback can authorize socket creation/duplication.
+  if (!MatchesLiveOwnedProcess(identity))
+    return;
+  const std::string node_id = product_connect_->node_id;
+  const auto generation = product_connect_->generation;
+  product_connect_->phase = ProductConnectBinding::Phase::kAwaitingAck;
+  if (!PrepareListenerForRequest(token, identity, node_id) || !alive) {
+    if (alive)
+      AbortProductConnect(token, identity);
+    return;
+  }
+  if (!MatchesProductConnect(token, identity))
+    return;
+  listener_->product_generation = generation;
+  if (!StartListenerImportForRequest(token, identity) && alive)
+    AbortProductConnect(token, identity);
+}
+
+bool MivpnService::StartProductConnectForRequest(
+    Token token, RuntimeIdentity identity, const base::Value& node) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!MatchesMutation(token, identity) ||
+      !MatchesListenerBinding(token, identity, ListenerPhase::kAcknowledged))
+    return false;
+  const auto generation = MatchMivpnProductNode(node);
+  if (!generation || (listener_->product_generation &&
+                       listener_->product_generation != generation))
+    return false;
+  // Consume this native binding before any CallerCheck. StartConnect serializes
+  // its own bounded mutable JSON before calling arbitrary permission code, then
+  // checks the captured product generation before and after every private gate.
+  listener_->product_generation = *generation;
+  const auto alive = weak_factory_.GetWeakPtr();
+  const bool sent = StartConnectForRequest(token, identity, node);
+  if (!sent && alive && MatchesMutation(token, identity))
+    RetireMutationRequest(token, Outcome::kUnavailable);
+  return sent;
+}
+
+bool MivpnService::StartConnectForRequest(
+    Token token, RuntimeIdentity identity, const base::Value& node) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!MatchesMutation(token, identity) ||
+      !MatchesListenerBinding(token, identity, ListenerPhase::kAcknowledged))
+    return false;
+  auto node_json = EncodeMivpnPrivateNode(node);
+  if (!node_json)
+    return false;
+  PrivateMutationJsonWiper wipe{&*node_json};
+  // The structure encoder is not SDK validation or product resource approval.
+  // Never retain a reference to caller-owned Node data across CallerCheck.
+  if (*node.GetDict().FindString("id") != listener_->node_id)
+    return false;
+  if (!ValidateConnectForRequest(token, identity, ListenerPhase::kAcknowledged) ||
+      !alive)
+    return false;
+  // Consume dispatch eligibility before the final CallerCheck and IPC. Failure
+  // after this transition cannot be retried with another Node.
+  listener_->phase = ListenerPhase::kConnecting;
+  if (!ValidateConnectForRequest(token, identity, ListenerPhase::kConnecting) ||
+      !alive)
+    return false;
+  remote_->Connect(*node_json, base::BindOnce(&MivpnService::ForwardConnectResult,
+                                            alive, token, identity));
+  return true;
+}
+
+void MivpnService::ForwardConnectResult(
+    base::WeakPtr<MivpnService> owner, Token token, RuntimeIdentity identity,
+    mivpn::mojom::OperationResultPtr result) {
+  // A static bridge wipes even when WeakPtr expired before delivery. Mojo/GC
+  // copies are outside this mutable-buffer guarantee; never log the result.
+  if (!result) {
+    if (owner)
+      owner->OnConnectResult(token, identity, -10002, std::string());
+    return;
+  }
+  PrivateMutationJsonWiper wipe{&result->status_json};
+  if (owner)
+    owner->OnConnectResult(token, identity, result->code,
+                           std::move(result->status_json));
+}
+
+void MivpnService::OnConnectResult(
+    Token token, RuntimeIdentity identity, int32_t code, std::string status_json) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  PrivateMutationJsonWiper wipe{&status_json};
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!ValidateConnectForRequest(token, identity, ListenerPhase::kConnecting))
+    return;
+  // Reuse the separately proven decoder/endpoint/node/vpn-generation gate,
+  // including its independent CallerCheck immediately before private commit.
+  const bool accepted = AcceptMutationResult(token, identity, code,
+                                             std::move(status_json));
+  if (!alive || !MatchesMutation(token, identity) ||
+      !MatchesListenerBinding(token, identity, ListenerPhase::kConnecting))
+    return;
+  if (!accepted) {
+    RetireMutationRequest(token, Outcome::kUnavailable);
+    if (alive)
+      OnUtilityLost();
+    return;
+  }
+  listener_->phase = ListenerPhase::kResultAccepted;
+  // Only a freshly revalidated local batch may commit the private gate. This
+  // does not settle a public mutation or publish Snapshot/Worker authority.
+  if (InstallConnectContextsForRequest(token, identity) && alive)
+    CommitMutationProxyInstalled(token, identity);
+}
+
+bool MivpnService::ValidateContextInstallRequest(
+    Token token, RuntimeIdentity identity, ListenerPhase phase) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!ValidateConnectForRequest(token, identity, phase) || !alive)
+    return false;
+  // Never hold status/credentials or a reference into a receipt across caller
+  // code. SDK generation is a session, not a Browser/request/context epoch.
+  const bool valid = runtime_commit_.Matches(identity) && !runtime_commit_.retiring_ &&
+      runtime_commit_.pending_ && runtime_commit_.status_ &&
+      runtime_commit_.pending_->operation ==
+          MivpnServiceRuntimeCommit::Operation::kConnect &&
+      runtime_commit_.pending_->operation_epoch == token.operation_epoch &&
+      runtime_commit_.pending_->result_validated &&
+      runtime_commit_.status_->vpn_generation ==
+          runtime_commit_.pending_->vpn_generation &&
+      runtime_commit_.status_->listen_port == listener_->endpoint.port() &&
+      runtime_commit_.status_->node_id == listener_->node_id;
+  return valid || RejectContextInstall(token, identity);
+}
+
+MivpnService::ContextBindings MivpnService::CaptureContextBindings(
+    const base::WeakPtr<MivpnProxyOverride>& context) {
+  ContextBindings bindings;
+  if (context) {
+    for (const auto& path : context->LiveKeys())
+      bindings.emplace_back(path, context->BindingEpoch(path));
+  }
+  return bindings;
+}
+
+bool MivpnService::MatchesContextInstall(
+    const ContextInstallReceipt& receipt, bool with_credentials) const {
+  const auto context = receipt.context;
+  if (!context || context->state().operation_epoch() != receipt.context_epoch ||
+      !context->state().CanAuthenticate(receipt.proxy_runtime,
+                                         receipt.context_epoch) ||
+      context->state().proxy_port() != receipt.port ||
+      CaptureContextBindings(context) != receipt.bindings)
+    return false;
+  const auto found = std::find_if(context_installs_.begin(), context_installs_.end(),
+      [&](const auto& row) {
+        return row.context.get() == context.get() && row.token == receipt.token &&
+            row.identity == receipt.identity &&
+            row.operation == receipt.operation &&
+            row.context_epoch == receipt.context_epoch &&
+            row.credentials_epoch == receipt.credentials_epoch;
+      });
+  if (found == context_installs_.end())
+    return false;
+  if (!with_credentials)
+    return !context->auth_credentials_;
+  return receipt.credentials_epoch && context->auth_credentials_ &&
+      context->auth_credentials_->runtime == receipt.proxy_runtime &&
+      context->auth_credentials_->credentials_epoch == receipt.credentials_epoch;
+}
+
+bool MivpnService::InstallConnectContextsForRequest(
+    Token token, RuntimeIdentity identity) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!ValidateContextInstallRequest(token, identity,
+                                     ListenerPhase::kResultAccepted) || !alive)
+    return false;
+  // Single-use local batch, not a global applied ACK or public Connect commit.
+  listener_->phase = ListenerPhase::kInstallingContexts;
+  const auto contexts = MivpnProxyOverride::LiveContexts();
+  for (const auto context : contexts) {
+    if (!context)
+      continue;
+    const auto bindings = CaptureContextBindings(context);
+    if (!ValidateContextInstallRequest(token, identity,
+                                       ListenerPhase::kInstallingContexts) || !alive)
+      return false;
+    if (!context)
+      continue;
+    if (CaptureContextBindings(context) != bindings)
+      return RejectContextInstall(token, identity);
+    const auto operation = context->Begin(MivpnProxyOverrideState::AccessKey(),
+        MivpnProxyOverrideState::Operation::kConnect);
+    if (!operation)
+      return RejectContextInstall(token, identity);
+    const auto proxy_runtime = MivpnProxyOverrideState::RuntimeIdentity{
+        identity.utility_generation, identity.listener_lease_generation,
+        runtime_commit_.status_->vpn_generation};
+    ContextInstallReceipt receipt{token, identity, context, *operation,
+        context->state().operation_epoch(), proxy_runtime,
+        listener_->endpoint.port(), 0, bindings};
+    // Publish the weak, exact operation receipt BEFORE CompleteConnect: its
+    // existing proxy-state notification is synchronous arbitrary Browser code.
+    context_installs_.push_back(receipt);
+    if (!ValidateContextInstallRequest(token, identity,
+                                       ListenerPhase::kInstallingContexts) || !alive)
+      return false;
+    if (!context || !context->state().IsPending(receipt.operation) ||
+        CaptureContextBindings(context) != receipt.bindings)
+      return RejectContextInstall(token, identity);
+    const bool overlay_installed = context->CompleteConnect(
+        MivpnProxyOverrideState::AccessKey(), receipt.operation,
+        receipt.port, receipt.proxy_runtime);
+    if (!alive)
+      return false;
+    if (!overlay_installed || !MatchesMutation(token, identity) ||
+        !MatchesListenerBinding(token, identity, ListenerPhase::kInstallingContexts))
+      return RejectContextInstall(token, identity);
+    if (!ValidateContextInstallRequest(token, identity,
+                                       ListenerPhase::kInstallingContexts) || !alive)
+      return false;
+    if (!MatchesContextInstall(receipt, false))
+      return RejectContextInstall(token, identity);
+    // This scope invokes no caller/observer code. Build credentials only after
+    // the final permission/process/remote/deadline check and wipe our buffers.
+    bool auth_installed = false;
+    {
+      PrivateProxyCredentials credentials(runtime_commit_.status_->username,
+                                           runtime_commit_.status_->password);
+      auth_installed = context->InstallAuthCredentials(
+          MivpnProxyOverrideState::AccessKey(), receipt.proxy_runtime,
+          receipt.context_epoch, credentials.value);
+      if (auth_installed) {
+        receipt.credentials_epoch = context->auth_credentials_->credentials_epoch;
+        // No callback in InstallAuthCredentials; the just-created receipt exists.
+        context_installs_.back().credentials_epoch = receipt.credentials_epoch;
+      }
+    }
+    if (!auth_installed)
+      return RejectContextInstall(token, identity);
+    if (!ValidateContextInstallRequest(token, identity,
+                                       ListenerPhase::kInstallingContexts) || !alive)
+      return false;
+    if (!MatchesContextInstall(receipt, true))
+      return RejectContextInstall(token, identity);
+  }
+  if (!ValidateContextInstallRequest(token, identity,
+                                     ListenerPhase::kInstallingContexts) || !alive)
+    return false;
+  // Recheck earlier contexts: a later CallerCheck may have changed a binding,
+  // destroyed a context, or replaced an account. No all-context claim escapes.
+  for (const auto& receipt : context_installs_) {
+    if (receipt.token != token || receipt.identity != identity ||
+        !MatchesContextInstall(receipt, true))
+      return RejectContextInstall(token, identity);
+  }
+  listener_->phase = ListenerPhase::kContextsInstalled;
+  return true;
+}
+
+bool MivpnService::MatchesCommittedContextRuntime(
+    Token token, RuntimeIdentity identity) const {
+  return !shutdown_ && !runtime_faulted_ && MatchesMutation(token, identity) &&
+      mutation_->proxy_installed &&
+      MatchesListenerBinding(token, identity, ListenerPhase::kContextsCommitted) &&
+      MatchesLiveOwnedProcess(identity) && remote_.is_bound() && remote_.is_connected() &&
+      runtime_commit_.Matches(identity) && !runtime_commit_.pending_ &&
+      runtime_commit_.snapshot() && runtime_commit_.status_ &&
+      runtime_commit_.status_->listen_port == listener_->endpoint.port() &&
+      runtime_commit_.status_->node_id == listener_->node_id;
+}
+
+bool MivpnService::InstallNewContextOverlayForRequest(
+    Token token, RuntimeIdentity identity,
+    base::WeakPtr<MivpnProxyOverride> context) {
+  // Stage only the existing endpoint overlay, never credentials or permission.
+  // This must precede initial-config selection, even during CallerCheck reentry.
+  if (!context || !MatchesCommittedContextRuntime(token, identity))
+    return false;
+  if (context->state().mode() != MivpnProxyOverrideState::Mode::kInactive ||
+      context->state().proxy_port() || context->auth_credentials_)
+    return RejectContextInstall(token, identity);
+  const auto operation = context->Begin(MivpnProxyOverrideState::AccessKey(),
+      MivpnProxyOverrideState::Operation::kConnect);
+  if (!operation)
+    return RejectContextInstall(token, identity);
+  const auto proxy_runtime = MivpnProxyOverrideState::RuntimeIdentity{
+      identity.utility_generation, identity.listener_lease_generation,
+      runtime_commit_.status_->vpn_generation};
+  ContextInstallReceipt receipt{token, identity, context, *operation,
+      context->state().operation_epoch(), proxy_runtime,
+      listener_->endpoint.port(), 0, CaptureContextBindings(context), 0, false};
+  context_installs_.push_back(receipt);
+  const auto alive = weak_factory_.GetWeakPtr();
+  const bool installed = context->CompleteConnect(
+      MivpnProxyOverrideState::AccessKey(), receipt.operation,
+      receipt.port, receipt.proxy_runtime);
+  if (!alive)
+    return false;
+  if (!context) {
+    std::erase_if(context_installs_, [](const auto& row) { return !row.context; });
+    return false;
+  }
+  if (!installed || !MatchesCommittedContextRuntime(token, identity))
+    return RejectContextInstall(token, identity);
+  const auto found = std::find_if(context_installs_.begin(), context_installs_.end(),
+      [&](const auto& row) {
+        return row.context && context && row.context.get() == context.get() &&
+            row.token == token && row.identity == identity &&
+            row.operation == receipt.operation && row.context_epoch == receipt.context_epoch;
+      });
+  if (found == context_installs_.end())
+    return RejectContextInstall(token, identity);
+  // CompleteConnect synchronously notifies Browser code. Nested observations
+  // saw overlay_ready=false and queued; no account was usable in that window.
+  found->overlay_ready = true;
+  return true;
+}
+
+bool MivpnService::InstallNewContextAuthForRequest(
+    Token token, RuntimeIdentity identity,
+    base::WeakPtr<MivpnProxyOverride> context) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!ValidateConnectForRequest(token, identity,
+                                 ListenerPhase::kContextsCommitted) || !alive)
+    return false;
+  if (!context)
+    return false;
+  if (!MatchesCommittedContextRuntime(token, identity))
+    return RejectContextInstall(token, identity);
+  const auto found = std::find_if(context_installs_.begin(), context_installs_.end(),
+      [&](const auto& row) {
+        return row.context && context && row.context.get() == context.get() &&
+            row.token == token && row.identity == identity;
+      });
+  if (found == context_installs_.end() || !found->overlay_ready ||
+      found->credentials_epoch)
+    return false;
+  auto receipt = *found;
+  receipt.bindings = CaptureContextBindings(context);
+  if (!MatchesContextInstall(receipt, false))
+    return RejectContextInstall(token, identity);
+  // No callback between the fresh check, exact no-account receipt and install.
+  PrivateProxyCredentials credentials(runtime_commit_.status_->username,
+                                       runtime_commit_.status_->password);
+  if (!context->InstallAuthCredentials(MivpnProxyOverrideState::AccessKey(),
+        receipt.proxy_runtime, receipt.context_epoch, credentials.value))
+    return RejectContextInstall(token, identity);
+  found->bindings = std::move(receipt.bindings);
+  found->credentials_epoch = context->auth_credentials_->credentials_epoch;
+  return true;
+}
+
+bool MivpnService::OnNetworkContextProxyBound(
+    base::WeakPtr<MivpnProxyOverride> context, const std::string& path_key,
+    uint64_t binding_epoch) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_ || runtime_faulted_ || !mutation_ || !mutation_->proxy_installed ||
+      !MatchesListenerBinding(mutation_->token, mutation_->identity,
+                              ListenerPhase::kContextsCommitted) ||
+      !context || !binding_epoch || !context->BindingMatches(path_key, binding_epoch))
+    return false;
+  const auto token = mutation_->token;
+  const auto identity = mutation_->identity;
+  const auto alive = weak_factory_.GetWeakPtr();
+  std::erase_if(context_installs_, [](const auto& row) { return !row.context; });
+  const auto find_receipt = [&]() {
+    return std::find_if(context_installs_.begin(), context_installs_.end(),
+        [&](const auto& row) {
+          return row.context && context && row.context.get() == context.get() &&
+              row.token == token && row.identity == identity;
+        });
+  };
+  if (find_receipt() == context_installs_.end()) {
+    if (!InstallNewContextOverlayForRequest(token, identity, context) || !alive)
+      return false;
+  }
+  if (!context || !context->BindingMatches(path_key, binding_epoch))
+    return false;
+  bool needs_auth = false;
+  {
+    const auto found = find_receipt();
+    if (found == context_installs_.end())
+      return false;
+    if (binding_epoch <= found->last_binding_update_epoch)
+      return false;
+    // A staged overlay is not permission. Reentrant observation waits until
+    // fresh CallerCheck and overlay notification finish; do not consume epoch.
+    if (!found->overlay_ready || requests_.IsValidatingCommit()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+          base::BindOnce([](base::WeakPtr<MivpnService> owner,
+                            base::WeakPtr<MivpnProxyOverride> context,
+                            std::string path, uint64_t epoch,
+                            Token token, RuntimeIdentity identity) {
+            if (owner && owner->MatchesMutation(token, identity))
+              owner->OnNetworkContextProxyBound(context, path, epoch);
+          }, alive, context, path_key, binding_epoch, token, identity));
+      return false;
+    }
+    found->last_binding_update_epoch = binding_epoch;
+    needs_auth = !found->credentials_epoch;
+  }
+  if (needs_auth &&
+      (!InstallNewContextAuthForRequest(token, identity, context) || !alive))
+    return false;
+  // Recheck after account installation too; callbacks can revoke, destroy,
+  // rotate account/session or bind another channel. Nothing caches permission.
+  if (!ValidateConnectForRequest(token, identity,
+                                 ListenerPhase::kContextsCommitted) || !alive)
+    return false;
+  if (!context) {
+    std::erase_if(context_installs_, [](const auto& row) { return !row.context; });
+    return false;
+  }
+  if (!context->BindingMatches(path_key, binding_epoch))
+    return false;
+  if (!MatchesCommittedContextRuntime(token, identity))
+    return RejectContextInstall(token, identity);
+  const auto found = find_receipt();
+  if (found == context_installs_.end() ||
+      found->last_binding_update_epoch != binding_epoch)
+    return false;
+  auto refreshed = *found;
+  refreshed.bindings = CaptureContextBindings(context);
+  const auto expected_runtime = MivpnProxyOverrideState::RuntimeIdentity{
+      identity.utility_generation, identity.listener_lease_generation,
+      runtime_commit_.status_->vpn_generation};
+  if (!refreshed.overlay_ready || refreshed.proxy_runtime != expected_runtime ||
+      refreshed.port != listener_->endpoint.port() ||
+      !MatchesContextInstall(refreshed, true))
+    return RejectContextInstall(token, identity);
+  found->bindings = std::move(refreshed.bindings);
+  return true;
+}
+
+bool MivpnService::RejectContextInstall(Token token, RuntimeIdentity identity) {
+  if (!MatchesMutation(token, identity))
+    return false;  // A stale batch cannot retire a successor.
+  const auto alive = weak_factory_.GetWeakPtr();
+  RetireMutationRequest(token, Outcome::kUnavailable);
+  if (alive)
+    OnUtilityLost();
+  return false;
+}
+
+void MivpnService::RetireContextInstalls(Token token, RuntimeIdentity identity) {
+  std::vector<ContextInstallReceipt> retired;
+  std::vector<ContextInstallReceipt> retained;
+  for (auto& receipt : context_installs_) {
+    if (receipt.token == token && receipt.identity == identity)
+      retired.push_back(std::move(receipt));
+    else
+      retained.push_back(std::move(receipt));
+  }
+  context_installs_ = std::move(retained);
+  RetireContextReceipts(std::move(retired));
+}
+
+void MivpnService::RetireContextReceipts(
+    std::vector<ContextInstallReceipt> receipts) {
+  // Detached before any notification, so destruction/reentry cannot reuse them.
+  // These weak receipts do not own BrowserContexts or create another registry.
+  for (const auto& receipt : receipts) {
+    const auto context = receipt.context;
+    if (!context || context->state().operation_epoch() != receipt.context_epoch)
+      continue;
+    if (context->state().IsPending(receipt.operation)) {
+      context->Fail(MivpnProxyOverrideState::AccessKey(), receipt.operation);
+      continue;
+    }
+    if (context->state().proxy_port() != receipt.port ||
+        !context->state().CanAuthenticate(receipt.proxy_runtime,
+                                           receipt.context_epoch))
+      continue;
+    if (context->auth_credentials_ &&
+        (context->auth_credentials_->runtime != receipt.proxy_runtime ||
+         context->auth_credentials_->credentials_epoch != receipt.credentials_epoch))
+      continue;  // A new private account in the same operation is not ours.
+    context->RetireAuthCredentials(MivpnProxyOverrideState::AccessKey(),
+                                  receipt.proxy_runtime, receipt.context_epoch);
+    // The legacy API compares only utility/listener. The checks above add the
+    // exact context epoch AND session AND credentials epoch before calling it.
+    // This faults local eligibility only; it is NOT proof of actual process exit.
+    context->OnRuntimeExit(MivpnProxyOverrideState::AccessKey(), receipt.proxy_runtime);
+  }
+}
+
+bool MivpnService::ArmConnectForRequest(
+    Token token, RuntimeIdentity identity, const net::IPEndPoint& endpoint,
+    std::string node_id) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (shutdown_ || runtime_faulted_ || !MatchesLiveOwnedProcess(identity) ||
+      !requests_.ValidateForCommit(token, MivpnServiceRequests::Kind::kConnect) ||
+      !alive || shutdown_ || runtime_faulted_ ||
+      !MatchesLiveOwnedProcess(identity) || mutation_ ||
+      !runtime_commit_.ArmConnect(identity, token.operation_epoch, endpoint,
+                                  std::move(node_id)))
+    return false;
+  mutation_ = MutationBinding{token, identity};
+  return true;
+}
+
+bool MivpnService::ArmSwitchForRequest(
+    Token token, RuntimeIdentity identity, std::string node_id) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (shutdown_ || runtime_faulted_ || !MatchesLiveOwnedProcess(identity) ||
+      !requests_.ValidateForCommit(token, MivpnServiceRequests::Kind::kSwitch) ||
+      !alive || shutdown_ || runtime_faulted_ ||
+      !MatchesLiveOwnedProcess(identity) || mutation_ ||
+      !runtime_commit_.ArmSwitch(identity, token.operation_epoch,
+                                 std::move(node_id)))
+    return false;
+  mutation_ = MutationBinding{token, identity};
+  return true;
+}
+
+bool MivpnService::ArmDisconnectForRequest(Token token, RuntimeIdentity identity) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (shutdown_ || runtime_faulted_ || !MatchesLiveOwnedProcess(identity) ||
+      !requests_.ValidateForCommit(token, MivpnServiceRequests::Kind::kDisconnect) ||
+      !alive || shutdown_ || runtime_faulted_ ||
+      !MatchesLiveOwnedProcess(identity) || mutation_ ||
+      !runtime_commit_.ArmDisconnect(identity, token.operation_epoch))
+    return false;
+  mutation_ = MutationBinding{token, identity};
+  return true;
+}
+
+bool MivpnService::MatchesMutation(Token token, RuntimeIdentity identity) const {
+  return mutation_ && mutation_->token == token && mutation_->identity == identity;
+}
+
+bool MivpnService::ValidateBoundMutation(Token token, RuntimeIdentity identity) {
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!MatchesMutation(token, identity))
+    return false;
+  if (!HasCurrentProductNodeBinding()) {
+    RetireMutationRequest(token, Outcome::kUnavailable);
+    return false;
+  }
+  const bool allowed = requests_.ValidateForCommit(token);
+  if (!alive)
+    return false;
+  if (!allowed || shutdown_ || runtime_faulted_ ||
+      !MatchesLiveOwnedProcess(identity) || !HasCurrentProductNodeBinding()) {
+    // Caller code may have settled this binding and installed another one.
+    // Never let a stale rejection retire a different request/runtime pair.
+    if (MatchesMutation(token, identity))
+      RetireMutationRequest(token, Outcome::kUnavailable);
+    return false;
+  }
+  return MatchesMutation(token, identity);
+}
+
+bool MivpnService::AcceptMutationResult(
+    Token token, RuntimeIdentity identity, int32_t code, std::string status_json) {
+  // Wipe rejected private JSON too; no copies escape into public replies.
+  PrivateMutationJsonWiper wipe{&status_json};
+  if (!ValidateBoundMutation(token, identity))
+    return false;
+  return runtime_commit_.AcceptNodeResult(
+      identity, token.operation_epoch, code, std::move(status_json));
+}
+
+bool MivpnService::CommitMutationProxyInstalled(Token token,
+                                               RuntimeIdentity identity) {
+  // Not an installer. Connect requires real, exact local overlay/auth receipts;
+  // neither this gate nor its phase is a public mutation settlement.
+  // Consume Connect commit eligibility before arbitrary CallerCheck reentry.
+  if (runtime_commit_.pending_ &&
+      runtime_commit_.pending_->operation ==
+          MivpnServiceRuntimeCommit::Operation::kConnect) {
+    if (!MatchesMutation(token, identity) ||
+        !MatchesListenerBinding(token, identity, ListenerPhase::kContextsInstalled))
+      return false;
+    const auto alive = weak_factory_.GetWeakPtr();
+    listener_->phase = ListenerPhase::kCommittingContexts;
+    if (!ValidateContextInstallRequest(token, identity,
+                                      ListenerPhase::kCommittingContexts) || !alive)
+      return false;
+    // This is a fresh local snapshot, NOT a NetworkService applied ACK. A new
+    // context created by caller code cannot silently inherit an old batch claim.
+    const auto contexts = MivpnProxyOverride::LiveContexts();
+    if (contexts.size() != context_installs_.size())
+      return RejectContextInstall(token, identity);
+    for (const auto& context : contexts) {
+      const auto found = std::find_if(context_installs_.begin(), context_installs_.end(),
+          [&](const auto& receipt) {
+            return receipt.context && context &&
+                receipt.context.get() == context.get() && receipt.token == token &&
+                receipt.identity == identity;
+          });
+      if (found == context_installs_.end() || !MatchesContextInstall(*found, true))
+        return RejectContextInstall(token, identity);
+    }
+    // No caller/observer callback may occur between the last receipt check and
+    // this synchronous private gate commit. Mutation settlement remains pending.
+    if (!runtime_commit_.CommitProxyInstalled(identity, token.operation_epoch))
+      return RejectContextInstall(token, identity);
+    mutation_->proxy_installed = true;
+    listener_->phase = ListenerPhase::kContextsCommitted;
+    return true;
+  }
+  // Switch integration remains separate; do not reinterpret its old gate as
+  // evidence that a Connect batch was installed or committed.
+  if (!ValidateBoundMutation(token, identity) ||
+      !runtime_commit_.CommitProxyInstalled(identity, token.operation_epoch))
+    return false;
+  mutation_->proxy_installed = true;
+  return true;
+}
+
+void MivpnService::RetireMutationRequest(Token token, Outcome outcome) {
+  if (product_connect_ && product_connect_->token == token)
+    product_connect_.reset();
+  RetireListenerRequest(token);
+  if (!mutation_ || mutation_->token != token)
+    return;
+  const auto identity = mutation_->identity;
+  const bool committed = mutation_->proxy_installed && outcome == Outcome::kCompleted;
+  mutation_.reset();
+  if (!committed) {
+    runtime_commit_.Retire();
+    // Last operation: existing overlay notifications can destroy this owner.
+    RetireContextInstalls(token, identity);
+  }
+  // Retire never removes overlay, restores ordinary proxy, or proves exit.
+}
+
+std::optional<MivpnService::RuntimeIdentity>
+MivpnService::ReserveUtilityLaunch() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_ || runtime_faulted_ || launcher_ || pending_launch_identity_ ||
+      owned_runtime_identity_ || utility_process_.IsValid() ||
+      last_owned_identity_.runtime_epoch == std::numeric_limits<uint64_t>::max() ||
+      last_owned_identity_.utility_generation == std::numeric_limits<uint64_t>::max() ||
+      last_owned_identity_.listener_lease_generation == std::numeric_limits<uint64_t>::max())
+    return std::nullopt;
+  ++last_owned_identity_.runtime_epoch;
+  ++last_owned_identity_.utility_generation;
+  ++last_owned_identity_.listener_lease_generation;
+  pending_launch_identity_ = last_owned_identity_;
+  // Reserve the sole future Listener identity, not proof of creation or import.
+  // A rejected launch consumes these ordinals; no counter is rolled back.
+  return pending_launch_identity_;
+}
+
+bool MivpnService::MatchesLiveOwnedProcess(RuntimeIdentity identity) const {
+  return owned_runtime_identity_ && *owned_runtime_identity_ == identity &&
+         utility_process_.IsValid() && utility_process_.Handle() != nullptr &&
+         ::WaitForSingleObject(utility_process_.Handle(), 0) == WAIT_TIMEOUT;
+}
+
+bool MivpnService::ConfirmOwnedRuntimeExit(RuntimeIdentity identity) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!owned_runtime_identity_ || *owned_runtime_identity_ != identity ||
+      !utility_process_.IsValid())
+    return false;
+  int exit_code = 0;
+  if (!utility_process_.WaitForExitWithTimeout(base::TimeDelta(), &exit_code))
+    return false;
+  if (runtime_commit_.held_runtime_ && !runtime_commit_.ConfirmExit(identity))
+    return false;
+  // Only the runtime gate is confirmed here. The caller still must retain the
+  // process/launcher association until the actual SDK file lease is released.
+  return true;
+}
+
+bool MivpnService::EnsureUtility() {
+  if (shutdown_ || runtime_faulted_)
+    return false;
+  if (remote_.is_bound())
+    return true;
+  const auto identity = ReserveUtilityLaunch();
+  if (!identity)
+    return false;
+  launcher_ = MivpnUtilityLauncher::Launch(base::BindOnce(
+      &MivpnService::OnProcessLaunched, weak_factory_.GetWeakPtr(), *identity));
+  if (!launcher_) {
+    // Launch returns null before ServiceProcessHost creates a child. A missing
+    // process callback after a non-null launch must instead retain the barrier.
+    pending_launch_identity_.reset();
+    return false;
+  }
+  remote_ = std::move(launcher_->remote());
+  remote_.set_disconnect_handler(base::BindOnce(
+      &MivpnService::OnUtilityLost, weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void MivpnService::OnProcessLaunched(RuntimeIdentity identity, base::Process process) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!pending_launch_identity_ || *pending_launch_identity_ != identity)
+    return;  // Stale/duplicate callback cannot replace or terminate this owner.
+  if (!process.IsValid() || utility_process_.IsValid() || owned_runtime_identity_) {
+    OnUtilityLost();
+    return;
+  }
+  utility_process_ = std::move(process);
+  owned_runtime_identity_ = identity;
+  pending_launch_identity_.reset();
+  exit_poll_.Start(FROM_HERE, base::Milliseconds(250),
+                   base::BindRepeating(&MivpnService::PollOwnedProcess,
+                                       weak_factory_.GetWeakPtr()));
+  if (runtime_faulted_ || shutdown_) {
+    OnUtilityLost();
+    return;
+  }
+  if (product_connect_ && product_connect_->identity == identity)
+    ContinueProductConnect(product_connect_->token, identity);
+}
+
+void MivpnService::OnUtilityLost() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  product_connect_.reset();
+  if (listener_)
+    RetireListenerRequest(listener_->token);
+  runtime_commit_.Retire();
+  mutation_.reset();
+  runtime_faulted_ = true;
+  remote_.reset();
+  const auto alive = weak_factory_.GetWeakPtr();
+  auto receipts = std::move(context_installs_);
+  context_installs_.clear();
+  RetireContextReceipts(std::move(receipts));
+  if (!alive)
+    return;
+  if (utility_process_.IsValid() && !termination_attempted_) {
+    // Only the actual handle from this launch, never lookup/kill by PID.
+    termination_attempted_ = true;
+    int exit_code = 0;
+    if (!utility_process_.WaitForExitWithTimeout(base::TimeDelta(), &exit_code))
+      utility_process_.Terminate(1, false);
+  }
+  requests_.RetireRuntime();
+  // Keep launcher, file lease and process object until PollOwnedProcess confirms
+  // exit. Missing process callback leaves retirement blocked, not replaceable.
+}
+
+void MivpnService::PollOwnedProcess() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!utility_process_.IsValid() || !owned_runtime_identity_)
+    return;
+  int exit_code = 0;
+  if (!utility_process_.WaitForExitWithTimeout(base::TimeDelta(), &exit_code))
+    return;
+  const auto identity = *owned_runtime_identity_;
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!runtime_faulted_) {
+    // Unexpected process exit also clears authority before any external reply.
+    OnUtilityLost();
+    if (!alive)
+      return;
+  }
+  if (!launcher_ || !launcher_->ReleaseFileLeaseAfterConfirmedExit() ||
+      !ConfirmOwnedRuntimeExit(identity))
+    return;
+  exit_poll_.Stop();
+  remote_.reset();
+  launcher_.reset();
+  listener_.reset();
+  utility_process_.Close();
+  owned_runtime_identity_.reset();
+  runtime_faulted_ = false;
+  termination_attempted_ = false;
+  requests_.RetireRuntime();
+}
+
+void MivpnService::OnVersion(Token token, scoped_refptr<Reply> reply,
+                             mivpn::mojom::VersionInfoPtr version) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!requests_.ValidateForCommit(token) || !alive)
+    return;
+  if (!version ||
+      (version->sdk_available &&
+       (version->api_version != 2 || !version->error_code.empty())) ||
+      (!version->sdk_available && version->api_version != 0 &&
+       version->api_version != 2)) {
+    reply->error = "STATUS_INVALID";
+  } else if (!version->sdk_available) {
+    FinishUnavailableVersion(*reply);
+  } else {
+    base::DictValue value;
+    value.Set("apiVersion", "2");
+    value.Set("sdkAvailable", true);
+    reply->arguments.Append(std::move(value));
+  }
+  requests_.Complete(token);
+}
+
+void MivpnService::OnStatus(Token token, scoped_refptr<Reply> reply,
+                            mivpn::mojom::StatusPtr status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto alive = weak_factory_.GetWeakPtr();
+  if (!requests_.ValidateForCommit(token) || !alive)
+    return;
+  // Private local commits do not settle public mutations. Reject Utility
+  // CONNECTED rather than publishing unadmitted or unsettled runtime status.
+  if (!status || (status->state != "DISCONNECTED" &&
+                  status->state != "ERROR_BLOCKED") ||
+      status->generation > static_cast<uint64_t>(std::numeric_limits<int>::max()) ||
+      status->node_id.size() > 128 ||
+      status->node_id.find('\0') != std::string::npos ||
+      (!status->error_code.empty() && status->error_code != "SDK_UNAVAILABLE" &&
+       status->error_code != "SDK_INTERNAL" && status->error_code != "STATUS_INVALID")) {
+    reply->error = "STATUS_INVALID";
+  } else {
+    base::DictValue value;
+    value.Set("state", status->state);
+    value.Set("sdkAvailable", status->sdk_available);
+    value.Set("generation", static_cast<int>(status->generation));
+    if (!status->node_id.empty())
+      value.Set("nodeId", status->node_id);
+    if (!status->error_code.empty())
+      value.Set("errorCode", status->error_code);
+    reply->arguments.Append(std::move(value));
+  }
+  requests_.Complete(token);
+}
+
+std::optional<MivpnServiceRuntimeCommit::Snapshot>
+MivpnService::RuntimeForAuthSource() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_ || runtime_faulted_ || mutation_ || !owned_runtime_identity_ ||
+      !MatchesLiveOwnedProcess(*owned_runtime_identity_) ||
+      !runtime_commit_.Matches(*owned_runtime_identity_))
+    return std::nullopt;
+  return runtime_commit_.snapshot();
+}
+
+void MivpnService::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_)
+    return;
+  shutdown_ = true;
+  const auto alive = weak_factory_.GetWeakPtr();
+  // Retire the held runtime before callbacks can destroy this owner.
+  OnUtilityLost();
+  if (alive)
+    requests_.Shutdown();
+}
+
+}  // namespace arupa
