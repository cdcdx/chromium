+namespace arupa {
+
+class MivpnUtilityLauncher;
+class MivpnServiceTestPeer;
+
+// One Browser-process control owner, not one Utility per frame or profile.
+// This slice implements caller-owned replies and read-only Utility control.
+// Node operations remain unavailable until product admission, Listener import,
+// proxy/auth commit and retirement barriers are wired. No ordinary host bridge.
+class MivpnService final {
+ public:
+  using Callback =
+      base::OnceCallback<void(bool, base::ListValue, const std::string&)>;
+  using CallerCheck = MivpnServiceRequests::CallerCheck;
+
+  static MivpnService& Get();
+  ~MivpnService();
+  MivpnService(const MivpnService&) = delete;
+  MivpnService& operator=(const MivpnService&) = delete;
+
+  uint64_t RegisterCaller(CallerCheck check);
+  void RetireCaller(uint64_t caller);
+  void Request(uint64_t caller, std::string_view name,
+               const base::ListValue& arguments, Callback callback);
+  void Shutdown();
+  // Browser-private local receipt refresh, not an applied ACK or public commit.
+  bool OnNetworkContextProxyBound(base::WeakPtr<MivpnProxyOverride> context,
+                                  const std::string& path_key,
+                                  uint64_t binding_epoch);
+  // Null until the real Connect/Listener and proxy commit paths are wired.
+  std::optional<MivpnServiceRuntimeCommit::Snapshot> RuntimeForAuthSource() const;
+
+ private:
+  using Token = MivpnServiceRequests::Token;
+  using Outcome = MivpnServiceRequests::Outcome;
+  using RuntimeIdentity = MivpnServiceRuntimeCommit::Identity;
+  struct Reply : public base::RefCounted<Reply> {
+    explicit Reply(Callback callback);
+    Callback callback;
+    base::ListValue arguments;
+    std::string error;
+    std::optional<Token> token;
+
+   private:
+    friend class base::RefCounted<Reply>;
+    ~Reply();
+  };
+  enum class ListenerPhase {
+    kReady, kAwaitingAck, kAcknowledged, kConnecting, kResultAccepted,
+    kInstallingContexts, kContextsInstalled, kCommittingContexts, kContextsCommitted
+  };
+  struct ListenerBinding {
+    Token token;
+    RuntimeIdentity identity;
+    std::unique_ptr<MivpnListenerLease> lease;
+    net::IPEndPoint endpoint;
+    std::string node_id;
+    ListenerPhase phase = ListenerPhase::kReady;
+    bool retired = false;
+    std::optional<base::UnguessableToken> product_generation = std::nullopt;
+  };
+  // Sole request-owned, bounded Node handoff across asynchronous startup.
+  // This is private lifecycle state, not a second protocol or business approval.
+  struct ProductConnectBinding {
+    enum class Phase { kWaitingPrerequisites, kAwaitingAck };
+    ProductConnectBinding(Token token, base::UnguessableToken generation,
+                          std::string json, std::string node_id);
+    ~ProductConnectBinding();
+    Token token;
+    RuntimeIdentity identity{};
+    base::UnguessableToken generation;
+    std::string json;
+    std::string node_id;
+    Phase phase = Phase::kWaitingPrerequisites;
+    bool sdk_available = false;
+  };
+  using ContextBindings = std::vector<std::pair<std::string, uint64_t>>;
+  struct ContextInstallReceipt {
+    Token token;
+    RuntimeIdentity identity;
+    base::WeakPtr<MivpnProxyOverride> context;
+    MivpnProxyOverrideState::OperationToken operation;
+    uint64_t context_epoch;
+    MivpnProxyOverrideState::RuntimeIdentity proxy_runtime;
+    uint16_t port;
+    uint64_t credentials_epoch;
+    ContextBindings bindings;
+    uint64_t last_binding_update_epoch = 0;
+    bool overlay_ready = true;
+  };
+  struct MutationBinding {
+    Token token;
+    RuntimeIdentity identity;
+    bool proxy_installed = false;
+  };
+
+  MivpnService();
+  static void ForwardOutcome(base::WeakPtr<MivpnService> owner,
+                             scoped_refptr<Reply> reply, Outcome outcome);
+  static void Deliver(scoped_refptr<Reply> reply, Outcome outcome);
+  static void FinishUnavailableVersion(Reply& reply);
+  static void FinishUnavailableStatus(Reply& reply);
+  void OnRequestOutcome(scoped_refptr<Reply> reply, Outcome outcome);
+  std::optional<Token> BeginRequest(MivpnServiceRequests::Kind kind,
+                                    uint64_t caller, scoped_refptr<Reply> reply);
+  // Private entry points only. Production may call these only after verifying
+  // the held process/lease/import or actual proxy installation; typed inputs
+  // and these wrappers do not prove those facts. Public mutation stays blocked.
+  // Browser-private preparation and frozen IPC. Public Node admission is still
+  // unavailable. An attempted transfer is never proof of successful import.
+  bool PrepareListenerForRequest(Token token, RuntimeIdentity identity,
+                                 std::string node_id);
+  bool MatchesListenerBinding(Token token, RuntimeIdentity identity,
+                              ListenerPhase phase) const;
+  bool HasCurrentProductNodeBinding() const;
+  bool ValidateListenerForRequest(Token token, RuntimeIdentity identity,
+                                  ListenerPhase phase);
+  std::optional<network::TransferableSocket> TakeListenerForRequest(
+      Token token, RuntimeIdentity identity);
+  bool StartListenerImportForRequest(Token token, RuntimeIdentity identity);
+  void OnPreboundListenerAck(Token token, RuntimeIdentity identity,
+                            bool success, const std::string& error);
+  void RetireListenerRequest(Token token);
+  // Production Node dispatch must enter through the exact product-resource
+  // wrapper. It still does not approve the dedicated business account or open
+  // public mutation; the lower-level method remains private for the control chain.
+  // Future admitted-product caller only; public Request still rejects mutation.
+  // False at admission leaves reply settlement to that caller. Async failure
+  // retires the exact owned runtime through the existing unavailable path.
+  bool StartProductLaunchForRequest(Token token, const base::Value& node);
+  bool MatchesProductConnect(Token token, RuntimeIdentity identity) const;
+  bool ValidateProductConnect(Token token, RuntimeIdentity identity);
+  bool AbortProductConnect(Token token, RuntimeIdentity identity);
+  void ContinueProductConnect(Token token, RuntimeIdentity identity);
+  void OnProductVersion(Token token, RuntimeIdentity identity,
+                        mivpn::mojom::VersionInfoPtr version);
+  bool StartProductConnectForRequest(Token token, RuntimeIdentity identity,
+                                     const base::Value& node);
+  // Private structural admission only, not dedicated-product resource approval.
+  bool ValidateConnectForRequest(Token token, RuntimeIdentity identity,
+                                 ListenerPhase phase);
+  bool StartConnectForRequest(Token token, RuntimeIdentity identity,
+                              const base::Value& node);
+  static void ForwardConnectResult(base::WeakPtr<MivpnService> owner,
+                                   Token token, RuntimeIdentity identity,
+                                   mivpn::mojom::OperationResultPtr result);
+  void OnConnectResult(Token token, RuntimeIdentity identity,
+                       int32_t code, std::string status_json);
+  bool ValidateContextInstallRequest(Token token, RuntimeIdentity identity,
+                                     ListenerPhase phase);
+  bool InstallConnectContextsForRequest(Token token, RuntimeIdentity identity);
+  bool InstallNewContextOverlayForRequest(Token token, RuntimeIdentity identity,
+      base::WeakPtr<MivpnProxyOverride> context);
+  bool InstallNewContextAuthForRequest(Token token, RuntimeIdentity identity,
+      base::WeakPtr<MivpnProxyOverride> context);
+  bool MatchesCommittedContextRuntime(Token token, RuntimeIdentity identity) const;
+  bool RejectContextInstall(Token token, RuntimeIdentity identity);
+  static ContextBindings CaptureContextBindings(
+      const base::WeakPtr<MivpnProxyOverride>& context);
+  bool MatchesContextInstall(const ContextInstallReceipt& receipt,
+                             bool with_credentials) const;
+  void RetireContextInstalls(Token token, RuntimeIdentity identity);
+  static void RetireContextReceipts(std::vector<ContextInstallReceipt> receipts);
+  bool ArmConnectForRequest(Token token, RuntimeIdentity identity,
+                            const net::IPEndPoint& endpoint, std::string node_id);
+  bool ArmSwitchForRequest(Token token, RuntimeIdentity identity, std::string node_id);
+  bool ArmDisconnectForRequest(Token token, RuntimeIdentity identity);
+  bool MatchesMutation(Token token, RuntimeIdentity identity) const;
+  bool ValidateBoundMutation(Token token, RuntimeIdentity identity);
+  bool AcceptMutationResult(Token token, RuntimeIdentity identity,
+                            int32_t code, std::string status_json);
+  bool CommitMutationProxyInstalled(Token token, RuntimeIdentity identity);
+  void RetireMutationRequest(Token token, Outcome outcome);
+  // These identities are allocated only by this Browser owner. A reserved
+  // Listener generation is not evidence that a lease was created or imported.
+  std::optional<RuntimeIdentity> ReserveUtilityLaunch();
+  bool MatchesLiveOwnedProcess(RuntimeIdentity identity) const;
+  bool ConfirmOwnedRuntimeExit(RuntimeIdentity identity);
+  bool EnsureUtility();
+  void OnProcessLaunched(RuntimeIdentity identity, base::Process process);
+  void OnUtilityLost();
+  void PollOwnedProcess();
+  void OnVersion(Token token, scoped_refptr<Reply> reply,
+                 mivpn::mojom::VersionInfoPtr version);
+  void OnStatus(Token token, scoped_refptr<Reply> reply,
+                mivpn::mojom::StatusPtr status);
+
+  bool shutdown_ = false;
+  bool runtime_faulted_ = false;
+  bool termination_attempted_ = false;
+  std::unique_ptr<MivpnUtilityLauncher> launcher_;
+  mojo::Remote<mivpn::mojom::MivpnUtilityService> remote_;
+  base::Process utility_process_;
+  RuntimeIdentity last_owned_identity_;
+  std::optional<RuntimeIdentity> pending_launch_identity_;
+  // Survives mutation retirement and Mojo loss; cleared only after actual exit
+  // AND SDK file-lease release in PollOwnedProcess. Never reconstructed by PID.
+  std::optional<RuntimeIdentity> owned_runtime_identity_;
+  base::RepeatingTimer exit_poll_;
+  MivpnServiceRequests requests_;
+  MivpnServiceRuntimeCommit runtime_commit_;
+  std::optional<MutationBinding> mutation_;
+  // Retained through request retirement/pipe loss until the actual exit and
+  // SDK file-lease release barrier succeeds. Never re-created for a retry.
+  std::optional<ListenerBinding> listener_;
+  std::unique_ptr<ProductConnectBinding> product_connect_;
+  // Weak per-operation installation receipts, not another context registry.
+  std::vector<ContextInstallReceipt> context_installs_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<MivpnService> weak_factory_{this};
+
+  friend class base::NoDestructor<MivpnService>;
+  friend class MivpnServiceTestPeer;
+};
+
+}  // namespace arupa
+
+#endif  // CHROME_BROWSER_ARUPA_DESKTOP_APP_ARUPA_MIVPN_SERVICE_H_
