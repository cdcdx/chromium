+namespace {
+struct PrivateMutationJsonWiper {
+  raw_ptr<std::string> json;
+  ~PrivateMutationJsonWiper() {
+    if (!json->empty())
+      ::SecureZeroMemory(json->data(), json->size());
+  }
+};
+struct PrivateProxyCredentials {
+  PrivateProxyCredentials(const std::string& user, const std::string& pass)
+      : username(user.begin(), user.end()), password(pass.begin(), pass.end()),
+        value(username, password) {}
+  ~PrivateProxyCredentials() {
+    const auto wipe = [](std::u16string& buffer) {
+      if (!buffer.empty())
+        ::SecureZeroMemory(buffer.data(), buffer.size() * sizeof(char16_t));
+    };
+    wipe(username);
+    wipe(password);
+    // value is mutable and owned here; these are not arbitrary const net data.
+    wipe(const_cast<std::u16string&>(value.username()));
+    wipe(const_cast<std::u16string&>(value.password()));
+  }
+  std::u16string username;
+  std::u16string password;
+  net::AuthCredentials value;
+};
+}  // namespace
