+TEST_F(SandboxWinTest, MiVpnRefusesChildNoSandbox) {
+  for (bool parent_no_sandbox : {false, true}) {
+    SCOPED_TRACE(parent_no_sandbox);
+    base::test::ScopedCommandLine scoped_command_line;
+    auto* const parent = scoped_command_line.GetProcessCommandLine();
+    parent->RemoveSwitch(switches::kNoSandbox);
+    parent->RemoveSwitch(switches::kAllowThirdPartyModules);
+    if (parent_no_sandbox) {
+      parent->AppendSwitch(switches::kNoSandbox);
+    }
+    TestSandboxDelegate delegate(sandbox::mojom::Sandbox::kMiVpn);
+    EXPECT_CALL(delegate, InitializeConfig(_)).Times(0);
+    EXPECT_CALL(delegate, PreSpawnTarget(_)).Times(0);
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitch(switches::kNoSandbox);
+    int callbacks = 0;
+    ResultCode result = SandboxWin::StartSandboxedProcess(
+        command_line, {}, &delegate,
+        base::BindOnce(
+            [](int* callbacks, base::Process process, DWORD error, int result) {
+              ++*callbacks;
+              EXPECT_FALSE(process.IsValid());
+              EXPECT_EQ(static_cast<DWORD>(ERROR_ACCESS_DENIED), error);
+              EXPECT_EQ(SBOX_ERROR_BAD_PARAMS, result);
+            },
+            base::Unretained(&callbacks)));
+    EXPECT_EQ(SBOX_ERROR_BAD_PARAMS, result);
+    EXPECT_EQ(1, callbacks);
+  }
