+class UtilityProcessHostMiVpnEarlyRejectTest : public testing::Test {
+ protected:
+  void ExpectRejected(const UnsafeLaunchCase& test_case,
+                      bool parent_no_sandbox = false) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    SCOPED_TRACE(test_case.name);
+    ASSERT_NE(nullptr, GetContentClientForTesting());
+    auto* const browser_before = GetContentClientForTesting()->browser();
+    ASSERT_NE(nullptr, browser_before);
+    auto* const test_client_instance_before =
+        TestContentBrowserClient::GetInstance();
+    const bool renderer_before = RenderProcessHost::run_renderer_in_process();
+    const auto command_line_before =
+        base::CommandLine::ForCurrentProcess()->GetCommandLineString();
+    const auto observations = std::make_shared<Observations>();
+    {
+      // Reverse destruction order is intentional: restore renderer state while
+      // the browser client is live, then restore the old browser client, then
+      // restore *all* command-line bytes affected by the renderer setter.
+      base::test::ScopedCommandLine scoped_command_line;
+      CountingBrowserClient browser_client(observations);
+      ScopedBrowserClientInstallation browser_client_scope(&browser_client);
+      ScopedRendererInProcessState renderer_scope;
+      auto* const command_line = scoped_command_line.GetProcessCommandLine();
+      for (const char* key : {switches::kSingleProcess,
+                             switches::kUtilityCmdPrefix,
+                             sandbox::policy::switches::kNoSandbox,
+                             sandbox::policy::switches::kAllowThirdPartyModules,
+                             switches::kBrowserSubprocessPath}) {
+        command_line->RemoveSwitch(key);
+      }
+      ASSERT_FALSE(RenderProcessHost::run_renderer_in_process());
+      ASSERT_EQ(&browser_client, GetContentClientForTesting()->browser());
+      if (parent_no_sandbox || test_case.parent_no_sandbox) {
+        command_line->AppendSwitch(sandbox::policy::switches::kNoSandbox);
+      }
+
+      UtilityProcessHost::Options options;
+      options.WithSandboxType(sandbox::mojom::Sandbox::kMiVpn);
+      switch (test_case.channel) {
+        case Channel::kRendererState:
+          // Exercise the real setter's locale side effect as well as the bool.
+          // This is a quiescent unit fixture, not a running browser/renderer.
+          command_line->RemoveSwitch(switches::kLang);
+          RenderProcessHost::SetRunRendererInProcess(true);
+          ASSERT_TRUE(RenderProcessHost::run_renderer_in_process());
+          ASSERT_FALSE(command_line->HasSwitch(switches::kSingleProcess));
+          break;
+        case Channel::kBrowser:
+          if (test_case.form == Form::kBare) {
+            command_line->AppendSwitch(test_case.key);
+          } else {
+            command_line->AppendSwitchASCII(test_case.key, test_case.value);
+          }
+          ASSERT_TRUE(command_line->HasSwitch(test_case.key));
+          break;
+        case Channel::kExtraSwitch: {
+          std::string key = test_case.key;
+          if (test_case.form == Form::kValue) {
+            // AppendSwitch("type=renderer") has a different in-memory key
+            // from the switch parsed from its serialized Windows argv.
+            key += "=";
+            key += test_case.value;
+          }
+          options.WithExtraCommandLineSwitches({std::move(key)});
+          break;
+        }
+        case Channel::kExtraKeyValue:
+          options.WithExtraCommandLineSwitchKeyValues(
+              {{test_case.key, test_case.value}});
+          break;
+      }
+
+      observations->inside_start.store(true);
+      const bool started = UtilityProcessHost::Start(
+          std::move(options), std::make_unique<CountingClient>(observations));
+      observations->inside_start.store(false);
+      EXPECT_FALSE(started);
+      ExpectNoConstructionOrCallbacks(*observations);
+      // The synchronous assertions above must already hold before pumping.
+      // Draining also catches delayed launch/crash/destructor notifications.
+      task_environment_.RunUntilIdle();
+      ExpectNoConstructionOrCallbacks(*observations);
+    }
+    EXPECT_EQ(browser_before, GetContentClientForTesting()->browser());
+    EXPECT_EQ(test_client_instance_before, TestContentBrowserClient::GetInstance());
+    EXPECT_EQ(renderer_before, RenderProcessHost::run_renderer_in_process());
+    EXPECT_EQ(command_line_before,
+              base::CommandLine::ForCurrentProcess()->GetCommandLineString());
+  }
+
+ private:
+  static void ExpectNoConstructionOrCallbacks(const Observations& observations) {
+    // This is the construction proof, not just a child-list or client-lifetime
+    // surrogate. The pinned BrowserChildProcessHostImpl constructor calls this
+    // hook synchronously after ChildProcessHost::Create initializes its IPC.
+    EXPECT_EQ(0, observations.host_constructions.load());
+    EXPECT_EQ(1, observations.client_destructions.load());
+    EXPECT_EQ(1, observations.client_destructions_during_start.load());
+    EXPECT_EQ(0, observations.launches.load());
+    EXPECT_EQ(0, observations.crashes.load());
+    EXPECT_EQ(0, observations.normal_terminations.load());
+  }
+
+  // Official UI-main-loop fixture; default IO is the same main-thread loop.
+  // First member, initialized first and destroyed last, as its header requires.
+  BrowserTaskEnvironment task_environment_;
+};
+
+TEST_F(UtilityProcessHostMiVpnEarlyRejectTest, RunRendererInProcess) {
+  ExpectRejected({"RunRendererInProcess", Channel::kRendererState, "", "",
+                  Form::kBare});
+}
