+// MiVPN uses LPAC for network access, without network-service data access.
+bool MiVpnInitializeConfig(sandbox::TargetConfig* config) {
+  DCHECK(!config->IsConfigured());
+  if (base::win::GetVersion() < base::win::Version::WIN10_RS5 ||
+      !config->GetAppContainer()) {
+    return false;
+  }
+  auto result = config->SetTokenLevel(sandbox::USER_UNPROTECTED,
+                                      sandbox::USER_UNPROTECTED);
+  if (result != sandbox::SBOX_ALL_OK) {
+    return false;
+  }
+  result = sandbox::policy::SandboxWin::AddWin32kLockdownPolicy(config);
+  if (result != sandbox::SBOX_ALL_OK) {
+    return false;
+  }
+  config->SetFilterEnvironment(true);
+  config->SetLockdownDefaultDacl();
+  config->AddKernelObjectToClose(sandbox::HandleToClose::kDeviceApi);
+  sandbox::policy::SandboxWin::AddBaseHandleClosePolicy(config);
+  return true;
+}
