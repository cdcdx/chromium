+class CountingClient final : public UtilityProcessHost::Client {
+ public:
+  explicit CountingClient(std::shared_ptr<Observations> observations)
+      : observations_(std::move(observations)) {}
+
+  ~CountingClient() override {
+    ++observations_->client_destructions;
+    if (observations_->inside_start.load()) {
+      ++observations_->client_destructions_during_start;
+    }
+  }
+
+  void OnProcessLaunched(const base::Process&) override {
+    ++observations_->launches;
+  }
+  void OnProcessCrashed(CrashType) override { ++observations_->crashes; }
+  void OnProcessTerminatedNormally() override {
+    ++observations_->normal_terminations;
+  }
+
+ private:
+  // Also avoids a dangling callback target if a regression unexpectedly keeps
+  // the self-owned host alive. This test never kills or looks up a child PID.
+  const std::shared_ptr<Observations> observations_;
+};
