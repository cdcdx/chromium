+// Product private startup orchestration tests - native generation to Connect
+#include "chrome/browser/arupa_desktop/app/mivpn/arupa_mivpn_service.h"
+
+#include "base/test/task_environment.h"
+#include "chrome/browser/arupa_desktop/app/arupa_content_browser_client.h"
+#include "chrome/browser/arupa_desktop/app/mivpn/arupa_mivpn_resources.h"
+#include "chrome/test/base/testing_browser_process.h"
+#include "chrome/test/base/testing_profile.h"
+#include "content/public/test/browser_task_environment.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace arupa_mivpn {
+namespace {
+
+class MivpnProductLaunchOrchestrationTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    profile_ = std::make_unique<TestingProfile>();
+    service_ = std::make_unique<MivpnService>(profile_.get());
+    service_->BindReceiver(service_remote_.BindNewPipeAndPassReceiver());
+  }
+
+  void TearDown() override {
+    service_remote_.reset();
+    service_.reset();
+    profile_.reset();
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  std::unique_ptr<TestingProfile> profile_;
+  std::unique_ptr<MivpnService> service_;
+  mojo::Remote<chrome::mivpn::MivpnService> service_remote_;
+};
+
+// Native generation exists, Connect triggers private launch orchestration
+TEST_F(MivpnProductLaunchOrchestrationTest, 
+       NativeGenerationTriggersPrivateLaunchOrchestration) {
+  // Precondition: native product generation loaded (from mainparts test)
+  // This test assumes component is enabled with valid generation
+  
+  base::RunLoop run_loop;
+  bool callback_invoked = false;
+  chrome::mivpn::OperationResult received_result = 
+      chrome::mivpn::OperationResult::SDK_UNAVAILABLE;
+  
+  service_remote_->Connect(
+      base::BindOnce([](base::RunLoop* loop, bool* invoked,
+                       chrome::mivpn::OperationResult* result,
+                       chrome::mivpn::ConnectReplyPtr reply) {
+        *invoked = true;
+        *result = reply->result;
+        loop->Quit();
+      }, &run_loop, &callback_invoked, &received_result));
+  
+  run_loop.Run();
+  
+  EXPECT_TRUE(callback_invoked);
+  // Without actual Utility launch, should fail at process spawn
+  // but NOT immediately return SDK_UNAVAILABLE
+  EXPECT_NE(received_result, chrome::mivpn::OperationResult::SDK_UNAVAILABLE);
+}
+
+// No native generation, Connect still rejects
+TEST_F(MivpnProductLaunchOrchestrationTest,
+       WithoutNativeGenerationConnectStillRejects) {
+  // Precondition: component disabled or not loaded
+  // Ensure no product generation exists
+  
+  base::RunLoop run_loop;
+  bool callback_invoked = false;
+  chrome::mivpn::OperationResult received_result = 
+      chrome::mivpn::OperationResult::CONNECTED;
+  
+  service_remote_->Connect(
+      base::BindOnce([](base::RunLoop* loop, bool* invoked,
+                       chrome::mivpn::OperationResult* result,
+                       chrome::mivpn::ConnectReplyPtr reply) {
+        *invoked = true;
+        *result = reply->result;
+        loop->Quit();
+      }, &run_loop, &callback_invoked, &received_result));
+  
+  run_loop.Run();
+  
+  EXPECT_TRUE(callback_invoked);
+  EXPECT_EQ(received_result, chrome::mivpn::OperationResult::SDK_UNAVAILABLE);
+}
+
+// Launch orchestration failure retires generation
+TEST_F(MivpnProductLaunchOrchestrationTest,
+       LaunchFailureRetiresProductGeneration) {
+  // Start with native generation, trigger launch, verify retirement on failure
+  
+  base::RunLoop run_loop;
+  bool callback_invoked = false;
+  
+  service_remote_->Connect(
+      base::BindOnce([](base::RunLoop* loop, bool* invoked,
+                       chrome::mivpn::ConnectReplyPtr reply) {
+        *invoked = true;
+        loop->Quit();
+      }, &run_loop, &callback_invoked));
+  
+  run_loop.Run();
+  
+  EXPECT_TRUE(callback_invoked);
+  // After failure, subsequent Connect should revert to SDK_UNAVAILABLE
+  
+  base::RunLoop run_loop2;
+  bool callback_invoked2 = false;
+  chrome::mivpn::OperationResult second_result = 
+      chrome::mivpn::OperationResult::CONNECTED;
+  
+  service_remote_->Connect(
+      base::BindOnce([](base::RunLoop* loop, bool* invoked,
+                       chrome::mivpn::OperationResult* result,
+                       chrome::mivpn::ConnectReplyPtr reply) {
+        *invoked = true;
+        *result = reply->result;
+        loop->Quit();
+      }, &run_loop2, &callback_invoked2, &second_result));
+  
+  run_loop2.Run();
+  
+  EXPECT_TRUE(callback_invoked2);
+  EXPECT_EQ(second_result, chrome::mivpn::OperationResult::SDK_UNAVAILABLE);
+}
