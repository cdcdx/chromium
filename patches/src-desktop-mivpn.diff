+MivpnService::ProductConnectBinding::ProductConnectBinding(
+    Token token, base::UnguessableToken generation,
+    std::string json, std::string node_id)
+    : token(token), generation(generation), json(std::move(json)),
+      node_id(std::move(node_id)) {}
+MivpnService::ProductConnectBinding::~ProductConnectBinding() {
+  if (!json.empty())
+    ::SecureZeroMemory(json.data(), json.size());
+}
