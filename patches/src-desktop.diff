+class GuardedResolveRequest final
+    : public GuardedRequest<net::HostResolver::ResolveHostRequest> {
+ public:
+  using GuardedRequest::GuardedRequest;
+
+  int Start(net::CompletionOnceCallback callback) override {
+    const int rv = Begin();
+    if (rv != net::OK) {
+      return rv;
+    }
+    callback_ = std::move(callback);
+    const int result = inner()->Start(base::BindOnce(
+        &GuardedResolveRequest::Complete, weak_factory_.GetWeakPtr()));
+    if (result != net::ERR_IO_PENDING) {
+      callback_.Reset();
+    }
+    return result;
+  }
+
+  const net::AddressList& GetAddressResults() const override {
+    return inner() ? inner()->GetAddressResults() : empty_addresses_;
+  }
+  base::span<const net::HostResolverEndpointResult> GetEndpointResults()
+      const override {
+    return inner() ? inner()->GetEndpointResults()
+                   : base::span<const net::HostResolverEndpointResult>();
+  }
+  base::span<const std::string> GetTextResults() const override {
+    return inner() ? inner()->GetTextResults()
+                   : base::span<const std::string>();
+  }
+  base::span<const net::HostPortPair> GetHostnameResults() const override {
+    return inner() ? inner()->GetHostnameResults()
+                   : base::span<const net::HostPortPair>();
+  }
+  const std::set<std::string>& GetDnsAliasResults() const override {
+    return inner() ? inner()->GetDnsAliasResults() : empty_aliases_;
+  }
+  net::ResolveErrorInfo GetResolveErrorInfo() const override {
+    return inner() ? inner()->GetResolveErrorInfo()
+                   : net::ResolveErrorInfo(error());
+  }
+  const std::optional<net::HostCache::EntryStaleness>& GetStaleInfo()
+      const override {
+    return inner() ? inner()->GetStaleInfo() : empty_staleness_;
+  }
+  void ChangeRequestPriority(net::RequestPriority priority) override {
+    if (inner()) {
+      inner()->ChangeRequestPriority(priority);
+    }
+  }
+  std::optional<net::ResolutionDetails> GetResolutionDetails() const override {
+    return inner() ? inner()->GetResolutionDetails() : std::nullopt;
+  }
+
+ private:
+  void OnRevoked(bool notify) override {
+    if (!notify) {
+      callback_.Reset();
+    } else if (callback_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&GuardedResolveRequest::Complete,
+                                    weak_factory_.GetWeakPtr(), error()));
+    }
+  }
+  void Complete(int rv) {
+    if (callback_) {
+      std::move(callback_).Run(error() == net::OK ? rv : error());
+    }
+  }
+
+  net::CompletionOnceCallback callback_;
+  const net::AddressList empty_addresses_;
+  const std::set<std::string> empty_aliases_;
+  const std::optional<net::HostCache::EntryStaleness> empty_staleness_;
+  base::WeakPtrFactory<GuardedResolveRequest> weak_factory_{this};
+};
