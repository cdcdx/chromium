+class RecordingUDPWrapper : public UDPSocket::SocketWrapper {
+ public:
+  int Connect(const net::IPEndPoint&,
+              mojom::UDPSocketOptionsPtr,
+              net::IPEndPoint*) override {
+    ++calls;
+    return net::ERR_FAILED;
+  }
+  int Bind(const net::IPEndPoint&,
+           mojom::UDPSocketOptionsPtr,
+           net::IPEndPoint*) override {
+    ++calls;
+    return net::ERR_FAILED;
+  }
+  int SendTo(net::IOBuffer*,
+             int,
+             const net::IPEndPoint&,
+             net::CompletionOnceCallback callback,
+             const net::NetworkTrafficAnnotationTag&) override {
+    ++calls;
+    send_callback = std::move(callback);
+    return net::ERR_IO_PENDING;
+  }
+  int Write(net::IOBuffer*,
+            int,
+            net::CompletionOnceCallback callback,
+            const net::NetworkTrafficAnnotationTag&) override {
+    ++calls;
+    send_callback = std::move(callback);
+    return net::ERR_IO_PENDING;
+  }
+  int SetBroadcast(bool) override { return UnexpectedOperation(); }
+  int SetSendBufferSize(int) override { return UnexpectedOperation(); }
+  int SetReceiveBufferSize(int) override { return UnexpectedOperation(); }
+  int JoinGroup(const net::IPAddress&,
+                const std::optional<net::IPAddress>&) override {
+    return UnexpectedOperation();
+  }
+  int LeaveGroup(const net::IPAddress&,
+                 const std::optional<net::IPAddress>&) override {
+    return UnexpectedOperation();
+  }
+  int RecvFrom(net::IOBuffer* buffer,
+               int,
+               net::IPEndPoint* address,
+               net::CompletionOnceCallback callback) override {
+    ++calls;
+    buffer->first(1u)[0] = 42;
+    *address = LocalAddress();
+    receive_callback = std::move(callback);
+    return net::ERR_IO_PENDING;
+  }
+
+  int calls = 0;
+  net::CompletionOnceCallback send_callback;
+  net::CompletionOnceCallback receive_callback;
+
+ private:
+  int UnexpectedOperation() {
+    ++calls;
+    ADD_FAILURE() << "Blocked UDP operation reached its transport";
+    return net::ERR_FAILED;
+  }
+};
