+struct MivpnConnectedResult {
+  int error;
+  std::optional<net::IPEndPoint> local;
+  std::optional<net::IPEndPoint> peer;
+  mojo::ScopedDataPipeConsumerHandle receive;
+  mojo::ScopedDataPipeProducerHandle send;
+};
+
+class MivpnConnectResults {
+ public:
+  mojom::NetworkContext::CreateTCPConnectedSocketCallback Callback(
+      base::OnceClosure after = base::OnceClosure()) {
+    return base::BindOnce(
+        [](MivpnConnectResults* results, base::OnceClosure after, int error,
+           const std::optional<net::IPEndPoint>& local,
+           const std::optional<net::IPEndPoint>& peer,
+           mojo::ScopedDataPipeConsumerHandle receive,
+           mojo::ScopedDataPipeProducerHandle send) {
+          EXPECT_TRUE(results->values.empty()) << "Connect completed twice";
+          EXPECT_EQ(error == net::OK, local.has_value());
+          EXPECT_EQ(error == net::OK, peer.has_value());
+          EXPECT_EQ(error == net::OK, receive.is_valid());
+          EXPECT_EQ(error == net::OK, send.is_valid());
+          results->values.push_back(MivpnConnectedResult{
+              error, local, peer, std::move(receive), std::move(send)});
+          if (after) {
+            std::move(after).Run();
+          }
+        },
+        this, std::move(after));
+  }
+
+  std::vector<int> Errors() const {
+    std::vector<int> errors;
+    for (const auto& value : values) {
+      errors.push_back(value.error);
+    }
+    return errors;
+  }
+
+  std::vector<MivpnConnectedResult> values;
+};
+
+enum class MivpnConnectPath { kFactory, kBound };
+constexpr MivpnConnectPath kMivpnConnectPaths[] = {MivpnConnectPath::kFactory,
+                                                   MivpnConnectPath::kBound};
+
+void MivpnInstallBoundConnectHook(SocketFactory* factory,
+                                  MivpnConnectTransportState& state) {
+  factory->SetBoundTransportFactoryForTesting(base::BindRepeating(
+      [](MivpnConnectTransportState* state,
+         std::unique_ptr<net::TCPSocket> socket,
+         const net::AddressList& addresses, const net::IPEndPoint& bind_address)
+          -> std::unique_ptr<net::TransportClientSocket> {
+        ++state->bound_hook_calls;
+        EXPECT_TRUE(socket);
+        if (!socket) {
+          return nullptr;
+        }
+        EXPECT_TRUE(socket->IsValid());
+        net::IPEndPoint actual_local;
+        const int result = socket->GetLocalAddress(&actual_local);
+        EXPECT_EQ(net::OK, result);
+        EXPECT_NE(0, actual_local.port());
+        state->bound_socket_address = actual_local;
+        state->bound_bind_argument = bind_address;
+        state->bound_addresses = addresses;
+        // The genuine bound socket is consumed by the same instance hook that
+        // defaults to TCPClientSocket::CreateFromBoundSocket in production.
+        // No ordinary ClientSocketFactory mock can stand in for this path.
+        return state->MakeTransport(addresses, actual_local);
+      },
+      &state));
+}
+
+class MivpnTCPConnectHarness {
+ public:
+  explicit MivpnTCPConnectHarness(scoped_refptr<MivpnResolverPolicy> policy)
+      : client_factory(state), policy(std::move(policy)) {
+    auto builder = net::CreateTestURLRequestContextBuilder();
+    builder->set_client_socket_factory_for_testing(&client_factory);
+    context = builder->Build();
+    factory =
+        std::make_unique<SocketFactory>(nullptr, context.get(), this->policy);
+    MivpnInstallBoundConnectHook(factory.get(), state);
+  }
+  ~MivpnTCPConnectHarness() { Close(); }
+
+  void Close() {
+    bound.reset();
+    connected.reset();
+    factory.reset();
+    results.values.clear();
+  }
+
+  bool PrepareBound() {
+    base::test::TestFuture<int> bind;
+    factory->CreateTCPBoundSocket(
+        LocalAddress(), TRAFFIC_ANNOTATION_FOR_TESTS,
+        bound.BindNewPipeAndPassReceiver(),
+        base::BindLambdaForTesting(
+            [&](int error, const std::optional<net::IPEndPoint>& address) {
+              EXPECT_EQ(net::OK, error);
+              EXPECT_TRUE(address);
+              bound_address = address;
+              bind.SetValue(error);
+            }));
+    return bind.Get() == net::OK;
+  }
+
+  bool Start(MivpnConnectPath path,
+             mojom::TCPConnectedSocketOptionsPtr options = nullptr,
+             const net::AddressList& addresses = MivpnConnectAddresses(),
+             const std::optional<net::IPEndPoint>& local = std::nullopt,
+             base::OnceClosure after = base::OnceClosure(),
+             mojo::PendingRemote<mojom::SocketObserver> observer =
+                 mojo::NullRemote()) {
+    if (path == MivpnConnectPath::kFactory) {
+      factory->CreateTCPConnectedSocket(
+          local, addresses, std::move(options),
+          net::MutableNetworkTrafficAnnotationTag(TRAFFIC_ANNOTATION_FOR_TESTS),
+          connected.BindNewPipeAndPassReceiver(), std::move(observer),
+          results.Callback(std::move(after)));
+      return true;
+    }
+    if (!bound.is_bound() && !PrepareBound()) {
+      return false;
+    }
+    if (policy && policy->blocked()) {
+      bound->Connect(addresses, std::move(options),
+                     connected.BindNewPipeAndPassReceiver(),
+                     std::move(observer), results.Callback(std::move(after)));
+      bound.FlushForTesting();
+      return true;
+    }
+    // Quit stops after the real Bound Connect dispatch, not after an arbitrary
+    // FlushForTesting that could already drain its posted normal completion.
+    base::RunLoop checkpoint;
+    state.after_create = checkpoint.QuitClosure();
+    bound->Connect(addresses, std::move(options),
+                   connected.BindNewPipeAndPassReceiver(), std::move(observer),
+                   results.Callback(std::move(after)));
+    checkpoint.Run();
+    EXPECT_FALSE(state.after_create);
+    return true;
+  }
+
+  MivpnConnectTransportState state;
+  MivpnConnectResults results;
+  MivpnRecordingConnectFactory client_factory;
+  scoped_refptr<MivpnResolverPolicy> policy;
+  std::unique_ptr<net::URLRequestContext> context;
+  std::unique_ptr<SocketFactory> factory;
+  std::optional<net::IPEndPoint> bound_address;
+  mojo::Remote<mojom::TCPBoundSocket> bound;
+  mojo::Remote<mojom::TCPConnectedSocket> connected;
+};
