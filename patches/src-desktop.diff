+class MivpnTCPConnectFactoryTest
+    : public MivpnSocketTest,
+      public testing::WithParamInterface<MivpnConnectPath> {
+ protected:
+  MivpnTCPConnectFactoryTest() : harness_(policy_) {}
+
+  void TearDown() override {
+    harness_.Close();
+    factory_.reset();
+    task_environment_.RunUntilIdle();
+  }
+
+  void CheckEntry() {
+    EXPECT_EQ(1, harness_.state.create_calls);
+    EXPECT_EQ(MivpnConnectAddresses(), harness_.state.created_addresses);
+    EXPECT_EQ(GetParam() == MivpnConnectPath::kBound ? 1 : 0,
+              harness_.state.bound_hook_calls);
+    if (GetParam() == MivpnConnectPath::kBound) {
+      EXPECT_EQ(LocalAddress(), harness_.state.bound_bind_argument);
+      EXPECT_EQ(harness_.bound_address, harness_.state.bound_socket_address);
+      EXPECT_EQ(MivpnConnectAddresses(), harness_.state.bound_addresses);
+      EXPECT_EQ(0, harness_.state.Count(MivpnConnectStep::kBind));
+    }
+  }
+
+  void CheckRevoked() {
+    EXPECT_EQ((std::vector<int>{kRevoked}), harness_.results.Errors());
+    EXPECT_EQ(1, harness_.state.disconnect_calls);
+    EXPECT_EQ(1, harness_.state.destruct_calls);
+    EXPECT_EQ(nullptr, harness_.state.provider->socket());
+    EXPECT_EQ(0, harness_.state.steps_after_cancel);
+  }
+
+  void CheckDestroyedResult() {
+    if (GetParam() == MivpnConnectPath::kFactory) {
+      EXPECT_EQ((std::vector<int>{net::ERR_ABORTED}),
+                harness_.results.Errors());
+    } else {
+      // Bound's weak child continuation is invalidated before the child is
+      // destroyed. It must not synthesize an external abort on a dead Bound.
+      EXPECT_TRUE(harness_.results.values.empty());
+    }
+  }
+
+  void CheckConnected(bool exercise_options = true) {
+    ASSERT_EQ((std::vector<int>{net::OK}), harness_.results.Errors());
+    EXPECT_NE(nullptr, harness_.state.provider->socket());
+    EXPECT_EQ(0, harness_.state.disconnect_calls);
+    EXPECT_EQ(0, harness_.state.destruct_calls);
+    if (exercise_options) {
+      base::test::TestFuture<bool> no_delay;
+      harness_.connected->SetNoDelay(true, no_delay.GetCallback());
+      EXPECT_TRUE(no_delay.Get());
+    }
+    harness_.connected.FlushForTesting();
+    EXPECT_TRUE(harness_.connected.is_connected());
+    if (GetParam() == MivpnConnectPath::kBound) {
+      EXPECT_EQ(harness_.bound_address, harness_.results.values[0].local);
+      harness_.bound.FlushForTesting();
+      EXPECT_FALSE(harness_.bound.is_connected());
+    }
+  }
+
+  MivpnTCPConnectHarness harness_;
+};
+
+TEST_P(MivpnTCPConnectFactoryTest,
+       PendingMivpnConnectDisconnectsSyncAndRevokesAsyncExactlyOnce) {
+  ASSERT_TRUE(harness_.Start(GetParam()));
+  CheckEntry();
+  ASSERT_TRUE(harness_.state.completer.is_connecting());
