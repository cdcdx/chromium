+auto AddressResult(base::test::TestFuture<int>* future, int expected) {
+  return base::BindOnce(
+      [](base::test::TestFuture<int>* future, int expected, int result,
+         const std::optional<net::IPEndPoint>& address) {
+        EXPECT_EQ(expected, result);
+        if (result != net::OK) {
+          EXPECT_FALSE(address);
+        } else {
+          EXPECT_TRUE(address);
+        }
+        future->SetValue(result);
+      },
+      future, expected);
+}
+
+auto DeniedConnectResult(base::test::TestFuture<int>* future) {
+  return base::BindOnce(
+      [](base::test::TestFuture<int>* future, int result,
+         const std::optional<net::IPEndPoint>& local,
+         const std::optional<net::IPEndPoint>& remote,
+         mojo::ScopedDataPipeConsumerHandle receive,
+         mojo::ScopedDataPipeProducerHandle send) {
+        EXPECT_EQ(kRevoked, result);
+        EXPECT_FALSE(local);
+        EXPECT_FALSE(remote);
+        EXPECT_FALSE(receive.is_valid());
+        EXPECT_FALSE(send.is_valid());
+        future->SetValue(result);
+      },
+      future);
+}
