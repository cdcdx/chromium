+// A real, test-only SOCKS endpoint. All listening/accepted/origin sockets live
+// on its dedicated IO sequence, independently of the SSL business owner. It
+// never resolves a client-supplied name: the parsed destination must equal the
+// one fixture origin. In particular, this cannot serve as an open proxy.
+class MivpnNativeSocksRelay {
+ public:
+  struct Stats {
+    int accepted = 0;
+    int requests = 0;
+    int origins = 0;
+    int rejected = 0;
+    int closed = 0;
+    int64_t upstream_bytes = 0;
+    int64_t downstream_bytes = 0;
+  };
+
+  enum class Mode { kForward, kPauseTraffic, kReject, kCloseBeforeReply };
+
+  MivpnNativeSocksRelay(int version, uint16_t origin_port, Mode mode)
+      : version_(version),
+        origin_port_(origin_port),
+        mode_(mode),
+        thread_("mivpn-native-socks-relay") {}
+  ~MivpnNativeSocksRelay() { Stop(); }
+
+  bool Start() {
+    base::Thread::Options options;
+    options.message_pump_type = base::MessagePumpType::IO;
+    if (!thread_.StartWithOptions(std::move(options))) {
+      return false;
+    }
+    base::test::TestFuture<int, uint16_t> ready;
+    auto caller = base::SingleThreadTaskRunner::GetCurrentDefault();
+    if (!thread_.task_runner()->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](MivpnNativeSocksRelay* relay,
+                   scoped_refptr<base::SingleThreadTaskRunner> caller,
+                   base::OnceCallback<void(int, uint16_t)> reply) {
+                  relay->state_ = std::make_unique<State>(
+                      relay->version_, relay->origin_port_, relay->mode_);
+                  uint16_t port = 0;
+                  int result = relay->state_->Start(&port);
+                  caller->PostTask(FROM_HERE, base::BindOnce(std::move(reply),
+                                                             result, port));
+                },
+                base::Unretained(this), caller, ready.GetCallback()))) {
+      thread_.Stop();
+      return false;
+    }
+    if (!ready.Wait()) {
+      return false;
+    }
+    port_ = ready.Get<1>();
+    return ready.Get<0>() == net::OK && port_ != 0;
+  }
+
+  uint16_t port() const { return port_; }
+
+  Stats Snapshot() {
+    base::test::TestFuture<Stats> reply;
+    auto caller = base::SingleThreadTaskRunner::GetCurrentDefault();
+    CHECK(thread_.task_runner()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](MivpnNativeSocksRelay* relay,
+                          scoped_refptr<base::SingleThreadTaskRunner> caller,
+                          base::OnceCallback<void(Stats)> reply) {
+                         caller->PostTask(
+                             FROM_HERE, base::BindOnce(std::move(reply),
+                                                       relay->state_->stats()));
+                       },
+                       base::Unretained(this), caller, reply.GetCallback())));
+    return reply.Get();
+  }
+
+  // Pre-TLS tests can release a pending ordinary Read using a real socket
+  // write. Only paused sessions accept this operation; TLS round trips use
+  // exclusively the two forwarding pumps below.
+  int SendPreTLSByte() {
+    base::test::TestFuture<int> reply;
+    auto caller = base::SingleThreadTaskRunner::GetCurrentDefault();
+    CHECK(thread_.task_runner()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](MivpnNativeSocksRelay* relay,
+               scoped_refptr<base::SingleThreadTaskRunner> caller,
+               base::OnceCallback<void(int)> reply) {
+              relay->state_->SendPreTLSByte(base::BindOnce(
+                  [](scoped_refptr<base::SingleThreadTaskRunner> caller,
+                     base::OnceCallback<void(int)> reply, int result) {
+                    caller->PostTask(FROM_HERE,
+                                     base::BindOnce(std::move(reply), result));
+                  },
+                  caller, std::move(reply)));
+            },
+            base::Unretained(this), caller, reply.GetCallback())));
+    return reply.Get();
+  }
+
+  void Stop() {
+    if (!thread_.IsRunning()) {
+      return;
+    }
+    base::test::TestFuture<void> stopped;
+    auto caller = base::SingleThreadTaskRunner::GetCurrentDefault();
+    CHECK(thread_.task_runner()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](MivpnNativeSocksRelay* relay,
+                          scoped_refptr<base::SingleThreadTaskRunner> caller,
+                          base::OnceClosure reply) {
+                         // Cancel tasks and IO, close endpoints, and destroy
+                         // every socket on its owning sequence before joining
+                         // the thread.
+                         relay->state_.reset();
+                         caller->PostTask(FROM_HERE, std::move(reply));
+                       },
+                       base::Unretained(this), caller, stopped.GetCallback())));
+    CHECK(stopped.Wait());
+    thread_.Stop();
+  }
+
+ private:
+  class Session {
+   public:
+    Session(int version,
+            uint16_t origin_port,
+            Mode mode,
+            Stats* stats,
+            std::unique_ptr<net::StreamSocket> client)
+        : version_(version),
+          origin_port_(origin_port),
+          mode_(mode),
+          stats_(stats),
+          client_(std::move(client)) {}
+    ~Session() { Close(); }
+
+    void Start() {
+      ReadExact(
+          version_ == 4 ? 9 : 3,
+          base::BindOnce(&Session::OnFirstRequest, weak_factory_.GetWeakPtr()));
+    }
+
+    void SendPreTLSByte(net::CompletionOnceCallback reply) {
+      if (closed_ || !ready_ || mode_ != Mode::kPauseTraffic) {
+        std::move(reply).Run(net::ERR_SOCKET_NOT_CONNECTED);
+        return;
+      }
+      CHECK(!pre_tls_reply_);
+      pre_tls_reply_ = std::move(reply);
+      Send(std::string("x"), base::BindOnce(&Session::OnPreTLSWritten,
+                                            weak_factory_.GetWeakPtr()));
+    }
+
+    void Close() {
+      if (closed_) {
+        return;
+      }
+      closed_ = true;
+      weak_factory_.InvalidateWeakPtrs();
+      ++stats_->closed;
+      if (client_) {
+        client_->Disconnect();
+      }
+      if (origin_) {
+        origin_->Disconnect();
+      }
+      // This object remains in State's owned vector until shutdown, so no
+      // active Session callback is deleted by Close.
+      continuation_.Reset();
+      protocol_write_.reset();
+      protocol_read_.reset();
+      client_.reset();
+      origin_.reset();
+      if (pre_tls_reply_) {
+        std::move(pre_tls_reply_).Run(net::ERR_ABORTED);
+      }
+    }
+
+   private:
+    void OnPreTLSWritten() { std::move(pre_tls_reply_).Run(1); }
+
+    static uint8_t Byte(const std::string& data, size_t index) {
+      return static_cast<uint8_t>(data[index]);
+    }
+
+    void ReadExact(int count, base::OnceClosure continuation) {
+      CHECK_GT(count, 0);
+      CHECK_LE(count, 512);
+      protocol_data_.clear();
+      protocol_remaining_ = count;
+      protocol_read_ = base::MakeRefCounted<net::IOBufferWithSize>(count);
+      continuation_ = std::move(continuation);
+      ReadProtocol();
+    }
+
+    void ReadProtocol() {
+      int result = client_->Read(
+          protocol_read_.get(), protocol_remaining_,
+          base::BindOnce(&Session::OnProtocolRead, weak_factory_.GetWeakPtr()));
+      if (result != net::ERR_IO_PENDING) {
+        OnProtocolRead(result);
+      }
+    }
+
+    void OnProtocolRead(int result) {
+      if (result <= 0) {
+        Close();
+        return;
+      }
+      CHECK_LE(result, protocol_remaining_);
+      protocol_data_.append(protocol_read_->data(), result);
+      protocol_remaining_ -= result;
+      if (protocol_remaining_ != 0) {
+        ReadProtocol();
+        return;
+      }
+      protocol_read_.reset();
+      auto continuation = std::move(continuation_);
+      std::move(continuation).Run();
+    }
+
+    void Send(std::string bytes, base::OnceClosure continuation) {
+      auto buffer = base::MakeRefCounted<net::StringIOBuffer>(std::move(bytes));
+      protocol_write_ =
+          base::MakeRefCounted<net::DrainableIOBuffer>(buffer, buffer->size());
+      continuation_ = std::move(continuation);
+      WriteProtocol();
+    }
+
+    void WriteProtocol() {
+      int result = client_->Write(protocol_write_.get(),
+                                  protocol_write_->BytesRemaining(),
+                                  base::BindOnce(&Session::OnProtocolWritten,
+                                                 weak_factory_.GetWeakPtr()),
+                                  TRAFFIC_ANNOTATION_FOR_TESTS);
+      if (result != net::ERR_IO_PENDING) {
+        OnProtocolWritten(result);
+      }
+    }
+
+    void OnProtocolWritten(int result) {
+      if (result <= 0) {
+        Close();
+        return;
+      }
+      protocol_write_->DidConsume(result);
+      if (protocol_write_->BytesRemaining() != 0) {
+        WriteProtocol();
+        return;
+      }
+      protocol_write_.reset();
+      auto continuation = std::move(continuation_);
+      std::move(continuation).Run();
+    }
+
+    void OnFirstRequest() {
+      if (version_ == 4) {
+        // Chromium's actual SOCKS4 request is CONNECT + IPv4 + empty userid.
+        const bool valid =
+            Byte(protocol_data_, 0) == 4 && Byte(protocol_data_, 1) == 1 &&
+            Byte(protocol_data_, 4) == 127 && Byte(protocol_data_, 5) == 0 &&
+            Byte(protocol_data_, 6) == 0 && Byte(protocol_data_, 7) == 1 &&
+            Byte(protocol_data_, 8) == 0 &&
+            RequestPort(protocol_data_, 2) == origin_port_;
+        OnDestination(valid);
+        return;
+      }
+      if (protocol_data_ != std::string("\x05\x01\x00", 3)) {
+        ++stats_->rejected;
+        Close();
+        return;
+      }
+      Send(std::string("\x05\x00", 2),
+           base::BindOnce(&Session::ReadSocks5Header,
+                          weak_factory_.GetWeakPtr()));
+    }
+
+    void ReadSocks5Header() {
+      ReadExact(5, base::BindOnce(&Session::OnSocks5Header,
+                                  weak_factory_.GetWeakPtr()));
+    }
+
+    void OnSocks5Header() {
+      if (Byte(protocol_data_, 0) != 5 || Byte(protocol_data_, 1) != 1 ||
+          Byte(protocol_data_, 2) != 0 || Byte(protocol_data_, 3) != 3 ||
+          Byte(protocol_data_, 4) == 0) {
+        OnDestination(false);
+        return;
+      }
+      ReadExact(Byte(protocol_data_, 4) + 2,
+                base::BindOnce(&Session::OnSocks5Destination,
+                               weak_factory_.GetWeakPtr()));
+    }
+
+    void OnSocks5Destination() {
+      const size_t length = protocol_data_.size() - 2;
+      const std::string host = protocol_data_.substr(0, length);
+      OnDestination((host == "127.0.0.1" || host == "mivpn-native.test") &&
+                    RequestPort(protocol_data_, length) == origin_port_);
+    }
+
+    static uint16_t RequestPort(const std::string& data, size_t offset) {
+      return (static_cast<uint16_t>(Byte(data, offset)) << 8) |
+             Byte(data, offset + 1);
+    }
+
+    std::string Response(bool success) const {
+      std::string bytes =
+          version_ == 4
+              ? std::string("\x00\x5a\x00\x00\x7f\x00\x00\x01", 8)
+              : std::string("\x05\x00\x00\x01\x7f\x00\x00\x01\x00\x00", 10);
+      if (!success) {
+        bytes[1] = version_ == 4 ? '\x5b' : '\x01';
+      }
+      return bytes;
+    }
+
+    void OnDestination(bool valid) {
+      ++stats_->requests;
+      if (!valid || mode_ == Mode::kReject) {
+        ++stats_->rejected;
+        Send(Response(false),
+             base::BindOnce(&Session::Close, weak_factory_.GetWeakPtr()));
+        return;
+      }
+      if (mode_ == Mode::kCloseBeforeReply) {
+        Close();
+        return;
+      }
+      // The client supplied no arbitrary endpoint to this constructor. Only
+      // the independently fixed HTTPS fixture origin is ever dialed.
+      origin_ = std::make_unique<net::TCPClientSocket>(
+          net::AddressList::CreateFromIPAddress(net::IPAddress::IPv4Localhost(),
+                                                origin_port_),
+          nullptr, nullptr, net::NetLog::Get(), net::NetLogSource(),
+          net::handles::kInvalidNetworkHandle);
+      int result = origin_->Connect(base::BindOnce(&Session::OnOriginConnected,
+                                                   weak_factory_.GetWeakPtr()));
+      if (result != net::ERR_IO_PENDING) {
+        OnOriginConnected(result);
+      }
+    }
+
+    void OnOriginConnected(int result) {
+      if (result != net::OK) {
+        ++stats_->rejected;
+        Send(Response(false),
+             base::BindOnce(&Session::Close, weak_factory_.GetWeakPtr()));
+        return;
+      }
+      ++stats_->origins;
+      Send(Response(true),
+           base::BindOnce(&Session::StartPumps, weak_factory_.GetWeakPtr()));
+    }
+
+    void StartPumps() {
+      ready_ = true;
+      if (mode_ == Mode::kPauseTraffic) {
+        return;
+      }
+      for (int direction = 0; direction != 2; ++direction) {
+        pumps_[direction].buffer =
+            base::MakeRefCounted<net::IOBufferWithSize>(16384);
+        QueueRead(direction);
+      }
+    }
+
+    net::StreamSocket* Source(int direction) {
+      return direction == 0 ? client_.get() : origin_.get();
+    }
+    net::StreamSocket* Destination(int direction) {
+      return direction == 0 ? origin_.get() : client_.get();
+    }
+
+    void QueueRead(int direction) {
+      // Avoid unbounded synchronous read/write recursion on loopback. Weak
+      // tasks are explicitly invalidated before State joins its IO thread.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&Session::ReadPump,
+                                    weak_factory_.GetWeakPtr(), direction));
+    }
+
+    void ReadPump(int direction) {
+      int result = Source(direction)->Read(
+          pumps_[direction].buffer.get(), pumps_[direction].buffer->size(),
+          base::BindOnce(&Session::OnPumpRead, weak_factory_.GetWeakPtr(),
+                         direction));
+      if (result != net::ERR_IO_PENDING) {
+        OnPumpRead(direction, result);
+      }
+    }
+
+    void OnPumpRead(int direction, int result) {
+      if (result <= 0) {
+        Close();
+        return;
+      }
+      pumps_[direction].drain = base::MakeRefCounted<net::DrainableIOBuffer>(
+          pumps_[direction].buffer, result);
+      WritePump(direction);
+    }
+
+    void WritePump(int direction) {
+      auto& pump = pumps_[direction];
+      int result = Destination(direction)->Write(
+          pump.drain.get(), pump.drain->BytesRemaining(),
+          base::BindOnce(&Session::OnPumpWritten, weak_factory_.GetWeakPtr(),
+                         direction),
+          TRAFFIC_ANNOTATION_FOR_TESTS);
+      if (result != net::ERR_IO_PENDING) {
+        OnPumpWritten(direction, result);
+      }
+    }
+
+    void OnPumpWritten(int direction, int result) {
+      if (result <= 0) {
+        Close();
+        return;
+      }
+      if (direction == 0) {
+        stats_->upstream_bytes += result;
+      } else {
+        stats_->downstream_bytes += result;
+      }
+      auto& pump = pumps_[direction];
+      pump.drain->DidConsume(result);
+      if (pump.drain->BytesRemaining() != 0) {
+        WritePump(direction);
+        return;
+      }
+      pump.drain.reset();
+      QueueRead(direction);
+    }
+
+    struct Pump {
+      scoped_refptr<net::IOBufferWithSize> buffer;
+      scoped_refptr<net::DrainableIOBuffer> drain;
+    };
+    const int version_;
+    const uint16_t origin_port_;
+    const Mode mode_;
+    raw_ptr<Stats> stats_;
+    bool ready_ = false;
+    bool closed_ = false;
+    std::unique_ptr<net::StreamSocket> client_;
+    std::unique_ptr<net::TCPClientSocket> origin_;
+    scoped_refptr<net::IOBufferWithSize> protocol_read_;
+    scoped_refptr<net::DrainableIOBuffer> protocol_write_;
+    int protocol_remaining_ = 0;
+    std::string protocol_data_;
+    base::OnceClosure continuation_;
+    net::CompletionOnceCallback pre_tls_reply_;
+    std::array<Pump, 2> pumps_;
+    base::WeakPtrFactory<Session> weak_factory_{this};
+  };
+
+  class State {
+   public:
+    State(int version, uint16_t origin_port, Mode mode)
+        : version_(version), origin_port_(origin_port), mode_(mode) {}
+    ~State() {
+      weak_factory_.InvalidateWeakPtrs();
+      listener_.reset();
+      pending_client_.reset();
+      for (auto& session : sessions_) {
+        session->Close();
+      }
+      sessions_.clear();
+    }
+
+    int Start(uint16_t* port) {
+      listener_ =
+          std::make_unique<net::TCPServerSocket>(nullptr, net::NetLogSource());
+      int result = listener_->Listen(
+          net::IPEndPoint(net::IPAddress::IPv4Localhost(), 0), 8, std::nullopt);
+      if (result != net::OK) {
+        return result;
+      }
+      net::IPEndPoint address;
+      result = listener_->GetLocalAddress(&address);
+      if (result != net::OK) {
+        return result;
+      }
+      CHECK_EQ(net::IPAddress::IPv4Localhost(), address.address());
+      *port = address.port();
+      Accept();
+      return net::OK;
+    }
+
+    Stats stats() const { return stats_; }
+    void SendPreTLSByte(net::CompletionOnceCallback reply) {
+      if (sessions_.empty()) {
+        std::move(reply).Run(net::ERR_SOCKET_NOT_CONNECTED);
+        return;
+      }
+      sessions_.back()->SendPreTLSByte(std::move(reply));
+    }
+
+   private:
+    void Accept() {
+      int result = listener_->Accept(
+          &pending_client_,
+          base::BindOnce(&State::OnAccepted, weak_factory_.GetWeakPtr()));
+      if (result != net::ERR_IO_PENDING) {
+        OnAccepted(result);
+      }
+    }
+    void OnAccepted(int result) {
+      if (result != net::OK) {
+        ++stats_.rejected;
+        return;
+      }
+      net::IPEndPoint peer;
+      if (pending_client_->GetPeerAddress(&peer) != net::OK ||
+          peer.address() != net::IPAddress::IPv4Localhost()) {
+        ++stats_.rejected;
+        pending_client_.reset();
+        return;
+      }
+      ++stats_.accepted;
+      sessions_.push_back(std::make_unique<Session>(
+          version_, origin_port_, mode_, &stats_, std::move(pending_client_)));
+      sessions_.back()->Start();
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&State::Accept, weak_factory_.GetWeakPtr()));
+    }
+    const int version_;
+    const uint16_t origin_port_;
+    const Mode mode_;
+    Stats stats_;
+    std::unique_ptr<net::TCPServerSocket> listener_;
+    std::unique_ptr<net::StreamSocket> pending_client_;
+    std::vector<std::unique_ptr<Session>> sessions_;
+    base::WeakPtrFactory<State> weak_factory_{this};
+  };
+
+  const int version_;
+  const uint16_t origin_port_;
+  const Mode mode_;
+  uint16_t port_ = 0;
+  base::Thread thread_;
+  // Accessed/constructed/destroyed only by thread_. The outer object's lifetime
+  // spans the explicit shutdown reply and Thread::Stop join.
+  std::unique_ptr<State> state_;
+};
+
+// Independent observation of a real lower native completion window.
+struct MivpnNativeSocksReadCompletionState {
+  int active = 0;
+  int completions = 0;
+  int forwarded = 0;
+  int destructions = 0;
+  base::OnceClosure hook;
+};
+
+// Wrap an ACTUAL native TCP completion, not a saved cancelled-provider callback
+// fabricated by the fixture. The physical TCP completion scope already carries
+// the shared tree ledger/hold. After the hook, only independent state and the
+// moved callback are accessed, so reentrant cancellation cannot leave dead
+// this.
+template <typename Base>
+class MivpnNativeSocksCompletionTransport final : public Base {
+ public:
+  template <typename... Args>
+  MivpnNativeSocksCompletionTransport(
+      std::shared_ptr<MivpnNativeSocksReadCompletionState> state,
+      Args&&... args)
+      : Base(std::forward<Args>(args)...), state_(std::move(state)) {}
+  ~MivpnNativeSocksCompletionTransport() override {
+    EXPECT_EQ(0, state_->active);
+    ++state_->destructions;
+  }
+  int Read(net::IOBuffer* buffer,
+           int size,
+           net::CompletionOnceCallback callback) override {
+    auto native = this->TrackPendingUpgradeActivity(&callback);
+    auto forward = base::BindOnce(
+        [](std::shared_ptr<MivpnNativeSocksReadCompletionState> state,
+           net::CompletionOnceCallback upstream, int result) {
+          ++state->active;
+          ++state->completions;
+          base::ScopedClosureRunner leave(base::BindOnce(
+              [](std::shared_ptr<MivpnNativeSocksReadCompletionState> state) {
+                --state->active;
+              },
+              state));
+          auto hook = std::move(state->hook);
+          if (hook) {
+            std::move(hook).Run();
+          }
+          ++state->forwarded;
+          std::move(upstream).Run(result);
+        },
+        state_, std::move(callback));
+    return Base::Read(buffer, size, std::move(forward));
+  }
+
+ private:
+  std::shared_ptr<MivpnNativeSocksReadCompletionState> state_;
+};
+
+// Resolver ownership evidence is separate from the socket resource hold. This
+// legal test provider keeps completed requests observable, returns only the
+// fixed loopback result, and has silent cancellation (no fabricated late DNS
+// callback). The actual MivpnHostResolver wraps it in the tests below.
+struct MivpnNativeSocksResolverState {
+  bool asynchronous = false;
+  bool shutdown = false;
+  int requests = 0;
+  int destructions = 0;
+  int active_frames = 0;
+  int starts = 0;
+  int completions = 0;
+  int error = net::OK;
+  base::OnceClosure on_start;
+  base::OnceClosure on_complete;
+  base::OnceClosure after_complete_callback;
+  base::OnceClosure on_destroy;
+};
+
+class MivpnNativeSocksResolver final : public net::HostResolver {
+ public:
+  explicit MivpnNativeSocksResolver(
+      std::shared_ptr<MivpnNativeSocksResolverState> state)
+      : state_(std::move(state)) {}
+  ~MivpnNativeSocksResolver() override { OnShutdown(); }
+  void OnShutdown() override { state_->shutdown = true; }
+  bool IsHappyEyeballsV3Enabled() const override { return false; }
+
+  class Request final : public ResolveHostRequest {
+   public:
+    Request(std::shared_ptr<MivpnNativeSocksResolverState> state, uint16_t port)
+        : state_(std::move(state)),
+          addresses_(net::AddressList::CreateFromIPAddress(
+              net::IPAddress::IPv4Localhost(),
+              port)) {
+      ++state_->requests;
+    }
+    ~Request() override {
+      weak_factory_.InvalidateWeakPtrs();
+      callback_.Reset();
+      auto state = state_;
+      --state->requests;
+      ++state->destructions;
+      EXPECT_EQ(0, state->active_frames);
+      auto hook = std::move(state->on_destroy);
+      if (hook) {
+        std::move(hook).Run();
+      }
+    }
+    int Start(net::CompletionOnceCallback callback) override {
+      auto state = state_;
+      auto frame = Enter(state);
+      const bool asynchronous = state->asynchronous;
+      const int error = state->error;
+      ++state->starts;
+      if (asynchronous) {
+        callback_ = std::move(callback);
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(&Request::Complete, weak_factory_.GetWeakPtr()));
+      }
+      auto hook = std::move(state->on_start);
+      if (hook) {
+        std::move(hook).Run();
+      }
+      return asynchronous ? net::ERR_IO_PENDING : error;
+    }
+    const net::AddressList& GetAddressResults() const override {
+      return addresses_;
+    }
+    base::span<const net::HostResolverEndpointResult> GetEndpointResults()
+        const override {
+      return {};
+    }
+    base::span<const std::string> GetTextResults() const override { return {}; }
+    base::span<const net::HostPortPair> GetHostnameResults() const override {
+      return {};
+    }
+    const std::set<std::string>& GetDnsAliasResults() const override {
+      return aliases_;
+    }
+    net::ResolveErrorInfo GetResolveErrorInfo() const override {
+      return net::ResolveErrorInfo(state_->error);
+    }
+    const std::optional<net::HostCache::EntryStaleness>& GetStaleInfo()
+        const override {
+      return staleness_;
+    }
+    std::optional<net::ResolutionDetails> GetResolutionDetails()
+        const override {
+      return std::nullopt;
+    }
+
+   private:
+    static base::ScopedClosureRunner Enter(
+        std::shared_ptr<MivpnNativeSocksResolverState> state) {
+      ++state->active_frames;
+      return base::ScopedClosureRunner(base::BindOnce(
+          [](std::shared_ptr<MivpnNativeSocksResolverState> state) {
+            --state->active_frames;
+          },
+          std::move(state)));
+    }
+    void Complete() {
+      auto state = state_;
+      if (state->shutdown) {
+        callback_.Reset();
+        return;
+      }
+      auto frame = Enter(state);
+      auto callback = std::move(callback_);
+      auto hook = std::move(state->on_complete);
+      auto after_callback = std::move(state->after_complete_callback);
+      ++state->completions;
+      if (hook) {
+        std::move(hook).Run();
+      }
+      // HostResolver permits callback-driven request deletion. Before calling
+      // it, move every item needed by the legal tail off this Request. The
+      // provider itself stays alive; the tail accesses no freed this/member.
+      std::move(callback).Run(state->error);
+      if (after_callback) {
+        std::move(after_callback).Run();
+      }
+    }
+    std::shared_ptr<MivpnNativeSocksResolverState> state_;
+    net::AddressList addresses_;
+    std::set<std::string> aliases_;
+    std::optional<net::HostCache::EntryStaleness> staleness_;
+    net::CompletionOnceCallback callback_;
+    base::WeakPtrFactory<Request> weak_factory_{this};
+  };
+
+  std::unique_ptr<ResolveHostRequest> CreateRequest(
+      url::SchemeHostPort host,
+      net::NetworkAnonymizationKey key,
+      net::handles::NetworkHandle network,
+      net::NetLogWithSource log,
+      std::optional<ResolveHostParameters> parameters) override {
+    return MakeRequest(host.host(), host.port());
+  }
+  std::unique_ptr<ResolveHostRequest> CreateRequest(
+      const net::HostPortPair& host,
+      const net::NetworkAnonymizationKey& key,
+      net::handles::NetworkHandle network,
+      const net::NetLogWithSource& log,
+      const std::optional<ResolveHostParameters>& parameters) override {
+    return MakeRequest(host.host(), host.port());
+  }
+  std::unique_ptr<ServiceEndpointRequest> CreateServiceEndpointRequest(
+      Host host,
+      net::NetworkAnonymizationKey key,
+      net::handles::NetworkHandle network,
+      net::NetLogWithSource log,
+      ResolveHostParameters parameters) override {
+    return CreateFailingServiceEndpointRequest(net::ERR_NOT_IMPLEMENTED);
+  }
+
+ private:
+  std::unique_ptr<ResolveHostRequest> MakeRequest(std::string_view host,
+                                                  uint16_t port) {
+    CHECK_EQ("mivpn-native.test", host);
+    if (state_->shutdown) {
+      return CreateFailingRequest(net::ERR_CONTEXT_SHUT_DOWN);
+    }
+    return std::make_unique<Request>(state_, port);
+  }
+  std::shared_ptr<MivpnNativeSocksResolverState> state_;
+};
+
+template <typename SocksSocket, int Version>
+class MivpnNativeTLSSocksTestBase : public MivpnNativeTLSCancellationTest {
+ protected:
+  using Socket = MivpnNativeHookTransport<SocksSocket>;
+  using RelayMode = MivpnNativeSocksRelay::Mode;
+
+  void SetUp() override {
+    MivpnNativeTLSCancellationTest::SetUp();
+    ASSERT_FALSE(HasFatalFailure());
+    resolver_state_ = std::make_shared<MivpnNativeSocksResolverState>();
+    policy_ = base::MakeRefCounted<MivpnResolverPolicy>();
+    resolver_ = std::make_unique<MivpnHostResolver>(
+        std::make_unique<MivpnNativeSocksResolver>(resolver_state_), policy_);
+    socks_hooks_ = std::make_shared<MivpnNativeTransportHooks>();
+  }
+
+  void TearDown() override {
+    // The business context/provider remain normally alive for unmanaged and
+    // committed sockets. Only cancellation tests destroy them early.
+    CloseNativeResources();
+    socks_.reset();
+    endpoint_ = nullptr;
+    socks_raw_ = nullptr;
+    if (relay_) {
+      relay_->Stop();
+      relay_.reset();
+    }
+    resolver_.reset();
+    policy_.reset();
+    EXPECT_EQ(0, resolver_state_->requests);
+    EXPECT_EQ(0, resolver_state_->active_frames);
+    MivpnNativeTLSCancellationTest::TearDown();
+  }
+
+  void MakeSocks(RelayMode mode = RelayMode::kForward,
+                 bool unknown_lower = false,
+                 uint16_t destination_port = 0) {
+    relay_ =
+        std::make_unique<MivpnNativeSocksRelay>(Version, server_.port(), mode);
+    ASSERT_TRUE(relay_->Start());
+    if (read_completion_state_) {
+      auto addresses = net::AddressList::CreateFromIPAddress(
+          net::IPAddress::IPv4Localhost(), relay_->port());
+      if (GetParam()) {
+        transport_ = std::make_unique<
+            MivpnNativeSocksCompletionTransport<BrokeredTcpClientSocket>>(
+            read_completion_state_, addresses, nullptr, nullptr,
+            net::NetLog::Get(), net::NetLogSource(), broker_factory_.get());
+      } else {
+        transport_ = std::make_unique<
+            MivpnNativeSocksCompletionTransport<net::TCPClientSocket>>(
+            read_completion_state_, addresses, nullptr, nullptr,
+            net::NetLog::Get(), net::NetLogSource(),
+            net::handles::kInvalidNetworkHandle);
+      }
+    } else {
+      CreateTransport(relay_->port());
+    }
+    ASSERT_EQ(net::OK, ConnectTransport());
+    endpoint_ = transport_.get();
+    std::unique_ptr<net::StreamSocket> lower = std::move(transport_);
+    if (unknown_lower) {
+      lower = std::make_unique<net::WrappedStreamSocket>(std::move(lower));
+    }
+    net::HostPortPair destination("mivpn-native.test", destination_port
+                                                           ? destination_port
+                                                           : server_.port());
+    if constexpr (Version == 4) {
+      socks_ = std::make_unique<Socket>(
+          socks_hooks_, std::move(lower), destination,
+          net::NetworkAnonymizationKey(), net::DEFAULT_PRIORITY,
+          resolver_.get(), net::SecureDnsPolicy::kAllow,
+          TRAFFIC_ANNOTATION_FOR_TESTS);
+    } else {
+      socks_ =
+          std::make_unique<Socket>(socks_hooks_, std::move(lower), destination,
+                                   TRAFFIC_ANNOTATION_FOR_TESTS);
+    }
+    socks_raw_ = socks_.get();
+  }
+
+  int ConnectSocks() {
+    net::TestCompletionCallback callback;
+    return callback.GetResult(socks_raw_->Connect(callback.callback()));
+  }
+
+  void MakeSocksRoot() {
+    net::SSLConfig config;
+    // This switch only quiets the NEW root in the independent native spike,
+    // exactly as in the existing harness. There is no inner SSL in this tree,
+    // and this is not evidence that an already-connected inner SSL is
+    // adoptable.
+    config.disable_post_handshake_peek_for_testing = true;
+    work_ = base::MakeRefCounted<MivpnNativeTLSWork>(&work_destructions_);
+    work_->socket =
+        net::ClientSocketFactory::GetDefaultFactory()->CreateSSLClientSocket(
+            ssl_context_.get(), std::move(socks_), server_.host_port_pair(),
+            config);
+  }
+
+  bool PrepareAndEnable() {
+    CHECK(work_);
+    auto weak_work = work_->GetWeakPtr();
+    auto* expected_root = work_->socket.get();
+    if constexpr (Version == 4) {
+      CHECK_EQ(0, resolver_state_->active_frames);  // explicit caller proof.
+      if (!socks_raw_->PrepareForPendingUpgrade(work_->ResourceGuard())) {
+        return false;
+      }
+    }
+    // Prepare can run request/callback destructors. Its resource-only hold is
+    // gone now: re-acquire the weak resource and separately recheck the normal
+    // business context, without retaining context/provider/factory in Work.
+    if (!weak_work || !work_ || !ssl_context_ ||
+        weak_work->socket.get() != expected_root ||
+        !socks_raw_->CanAdoptPendingUpgrade()) {
+      return false;
+    }
+    return weak_work->socket->EnablePendingUpgradeCancellation(
+        weak_work->ResourceGuard());
+  }
