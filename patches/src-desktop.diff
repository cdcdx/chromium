+TEST_P(MivpnNativeTLSSocks4Test, CancelReadinessDestructorAndRealUnwind) {
+  ASSERT_NO_FATAL_FAILURE(MakeSocks(RelayMode::kPauseTraffic));
+  ASSERT_EQ(net::OK, ConnectSocks());
+  MakeSocksRoot();
+  ASSERT_TRUE(socks_raw_->PrepareForPendingUpgrade(work_->ResourceGuard()));
+  auto buffer = base::MakeRefCounted<net::IOBufferWithSize>(1);
+  bool released = false;
+  auto token = std::make_unique<MivpnNativeCallbackRelease>(
+      base::BindLambdaForTesting([&] {
+        released = true;
+        EXPECT_FALSE(socks_raw_->CanAdoptPendingUpgrade());
+        base::RunLoop(base::RunLoop::Type::kNestableTasksAllowed)
+            .RunUntilIdle();
+        EXPECT_FALSE(socks_raw_->CanAdoptPendingUpgrade());
+      }));
+  auto cleanup = CleanupNativeResources();
+  ASSERT_EQ(
+      net::ERR_IO_PENDING,
+      socks_raw_->ReadIfReady(
+          buffer.get(), 1,
+          base::BindOnce(
+              [](std::unique_ptr<MivpnNativeCallbackRelease> token,
+                 int result) { ADD_FAILURE() << "Cancelled readiness ran"; },
+              std::move(token))));
+  EXPECT_FALSE(socks_raw_->CanAdoptPendingUpgrade());
+  EXPECT_FALSE(released);
+  ASSERT_EQ(net::OK, socks_raw_->CancelReadIfReady());
+  EXPECT_TRUE(released);
+  EXPECT_TRUE(socks_raw_->CanAdoptPendingUpgrade());
+  ASSERT_TRUE(Enable());  // only after the real cancellation stack returns.
+  work_->socket->CancelPendingUpgrade();
+  EXPECT_FALSE(endpoint_->IsConnected());
+  EXPECT_EQ(0, verifier_state_->calls);
+}
