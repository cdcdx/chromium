+  ASSERT_NO_FATAL_FAILURE(CreatePlainPeer());
+  ASSERT_EQ(net::OK, transport_->SetSendBufferSize(1024));
+  auto buffer = base::MakeRefCounted<net::IOBufferWithSize>(65536);
+  std::fill_n(buffer->data(), buffer->size(), 'x');
+  net::TestCompletionCallback callback;
+  auto cleanup = CleanupNativeResources();
+  int result = net::OK;
+  // The real peer deliberately does not read. Bound the fill attempt rather
+  // than spinning indefinitely if a platform never exposes pending writes.
+  for (int i = 0; i < 256; ++i) {
+    result =
+        transport_->Write(buffer.get(), buffer->size(), callback.callback(),
+                          TRAFFIC_ANNOTATION_FOR_TESTS);
+    if (result <= 0) {
+      break;
+    }
+  }
+  ASSERT_EQ(net::ERR_IO_PENDING, result);
+  EXPECT_FALSE(transport_->CanAdoptPendingUpgrade());
+  CreateRoot();
+  EXPECT_FALSE(Enable());
+  EXPECT_EQ(net::ERR_ABORTED, StartHandshake());
+  EXPECT_EQ(0, verifier_state_->calls);
+  work_->socket->Disconnect();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(callback.have_result());
+}
