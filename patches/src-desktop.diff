+        url, net::NetworkAnonymizationKey(), std::move(options),
+        net::MutableNetworkTrafficAnnotationTag(TRAFFIC_ANNOTATION_FOR_TESTS),
+        socket.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+        result->callback());
+  }
+
+  size_t TransportCount() {
+    return mock_client_socket_factory()->mock_data().next_index();
+  }
+
+  scoped_refptr<MivpnResolverPolicy> policy_ =
+      base::MakeRefCounted<MivpnResolverPolicy>();
+  net::MockAsyncProxyResolver resolver_;
+  raw_ptr<net::MockAsyncProxyResolverFactory> resolver_factory_ = nullptr;
+};
