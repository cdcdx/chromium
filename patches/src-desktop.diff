+// Exercise sandbox's common policy generation without pretending to load or
+// trust the content MiVPN SDK delegate. LPAC capabilities/access checks have
+// their own real-profile tests above; no process is spawned here.
+class PolicyOnlySandboxDelegate : public TestSandboxDelegate {
+ public:
+  explicit PolicyOnlySandboxDelegate(sandbox::mojom::Sandbox sandbox_type)
+      : TestSandboxDelegate(sandbox_type) {}
+
+  bool GetAppContainerId(std::string* appcontainer_id) override { return false; }
+};
