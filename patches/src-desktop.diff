+void BrokeredTcpClientSocket::DetachPendingUpgrade() {
+  CHECK(PendingUpgradeCancelled());
+  client_socket_factory_ = nullptr;
+  network_quality_estimator_ = nullptr;
+  is_connect_in_progress_ = false;
+  brokered_weak_ptr_factory_.InvalidateWeakPtrs();
+  brokered_socket_->DetachPendingUpgrade();
