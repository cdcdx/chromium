+class MivpnHostResolverTest : public testing::Test {
+ protected:
+  MivpnHostResolverTest() {
+    auto inner = std::make_unique<RecordingResolver>();
+    inner_ = inner.get();
+    resolver_ = std::make_unique<MivpnHostResolver>(std::move(inner), policy_);
+  }
+  std::unique_ptr<net::HostResolver::ResolveHostRequest> Resolve(
+      std::string host = "example.test") {
+    return resolver_->CreateRequest(net::HostPortPair(host, 443),
+                                    net::NetworkAnonymizationKey(),
+                                    net::handles::kInvalidNetworkHandle,
+                                    net::NetLogWithSource(), std::nullopt);
+  }
+  std::unique_ptr<net::HostResolver::ServiceEndpointRequest> Endpoint() {
+    return resolver_->CreateServiceEndpointRequest(
+        net::HostResolver::Host(
+            url::SchemeHostPort("https", "example.test", 443)),
+        net::NetworkAnonymizationKey(), net::handles::kInvalidNetworkHandle,
+        net::NetLogWithSource(), net::HostResolver::ResolveHostParameters());
+  }
+
+  base::test::TaskEnvironment tasks_;
+  scoped_refptr<MivpnResolverPolicy> policy_ =
+      base::MakeRefCounted<MivpnResolverPolicy>();
+  raw_ptr<RecordingResolver> inner_ = nullptr;
+  std::unique_ptr<MivpnHostResolver> resolver_;
+};
+
+TEST_F(MivpnHostResolverTest, AllFactoriesAreLazyAndCheckLiveBlockedPolicy) {
+  auto plain = Resolve();
+  auto scheme = resolver_->CreateRequest(
+      url::SchemeHostPort("https", "example.test", 443),
+      net::NetworkAnonymizationKey(), net::handles::kInvalidNetworkHandle,
+      net::NetLogWithSource(), std::nullopt);
+  auto endpoint = Endpoint();
+  auto probe = resolver_->CreateDohProbeRequest();
+  auto mdns = resolver_->CreateMdnsListener(net::HostPortPair("test.local", 80),
+                                            net::DnsQueryType::A);
+  EXPECT_EQ(0u, inner_->factories);
+  policy_->Block();
+  net::TestCompletionCallback callback;
+  testing::StrictMock<EndpointDelegate> endpoint_delegate;
+  testing::StrictMock<MdnsDelegate> mdns_delegate;
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED, plain->Start(callback.callback()));
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED,
+            scheme->Start(callback.callback()));
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED,
+            endpoint->Start(&endpoint_delegate));
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED, probe->Start());
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED, mdns->Start(&mdns_delegate));
+  tasks_.RunUntilIdle();
+  EXPECT_FALSE(callback.have_result());
+  EXPECT_EQ(0u, inner_->factories);
+  EXPECT_EQ(0u, inner_->num_resolve());
+  EXPECT_FALSE(inner_->IsDohProbeRunning());
+  EXPECT_TRUE(plain->GetAddressResults().empty());
+  EXPECT_TRUE(plain->GetEndpointResults().empty());
+  EXPECT_TRUE(plain->GetDnsAliasResults().empty());
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED,
+            plain->GetResolveErrorInfo().error);
+  EXPECT_FALSE(plain->GetResolveErrorInfo().is_secure_network_error);
+  EXPECT_FALSE(plain->GetStaleInfo());
+  EXPECT_FALSE(plain->GetResolutionDetails());
+  EXPECT_TRUE(endpoint->GetEndpointResults().empty());
+  EXPECT_FALSE(endpoint->EndpointsCryptoReady());
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED,
+            endpoint->GetResolveErrorInfo().error);
+  EXPECT_EQ(nullptr, endpoint->GetStaleInfo());
+}
+
+TEST_F(MivpnHostResolverTest, BlockedDeniesCacheLiteralsAndAllSources) {
+  ASSERT_EQ(net::OK,
+            inner_->LoadIntoCache(
+                net::HostResolver::Host(net::HostPortPair("cached.test", 443)),
+                net::NetworkAnonymizationKey(), std::nullopt));
+  const size_t initial_count = inner_->num_resolve();
+  policy_->Block();
+  for (const char* host : {"cached.test", "127.0.0.1", "::1", "localhost",
+                           "192.0.2.1", "2001:db8::1", "test.local"}) {
+    for (auto source :
+         {net::HostResolverSource::ANY, net::HostResolverSource::SYSTEM,
+          net::HostResolverSource::DNS, net::HostResolverSource::MULTICAST_DNS,
+          net::HostResolverSource::LOCAL_ONLY}) {
+      for (auto type : {net::DnsQueryType::A, net::DnsQueryType::AAAA}) {
+        net::HostResolver::ResolveHostParameters parameters;
+        parameters.source = source;
+        parameters.dns_query_type = type;
+        auto request = resolver_->CreateRequest(
+            net::HostPortPair(host, 443), net::NetworkAnonymizationKey(),
+            net::handles::kInvalidNetworkHandle, net::NetLogWithSource(),
+            parameters);
+        net::TestCompletionCallback callback;
+        EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED,
+                  request->Start(callback.callback()));
+        EXPECT_FALSE(callback.have_result());
+      }
+    }
+  }
+  EXPECT_EQ(0u, inner_->factories);
+  EXPECT_EQ(initial_count, inner_->num_resolve());
+}
