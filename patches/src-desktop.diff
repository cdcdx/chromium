+    InitWithService(std::make_unique<net::ConfiguredProxyResolutionService>(
+                        std::make_unique<net::ProxyConfigServiceFixed>(
+                            net::ProxyConfigWithAnnotation(
+                                config, TRAFFIC_ANNOTATION_FOR_TESTS)),
