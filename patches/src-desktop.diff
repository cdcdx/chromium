+class RecordingResolver : public net::MockCachingHostResolver {
+ public:
+  RecordingResolver() { rules()->AddRule("*", "192.0.2.1"); }
+
+  std::unique_ptr<ResolveHostRequest> CreateRequest(
+      url::SchemeHostPort host,
+      net::NetworkAnonymizationKey key,
+      net::handles::NetworkHandle network,
+      net::NetLogWithSource log,
+      std::optional<ResolveHostParameters> parameters) override {
+    ++factories;
+    return MockCachingHostResolver::CreateRequest(
+        std::move(host), std::move(key), network, std::move(log),
+        std::move(parameters));
+  }
+  std::unique_ptr<ResolveHostRequest> CreateRequest(
+      const net::HostPortPair& host,
+      const net::NetworkAnonymizationKey& key,
+      net::handles::NetworkHandle network,
+      const net::NetLogWithSource& log,
+      const std::optional<ResolveHostParameters>& parameters) override {
+    ++factories;
+    return MockCachingHostResolver::CreateRequest(host, key, network, log,
+                                                  parameters);
+  }
+  std::unique_ptr<ServiceEndpointRequest> CreateServiceEndpointRequest(
+      Host host,
+      net::NetworkAnonymizationKey key,
+      net::handles::NetworkHandle network,
+      net::NetLogWithSource log,
+      ResolveHostParameters parameters) override {
+    ++factories;
+    return MockCachingHostResolver::CreateServiceEndpointRequest(
+        std::move(host), std::move(key), network, std::move(log),
+        std::move(parameters));
+  }
+  std::unique_ptr<ProbeRequest> CreateDohProbeRequest() override {
+    ++factories;
+    return MockCachingHostResolver::CreateDohProbeRequest();
+  }
+  std::unique_ptr<MdnsListener> CreateMdnsListener(
+      const net::HostPortPair& host,
+      net::DnsQueryType type) override {
+    ++factories;
+    return MockCachingHostResolver::CreateMdnsListener(host, type);
+  }
+  size_t factories = 0;
+};
+
+class EndpointDelegate
+    : public net::HostResolver::ServiceEndpointRequest::Delegate {
+ public:
+  MOCK_METHOD(void, OnServiceEndpointsUpdated, (), (override));
+  MOCK_METHOD(void, OnServiceEndpointRequestFinished, (int), (override));
+};
