+class MivpnTCPConnectAsyncOptionsTest
+    : public MivpnTCPConnectOwnerTest,
+      public testing::WithParamInterface<MivpnConnectStep> {
+ protected:
+  void QueueRetry(base::OnceClosure hook) {
+    MakeOwner();
+    StartOwner(MivpnConnectOptions());
+    ASSERT_TRUE(transport_.completer.is_connecting());
+    ASSERT_TRUE(transport_.saved_before_connect);
+    ASSERT_TRUE(transport_.retry_before_connect);
+    EXPECT_EQ(0, transport_.active_methods);
+    transport_.hook_step = GetParam();
+    transport_.hook = std::move(hook);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, transport_.retry_before_connect);
+  }
+
+  void CheckRetry(int expected_error) {
+    task_environment_.RunUntilIdle();
+    ASSERT_EQ(1, transport_.hook_calls);
+    ASSERT_EQ(1u, transport_.retry_results.size());
+    EXPECT_NE(net::OK, transport_.retry_results[0]);
+    EXPECT_NE(net::ERR_IO_PENDING, transport_.retry_results[0]);
+    EXPECT_TRUE(transport_.alive_after_retry_callback);
+    EXPECT_EQ(0, transport_.active_methods);
+    EXPECT_EQ(1, transport_.disconnect_calls);
+    EXPECT_EQ(1, transport_.destruct_calls);
+    EXPECT_EQ(0, transport_.steps_after_cancel);
+    EXPECT_EQ(nullptr, transport_.provider->socket());
+    CheckOneError(expected_error);
+    // The retained independent weak callback must drop after physical close.
+    transport_.retry_before_connect.Run();
+    EXPECT_EQ(1u, transport_.retry_results.size());
+    ASSERT_TRUE(transport_.completer.is_connecting());
+    transport_.completer.Complete(net::OK);
+    CheckOneError(expected_error);
+  }
+};
