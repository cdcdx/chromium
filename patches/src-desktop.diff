+struct MivpnNativeSignState {
+  int calls = 0;
+  int results = 0;
+  bool hold_result = false;
+  bool inline_completion = false;
+  net::Error error = net::ERR_IO_PENDING;
+  std::vector<uint8_t> signature;
+  net::SSLPrivateKey::SignCallback callback;
+  base::test::TestFuture<void> ready;
+
+  void Deliver() {
+    CHECK(ready.IsReady());
+    CHECK(callback);
+    auto completion = std::move(callback);
+    std::move(completion).Run(error, signature);
+  }
+};
+
+class MivpnNativePrivateKey final : public net::SSLPrivateKey {
+ public:
+  explicit MivpnNativePrivateKey(scoped_refptr<net::SSLPrivateKey> key)
+      : key_(std::move(key)),
+        state_(std::make_shared<MivpnNativeSignState>()) {}
+
+  std::string GetProviderName() override {
+    auto name = key_->GetProviderName();
+    auto hook = std::move(name_hook);
+    if (hook) {
+      std::move(hook).Run();
+    }
+    return name;
+  }
+  std::vector<uint16_t> GetAlgorithmPreferences() override {
+    auto algorithms = key_->GetAlgorithmPreferences();
+    auto hook = std::move(preferences_hook);
+    if (hook) {
+      std::move(hook).Run();
+    }
+    return algorithms;
+  }
+  void Sign(uint16_t algorithm,
+            base::span<const uint8_t> input,
+            SignCallback callback) override {
+    auto state = state_;
+    auto key = key_;
+    auto hook = std::move(sign_hook);
+    ++state->calls;
+    CHECK(!state->callback);
+    state->callback = std::move(callback);
+    key->Sign(algorithm, input,
+              base::BindOnce(
+                  [](std::shared_ptr<MivpnNativeSignState> state,
+                     net::Error error, const std::vector<uint8_t>& signature) {
+                    state->error = error;
+                    state->signature = signature;
+                    ++state->results;
+                    state->ready.SetValue();
+                    if (!state->hold_result && !state->inline_completion) {
+                      state->Deliver();
+                    }
+                  },
+                  state));
+    if (state->inline_completion) {
+      // This test-only provider waits for the real threaded crypto result,
+      // then exercises the legal callback-before-Sign-return window. Sign is
+      // still active across the nested loop; it must not reenter BoringSSL.
+      CHECK(state->ready.Wait(base::RunLoop::Type::kNestableTasksAllowed));
+      state->Deliver();
+    }
+    if (hook) {
+      std::move(hook).Run();
+    }
+  }
+
+  std::shared_ptr<MivpnNativeSignState> state() { return state_; }
+  base::OnceClosure name_hook;
+  base::OnceClosure preferences_hook;
+  base::OnceClosure sign_hook;
+
+ private:
+  ~MivpnNativePrivateKey() override = default;
+  scoped_refptr<net::SSLPrivateKey> key_;
+  std::shared_ptr<MivpnNativeSignState> state_;
+};
