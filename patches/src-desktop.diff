+// Unlike the deterministic MockConnectCompleter cases above, this transport
+// executes TCPClientSocket's real timeout, DidCompleteConnect and address
+// fallback state machine. Only ConnectInternal is prevented from sending a
+// network packet. Its public Disconnect must really clear the native callback
+// and state; an independent mock callback container cannot prove that path.
+struct MivpnNativeRetryTransportState {
+  void VisitOption(MivpnConnectStep step) {
+    if (cancelled) {
+      ++options_after_cancel;
+    }
+    if (before_connect_calls == 1) {
+      first_options.push_back(step);
+    } else {
+      EXPECT_EQ(2, before_connect_calls);
+      second_options.push_back(step);
+    }
+    if (before_connect_calls == 2 && hook && hook_step == step) {
+      ++hook_calls;
+      auto callback = std::move(hook);
+      std::move(callback).Run();
+    }
+  }
+
+  std::vector<net::IPEndPoint> attempts;
+  std::vector<MivpnConnectStep> first_options;
+  std::vector<MivpnConnectStep> second_options;
+  std::vector<int> before_connect_results;
+  std::vector<int> native_completions;
+  MivpnConnectStep hook_step = MivpnConnectStep::kSendBuffer;
+  base::OnceClosure hook;
+  base::RepeatingClosure after_configuration;
+  int create_calls = 0;
+  int connect_calls = 0;
+  int before_connect_calls = 0;
+  int active_methods = 0;
+  int active_before_callbacks = 0;
+  int disconnect_calls = 0;
+  int destruct_calls = 0;
+  int hook_calls = 0;
+  int options_after_cancel = 0;
+  int setter_nested_probes = 0;
+  int callback_return_nested_probes = 0;
+  bool cancelled = false;
+  bool alive_after_configuration = false;
+};
+
+class MivpnNativeRetryMethodGuard {
+ public:
+  explicit MivpnNativeRetryMethodGuard(MivpnNativeRetryTransportState& state)
+      : state_(state), destruct_calls_(state.destruct_calls) {
+    ++state_->active_methods;
+  }
+  ~MivpnNativeRetryMethodGuard() {
+    EXPECT_EQ(destruct_calls_, state_->destruct_calls);
+    --state_->active_methods;
+  }
+
+ private:
+  const raw_ref<MivpnNativeRetryTransportState> state_;
+  const int destruct_calls_;
+};
+
+class MivpnRecordingNativeRetrySocket : public net::TCPClientSocket {
+ public:
+  MivpnRecordingNativeRetrySocket(MivpnNativeRetryTransportState& state,
+                                  const net::AddressList& addresses)
+      : net::TCPClientSocket(addresses,
+                             nullptr,
+                             nullptr,
+                             net::NetLog::Get(),
+                             net::NetLogSource(),
+                             net::handles::kInvalidNetworkHandle),
+        state_(state) {}
+
+  ~MivpnRecordingNativeRetrySocket() override {
+    EXPECT_EQ(0, state_->active_methods);
+    EXPECT_EQ(0, state_->active_before_callbacks);
+    ++state_->destruct_calls;
+  }
+
+  int Connect(net::CompletionOnceCallback callback) override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    ++state.connect_calls;
+    // This is still the native member callback, not a MockConnectCompleter.
+    // Cancellation resets it in the base Disconnect implementation. Neither
+    // this recording closure nor the production callback holds the transport.
+    return net::TCPClientSocket::Connect(base::BindOnce(
+        [](MivpnNativeRetryTransportState* state,
+           net::CompletionOnceCallback callback, int result) {
+          state->native_completions.push_back(result);
+          std::move(callback).Run(result);
+        },
+        &state, std::move(callback)));
+  }
+
+  void SetBeforeConnectCallback(
+      const BeforeConnectCallback& callback) override {
+    net::TCPClientSocket::SetBeforeConnectCallback(base::BindRepeating(
+        [](MivpnNativeRetryTransportState* state,
+           BeforeConnectCallback callback) {
+          MivpnNativeRetryMethodGuard guard(*state);
+          ++state->before_connect_calls;
+          ++state->active_before_callbacks;
+          const int result = callback.Run();
+          state->before_connect_results.push_back(result);
+          EXPECT_EQ(0, state->destruct_calls);
+          if (state->before_connect_calls == 2) {
+            state->alive_after_configuration = state->destruct_calls == 0;
+            auto probe = state->after_configuration;
+            if (probe) {
+              // Configure has returned and any production ReleaseSoon is now
+              // queued, but the real DidCompleteConnect/DoConnectLoop stack
+              // has not returned. Pump nestable tasks in exactly that window.
+              probe.Run();
+            }
+            EXPECT_EQ(0, state->destruct_calls);
+          }
+          --state->active_before_callbacks;
+          // Everything after callback.Run() accesses only independent state
+          // and locals, never this or a possibly destroyed transport pointer.
+          return result;
+        },
+        &*state_, callback));
+  }
+
+  int SetSendBufferSize(int32_t size) override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    EXPECT_EQ(4096, size);
+    EXPECT_EQ(net::OK, net::TCPClientSocket::SetSendBufferSize(size));
+    state.VisitOption(MivpnConnectStep::kSendBuffer);
+    // Deliberately report setter success even if its hook cancelled the owner.
+    // The service's post-setter live check must stop the native continuation.
+    return net::OK;
+  }
+
+  int SetReceiveBufferSize(int32_t size) override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    EXPECT_EQ(8192, size);
+    EXPECT_EQ(net::OK, net::TCPClientSocket::SetReceiveBufferSize(size));
+    state.VisitOption(MivpnConnectStep::kReceiveBuffer);
+    return net::OK;
+  }
+
+  bool SetNoDelay(bool no_delay) override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    EXPECT_FALSE(no_delay);
+    EXPECT_TRUE(net::TCPClientSocket::SetNoDelay(no_delay));
+    state.VisitOption(MivpnConnectStep::kNoDelay);
+    return true;
+  }
+
+  bool SetKeepAlive(bool enable, int delay) override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    EXPECT_TRUE(enable);
+    EXPECT_EQ(17, delay);
+    EXPECT_TRUE(net::TCPClientSocket::SetKeepAlive(enable, delay));
+    state.VisitOption(MivpnConnectStep::kKeepAlive);
+    return true;
+  }
+
+  void Disconnect() override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    ++state.disconnect_calls;
+    net::TCPClientSocket::Disconnect();
+    state.cancelled = true;
+  }
+
+ private:
+  // C++ permits overriding an inherited private virtual. The real base timer
+  // still calls its private DidCompleteConnect; no new net testing API is used.
+  int ConnectInternal(const net::IPEndPoint& endpoint) override {
+    auto& state = *state_;
+    MivpnNativeRetryMethodGuard guard(state);
+    EXPECT_FALSE(state.cancelled);
+    state.attempts.push_back(endpoint);
+    EXPECT_LE(state.attempts.size(), 2u);
+    return state.attempts.size() == 1 ? net::ERR_IO_PENDING
+                                      : net::ERR_CONNECTION_REFUSED;
+  }
+
+  const raw_ref<MivpnNativeRetryTransportState> state_;
+};
+
+class MivpnNativeRetrySocketFactory : public net::MockClientSocketFactory {
+ public:
+  explicit MivpnNativeRetrySocketFactory(MivpnNativeRetryTransportState& state)
+      : state_(state) {}
+
+  std::unique_ptr<net::TransportClientSocket> CreateTransportClientSocket(
+      const net::AddressList& addresses,
+      net::handles::NetworkHandle,
+      std::unique_ptr<net::SocketPerformanceWatcher>,
+      net::NetworkQualityEstimator*,
+      net::NetLog*,
+      const net::NetLogSource&) override {
+    ++state_->create_calls;
+    return std::make_unique<MivpnRecordingNativeRetrySocket>(*state_,
+                                                             addresses);
+  }
+
+ private:
+  const raw_ref<MivpnNativeRetryTransportState> state_;
+};
