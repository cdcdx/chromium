+ private:
+  friend class base::RefCounted<PendingUpgradeControl>;
+  ~PendingUpgradeControl();
+  State state_ = State::kPending;
+  bool prepared_ = false;
+  size_t active_native_count_ = 0;
+  PendingUpgradeResourceGuardCallback resource_guard_;
+  base::RepeatingClosure cancel_callback_;
+  SEQUENCE_CHECKER(sequence_checker_);
