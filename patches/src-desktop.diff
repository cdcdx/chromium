+// Request destruction cancels inner work. BLOCKED additionally completes
+// pending clients asynchronously, without reentering the policy callback list.
+// Resolver shutdown cancels silently, matching HostResolver's lifetime
+// contract.
+template <typename Request>
+class GuardedRequest : public Request {
+ public:
+  using Factory = base::OnceCallback<std::unique_ptr<Request>()>;
+
+  GuardedRequest(base::WeakPtr<MivpnHostResolver> resolver,
+                 scoped_refptr<MivpnResolverPolicy> policy,
+                 Factory factory)
+      : resolver_(std::move(resolver)),
+        policy_(std::move(policy)),
+        factory_(std::move(factory)),
+        block_subscription_(policy_->AddBlockCallback(
+            base::BindRepeating(&GuardedRequest::Revoke,
+                                base::Unretained(this),
+                                true))),
+        shutdown_subscription_(resolver_->AddShutdownCallback(
+            base::BindRepeating(&GuardedRequest::Revoke,
+                                base::Unretained(this),
+                                false))) {}
+
+ protected:
+  int Begin() {
+    CHECK(!started_);
+    started_ = true;
+    if (!resolver_ || resolver_->is_shutdown()) {
+      error_ = net::ERR_CONTEXT_SHUT_DOWN;
+    } else if (policy_->blocked()) {
+      error_ = net::ERR_NETWORK_ACCESS_REVOKED;
+    }
+    if (error_ != net::OK) {
+      factory_.Reset();
+      return error_;
+    }
+    inner_ = std::move(factory_).Run();
+    CHECK(inner_);
+    return net::OK;
+  }
+
+  Request* inner() const { return inner_.get(); }
+  int error() const { return error_; }
+  virtual void OnRevoked(bool notify) = 0;
+
+ private:
+  void Revoke(bool notify) {
+    error_ =
+        notify ? net::ERR_NETWORK_ACCESS_REVOKED : net::ERR_CONTEXT_SHUT_DOWN;
+    factory_.Reset();
+    inner_.reset();
+    OnRevoked(notify);
+  }
+
+  base::WeakPtr<MivpnHostResolver> resolver_;
+  scoped_refptr<MivpnResolverPolicy> policy_;
+  Factory factory_;
+  std::unique_ptr<Request> inner_;
+  bool started_ = false;
+  int error_ = net::OK;
+  base::CallbackListSubscription block_subscription_;
+  base::CallbackListSubscription shutdown_subscription_;
+};
