+void NetworkContext::ApplyMivpnRoutePolicy(
+    const base::UnguessableToken& context_id,
+    uint64_t generation,
+    mojom::MivpnRouteMode mode,
+    const std::optional<net::ProxyConfigWithAnnotation>& proxy_config,
+    ApplyMivpnRoutePolicyCallback callback) {
+  const bool valid_proxy_shape =
+      (mode == mojom::MivpnRouteMode::kProxy) == proxy_config.has_value();
+  int error_code = net::ERR_INVALID_ARGUMENT;
+  if (!context_id.is_empty() && context_id == mivpn_context_id_ &&
+      generation != 0 && valid_proxy_shape) {
+    if (generation < highest_mivpn_route_generation_seen_) {
+      error_code = net::ERR_ABORTED;
+    } else {
+      // Every accepted transition first closes the route. DIRECT and PROXY
+      // remain unsupported until their complete overlays are installed.
+      mivpn_resolver_policy_->Block();
+      highest_mivpn_route_generation_seen_ = generation;
+      error_code = net::ERR_NOT_IMPLEMENTED;
+    }
+  }
+
+  // Keep the Browser-side barrier blocked until this context has installed the
+  // requested deny or authenticated-proxy route.
+  std::move(callback).Run(mojom::MivpnRoutePolicyAck::New(
+      context_id, generation, false, error_code));
+}
+
+bool NetworkContext::IsMivpnRouteBlocked() const {
+  return mivpn_resolver_policy_ && mivpn_resolver_policy_->blocked();
+}
+
+void NetworkContext::DrainMivpnConnections(
+    const base::UnguessableToken& context_id,
+    uint64_t generation,
+    DrainMivpnConnectionsCallback callback) {
+  int error_code = net::ERR_INVALID_ARGUMENT;
+  if (!context_id.is_empty() && context_id == mivpn_context_id_ &&
+      generation != 0) {
+    if (generation < highest_mivpn_route_generation_seen_) {
+      error_code = net::ERR_ABORTED;
+    } else if (generation == highest_mivpn_route_generation_seen_) {
+      error_code = net::ERR_NOT_IMPLEMENTED;
+    }
+  }
+
+  // Closing only a subset of connection pools is not a successful drain.
+  std::move(callback).Run(
+      mojom::MivpnDrainAck::New(context_id, generation, false, error_code));
+}
