+
+bool WebContentsViewMac::CancelDragForEmbedder() {
+  if (!drag_source_start_rwh_) {
+    return false;
+  }
+  NSEvent* escape = [NSEvent keyEventWithType:NSEventTypeKeyDown
+                                     location:NSZeroPoint
+                                modifierFlags:0
+                                    timestamp:NSProcessInfo.processInfo.systemUptime
+                                 windowNumber:0
+                                      context:nil
+                                   characters:@"\x1b"
+                  charactersIgnoringModifiers:@"\x1b"
+                                    isARepeat:NO
+                                      keyCode:kVK_Escape];
+  [NSApp postEvent:escape atStart:YES];
+  return true;
+}
