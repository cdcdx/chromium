+class MivpnNativeVerifier final : public net::CertVerifier {
+ public:
+  explicit MivpnNativeVerifier(std::shared_ptr<MivpnNativeVerifierState> state)
+      : state_(std::move(state)) {}
+
+  class PendingRequest final : public Request {
+   public:
+    explicit PendingRequest(std::shared_ptr<MivpnNativeVerifierState> state)
+        : state_(std::move(state)) {
+      ++state_->active_requests;
+    }
+    ~PendingRequest() override {
+      --state_->active_requests;
+      ++state_->request_destructions;
+      state_->callback.Reset();
+      auto hook = std::move(state_->on_request_destroy);
+      if (hook) {
+        std::move(hook).Run();
+      }
+    }
+
+   private:
+    std::shared_ptr<MivpnNativeVerifierState> state_;
+  };
+
+  int Verify(const RequestParams& params,
+             net::CertVerifyResult* result,
+             net::CompletionOnceCallback callback,
+             std::unique_ptr<Request>* request,
+             const net::NetLogWithSource& net_log) override {
+    ++state_->calls;
+    result->Reset();
+    result->verified_cert = params.certificate();
+    if (pending_) {
+      state_->callback = std::move(callback);
+      if (!late_request_) {
+        *request = std::make_unique<PendingRequest>(state_);
+      }
+    }
+    state_->entered.SetValue();
+    auto hook = std::move(on_verify_);
+    if (hook) {
+      std::move(hook).Run();
+    }
+    // The provider itself remains alive across this call. The SSL context and
+    // transport owner need not. A late Request still has a valid out parameter
+    // because the native scope, not that owner, retains the resource tree.
+    if (pending_ && late_request_) {
+      *request = std::make_unique<PendingRequest>(state_);
+    }
+    return pending_ ? net::ERR_IO_PENDING : net::OK;
+  }
+
+  void Verify2QwacBinding(
+      const std::string& binding,
+      const std::string& hostname,
+      const scoped_refptr<net::X509Certificate>& tls_cert,
+      base::OnceCallback<void(const scoped_refptr<net::X509Certificate>&)>
+          callback,
+      const net::NetLogWithSource& net_log) override {
+    std::move(callback).Run(nullptr);
+  }
+  void SetConfig(const Config& config) override {}
+  void AddObserver(Observer* observer) override {}
+  void RemoveObserver(Observer* observer) override {}
+
+  void set_pending(bool pending) { pending_ = pending; }
+  void set_late_request(bool late) { late_request_ = late; }
+  void set_on_verify(base::OnceClosure hook) { on_verify_ = std::move(hook); }
+  void Complete() {
+    CHECK_EQ(1, state_->active_requests);
+    auto callback = std::move(state_->callback);
+    CHECK(callback);
+    std::move(callback).Run(net::OK);
+  }
+
+ private:
+  std::shared_ptr<MivpnNativeVerifierState> state_;
+  bool pending_ = false;
+  bool late_request_ = false;
+  base::OnceClosure on_verify_;
+};
