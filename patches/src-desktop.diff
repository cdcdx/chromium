+TEST_F(MivpnSocketTest, MivpnFactoryAccessorRetainsExactSharedPolicy) {
+  const SocketFactory& const_factory = *factory_;
+  auto retained = const_factory.GetMivpnResolverPolicy();
+  EXPECT_EQ(policy_, retained);
+  EXPECT_FALSE(retained->blocked());
+  factory_.reset();
+  policy_->Block();
+  EXPECT_TRUE(retained->blocked());
+  SocketFactory unmanaged(nullptr, context_.get());
+  EXPECT_FALSE(unmanaged.GetMivpnResolverPolicy());
+}
