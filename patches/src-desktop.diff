+struct MivpnNativeTransportHooks {
+  int active_overrides = 0;
+  int destructions = 0;
+  int reads = 0;
+  int reads_if_ready = 0;
+  int writes = 0;
+  bool force_fallback = false;
+  base::OnceClosure read_hook;
+  base::OnceClosure read_if_ready_hook;
+  base::OnceClosure write_hook;
+  base::OnceClosure disconnect_hook;
+};
+
+// The real TCP/Brokered base has already returned when these hooks execute.
+// TrackPendingUpgradeActivity covers the still-active override and callers;
+// it does not purport to keep an already-returned platform stack active.
+template <typename Base>
+class MivpnNativeHookTransport final : public Base {
+ public:
+  template <typename... Args>
+  MivpnNativeHookTransport(std::shared_ptr<MivpnNativeTransportHooks> hooks,
+                           Args&&... args)
+      : Base(std::forward<Args>(args)...), hooks_(std::move(hooks)) {}
+
+  ~MivpnNativeHookTransport() override {
+    EXPECT_EQ(0, hooks_->active_overrides);
+    ++hooks_->destructions;
+  }
+
+  int Read(net::IOBuffer* buffer,
+           int size,
+           net::CompletionOnceCallback callback) override {
+    auto native = this->TrackPendingUpgradeActivity(&callback);
+    auto local = EnterOverride();
+    ++hooks_->reads;
+    int result = Base::Read(buffer, size, std::move(callback));
+    RunHook(&hooks_->read_hook);
+    return result;
+  }
+  int ReadIfReady(net::IOBuffer* buffer,
+                  int size,
+                  net::CompletionOnceCallback callback) override {
+    auto native = this->TrackPendingUpgradeActivity(&callback);
+    auto local = EnterOverride();
+    ++hooks_->reads_if_ready;
+    if (hooks_->force_fallback) {
+      RunHook(&hooks_->read_if_ready_hook);
+      return net::ERR_READ_IF_READY_NOT_IMPLEMENTED;
+    }
+    int result = Base::ReadIfReady(buffer, size, std::move(callback));
+    RunHook(&hooks_->read_if_ready_hook);
+    return result;
+  }
+  int Write(net::IOBuffer* buffer,
+            int size,
+            net::CompletionOnceCallback callback,
+            const net::NetworkTrafficAnnotationTag& annotation) override {
+    auto native = this->TrackPendingUpgradeActivity(&callback);
+    auto local = EnterOverride();
+    ++hooks_->writes;
+    int result = Base::Write(buffer, size, std::move(callback), annotation);
+    RunHook(&hooks_->write_hook);
+    return result;
+  }
+  void Disconnect() override {
+    auto native = this->TrackPendingUpgradeActivity();
+    auto local = EnterOverride();
+    Base::Disconnect();
+    RunHook(&hooks_->disconnect_hook);
+  }
+
+ private:
+  base::ScopedClosureRunner EnterOverride() {
+    ++hooks_->active_overrides;
+    return base::ScopedClosureRunner(base::BindOnce(
+        [](std::shared_ptr<MivpnNativeTransportHooks> hooks) {
+          --hooks->active_overrides;
+        },
+        hooks_));
+  }
+  static void RunHook(base::OnceClosure* storage) {
+    auto hook = std::move(*storage);
+    if (hook) {
+      std::move(hook).Run();
+    }
+  }
+
+  std::shared_ptr<MivpnNativeTransportHooks> hooks_;
+};
