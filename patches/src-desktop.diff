+namespace {
+
+enum class MivpnServerCreationPath {
+  kFactory,
+  kBoundListen,
+#if BUILDFLAG(IS_WIN)
+  kDelayedBroker,
+#endif
+};
+
+constexpr MivpnServerCreationPath kMivpnServerCreationPaths[] = {
+    MivpnServerCreationPath::kFactory,
+    MivpnServerCreationPath::kBoundListen,
+#if BUILDFLAG(IS_WIN)
+    MivpnServerCreationPath::kDelayedBroker,
+#endif
+};
+
+std::unique_ptr<net::TransportClientSocket> MivpnCreateLoopbackPeer(
+    const net::IPEndPoint& address) {
+  return net::ClientSocketFactory::GetDefaultFactory()
+      ->CreateTransportClientSocket(
+          net::AddressList(address), net::handles::kInvalidNetworkHandle,
+          nullptr, nullptr, net::NetLog::Get(), net::NetLogSource());
+}
+
+}  // namespace
+
+// Unlike the recording-listener tests above, these cases retain genuine Mojo
+// remotes backed by OS loopback listeners. The Windows variant actually
+// completes SocketBrokerImpl creation before testing retained/pending Accept.
+class MivpnTCPServerFactoryTest
+    : public MivpnSocketTest,
+      public testing::WithParamInterface<MivpnServerCreationPath> {
+ protected:
+  void TearDown() override {
+    // Cleanup precedes destruction of results/completers even on ASSERT paths.
+    server_remote_.reset();
+    bound_remote_.reset();
+    peer_.reset();
+    factory_.reset();
+    results_.values.clear();
+    task_environment_.RunUntilIdle();
+#if BUILDFLAG(IS_WIN)
+    broker_.reset();
+#endif
+  }
+
+  base::test::TestFuture<void>& NewMivpnSignal() {
+    signals_.push_back(std::make_unique<base::test::TestFuture<void>>());
+    return *signals_.back();
+  }
+
+  base::test::TestFuture<int>& NewMivpnIntegerResult() {
+    integer_results_.push_back(std::make_unique<base::test::TestFuture<int>>());
+    return *integer_results_.back();
+  }
+
+  bool CreateListeningServer() {
+    EXPECT_EQ(policy_, factory_->GetMivpnResolverPolicy());
+    auto& create = NewMivpnIntegerResult();
+    if (GetParam() == MivpnServerCreationPath::kBoundListen) {
+      factory_->CreateTCPBoundSocket(
+          LocalAddress(), TRAFFIC_ANNOTATION_FOR_TESTS,
+          bound_remote_.BindNewPipeAndPassReceiver(),
+          base::BindLambdaForTesting(
+              [&](int error, const std::optional<net::IPEndPoint>& address) {
+                if (address) {
+                  local_address_ = *address;
+                }
+                EXPECT_EQ(net::OK, error);
+                EXPECT_TRUE(address);
+                create.SetValue(error);
+              }));
+      if (create.Get() != net::OK) {
+        return false;
+      }
+      auto& listen = NewMivpnIntegerResult();
+      bound_remote_->Listen(4, server_remote_.BindNewPipeAndPassReceiver(),
+                            listen.GetCallback());
+      const int error = listen.Get();
+      EXPECT_EQ(net::OK, error);
+      bound_remote_.FlushForTesting();
+      EXPECT_FALSE(bound_remote_.is_connected());
+      return error == net::OK;
+    }
+#if BUILDFLAG(IS_WIN)
+    if (GetParam() == MivpnServerCreationPath::kDelayedBroker) {
+      broker_ = std::make_unique<DelayedSocketBroker>();
+      factory_->BindSocketBroker(broker_->BindNewRemote());
+    }
+#endif
+    auto options = mojom::TCPServerSocketOptions::New();
+    options->backlog = 4;
+    factory_->CreateTCPServerSocket(
+        LocalAddress(), std::move(options), TRAFFIC_ANNOTATION_FOR_TESTS,
+        server_remote_.BindNewPipeAndPassReceiver(),
+        base::BindLambdaForTesting(
+            [&](int error, const std::optional<net::IPEndPoint>& address) {
+              EXPECT_EQ(net::OK, error);
+              EXPECT_TRUE(address);
+              if (address) {
+                local_address_ = *address;
+              }
+              create.SetValue(error);
+            }));
+#if BUILDFLAG(IS_WIN)
+    if (broker_) {
+      task_environment_.RunUntilIdle();
+      EXPECT_EQ(1, broker_->calls);
+      EXPECT_FALSE(create.IsReady());
+      broker_->Complete();
+    }
+#endif
+    return create.Get() == net::OK;
+  }
+
+  bool ConnectPeer() {
+    peer_ = MivpnCreateLoopbackPeer(local_address_);
+    auto& connect = NewMivpnIntegerResult();
+    const int result = peer_->Connect(connect.GetCallback());
+    if (result != net::ERR_IO_PENDING) {
+      connect.SetValue(result);
+    }
+    const int completed = connect.Get();
+    EXPECT_EQ(net::OK, completed);
+    return completed == net::OK;
+  }
+
+  void CheckRetainedDeny(int id) {
+    auto& complete = NewMivpnSignal();
+    server_remote_->Accept(mojo::NullRemote(),
+                           results_.Callback(id, complete.GetCallback()));
+    ASSERT_TRUE(complete.Wait());
+    EXPECT_EQ(kRevoked, results_.values.back().error);
+    server_remote_.FlushForTesting();
+    EXPECT_TRUE(server_remote_.is_connected());
+#if BUILDFLAG(IS_WIN)
+    if (broker_) {
+      EXPECT_EQ(1, broker_->calls);
+    }
+#endif
+  }
+
+  void CheckAcceptedRemote() {
+    ASSERT_FALSE(results_.values.empty());
+    auto& value = results_.values.front();
+    ASSERT_EQ(net::OK, value.error);
+    ASSERT_TRUE(value.address);
+    net::IPEndPoint peer_local_address;
+    ASSERT_EQ(net::OK, peer_->GetLocalAddress(&peer_local_address));
+    EXPECT_EQ(peer_local_address, *value.address);
+    base::test::TestFuture<bool> no_delay;
+    value.socket->SetNoDelay(true, no_delay.GetCallback());
+    EXPECT_TRUE(no_delay.Get());
+    value.socket.FlushForTesting();
+    EXPECT_TRUE(value.socket.is_connected());
+  }
+
+  // TearDown releases every production owner before these external completers.
+  std::vector<std::unique_ptr<base::test::TestFuture<void>>> signals_;
+  std::vector<std::unique_ptr<base::test::TestFuture<int>>> integer_results_;
+  MivpnAcceptResults results_;
+  net::IPEndPoint local_address_;
+  mojo::Remote<mojom::TCPServerSocket> server_remote_;
+  mojo::Remote<mojom::TCPBoundSocket> bound_remote_;
+  std::unique_ptr<net::TransportClientSocket> peer_;
+#if BUILDFLAG(IS_WIN)
+  std::unique_ptr<DelayedSocketBroker> broker_;
+#endif
+};
