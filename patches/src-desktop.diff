+// Enqueue Block from the SSL mock's start hook before it posts its ordinary
+// completion. Unlike MockConnectCompleter, this late completion is weak-bound
+// to the SSL socket, so destroying the ConnectJob legally cancels the task.
+TEST_F(ProxyResolvingSocketMiVPNTest, MiVPNInitialTLSPendingBlockCleanup) {
+  for (int late_result : {net::OK, net::ERR_SSL_PROTOCOL_ERROR}) {
+    SCOPED_TRACE(late_result);
+    policy_ = base::MakeRefCounted<MivpnResolverPolicy>();
+    Init("DIRECT", policy_);
+    net::StaticSocketDataProvider data;
+    data.set_connect_data(net::MockConnect(net::SYNCHRONOUS, net::OK));
+    mock_client_socket_factory()->AddSocketDataProvider(&data);
+    net::SSLSocketDataProvider ssl(net::ASYNC, late_result);
+    mock_client_socket_factory()->AddSSLSocketDataProvider(&ssl);
+    mojo::Remote<mojom::ProxyResolvingSocket> socket;
+    auto result = base::MakeRefCounted<MiVPNConnectResult>();
+    bool observed_cleanup = false;
+    ssl.connect_callback = base::BindLambdaForTesting([&] {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindLambdaForTesting([&] {
+            EXPECT_TRUE(ssl.ConnectDataConsumed());
+            EXPECT_NE(nullptr, data.socket());
+            policy_->Block();
+            EXPECT_EQ(nullptr, data.socket());
+            EXPECT_EQ(0, result->calls);
+            observed_cleanup = true;
+          }));
+    });
+    Start(socket, result, true);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(observed_cleanup);
+    result->ExpectError(net::ERR_NETWORK_ACCESS_REVOKED);
+    EXPECT_EQ(nullptr, data.socket());
+    EXPECT_EQ(1u, TransportCount());
+    policy_->Block();
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(1, result->calls);
+    ResetFactory();
+  }
+}
