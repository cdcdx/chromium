+struct MivpnConnectTransportState {
+  MivpnConnectTransportState() {
+    // Use the Read fallback, just as MivpnRecordingTCPClientSocket does. Its
+    // sequenced pause must not be cancelled as if it were a pending
+    // ReadIfReady.
+    static const net::MockRead reads[] = {
+        net::MockRead(net::ASYNC, net::ERR_IO_PENDING, 0),
+        net::MockRead(net::ASYNC, net::OK, 1)};
+    provider = std::make_unique<net::SequencedSocketData>(
+        reads, base::span<net::MockWrite>());
+    provider->set_connect_data(net::MockConnect(&completer));
+  }
+
+  void Visit(MivpnConnectStep step) {
+    steps.push_back(step);
+    if (cancelled && step != MivpnConnectStep::kDisconnect) {
+      ++steps_after_cancel;
+    }
+    if (hook && step == hook_step) {
+      ++hook_calls;
+      auto callback = std::move(hook);
+      std::move(callback).Run();
+    }
+  }
+
+  int Count(MivpnConnectStep step) const {
+    return static_cast<int>(std::count(steps.begin(), steps.end(), step));
+  }
+
+  void SetConnectResult(net::IoMode mode,
+                        int result,
+                        bool first_attempt_fails = false) {
+    provider->set_connect_data(net::MockConnect(
+        mode, result, MivpnConnectAddresses()[0], first_attempt_fails));
+  }
+
+  std::unique_ptr<net::TransportClientSocket> MakeTransport(
+      const net::AddressList& addresses,
+      const std::optional<net::IPEndPoint>& local = std::nullopt);
+
+  net::MockConnectCompleter completer;
+  std::unique_ptr<net::SequencedSocketData> provider;
+  std::vector<MivpnConnectStep> steps;
+  net::AddressList created_addresses;
+  std::optional<net::IPEndPoint> bind_argument;
+  std::optional<net::IPEndPoint> bound_socket_address;
+  std::optional<net::IPEndPoint> bound_bind_argument;
+  net::AddressList bound_addresses;
+  net::StreamSocket::BeforeConnectCallback saved_before_connect;
+  MivpnConnectStep hook_step = MivpnConnectStep::kCreate;
+  base::OnceClosure hook;
+  base::OnceClosure after_create;
+  base::RepeatingClosure retry_before_connect;
+  std::vector<int> retry_results;
+  bool alive_after_retry_callback = false;
+  int active_methods = 0;
+  int create_calls = 0;
+  int bound_hook_calls = 0;
+  int disconnect_calls = 0;
+  int destruct_calls = 0;
+  int hook_calls = 0;
+  int steps_after_cancel = 0;
+  int bind_result = net::OK;
+  int local_address_result = net::OK;
+  bool cancelled = false;
+  bool callback_observed = false;
+};
+
+// A production cancellation may run inside any mocked virtual method. The
+// resource guard must keep that method's object alive until the method returns.
+class MivpnConnectMethodGuard {
+ public:
+  explicit MivpnConnectMethodGuard(MivpnConnectTransportState& state)
+      : state_(state), destruct_calls_(state.destruct_calls) {
+    ++state_->active_methods;
+  }
+  ~MivpnConnectMethodGuard() {
+    EXPECT_EQ(destruct_calls_, state_->destruct_calls);
+    --state_->active_methods;
+  }
+
+ private:
+  const raw_ref<MivpnConnectTransportState> state_;
+  const int destruct_calls_;
+};
+
+class MivpnRecordingConnectSocket : public net::MockTCPClientSocket {
+ public:
+  MivpnRecordingConnectSocket(MivpnConnectTransportState& state,
+                              const net::AddressList& addresses,
+                              const std::optional<net::IPEndPoint>& local)
+      : net::MockTCPClientSocket(addresses,
+                                 net::NetLog::Get(),
+                                 state.provider.get()),
+        state_(state) {
+    set_enable_read_if_ready(false);
+    if (local) {
+      local_addr_ = *local;
+    }
+    state.retry_before_connect = base::BindRepeating(
+        &MivpnRecordingConnectSocket::RunBeforeConnectForTesting,
+        weak_factory_.GetWeakPtr());
+  }
+  ~MivpnRecordingConnectSocket() override {
+    EXPECT_EQ(0, state_->active_methods);
+    ++state_->destruct_calls;
+  }
+
+  // An asynchronous address retry invokes the option callback after the
+  // initial Connect() method has returned. There is deliberately no enclosing
+  // service Connect() guard here. This is a deterministic service-layer
+  // observation of the callback-return boundary, not a real TCP retry test.
+  void RunBeforeConnectForTesting() {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    auto callback = state.saved_before_connect;
+    EXPECT_TRUE(callback);
+    if (!callback) {
+      return;
+    }
+    const int result = callback.Run();
+    // Only the independent recording state and local values are accessed
+    // below. Even a faulty production lifetime cannot make the test itself
+    // dereference this or call an already cancelled/destroyed mock transport.
+    state.retry_results.push_back(result);
+    state.alive_after_retry_callback = state.destruct_calls == 0;
+    EXPECT_TRUE(state.alive_after_retry_callback);
+  }
+
+  int Bind(const net::IPEndPoint& address) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    state.bind_argument = address;
+    const int result = state.bind_result == net::OK
+                           ? net::MockTCPClientSocket::Bind(address)
+                           : state.bind_result;
+    state.Visit(MivpnConnectStep::kBind);
+    return result;
+  }
+  void SetBeforeConnectCallback(
+      const BeforeConnectCallback& callback) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    state.saved_before_connect = callback;
+    state.Visit(MivpnConnectStep::kBeforeConnect);
+    if (!state.cancelled && !state.destruct_calls) {
+      net::MockTCPClientSocket::SetBeforeConnectCallback(callback);
+    }
+  }
+  int SetSendBufferSize(int32_t size) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    const int result = net::MockTCPClientSocket::SetSendBufferSize(size);
+    state.Visit(MivpnConnectStep::kSendBuffer);
+    return result;
+  }
+  int SetReceiveBufferSize(int32_t size) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    const int result = net::MockTCPClientSocket::SetReceiveBufferSize(size);
+    state.Visit(MivpnConnectStep::kReceiveBuffer);
+    return result;
+  }
+  bool SetNoDelay(bool no_delay) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    const bool result = net::MockTCPClientSocket::SetNoDelay(no_delay);
+    state.Visit(MivpnConnectStep::kNoDelay);
+    return result;
+  }
+  bool SetKeepAlive(bool enable, int delay) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    const bool result = net::MockTCPClientSocket::SetKeepAlive(enable, delay);
+    state.Visit(MivpnConnectStep::kKeepAlive);
+    return result;
+  }
+  int Connect(net::CompletionOnceCallback callback) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    state.Visit(MivpnConnectStep::kConnect);
+    if (state.cancelled || state.destruct_calls) {
+      return net::ERR_ABORTED;
+    }
+    return net::MockTCPClientSocket::Connect(std::move(callback));
+  }
+  int GetLocalAddress(net::IPEndPoint* address) const override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    const int result = state.local_address_result == net::OK
+                           ? net::MockTCPClientSocket::GetLocalAddress(address)
+                           : state.local_address_result;
+    state.Visit(MivpnConnectStep::kLocalAddress);
+    return result;
+  }
+  int GetPeerAddress(net::IPEndPoint* address) const override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    const int result = net::MockTCPClientSocket::GetPeerAddress(address);
+    state.Visit(MivpnConnectStep::kPeerAddress);
+    return result;
+  }
+  int ReadIfReady(net::IOBuffer* buffer,
+                  int size,
+                  net::CompletionOnceCallback callback) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    state.Visit(MivpnConnectStep::kPumpReadIfReady);
+    if (state.cancelled || state.destruct_calls) {
+      return net::ERR_CONNECTION_CLOSED;
+    }
+    return net::MockTCPClientSocket::ReadIfReady(buffer, size,
+                                                 std::move(callback));
+  }
+  int Read(net::IOBuffer* buffer,
+           int size,
+           net::CompletionOnceCallback callback) override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    state.Visit(MivpnConnectStep::kPumpRead);
+    if (state.cancelled || state.destruct_calls) {
+      return net::ERR_CONNECTION_CLOSED;
+    }
+    return net::MockTCPClientSocket::Read(buffer, size, std::move(callback));
+  }
+  void Disconnect() override {
+    auto& state = *state_;
+    MivpnConnectMethodGuard guard(state);
+    ++state.disconnect_calls;
+    net::MockTCPClientSocket::Disconnect();
+    state.cancelled = true;
+    state.Visit(MivpnConnectStep::kDisconnect);
+  }
+
+ private:
+  const raw_ref<MivpnConnectTransportState> state_;
+  base::WeakPtrFactory<MivpnRecordingConnectSocket> weak_factory_{this};
+};
+
+std::unique_ptr<net::TransportClientSocket>
+MivpnConnectTransportState::MakeTransport(
+    const net::AddressList& addresses,
+    const std::optional<net::IPEndPoint>& local) {
+  MivpnConnectMethodGuard guard(*this);
+  ++create_calls;
+  created_addresses = addresses;
+  auto socket =
+      std::make_unique<MivpnRecordingConnectSocket>(*this, addresses, local);
+  Visit(MivpnConnectStep::kCreate);
+  auto checkpoint = std::move(after_create);
+  if (checkpoint) {
+    std::move(checkpoint).Run();
+  }
+  return socket;
+}
