+
+  void StartOn(mojom::ProxyResolvingSocketFactory* target,
+               mojo::Remote<mojom::ProxyResolvingSocket>& socket,
+               scoped_refptr<MiVPNConnectResult> result,
+               const GURL& url,
+               bool use_tls = false) {
+    auto options = mojom::ProxyResolvingSocketOptions::New();
+    options->use_tls = use_tls;
