+MivpnHostResolver::MivpnHostResolver(std::unique_ptr<net::HostResolver> inner,
+                                     scoped_refptr<MivpnResolverPolicy> policy)
+    : inner_(std::move(inner)), policy_(std::move(policy)) {
+  CHECK(inner_);
+  CHECK(policy_);
+}
+
+MivpnHostResolver::~MivpnHostResolver() {
+  OnShutdown();
+}
+
+void MivpnHostResolver::OnShutdown() {
+  if (is_shutdown_) {
+    return;
+  }
+  is_shutdown_ = true;
+  shutdown_callbacks_.Notify();
+  inner_->OnShutdown();
+}
+
+base::CallbackListSubscription MivpnHostResolver::AddShutdownCallback(
+    base::RepeatingClosure callback) {
+  return shutdown_callbacks_.Add(std::move(callback));
+}
