+  net::SSLClientSocket::ResourceGuardCallback ResourceGuard() {
+    auto weak = weak_factory_.GetWeakPtr();
+    return base::BindRepeating(
+        [](base::WeakPtr<MivpnNativeTLSWork> work) {
+          if (!work) {
+            return base::ScopedClosureRunner();
+          }
+          return base::ScopedClosureRunner(
+              base::BindOnce([](scoped_refptr<MivpnNativeTLSWork>) {},
+                             base::WrapRefCounted(work.get())));
+        },
+        weak);
+  }
