+// This fixture uses the existing private socket-wrapper seam; the
+// implementation under test is the production UDPSocket, not a denying Mojo
+// test stub.
+class MivpnSocketTest : public testing::Test {
+ protected:
+  MivpnSocketTest()
+      : task_environment_(base::test::TaskEnvironment::MainThreadType::IO),
+        notifier_(net::NetworkChangeNotifier::CreateMockIfNeeded()),
+        policy_(base::MakeRefCounted<MivpnResolverPolicy>()) {
+    auto builder = net::CreateTestURLRequestContextBuilder();
+    mock_factory_.set_enable_read_if_ready(true);
+    builder->set_client_socket_factory_for_testing(&mock_factory_);
+    context_ = builder->Build();
+    factory_ =
+        std::make_unique<SocketFactory>(nullptr, context_.get(), policy_);
+  }
+
+  bool HasUDPTransport(UDPSocket* socket) {
+    return socket->wrapped_socket_ != nullptr;
+  }
+  uint32_t ReceiveSlots(UDPSocket* socket) {
+    return socket->remaining_recv_slots_;
+  }
+  RecordingUDPWrapper* InstallUDPTransport(UDPSocket* socket) {
+    auto wrapper = std::make_unique<RecordingUDPWrapper>();
+    auto* result = wrapper.get();
+    socket->wrapped_socket_ = std::move(wrapper);
+    return result;
+  }
+  void BindUDP(UDPSocket* socket) {
+    base::test::TestFuture<int> future;
+    socket->Bind(LocalAddress(), nullptr, AddressResult(&future, net::OK));
+    ASSERT_EQ(net::OK, future.Get());
+  }
+  void CheckTCPConnected(mojom::SocketFactory* factory,
+                         const net::IPEndPoint& endpoint) {
+    mojo::Remote<mojom::TCPConnectedSocket> socket;
+    base::test::TestFuture<int> future;
+    factory->CreateTCPConnectedSocket(
+        std::nullopt, net::AddressList(endpoint), nullptr,
+        net::MutableNetworkTrafficAnnotationTag(TRAFFIC_ANNOTATION_FOR_TESTS),
+        socket.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+        DeniedConnectResult(&future));
+    EXPECT_EQ(kRevoked, future.Get());
+    socket.FlushForTesting();
+    EXPECT_FALSE(socket.is_connected());
+  }
+  void CheckTLSUpgrade(bool deferred) {
+    const net::MockRead reads[] = {
+        net::MockRead(net::ASYNC, net::ERR_IO_PENDING, 0),
+        net::MockRead(net::ASYNC, net::OK, 1)};
+    net::SequencedSocketData data(reads, base::span<net::MockWrite>());
+    data.set_connect_data(net::MockConnect(net::SYNCHRONOUS, net::OK));
+    net::SSLSocketDataProvider ssl(net::ASYNC, net::OK);
+    mock_factory_.AddSocketDataProvider(&data);
+    mock_factory_.AddSSLSocketDataProvider(&ssl);
+    mojo::Remote<mojom::TCPConnectedSocket> socket;
+    mojo::ScopedDataPipeConsumerHandle receive;
+    mojo::ScopedDataPipeProducerHandle send;
+    base::test::TestFuture<int> connect;
+    factory_->CreateTCPConnectedSocket(
+        std::nullopt,
+        net::AddressList(net::IPEndPoint(net::IPAddress::IPv4Localhost(), 443)),
+        nullptr,
+        net::MutableNetworkTrafficAnnotationTag(TRAFFIC_ANNOTATION_FOR_TESTS),
+        socket.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+        base::BindLambdaForTesting(
+            [&](int result, const std::optional<net::IPEndPoint>&,
+                const std::optional<net::IPEndPoint>&,
+                mojo::ScopedDataPipeConsumerHandle receive_stream,
+                mojo::ScopedDataPipeProducerHandle send_stream) {
+              receive = std::move(receive_stream);
+              send = std::move(send_stream);
+              connect.SetValue(result);
+            }));
+    ASSERT_EQ(net::OK, connect.Get());
+    ASSERT_TRUE(receive.is_valid());
+    ASSERT_TRUE(send.is_valid());
+    if (!deferred) {
+      policy_->Block();
+    }
+    mojo::Remote<mojom::TLSClientSocket> tls;
+    base::test::TestFuture<int> upgrade;
+    socket->UpgradeToTLS(
+        net::HostPortPair("example.test", 443), nullptr,
+        net::MutableNetworkTrafficAnnotationTag(TRAFFIC_ANNOTATION_FOR_TESTS),
+        tls.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+        DeniedTLSResult(&upgrade));
+    socket.FlushForTesting();
+    if (deferred) {
+      EXPECT_FALSE(upgrade.IsReady());
+      policy_->Block();
+      receive.reset();
+      send.reset();
+    }
+    EXPECT_EQ(kRevoked, upgrade.Get());
+    EXPECT_FALSE(ssl.ConnectDataConsumed());
+    tls.FlushForTesting();
+    EXPECT_FALSE(tls.is_connected());
+    // The data provider must outlive the retained TCP socket and its pump.
+    socket.reset();
+    task_environment_.RunUntilIdle();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  std::unique_ptr<net::NetworkChangeNotifier> notifier_;
+  net::MockClientSocketFactory mock_factory_;
+  std::unique_ptr<net::URLRequestContext> context_;
+  scoped_refptr<MivpnResolverPolicy> policy_;
+  std::unique_ptr<SocketFactory> factory_;
+};
