+    mojo::Remote<mojom::ProxyResolvingSocket> socket;
+    base::test::TestFuture<int> completion;
+    int completions = 0;
+    base::ScopedClosureRunner cleanup(base::BindLambdaForTesting([&] {
+      socket.reset();
+      task_environment_.RunUntilIdle();
+    }));
+    auto options = mojom::ProxyResolvingSocketOptions::New();
+    options->use_tls = use_tls;
+    factory->CreateProxyResolvingSocket(
