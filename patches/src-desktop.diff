+  ack = drain(foreign_context_id, 10);
+  EXPECT_EQ(foreign_context_id, ack->context_id);
+  EXPECT_FALSE(ack->drained);
+  EXPECT_EQ(net::ERR_INVALID_ARGUMENT, ack->error_code);
+}
