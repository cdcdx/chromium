+MivpnResolverPolicy::MivpnResolverPolicy() = default;
+MivpnResolverPolicy::~MivpnResolverPolicy() = default;
+
+void MivpnResolverPolicy::Block() {
+  if (blocked_) {
+    return;
+  }
+  blocked_ = true;
+  block_callbacks_.Notify();
+}
+
+base::CallbackListSubscription MivpnResolverPolicy::AddBlockCallback(
+    base::RepeatingClosure callback) {
+  return block_callbacks_.Add(std::move(callback));
+}
