+// Strong callback ownership also keeps failed ASSERT paths safe while the
+// fixture's UniqueReceiverSet still owns a pending socket.
+class MiVPNConnectResult : public base::RefCounted<MiVPNConnectResult> {
+ public:
+  MiVPNConnectResult() = default;
+
+  mojom::ProxyResolvingSocketFactory::CreateProxyResolvingSocketCallback
+  callback() {
+    return base::BindOnce(&MiVPNConnectResult::OnCompleted,
+                          base::WrapRefCounted(this));
+  }
+
+  mojom::ProxyResolvingSocket::UpgradeToTLSCallback upgrade_callback() {
+    return base::BindOnce(
+        [](scoped_refptr<MiVPNConnectResult> result, int error,
+           mojo::ScopedDataPipeConsumerHandle receive,
+           mojo::ScopedDataPipeProducerHandle send) {
+          result->OnCompleted(error, std::nullopt, std::nullopt,
+                              std::move(receive), std::move(send));
+        },
+        base::WrapRefCounted(this));
+  }
+
+  void ExpectError(int expected_error) const {
+    EXPECT_EQ(1, calls);
+    EXPECT_EQ(expected_error, error);
+    EXPECT_FALSE(local_addr.has_value());
+    EXPECT_FALSE(peer_addr.has_value());
+    EXPECT_FALSE(receive.is_valid());
+    EXPECT_FALSE(send.is_valid());
+  }
+
+  void ExpectSuccess() const {
+    EXPECT_EQ(1, calls);
+    EXPECT_EQ(net::OK, error);
+    EXPECT_TRUE(local_addr.has_value());
+    EXPECT_TRUE(receive.is_valid());
+    EXPECT_TRUE(send.is_valid());
+  }
+
+  int calls = 0;
+  int error = net::ERR_IO_PENDING;
+  std::optional<net::IPEndPoint> local_addr;
+  std::optional<net::IPEndPoint> peer_addr;
+  mojo::ScopedDataPipeConsumerHandle receive;
+  mojo::ScopedDataPipeProducerHandle send;
+  base::OnceClosure on_complete;
+
+ private:
+  friend class base::RefCounted<MiVPNConnectResult>;
+  ~MiVPNConnectResult() = default;
+
+  void OnCompleted(int result,
+                   const std::optional<net::IPEndPoint>& local,
+                   const std::optional<net::IPEndPoint>& peer,
+                   mojo::ScopedDataPipeConsumerHandle receive_pipe,
+                   mojo::ScopedDataPipeProducerHandle send_pipe) {
+    ++calls;
+    error = result;
+    local_addr = local;
+    peer_addr = peer;
+    receive = std::move(receive_pipe);
+    send = std::move(send_pipe);
+    if (on_complete) {
+      std::move(on_complete).Run();
+    }
+  }
+};
+
+// Only the late/reentrant completion lifetime tests use this seam. PAC and
+// ConnectJob cancellation tests below use the real factory and inner socket.
+struct MiVPNLateConnectState {
+  net::CompletionOnceCallback callback;
+  int connects = 0;
+  int disconnects = 0;
+  int destructions = 0;
+  std::optional<int> complete_on_disconnect;
+};
+
+class MiVPNLateConnectSocket : public net::MockTCPClientSocket {
+ public:
+  MiVPNLateConnectSocket(MiVPNLateConnectState& state,
+                         net::SocketDataProvider* data)
+      : net::MockTCPClientSocket(net::AddressList(), nullptr, data),
+        state_(state) {}
+
+  ~MiVPNLateConnectSocket() override { ++state_->destructions; }
+
+  int Connect(net::CompletionOnceCallback callback) override {
+    ++state_->connects;
+    state_->callback = std::move(callback);
+    return net::ERR_IO_PENDING;
+  }
+
+  void Disconnect() override {
+    ++state_->disconnects;
+    net::MockTCPClientSocket::Disconnect();
+    if (state_->complete_on_disconnect && state_->callback) {
+      std::move(state_->callback).Run(*state_->complete_on_disconnect);
+    }
+  }
+
+ private:
+  raw_ref<MiVPNLateConnectState> state_;
+};
+
+std::unique_ptr<ProxyResolvingSocketMojo> MakeMiVPNLateSocket(
+    MiVPNLateConnectState& state,
+    net::SocketDataProvider* data,
+    scoped_refptr<MivpnResolverPolicy> policy) {
+  return std::make_unique<ProxyResolvingSocketMojo>(
+      std::make_unique<MiVPNLateConnectSocket>(state, data),
+      TRAFFIC_ANNOTATION_FOR_TESTS, mojo::NullRemote(),
+      nullptr /* tls_socket_factory: no upgrades in lifetime tests */,
+      std::move(policy));
+}
