+TEST_F(NetworkContextTest, MivpnRoutePolicyFailureAcks) {
+  const base::UnguessableToken context_id = base::UnguessableToken::Create();
+  mojom::NetworkContextParamsPtr context_params =
+      CreateNetworkContextParamsForTesting();
+  context_params->mivpn_initial_route_policy =
+      mojom::MivpnInitialRoutePolicy::New(context_id, 10,
+                                          mojom::MivpnRouteMode::kBlocked);
+  std::unique_ptr<NetworkContext> network_context =
+      CreateContextWithParams(std::move(context_params));
+
+  auto apply_policy =
+      [&](const base::UnguessableToken& request_context_id, uint64_t generation,
+          mojom::MivpnRouteMode mode,
+          std::optional<net::ProxyConfigWithAnnotation> proxy_config) {
+        base::test::TestFuture<mojom::MivpnRoutePolicyAckPtr> ack_future;
+        network_context->ApplyMivpnRoutePolicy(request_context_id, generation,
+                                               mode, proxy_config,
+                                               ack_future.GetCallback());
+        return ack_future.Take();
+      };
+
+  mojom::MivpnRoutePolicyAckPtr ack = apply_policy(
+      context_id, 10, mojom::MivpnRouteMode::kBlocked, std::nullopt);
+  EXPECT_EQ(context_id, ack->context_id);
+  EXPECT_EQ(10u, ack->generation);
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_NOT_IMPLEMENTED, ack->error_code);
+
+  ack = apply_policy(context_id, 9, mojom::MivpnRouteMode::kBlocked,
+                     std::nullopt);
+  EXPECT_EQ(9u, ack->generation);
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_ABORTED, ack->error_code);
+
+  ack = apply_policy(context_id, 0, mojom::MivpnRouteMode::kBlocked,
+                     std::nullopt);
+  EXPECT_EQ(0u, ack->generation);
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_INVALID_ARGUMENT, ack->error_code);
+
+  const base::UnguessableToken empty_context_id;
+  ack = apply_policy(empty_context_id, 10, mojom::MivpnRouteMode::kBlocked,
+                     std::nullopt);
+  EXPECT_EQ(empty_context_id, ack->context_id);
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_INVALID_ARGUMENT, ack->error_code);
+
+  const base::UnguessableToken foreign_context_id =
+      base::UnguessableToken::Create();
+  ack = apply_policy(foreign_context_id, 10, mojom::MivpnRouteMode::kBlocked,
+                     std::nullopt);
+  EXPECT_EQ(foreign_context_id, ack->context_id);
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_INVALID_ARGUMENT, ack->error_code);
+
+  ack = apply_policy(
+      context_id, 10, mojom::MivpnRouteMode::kDirect,
+      net::ProxyConfigWithAnnotation(net::ProxyConfig::CreateDirect(),
+                                     TRAFFIC_ANNOTATION_FOR_TESTS));
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_INVALID_ARGUMENT, ack->error_code);
+
+  ack = apply_policy(context_id, 11, mojom::MivpnRouteMode::kDirect,
+                     std::nullopt);
+  EXPECT_FALSE(ack->applied);
+  EXPECT_EQ(net::ERR_NOT_IMPLEMENTED, ack->error_code);
+  EXPECT_TRUE(network_context->IsMivpnRouteBlocked());
+}
