+TEST_F(SandboxWinTest, MiVpnParentNoSandboxKeepsSandboxedPolicy) {
+  base::test::ScopedCommandLine scoped_command_line;
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kWinSboxStrictHandleChecks);
+  auto* const parent = scoped_command_line.GetProcessCommandLine();
+  BrokerServices* broker = SandboxFactory::GetBrokerServices();
+  ASSERT_NE(nullptr, broker);
+
+  // Include the clean-parent control: MiVPN's Microsoft-only exception is not
+  // contingent on --no-sandbox, and a value of "0" still denotes a present flag.
+  for (int parent_form = 0; parent_form < 3; ++parent_form) {
+    SCOPED_TRACE(parent_form);
+    parent->RemoveSwitch(switches::kNoSandbox);
+    if (parent_form == 1) {
+      parent->AppendSwitch(switches::kNoSandbox);
+    } else if (parent_form == 2) {
+      parent->AppendSwitchASCII(switches::kNoSandbox, "0");
+    }
+    PolicyOnlySandboxDelegate delegate(sandbox::mojom::Sandbox::kMiVpn);
+    EXPECT_CALL(delegate, InitializeConfig(_)).WillOnce(Return(true));
+    EXPECT_CALL(delegate, PreSpawnTarget(_)).WillOnce(Return(true));
+    base::CommandLine child(base::CommandLine::NO_PROGRAM);
+    auto policy = broker->CreatePolicy();
+    ASSERT_EQ(SBOX_ALL_OK, SandboxWin::GeneratePolicyForSandboxedProcess(
+                               child, {}, &delegate, policy.get()));
+    auto* const config = policy->GetConfig();
+    EXPECT_EQ(INTEGRITY_LEVEL_LOW, config->GetIntegrityLevel());
+    EXPECT_EQ(JobLevel::kLockdown, config->GetJobLevel());
+    EXPECT_EQ(USER_LOCKDOWN, config->GetLockdownTokenLevel());
+    const MitigationFlags expected_startup =
+        MITIGATION_HEAP_TERMINATE | MITIGATION_BOTTOM_UP_ASLR | MITIGATION_DEP |
+        MITIGATION_DEP_NO_ATL_THUNK | MITIGATION_EXTENSION_POINT_DISABLE |
+        MITIGATION_SEHOP | MITIGATION_NONSYSTEM_FONT_DISABLE |
+        MITIGATION_IMAGE_LOAD_NO_REMOTE | MITIGATION_IMAGE_LOAD_NO_LOW_LABEL |
+        MITIGATION_RESTRICT_INDIRECT_BRANCH_PREDICTION |
+        MITIGATION_KTM_COMPONENT | MITIGATION_FSCTL_DISABLED;
+    EXPECT_EQ(expected_startup, config->GetProcessMitigations());
+    EXPECT_EQ(MITIGATION_DLL_SEARCH_ORDER | MITIGATION_DYNAMIC_CODE_DISABLE |
+                  MITIGATION_STRICT_HANDLE_CHECKS,
+              config->GetDelayedProcessMitigations());
+    EXPECT_EQ(0U, config->GetDelayedProcessMitigations() &
+                      MITIGATION_FORCE_MS_SIGNED_BINS);
+
+    // Content's delegate adds Win32k lockdown separately. Verify the real
+    // sandbox operation still composes with this common policy and does not
+    // remove any other mitigation or restore the Microsoft-only restriction.
+    ASSERT_EQ(SBOX_ALL_OK, SandboxWin::AddWin32kLockdownPolicy(config));
+    EXPECT_EQ(expected_startup | MITIGATION_WIN32K_DISABLE,
+              config->GetProcessMitigations());
+    EXPECT_EQ(MITIGATION_DLL_SEARCH_ORDER | MITIGATION_DYNAMIC_CODE_DISABLE |
+                  MITIGATION_STRICT_HANDLE_CHECKS,
+              config->GetDelayedProcessMitigations());
+  }
+}
