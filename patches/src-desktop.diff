+#if BUILDFLAG(ENABLE_CLIENT_CERTIFICATES)
+template <typename Base>
+class MivpnNativeTLSSocksPrivateKeyBase : public Base {
+ protected:
+  bool NeedsClientCertificate() const override { return true; }
+
+  void SetUp() override {
+    Base::SetUp();
+    ASSERT_FALSE(this->HasFatalFailure());
+    auto cert =
+        net::ImportCertFromFile(net::GetTestCertsDirectory(), "client_1.pem");
+    auto real_key = net::key_util::LoadPrivateKeyOpenSSL(
+        net::GetTestCertsDirectory().AppendASCII("client_1.key"));
+    ASSERT_TRUE(cert);
+    ASSERT_TRUE(real_key);
+    key_ = base::MakeRefCounted<MivpnNativePrivateKey>(std::move(real_key));
+    this->ssl_context_->SetClientCertificate(this->server_.host_port_pair(),
+                                             cert, key_);
+  }
+
+  void RealCryptoCommit(bool inline_completion) {
+    ASSERT_NO_FATAL_FAILURE(this->CreateConnectedRoot());
+    key_->state()->inline_completion = inline_completion;
+    this->on_complete_ = base::BindLambdaForTesting([&] {
+      EXPECT_FALSE(this->work_->socket->CommitPendingUpgrade());
+      base::RunLoop(base::RunLoop::Type::kNestableTasksAllowed).RunUntilIdle();
+      EXPECT_FALSE(this->work_->socket->CommitPendingUpgrade());
+    });
+    ASSERT_EQ(net::OK, this->WaitHandshake(this->StartHandshake()));
+    EXPECT_EQ(1, key_->state()->calls);
+    EXPECT_EQ(1, key_->state()->results);
+    ASSERT_TRUE(this->work_->socket->CommitPendingUpgrade());
+    this->RoundTrip();
+    this->ExpectRealRelay();
+  }
+
+  void InlineSignCallbackCancel() {
+    ASSERT_NO_FATAL_FAILURE(this->CreateConnectedRoot());
+    key_->state()->inline_completion = true;
+    auto weak = this->work_->GetWeakPtr();
+    base::test::TestFuture<void> entered;
+    auto cleanup = this->CleanupNativeResources();
+    key_->sign_hook = base::BindLambdaForTesting([&] {
+      EXPECT_EQ(1, key_->state()->results);
+      EXPECT_FALSE(this->completion_.IsReady());
+      EXPECT_FALSE(this->work_->socket->CommitPendingUpgrade());
+      // key_ independently keeps the executing provider legally alive, not the
+      // business SSL context or its transport/factory owner.
+      this->CancelAndDestroyContext(true);
+      this->resolver_.reset();
+      this->policy_.reset();
+      EXPECT_FALSE(this->endpoint_->IsConnected());
+      EXPECT_FALSE(this->socks_raw_->IsConnected());
+      EXPECT_TRUE(weak);
+      EXPECT_EQ(0, this->work_destructions_);
+      base::RunLoop(base::RunLoop::Type::kNestableTasksAllowed).RunUntilIdle();
+      EXPECT_TRUE(weak);
+      entered.SetValue();
+    });
+    int result = this->StartHandshake();
+    EXPECT_TRUE(result == net::ERR_IO_PENDING || result == net::ERR_ABORTED);
+    ASSERT_TRUE(entered.Wait());
+    EXPECT_FALSE(weak);
+    EXPECT_EQ(1, key_->state()->calls);
+    EXPECT_EQ(1, key_->state()->results);
+    EXPECT_EQ(1, this->work_destructions_);
+    EXPECT_EQ(1, this->socks_hooks_->destructions);
+    EXPECT_EQ(0, this->completion_count_);
+  }
+
+  void RealCryptoLateCallbackCancel() {
+    ASSERT_NO_FATAL_FAILURE(this->CreateConnectedRoot());
+    key_->state()->hold_result = true;
+    auto weak = this->work_->GetWeakPtr();
+    base::test::TestFuture<void> entered;
+    auto cleanup = this->CleanupNativeResources();
+    key_->sign_hook = base::BindLambdaForTesting([&] {
+      EXPECT_FALSE(this->work_->socket->CommitPendingUpgrade());
+      this->CancelAndDestroyContext(true);
+      this->resolver_.reset();
+      this->policy_.reset();
+      EXPECT_FALSE(this->endpoint_->IsConnected());
+      EXPECT_TRUE(weak);
+      EXPECT_EQ(0, this->work_destructions_);
+      entered.SetValue();
+    });
+    int result = this->StartHandshake();
+    EXPECT_TRUE(result == net::ERR_IO_PENDING || result == net::ERR_ABORTED);
+    ASSERT_TRUE(entered.Wait());
+    ASSERT_TRUE(key_->state()->ready.Wait());
+    ASSERT_EQ(net::OK, key_->state()->error);
+    EXPECT_FALSE(weak);
+    EXPECT_EQ(1, this->work_destructions_);
+    // SSLPrivateKey, unlike a cancelled HostResolver/CertVerifier request,
+    // explicitly permits legal late completion. Deliver the REAL crypto result
+    // after all resource-only native holds have unwound.
+    key_->state()->Deliver();
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(1, key_->state()->calls);
+    EXPECT_EQ(1, key_->state()->results);
+    EXPECT_EQ(1, this->work_destructions_);
+    EXPECT_EQ(0, this->completion_count_);
+  }
+
+  void CryptoResumeBIOWriteCancel() {
+    ASSERT_NO_FATAL_FAILURE(this->CreateConnectedRoot());
+    key_->state()->hold_result = true;
+    ASSERT_EQ(net::ERR_IO_PENDING, this->StartHandshake());
+    ASSERT_TRUE(key_->state()->ready.Wait());
+    ASSERT_EQ(net::OK, key_->state()->error);
+    EXPECT_FALSE(this->completion_.IsReady());
+    auto weak = this->work_->GetWeakPtr();
+    base::test::TestFuture<void> entered;
+    auto cleanup = this->CleanupNativeResources();
+    this->socks_hooks_->write_hook = base::BindLambdaForTesting([&] {
+      EXPECT_FALSE(this->work_->socket->CommitPendingUpgrade());
+      this->CancelAndDestroyContext(true);
+      this->resolver_.reset();
+      this->policy_.reset();
+      EXPECT_FALSE(this->endpoint_->IsConnected());
+      EXPECT_TRUE(weak);
+      EXPECT_GT(this->socks_hooks_->active_overrides, 0);
+      EXPECT_EQ(0, this->socks_hooks_->destructions);
+      entered.SetValue();
+    });
+    key_->state()->Deliver();
+    ASSERT_TRUE(entered.IsReady());
+    EXPECT_FALSE(weak);
+    EXPECT_EQ(1, this->socks_hooks_->destructions);
+    EXPECT_EQ(1, this->work_destructions_);
+    EXPECT_EQ(0, this->completion_count_);
+  }
+
+  void CryptoProviderHookCancel(bool preferences) {
+    ASSERT_NO_FATAL_FAILURE(this->CreateConnectedRoot());
+    auto weak = this->work_->GetWeakPtr();
+    base::test::TestFuture<void> entered;
+    auto cleanup = this->CleanupNativeResources();
+    auto hook = base::BindLambdaForTesting([&] {
+      EXPECT_FALSE(this->work_->socket->CommitPendingUpgrade());
+      this->CancelAndDestroyContext(true);
+      this->resolver_.reset();
+      this->policy_.reset();
+      EXPECT_FALSE(this->endpoint_->IsConnected());
+      EXPECT_TRUE(weak);
+      EXPECT_EQ(0, this->work_destructions_);
+      entered.SetValue();
+    });
+    if (preferences) {
+      key_->preferences_hook = std::move(hook);
+    } else {
+      key_->name_hook = std::move(hook);
+    }
+    int result = this->StartHandshake();
+    EXPECT_TRUE(result == net::ERR_IO_PENDING || result == net::ERR_ABORTED);
+    ASSERT_TRUE(entered.Wait());
+    EXPECT_FALSE(weak);
+    EXPECT_EQ(0, key_->state()->calls);
+    EXPECT_EQ(1, this->work_destructions_);
+    EXPECT_EQ(0, this->completion_count_);
+  }
+
+  scoped_refptr<MivpnNativePrivateKey> key_;
+};
