+TEST_F(MivpnHostResolverTest, AllowedSynchronousResolveForwardsResults) {
+  inner_->set_synchronous_mode(true);
+  auto request = Resolve();
+  net::TestCompletionCallback callback;
+  EXPECT_EQ(net::OK, request->Start(callback.callback()));
+  EXPECT_FALSE(callback.have_result());
+  EXPECT_FALSE(request->GetAddressResults().empty());
+  EXPECT_EQ(net::OK, request->GetResolveErrorInfo().error);
+  EXPECT_EQ(1u, inner_->factories);
+}
+
+TEST_F(MivpnHostResolverTest, AllowedAsyncResolveForwardsCompletion) {
+  inner_->set_ondemand_mode(true);
+  auto request = Resolve();
+  net::TestCompletionCallback callback;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(callback.callback()));
+  inner_->ResolveAllPending();
+  EXPECT_EQ(net::OK, callback.WaitForResult());
+  EXPECT_FALSE(request->GetAddressResults().empty());
+}
+
+TEST_F(MivpnHostResolverTest, BlockCancelsPendingResolveAndCompletesOnce) {
+  inner_->set_ondemand_mode(true);
+  auto request = Resolve();
+  int calls = 0;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(base::BindOnce(
+                                     [](int* calls, int rv) {
+                                       ++*calls;
+                                       EXPECT_EQ(
+                                           net::ERR_NETWORK_ACCESS_REVOKED, rv);
+                                     },
+                                     &calls)));
+  ASSERT_TRUE(inner_->has_pending_requests());
+  inner_->ResolveAllPending();
+  policy_->Block();
+  EXPECT_FALSE(inner_->has_pending_requests());
+  EXPECT_EQ(0, calls);
+  policy_->Block();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(1, calls);
+  EXPECT_TRUE(request->GetAddressResults().empty());
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED,
+            request->GetResolveErrorInfo().error);
+}
+
+TEST_F(MivpnHostResolverTest,
+       DestroyedRequestSuppressesQueuedBlockedCompletion) {
+  inner_->set_ondemand_mode(true);
+  auto request = Resolve();
+  net::TestCompletionCallback callback;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(callback.callback()));
+  policy_->Block();
+  request.reset();
+  tasks_.RunUntilIdle();
+  EXPECT_FALSE(callback.have_result());
+  EXPECT_FALSE(inner_->has_pending_requests());
+}
+
+TEST_F(MivpnHostResolverTest, ShutdownSuppressesQueuedBlockedCompletion) {
+  inner_->set_ondemand_mode(true);
+  auto request = Resolve();
+  net::TestCompletionCallback callback;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(callback.callback()));
+  policy_->Block();
+  resolver_->OnShutdown();
+  resolver_->OnShutdown();
+  tasks_.RunUntilIdle();
+  EXPECT_FALSE(callback.have_result());
+  EXPECT_EQ(net::ERR_CONTEXT_SHUT_DOWN, request->GetResolveErrorInfo().error);
+}
+
+TEST_F(MivpnHostResolverTest, ResolverDestructionCancelsPendingWorkSilently) {
+  inner_->set_ondemand_mode(true);
+  auto state = inner_->state();
+  auto request = Resolve();
+  auto delayed = Resolve();
+  net::TestCompletionCallback callback;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(callback.callback()));
+  inner_ = nullptr;
+  resolver_.reset();
+  policy_->Block();
+  tasks_.RunUntilIdle();
+  EXPECT_FALSE(state->has_pending_requests());
+  EXPECT_FALSE(callback.have_result());
+  EXPECT_EQ(net::ERR_CONTEXT_SHUT_DOWN, delayed->Start(callback.callback()));
+}
+
+TEST_F(MivpnHostResolverTest, AllFactoriesRejectStartAfterShutdown) {
+  resolver_->OnShutdown();
+  auto plain = Resolve();
+  auto endpoint = Endpoint();
+  auto probe = resolver_->CreateDohProbeRequest();
+  auto mdns = resolver_->CreateMdnsListener(net::HostPortPair("test.local", 80),
+                                            net::DnsQueryType::A);
+  net::TestCompletionCallback callback;
+  testing::StrictMock<EndpointDelegate> endpoint_delegate;
+  testing::StrictMock<MdnsDelegate> mdns_delegate;
+  EXPECT_EQ(net::ERR_CONTEXT_SHUT_DOWN, plain->Start(callback.callback()));
+  EXPECT_EQ(net::ERR_CONTEXT_SHUT_DOWN, endpoint->Start(&endpoint_delegate));
+  EXPECT_EQ(net::ERR_CONTEXT_SHUT_DOWN, probe->Start());
+  EXPECT_EQ(net::ERR_CONTEXT_SHUT_DOWN, mdns->Start(&mdns_delegate));
+  EXPECT_EQ(0u, inner_->factories);
+}
+
+TEST_F(MivpnHostResolverTest, AllowedSynchronousEndpointDoesNotNotifyDelegate) {
+  inner_->set_synchronous_mode(true);
+  auto request = Endpoint();
+  testing::StrictMock<EndpointDelegate> delegate;
