+class MivpnStandaloneTestResolverFactory : public net::HostResolver::Factory {
+ public:
+  std::unique_ptr<net::HostResolver> CreateResolver(net::HostResolverManager*,
+                                                    std::string_view,
+                                                    bool,
+                                                    bool) override {
+    return MakeResolver();
+  }
+  std::unique_ptr<net::HostResolver> CreateStandaloneResolver(
+      net::NetLog*,
+      const net::HostResolver::ManagerOptions& options,
+      std::string_view,
+      bool,
+      bool) override {
+    overrides = options.dns_config_overrides;
+    return MakeResolver();
+  }
+  std::vector<scoped_refptr<const net::MockHostResolver::State>> states;
+  net::DnsConfigOverrides overrides;
+
+ private:
+  std::unique_ptr<net::HostResolver> MakeResolver() {
+    auto resolver = std::make_unique<net::MockHostResolver>();
+    resolver->rules()->AddRule("*", "192.0.2.1");
+    states.push_back(resolver->state());
+    return resolver;
+  }
+};
+
+TEST_F(NetworkContextTest,
+       MivpnInitialBlockedDeniesSharedAndStandaloneResolvers) {
+  auto factory = std::make_unique<MivpnStandaloneTestResolverFactory>();
+  auto* factory_ptr = factory.get();
+  network_service_->set_host_resolver_factory_for_testing(std::move(factory));
+  auto params = CreateNetworkContextParamsForTesting();
+  params->mivpn_initial_route_policy = mojom::MivpnInitialRoutePolicy::New(
+      base::UnguessableToken::Create(), 1, mojom::MivpnRouteMode::kBlocked);
+  auto context = CreateContextWithParams(std::move(params));
+  net::DnsConfigOverrides overrides;
+  overrides.nameservers =
+      std::vector<net::IPEndPoint>{CreateExpectedEndPoint("192.0.2.53", 53)};
+  for (bool standalone : {false, true}) {
+    mojo::Remote<mojom::HostResolver> resolver;
+    context->CreateHostResolver(
+        standalone ? std::make_optional(overrides) : std::nullopt,
+        resolver.BindNewPipeAndPassReceiver());
+    base::RunLoop loop;
+    mojo::PendingRemote<mojom::ResolveHostClient> pending;
+    TestResolveHostClient client(&pending, &loop);
+    resolver->ResolveHost(mojom::HostResolverHost::NewHostPortPair(
+                              net::HostPortPair("standalone.test", 443)),
+                          net::NetworkAnonymizationKey(), nullptr,
+                          std::move(pending));
+    loop.Run();
+    EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED, client.top_level_result_error());
+    EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED, client.result_error());
+    EXPECT_TRUE(client.result_addresses().empty());
+  }
+  EXPECT_EQ(overrides, factory_ptr->overrides);
+  ASSERT_EQ(2u, factory_ptr->states.size());
+  for (const auto& state : factory_ptr->states) {
+    EXPECT_EQ(0u, state->num_resolve());
+    EXPECT_FALSE(state->has_pending_requests());
+  }
+}
