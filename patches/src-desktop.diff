+bool SSLClientSocketImpl::EnablePendingUpgradeCancellation(
+    ResourceGuardCallback guard) {
+  if (pending_upgrade_control_ || pending_upgrade_opt_in_failed_) {
+    return false;
+  }
+  // Probe the entire transport tree before installing anything or starting IO.
+  // The fresh root's own stack must also have fully exited.
+  if (guard.is_null() || ssl_ || transport_adapter_ || disconnected_ ||
+      completed_connect_ || native_activity_->active() != 0 ||
+      next_handshake_state_ != STATE_NONE || user_connect_callback_ ||
+      user_read_callback_ || user_write_callback_ ||
+      !stream_socket_->CanAdoptPendingUpgrade()) {
+    pending_upgrade_opt_in_failed_ = true;
+    return false;
+  }
+  auto control = base::MakeRefCounted<PendingUpgradeControl>(std::move(guard));
+  control->SetCancelCallback(
+      base::BindRepeating(&SSLClientSocketImpl::CancelPendingUpgrade,
+                          resource_weak_factory_.GetWeakPtr()));
+  stream_socket_->InstallPendingUpgradeControl(control);
+  pending_upgrade_control_ = std::move(control);
+  // Only the root marks prepared, after the no-hook installation is complete.
+  pending_upgrade_control_->MarkPrepared();
+  return true;
+}
+
+void SSLClientSocketImpl::CancelPendingUpgrade() {
+  auto control = pending_upgrade_control_;
+  if (!control || control->committed()) {
+    return;
+  }
+  control->LatchCancelled();
+  auto hold = control->HoldResources();
+  // The complete no-hook detach pass must precede any endpoint closure or
+  // callback/Request destruction. Repeat it safely on recursive cancellation.
+  DetachPendingUpgrade();
+  ClosePendingUpgrade();
+}
+
+void SSLClientSocketImpl::DetachPendingUpgrade() {
+  CHECK(PendingUpgradeCancelled());
+  context_ = nullptr;
+  disconnected_ = true;
+  completed_connect_ = false;
+  next_handshake_state_ = STATE_NONE;
+  in_confirm_handshake_ = false;
+  weak_factory_.InvalidateWeakPtrs();
+  if (transport_adapter_) {
+    transport_adapter_->DetachPendingUpgrade();
+  }
+  stream_socket_->DetachPendingUpgrade();
+}
+
+void SSLClientSocketImpl::ClosePendingUpgrade() {
+  auto scope = TrackPendingUpgradeActivity();
+  CHECK(PendingUpgradeCancelled());
+  // Recurse even on the second Cancel: each layer separately claims resources.
+  stream_socket_->ClosePendingUpgrade();
+  if (transport_adapter_) {
+    transport_adapter_->ClosePendingUpgrade();
+  }
+  if (verifier_request_close_.Claim()) {
+    // Move out before invoking a Request destructor which can reenter Cancel.
+    auto request = std::move(cert_verifier_request_);
+    request.reset();
+    verifier_request_close_.Complete();
+  }
+  if (connect_callback_close_.Claim()) {
+    user_connect_callback_.Reset();
+    connect_callback_close_.Complete();
+  }
+  if (read_callback_close_.Claim()) {
+    user_read_callback_.Reset();
+    read_callback_close_.Complete();
+  }
+  if (write_callback_close_.Claim()) {
+    user_write_callback_.Reset();
+    write_callback_close_.Complete();
+  }
+  // Active SSL_write/read still reference these buffers. They, the adapter,
+  // SSL object and owned transport remain until the last resource scope exits.
+}
