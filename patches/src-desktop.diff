+                    EXPECT_FALSE(socks_raw_->IsConnected());
+                    EXPECT_TRUE(weak);
+                    EXPECT_EQ(0, work_destructions_);
+                    base::RunLoop(base::RunLoop::Type::kNestableTasksAllowed)
+                        .RunUntilIdle();
+                    EXPECT_TRUE(weak);
+                    read_returned.SetValue();
+                  })));
+    ASSERT_EQ(1, relay_->SendPreTLSByte());
+    ASSERT_TRUE(read_returned.Wait());
+    EXPECT_FALSE(weak);
+    EXPECT_EQ(1, read_completions);
+    EXPECT_EQ(1, socks_hooks_->destructions);
+    EXPECT_EQ(1, work_destructions_);
+    EXPECT_EQ(0, completion_count_);
+    // Drain already-scheduled native events; cancellation must not turn a late
+    // lower event into a second SOCKS or root TLS completion.
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(1, read_completions);
+    EXPECT_EQ(0, completion_count_);
+  }
+
+  void SCTCallbackCancels() {
+    ASSERT_NO_FATAL_FAILURE(CreateConnectedRoot());
+    auto weak = work_->GetWeakPtr();
+    base::test::TestFuture<void> entered;
+    auto cleanup = CleanupNativeResources();
+    sct_delegate_->hook = base::BindLambdaForTesting([&] {
+      EXPECT_FALSE(work_->socket->CommitPendingUpgrade());
+      CancelAndDestroyContext(true);
+      resolver_.reset();
+      policy_.reset();
+      EXPECT_FALSE(endpoint_->IsConnected());
+      EXPECT_TRUE(weak);
+      EXPECT_EQ(0, work_destructions_);
+      entered.SetValue();
+    });
+    int result = StartHandshake();
+    EXPECT_TRUE(result == net::ERR_IO_PENDING || result == net::ERR_ABORTED);
+    ASSERT_TRUE(entered.Wait());
+    EXPECT_FALSE(weak);
+    EXPECT_EQ(1, sct_delegate_->calls);
+    EXPECT_EQ(1, work_destructions_);
+    EXPECT_EQ(0, completion_count_);
+  }
+
+  std::unique_ptr<SocksSocket> MakePlainSocks() {
+    relay_ = std::make_unique<MivpnNativeSocksRelay>(Version, server_.port(),
+                                                     RelayMode::kPauseTraffic);
+    if (!relay_->Start()) {
+      ADD_FAILURE() << "Loopback relay failed to start";
+      return nullptr;
+    }
+    CreateTransport(relay_->port());
+    const int result = ConnectTransport();
+    EXPECT_EQ(net::OK, result);
+    if (result != net::OK) {
+      return nullptr;
+    }
+    endpoint_ = transport_.get();
+    const net::HostPortPair destination("mivpn-native.test", server_.port());
+    if constexpr (Version == 4) {
+      return std::make_unique<SocksSocket>(
+          std::move(transport_), destination, net::NetworkAnonymizationKey(),
+          net::DEFAULT_PRIORITY, resolver_.get(), net::SecureDnsPolicy::kAllow,
+          TRAFFIC_ANNOTATION_FOR_TESTS);
+    } else {
+      return std::make_unique<SocksSocket>(std::move(transport_), destination,
+                                           TRAFFIC_ANNOTATION_FOR_TESTS);
+    }
+  }
+
+  void UnmanagedSynchronousWriteCanDeleteSocks() {
+    // Use the plain production class: a test override that accesses members
+    // after Base::Write would itself be an illegal unmanaged delete-this
+    // caller.
+    auto owner = MakePlainSocks();
+    ASSERT_TRUE(owner);
+    net::TestCompletionCallback connected;
+    ASSERT_EQ(net::OK,
+              connected.GetResult(owner->Connect(connected.callback())));
+    auto buffer = base::MakeRefCounted<net::StringIOBuffer>("x");
+    bool released = false;
+    bool may_destroy = true;
+    auto token = std::make_unique<MivpnNativeCallbackRelease>(
+        base::BindLambdaForTesting([&] {
+          released = true;
+          if (may_destroy) {
+            owner.reset();
+          }
+        }));
+    base::ScopedClosureRunner cleanup(base::BindLambdaForTesting([&] {
+      may_destroy = false;
+      owner.reset();
+    }));
+    int result = owner->Write(
+        buffer.get(), 1,
+        base::BindOnce(
+            [](std::unique_ptr<MivpnNativeCallbackRelease> token, int result) {
+              ADD_FAILURE() << "Expected the real empty-queue write to be sync";
+            },
+            std::move(token)),
+        TRAFFIC_ANNOTATION_FOR_TESTS);
+    ASSERT_EQ(1, result);
+    EXPECT_TRUE(released);
+    EXPECT_FALSE(owner);
+    EXPECT_EQ(0, resolver_state_->requests);
+  }
+
+  void UnmanagedReadinessCallbackCanDeleteSocks() {
+    auto owner = MakePlainSocks();
+    ASSERT_TRUE(owner);
+    net::TestCompletionCallback connected;
+    ASSERT_EQ(net::OK,
+              connected.GetResult(owner->Connect(connected.callback())));
+    auto buffer = base::MakeRefCounted<net::IOBufferWithSize>(1);
+    bool released = false;
+    bool may_destroy = true;
+    auto token = std::make_unique<MivpnNativeCallbackRelease>(
+        base::BindLambdaForTesting([&] {
+          released = true;
+          if (may_destroy) {
+            owner.reset();
+          }
+        }));
+    base::ScopedClosureRunner cleanup(base::BindLambdaForTesting([&] {
+      may_destroy = false;
+      owner.reset();
+    }));
+    int result = owner->ReadIfReady(
+        buffer.get(), 1,
+        base::BindOnce(
+            [](std::unique_ptr<MivpnNativeCallbackRelease> token, int result) {
+              ADD_FAILURE() << "Readiness callback unexpectedly ran";
+            },
+            std::move(token)));
+    if constexpr (Version == 4) {
+      ASSERT_EQ(net::ERR_IO_PENDING, result);
+      EXPECT_FALSE(released);
+      EXPECT_EQ(net::OK, owner->CancelReadIfReady());
+    } else {
+      EXPECT_EQ(net::ERR_READ_IF_READY_NOT_IMPLEMENTED, result);
+    }
+    EXPECT_TRUE(released);
+    EXPECT_FALSE(owner);
+    EXPECT_EQ(0, resolver_state_->requests);
+  }
+
+  void RefuseOtherOrigin() {
+    const uint16_t other = server_.port() == 65535 ? 1 : server_.port() + 1;
+    ASSERT_NO_FATAL_FAILURE(MakeSocks(RelayMode::kForward, false, other));
+    EXPECT_EQ(net::ERR_SOCKS_CONNECTION_FAILED, ConnectSocks());
+    auto stats = relay_->Snapshot();
+    EXPECT_EQ(1, stats.requests);
+    EXPECT_EQ(1, stats.rejected);
+    EXPECT_EQ(0, stats.origins);
+  }
+
+  std::unique_ptr<MivpnNativeSocksRelay> relay_;
+  std::shared_ptr<MivpnNativeSocksResolverState> resolver_state_;
+  scoped_refptr<MivpnResolverPolicy> policy_;
+  std::unique_ptr<MivpnHostResolver> resolver_;
+  std::shared_ptr<MivpnNativeTransportHooks> socks_hooks_;
+  std::shared_ptr<MivpnNativeSocksReadCompletionState> read_completion_state_;
+  std::unique_ptr<Socket> socks_;
+  // Observation-only: dereferenced after owner reset ONLY inside a genuine
+  // managed native scope whose resource guard still owns the socket tree.
+  raw_ptr<net::TransportClientSocket> endpoint_ = nullptr;
+  raw_ptr<Socket> socks_raw_ = nullptr;
+};
