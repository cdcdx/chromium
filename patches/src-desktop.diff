+
+TEST_F(MivpnHostResolverTest, EndpointPreservesPriorityChangedBeforeStart) {
+  inner_->set_ondemand_mode(true);
+  auto request = Endpoint();
+  request->ChangeRequestPriority(net::HIGHEST);
+  testing::StrictMock<EndpointDelegate> delegate;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(&delegate));
+  EXPECT_EQ(net::HIGHEST, inner_->request_priority(inner_->last_id()));
+  request->ChangeRequestPriority(net::LOWEST);
+  EXPECT_EQ(net::LOWEST, inner_->request_priority(inner_->last_id()));
+  EXPECT_CALL(delegate, OnServiceEndpointRequestFinished(net::OK)).Times(1);
+  inner_->ResolveAllPending();
+  tasks_.RunUntilIdle();
+}
+
+TEST_F(MivpnHostResolverTest, BlockCancelsPendingEndpointAndFinishesOnce) {
+  inner_->set_ondemand_mode(true);
+  auto request = Endpoint();
+  testing::StrictMock<EndpointDelegate> delegate;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(&delegate));
+  ASSERT_TRUE(inner_->has_pending_requests());
+  inner_->ResolveAllPending();
+  policy_->Block();
+  EXPECT_FALSE(inner_->has_pending_requests());
+  EXPECT_TRUE(request->GetEndpointResults().empty());
+  EXPECT_FALSE(request->EndpointsCryptoReady());
+  EXPECT_CALL(delegate,
+              OnServiceEndpointRequestFinished(net::ERR_NETWORK_ACCESS_REVOKED))
+      .Times(1);
+  policy_->Block();
+  tasks_.RunUntilIdle();
+}
+
+TEST_F(MivpnHostResolverTest, EndpointDestructionSuppressesQueuedFinish) {
+  inner_->set_ondemand_mode(true);
+  auto request = Endpoint();
+  testing::StrictMock<EndpointDelegate> delegate;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(&delegate));
+  policy_->Block();
+  request.reset();
+  tasks_.RunUntilIdle();
+}
+
+TEST_F(MivpnHostResolverTest, EndpointShutdownSuppressesQueuedFinish) {
+  inner_->set_ondemand_mode(true);
+  auto request = Endpoint();
+  testing::StrictMock<EndpointDelegate> delegate;
+  ASSERT_EQ(net::ERR_IO_PENDING, request->Start(&delegate));
