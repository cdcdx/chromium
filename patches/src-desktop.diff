+struct MivpnAcceptStep {
+  int result = net::ERR_IO_PENDING;
+  bool stage_transport = false;
+};
+
+// This state outlives the listener, every accepted transport and every posted
+// production completion. In particular, Complete() never writes an output
+// pointer and never calls a method on the (possibly destroyed) mock listener.
+struct MivpnServerTransportState {
+  void Complete(int result) {
+    ASSERT_NE(net::ERR_IO_PENDING, result);
+    ASSERT_TRUE(completion);
+    auto callback = std::move(completion);
+    std::move(callback).Run(result);
+  }
+
+  std::unique_ptr<net::StreamSocket> MakeTransport();
+
+  int listen_calls = 0;
+  mutable int local_address_calls = 0;
+  int accept_calls = 0;
+  int listener_closes = 0;
+  int transports_created = 0;
+  int accepted_closes = 0;
+  int delegate_handoffs = 0;
+  std::vector<MivpnAcceptStep> steps;
+  net::CompletionOnceCallback completion;
+  std::vector<std::unique_ptr<net::SequencedSocketData>> providers;
+};
+
+class MivpnRecordingTCPClientSocket : public net::MockTCPClientSocket {
+ public:
+  MivpnRecordingTCPClientSocket(MivpnServerTransportState& state,
+                                net::SocketDataProvider* provider)
+      : net::MockTCPClientSocket(
+            net::AddressList(
+                net::IPEndPoint(net::IPAddress::IPv4Localhost(), 12345)),
+            net::NetLog::Get(),
+            provider),
+        state_(state) {
+    ++state_->transports_created;
+    // Use the ordinary Read fallback. Cancelling ReadIfReady while a sequenced
+    // provider is paused would violate that provider's kPending precondition.
+    set_enable_read_if_ready(false);
+  }
+
+  ~MivpnRecordingTCPClientSocket() override { ++state_->accepted_closes; }
+
+ private:
+  const raw_ref<MivpnServerTransportState> state_;
+};
+
+std::unique_ptr<net::StreamSocket> MivpnServerTransportState::MakeTransport() {
+  // Spans remain valid for every provider. A pause is followed by an ASYNC EOF,
+  // not another pause or a synchronous event.
+  static const net::MockRead reads[] = {
+      net::MockRead(net::ASYNC, net::ERR_IO_PENDING, 0),
+      net::MockRead(net::ASYNC, net::OK, 1)};
+  auto provider = std::make_unique<net::SequencedSocketData>(
+      reads, base::span<net::MockWrite>());
+  provider->set_connect_data(net::MockConnect(net::SYNCHRONOUS, net::OK));
+  auto transport =
+      std::make_unique<MivpnRecordingTCPClientSocket>(*this, provider.get());
+  providers.push_back(std::move(provider));
+  EXPECT_EQ(net::OK, transport->Connect(base::BindOnce([](int) {
+    ADD_FAILURE() << "Accepted transport unexpectedly connected async";
+  })));
+  return transport;
+}
+
+class MivpnRecordingServerSocket : public net::ServerSocket {
+ public:
+  explicit MivpnRecordingServerSocket(MivpnServerTransportState& state)
+      : state_(state) {}
+  ~MivpnRecordingServerSocket() override { ++state_->listener_closes; }
+
+  int Listen(const net::IPEndPoint&, int, std::optional<bool>) override {
+    ++state_->listen_calls;
+    return net::OK;
+  }
+  int GetLocalAddress(net::IPEndPoint* address) const override {
+    ++state_->local_address_calls;
+    *address = net::IPEndPoint(net::IPAddress::IPv4Localhost(), 54321);
+    return net::OK;
+  }
+  int Accept(std::unique_ptr<net::StreamSocket>* socket,
+             net::CompletionOnceCallback callback) override {
+    return Accept(socket, std::move(callback), nullptr);
+  }
+  int Accept(std::unique_ptr<net::StreamSocket>* socket,
+             net::CompletionOnceCallback callback,
+             net::IPEndPoint* peer_address) override {
+    EXPECT_FALSE(state_->completion);
+    const size_t index = static_cast<size_t>(state_->accept_calls++);
+    const MivpnAcceptStep step =
+        index < state_->steps.size() ? state_->steps[index] : MivpnAcceptStep();
+    if (step.stage_transport) {
+      *socket = state_->MakeTransport();
+      if (peer_address) {
+        *peer_address = net::IPEndPoint(net::IPAddress::IPv4Localhost(), 12345);
+      }
+    }
+    if (step.result == net::ERR_IO_PENDING) {
+      state_->completion = std::move(callback);
+    }
+    return step.result;
+  }
+
+ private:
+  const raw_ref<MivpnServerTransportState> state_;
+};
