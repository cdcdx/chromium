+namespace {
+
+// Like the recording Accept transports above, these observations are external
+// to the production owner. Disconnect and destruction are separate events;
+// SocketDataProvider::socket() is only evidence of the latter. A completer owns
+// the net callback independently, so late Complete() never touches a dead mock.
+enum class MivpnConnectStep {
+  kCreate,
+  kBind,
+  kBeforeConnect,
+  kSendBuffer,
+  kReceiveBuffer,
+  kNoDelay,
+  kKeepAlive,
+  kConnect,
+  kLocalAddress,
+  kPeerAddress,
+  kPumpReadIfReady,
+  kPumpRead,
+  kDisconnect,
+};
+
+constexpr MivpnConnectStep kMivpnConnectReentrySteps[] = {
+    MivpnConnectStep::kCreate,          MivpnConnectStep::kBind,
+    MivpnConnectStep::kBeforeConnect,   MivpnConnectStep::kSendBuffer,
+    MivpnConnectStep::kReceiveBuffer,   MivpnConnectStep::kNoDelay,
+    MivpnConnectStep::kKeepAlive,       MivpnConnectStep::kConnect,
+    MivpnConnectStep::kLocalAddress,    MivpnConnectStep::kPeerAddress,
+    MivpnConnectStep::kPumpReadIfReady, MivpnConnectStep::kPumpRead,
+};
+
+net::AddressList MivpnConnectAddresses() {
+  return net::AddressList(
+      net::IPEndPoint(net::IPAddress::IPv4Localhost(), 12345));
+}
