+TEST_P(MivpnNativeTLSSocks4Test,
+       ResolverCompletionTailMustNotReleaseBeforeUnwind) {
+  // The caller, not the SOCKS-local ledger, proves the complete provider
+  // unwind. HostResolver permits request deletion from its callback; this
+  // provider's legal tail uses only independent state/closure, never freed
+  // request/provider this. No manually injected socket scope hides that tail.
+  resolver_state_->asynchronous = true;
+  ASSERT_NO_FATAL_FAILURE(MakeSocks());
+  base::test::TestFuture<int> connected;
+  base::test::TestFuture<void> tail_checked;
+  resolver_state_->after_complete_callback = base::BindLambdaForTesting([&] {
+    ASSERT_TRUE(connected.Wait(base::RunLoop::Type::kNestableTasksAllowed));
+    EXPECT_EQ(net::OK, connected.Get());
+    EXPECT_EQ(1, resolver_state_->active_frames);
+    EXPECT_TRUE(socks_raw_->IsConnected());
+    EXPECT_TRUE(endpoint_->CanAdoptPendingUpgrade());
+    EXPECT_EQ(1, resolver_state_->requests);
+    EXPECT_FALSE(socks_raw_->CanAdoptPendingUpgrade());
+    EXPECT_EQ(1, resolver_state_->requests);  // pure probe keeps subscriptions.
+    EXPECT_EQ(0, resolver_state_->destructions);
+    EXPECT_EQ(0, verifier_state_->calls);
+    EXPECT_EQ(0, completion_count_);
+    // Do NOT call Prepare in this live provider tail: its explicit caller
+    // precondition is unsatisfied. Fresh-root rejection is separately exercised
+    // in ConnectCallbackAndNestedLoopRejectAdoption (rejection is
+    // irreversible).
+    tail_checked.SetValue();
+  });
+  ASSERT_EQ(net::ERR_IO_PENDING,
+            socks_raw_->Connect(base::BindLambdaForTesting([&](int result) {
+              EXPECT_FALSE(socks_raw_->CanAdoptPendingUpgrade());
+              connected.SetValue(result);
+            })));
+  ASSERT_TRUE(tail_checked.Wait());
+  // This is an outer application-task return boundary, not RunUntilIdle and
+  // not an inner completion signal mistaken for complete provider unwinding.
+  ASSERT_EQ(0, resolver_state_->active_frames);
+  ASSERT_EQ(1, resolver_state_->requests);
+  MakeSocksRoot();
+  ASSERT_TRUE(PrepareAndEnable());
+  EXPECT_EQ(0, resolver_state_->requests);
+  EXPECT_EQ(1, resolver_state_->destructions);
+  ASSERT_EQ(net::OK, WaitHandshake(StartHandshake()));
+  ASSERT_TRUE(work_->socket->CommitPendingUpgrade());
+  RoundTrip();
+  ExpectRealRelay();
+}
