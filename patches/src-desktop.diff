+class MivpnInitialProxyResolvingSocketContextTest
+    : public MivpnProxyResolvingSocketContextTest,
+      public testing::WithParamInterface<bool> {};
+
+TEST_P(MivpnInitialProxyResolvingSocketContextTest,
+       MivpnRetainedFactoryRejectsAllAddressScopesBeforeProxyResolution) {
+  auto context = CreateContext(mojom::MivpnInitialRoutePolicy::New(
+      GetParam() ? base::UnguessableToken() : base::UnguessableToken::Create(),
+      GetParam() ? 0 : 1,
+      GetParam() ? mojom::MivpnRouteMode::kDirect
+                 : mojom::MivpnRouteMode::kBlocked));
+  ASSERT_TRUE(context->impl->IsMivpnRouteBlocked());
+  net::RecordingNetLogObserver observer(
+      context->impl->url_request_context()->net_log(),
+      net::NetLogCaptureMode::kIncludeSensitive);
+  mojo::Remote<mojom::ProxyResolvingSocketFactory> factory;
+  context->remote->CreateProxyResolvingSocketFactory(
+      factory.BindNewPipeAndPassReceiver());
+  context->remote.FlushForTesting();
+  factory.FlushForTesting();
+  ASSERT_TRUE(factory.is_connected());
+
+  for (bool use_tls : {false, true}) {
+    for (const char* url :
+         {"https://example.test:443/", "https://192.0.2.1:443/",
+          "https://[2001:db8::1]:443/", "https://127.0.0.1:443/",
+          "https://[::1]:443/", "https://169.254.1.1:443/",
+          "https://[fe80::1]:443/"}) {
+      SCOPED_TRACE(url);
+      SCOPED_TRACE(use_tls);
+      const GURL target(url);
+      ASSERT_TRUE(target.is_valid());
+      CheckCreate(factory, target, use_tls, net::ERR_NETWORK_ACCESS_REVOKED);
+    }
+  }
+  // Merely relying on the wrapped HostResolver also returns revoke, but starts
+  // proxy resolution first. Observe that real boundary to verify policy wiring
+  // into the independent factory, rather than just checking the final error.
+  EXPECT_TRUE(
+      observer
+          .GetEntriesWithType(net::NetLogEventType::PROXY_RESOLUTION_SERVICE)
+          .empty());
+  EXPECT_EQ(0u, mock_factory_.mock_data().next_index());
+  EXPECT_EQ(0u, mock_factory_.datagram_socket_count());
+  EXPECT_TRUE(mock_factory_.transport_addresses().empty());
+  EXPECT_TRUE(factory.is_connected());
+  factory.reset();
+  context.reset();
+  task_environment_.RunUntilIdle();
+}
