+class MivpnTCPConnectOwnerTest : public MivpnSocketTest {
+ protected:
+  MivpnTCPConnectOwnerTest() : client_factory_(transport_) {}
+
+  void TearDown() override {
+    owner_.reset();
+    factory_.reset();
+    results_.values.clear();
+    task_environment_.RunUntilIdle();
+  }
+
+  void MakeOwner(bool managed = true) {
+    if (managed) {
+      owner_ = std::make_unique<TCPConnectedSocket>(
+          mojo::NullRemote(), net::NetLog::Get(), nullptr, &client_factory_,
+          TRAFFIC_ANNOTATION_FOR_TESTS, policy_);
+    } else {
+      // Exercise the original five-argument constructor, not a null policy
+      // passed to the new overload.
+      owner_ = std::make_unique<TCPConnectedSocket>(
+          mojo::NullRemote(), net::NetLog::Get(), nullptr, &client_factory_,
+          TRAFFIC_ANNOTATION_FOR_TESTS);
+    }
+  }
+
+  void StartOwner(mojom::TCPConnectedSocketOptionsPtr options = nullptr,
+                  const std::optional<net::IPEndPoint>& local = std::nullopt,
+                  base::OnceClosure after = base::OnceClosure()) {
+    owner_->Connect(local, MivpnConnectAddresses(), std::move(options),
+                    results_.Callback(std::move(after)));
+  }
+
+  void CheckOneError(int error) {
+    EXPECT_EQ((std::vector<int>{error}), results_.Errors());
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ((std::vector<int>{error}), results_.Errors());
+  }
+
+  void CheckPendingSetters() {
+    ASSERT_TRUE(transport_.completer.is_connecting());
+    base::test::TestFuture<int> send_buffer;
+    owner_->SetSendBufferSize(4096, send_buffer.GetCallback());
+    EXPECT_EQ(net::OK, send_buffer.Get());
+    EXPECT_EQ(4096, transport_.provider->send_buffer_size());
+    base::test::TestFuture<int> receive_buffer;
+    owner_->SetReceiveBufferSize(8192, receive_buffer.GetCallback());
+    EXPECT_EQ(net::OK, receive_buffer.Get());
+    EXPECT_EQ(8192, transport_.provider->receive_buffer_size());
+    base::test::TestFuture<bool> no_delay;
+    owner_->SetNoDelay(false, no_delay.GetCallback());
+    EXPECT_TRUE(no_delay.Get());
+    EXPECT_FALSE(transport_.provider->no_delay());
+    base::test::TestFuture<bool> keep_alive;
+    owner_->SetKeepAlive(true, 17, keep_alive.GetCallback());
+    EXPECT_TRUE(keep_alive.Get());
+    EXPECT_EQ(net::SocketDataProvider::KeepAliveState::kEnabled,
+              transport_.provider->keep_alive_state());
+    EXPECT_EQ(17, transport_.provider->keep_alive_delay());
+    EXPECT_TRUE(results_.values.empty());
+    EXPECT_EQ(0, transport_.disconnect_calls);
+    EXPECT_EQ(0, transport_.destruct_calls);
+    EXPECT_NE(nullptr, transport_.provider->socket());
+  }
+
+  void CheckRetainedFailureTransport() {
+    EXPECT_EQ(0, transport_.disconnect_calls);
+    EXPECT_EQ(0, transport_.destruct_calls);
+    EXPECT_NE(nullptr, transport_.provider->socket());
+    EXPECT_EQ(0, transport_.Count(MivpnConnectStep::kPumpReadIfReady));
+    // The legacy owner retained its socket and options after a normal error.
+    // Observing a provider alone cannot establish that Set* still borrows it.
+    base::test::TestFuture<bool> no_delay;
+    owner_->SetNoDelay(false, no_delay.GetCallback());
+    EXPECT_TRUE(no_delay.Get());
+    EXPECT_FALSE(transport_.provider->no_delay());
+    EXPECT_EQ(1, transport_.Count(MivpnConnectStep::kNoDelay));
+    EXPECT_EQ(0, transport_.disconnect_calls);
+    EXPECT_EQ(0, transport_.destruct_calls);
+  }
+
+  MivpnConnectTransportState transport_;
+  MivpnConnectResults results_;
+  MivpnRecordingConnectFactory client_factory_;
+  std::unique_ptr<TCPConnectedSocket> owner_;
+};
