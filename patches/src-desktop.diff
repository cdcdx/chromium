+mojom::TCPConnectedSocketOptionsPtr MivpnConnectOptions() {
+  auto options = mojom::TCPConnectedSocketOptions::New();
+  options->send_buffer_size = 4096;
+  options->receive_buffer_size = 8192;
+  options->no_delay = false;
+  options->keep_alive_options = mojom::TCPKeepAliveOptions::New(true, 17U);
+  return options;
+}
