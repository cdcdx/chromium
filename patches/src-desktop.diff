+TEST_F(MivpnSocketTest, IndependentMivpnFactoryContextsDoNotShareBlock) {
+  // Separate URLRequestContexts and policies, not two references to the same
+  // fixture policy. The control listener must still complete a real Accept.
+  auto second_context = net::CreateTestURLRequestContextBuilder()->Build();
+  auto second_policy = base::MakeRefCounted<MivpnResolverPolicy>();
+  auto second_factory = std::make_unique<SocketFactory>(
+      nullptr, second_context.get(), second_policy);
+  MivpnAcceptResults first_results;
+  MivpnAcceptResults second_results;
+  mojo::Remote<mojom::TCPServerSocket> first;
+  mojo::Remote<mojom::TCPServerSocket> second;
+  net::IPEndPoint second_address;
+  base::test::TestFuture<void> first_complete;
+  base::test::TestFuture<void> second_complete;
+  base::test::TestFuture<int> connect;
+  std::unique_ptr<net::TransportClientSocket> peer;
+  base::ScopedClosureRunner cleanup(base::BindLambdaForTesting([&] {
+    // Drop every owner before the stack recording state and completers.
+    first.reset();
+    second.reset();
+    peer.reset();
+    factory_.reset();
+    second_factory.reset();
+    task_environment_.RunUntilIdle();
+  }));
+  for (int index = 0; index < 2; ++index) {
+    base::test::TestFuture<int> create;
+    auto options = mojom::TCPServerSocketOptions::New();
+    options->backlog = 1;
+    auto* factory = index == 0 ? factory_.get() : second_factory.get();
+    auto& remote = index == 0 ? first : second;
+    factory->CreateTCPServerSocket(
+        LocalAddress(), std::move(options), TRAFFIC_ANNOTATION_FOR_TESTS,
+        remote.BindNewPipeAndPassReceiver(),
+        base::BindLambdaForTesting(
+            [&](int error, const std::optional<net::IPEndPoint>& address) {
+              EXPECT_EQ(net::OK, error);
+              EXPECT_TRUE(address);
+              if (index == 1 && address) {
+                second_address = *address;
+              }
+              create.SetValue(error);
+            }));
+    EXPECT_EQ(net::OK, create.Get());
+  }
+  first->Accept(mojo::NullRemote(),
+                first_results.Callback(0, first_complete.GetCallback()));
+  second->Accept(mojo::NullRemote(),
+                 second_results.Callback(0, second_complete.GetCallback()));
+  first.FlushForTesting();
+  second.FlushForTesting();
+  EXPECT_TRUE(first_results.values.empty());
+  EXPECT_TRUE(second_results.values.empty());
+  policy_->Block();
+  EXPECT_TRUE(first_complete.Wait());
+  EXPECT_EQ((std::vector<int>{kRevoked}), first_results.Errors());
+  EXPECT_FALSE(second_policy->blocked());
+  EXPECT_FALSE(second_factory->IsMivpnRouteBlocked());
+  EXPECT_FALSE(second_complete.IsReady());
+  peer = MivpnCreateLoopbackPeer(second_address);
+  const int result = peer->Connect(connect.GetCallback());
+  if (result != net::ERR_IO_PENDING) {
+    connect.SetValue(result);
+  }
+  EXPECT_EQ(net::OK, connect.Get());
+  EXPECT_TRUE(second_complete.Wait());
+  EXPECT_EQ((std::vector<int>{net::OK}), second_results.Errors());
+}
