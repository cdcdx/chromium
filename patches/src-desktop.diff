+namespace network {
+
+// Shared by a context's main resolver and its private standalone resolvers.
+// Requests observe transitions on the NetworkContext sequence.
+class COMPONENT_EXPORT(NETWORK_SERVICE) MivpnResolverPolicy
+    : public base::RefCounted<MivpnResolverPolicy> {
+ public:
+  MivpnResolverPolicy();
+  bool blocked() const { return blocked_; }
+  void Block();
+  base::CallbackListSubscription AddBlockCallback(
+      base::RepeatingClosure callback);
+
+ private:
+  friend class base::RefCounted<MivpnResolverPolicy>;
+  ~MivpnResolverPolicy();
+
+  bool blocked_ = false;
+  base::RepeatingClosureList block_callbacks_;
+};
+
+// Keeps the policy check outside cache, mapping, system DNS, DoH and mDNS.
+// Inner request creation is deferred until Start() has checked the live policy.
+class COMPONENT_EXPORT(NETWORK_SERVICE) MivpnHostResolver final
+    : public net::HostResolver {
+ public:
+  MivpnHostResolver(std::unique_ptr<net::HostResolver> inner,
+                    scoped_refptr<MivpnResolverPolicy> policy);
+  ~MivpnHostResolver() override;
+
+  void OnShutdown() override;
+  std::unique_ptr<ResolveHostRequest> CreateRequest(
+      url::SchemeHostPort host,
+      net::NetworkAnonymizationKey network_anonymization_key,
+      net::handles::NetworkHandle target_network,
+      net::NetLogWithSource net_log,
+      std::optional<ResolveHostParameters> optional_parameters) override;
+  std::unique_ptr<ResolveHostRequest> CreateRequest(
+      const net::HostPortPair& host,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      net::handles::NetworkHandle target_network,
+      const net::NetLogWithSource& net_log,
+      const std::optional<ResolveHostParameters>& optional_parameters) override;
+  std::unique_ptr<ServiceEndpointRequest> CreateServiceEndpointRequest(
+      Host host,
+      net::NetworkAnonymizationKey network_anonymization_key,
+      net::handles::NetworkHandle target_network,
+      net::NetLogWithSource net_log,
+      ResolveHostParameters parameters) override;
+  std::unique_ptr<ProbeRequest> CreateDohProbeRequest() override;
+  std::unique_ptr<MdnsListener> CreateMdnsListener(
+      const net::HostPortPair& host,
+      net::DnsQueryType query_type) override;
+  net::HostCache* GetHostCache() override;
+  base::DictValue GetDnsConfigAsValue() const override;
+  void SetRequestContext(net::URLRequestContext* request_context) override;
+  bool IsHappyEyeballsV3Enabled() const override;
+  net::HostResolverManager* GetManagerForTesting() override;
+  const net::URLRequestContext* GetContextForTesting() const override;
+  net::handles::NetworkHandle GetTargetNetworkForTesting() const override;
+
+  bool is_shutdown() const { return is_shutdown_; }
+  base::CallbackListSubscription AddShutdownCallback(
+      base::RepeatingClosure callback);
+
+ private:
+  std::unique_ptr<net::HostResolver> inner_;
+  scoped_refptr<MivpnResolverPolicy> policy_;
+  bool is_shutdown_ = false;
+  base::RepeatingClosureList shutdown_callbacks_;
+  base::WeakPtrFactory<MivpnHostResolver> weak_factory_{this};
+};
+
+}  // namespace network
+
+#endif  // SERVICES_NETWORK_MIVPN_HOST_RESOLVER_H_
