+          0, base::BindLambdaForTesting([&] {
+            success_callback_observed = true;
+            EXPECT_EQ((std::vector<int>{0}), results_.Ids());
+            EXPECT_EQ((std::vector<int>{net::OK}), results_.Errors());
+            const size_t callbacks_before_block = results_.values.size();
+            policy_->Block();
+            // Observe the success callback's own stack: Block
+            // closes synchronously but cannot run queued revoke
+            // callbacks on its Notify stack.
+            EXPECT_EQ(callbacks_before_block, results_.values.size());
+            EXPECT_EQ((std::vector<int>{0}), results_.Ids());
+            EXPECT_EQ((std::vector<int>{net::OK}), results_.Errors());
+            EXPECT_EQ(1, transport_.listener_closes);
+            EXPECT_EQ(0, transport_.accepted_closes);
+          })));
+  server_->Accept(mojo::NullRemote(), results_.Callback(1));
+  server_->Accept(mojo::NullRemote(), results_.Callback(2));
+  transport_.Complete(net::OK);
+  EXPECT_FALSE(success_callback_observed);
+  EXPECT_TRUE(results_.values.empty());
+  // This drains both the posted success completion and all posted FIFO revoke
+  // tasks. The success-only observation belongs inside its callback above.
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(success_callback_observed);
+  EXPECT_EQ((std::vector<int>{0, 1, 2}), results_.Ids());
+  EXPECT_EQ((std::vector<int>{net::OK, kRevoked, kRevoked}), results_.Errors());
+  EXPECT_EQ(1, transport_.delegate_handoffs);
+  EXPECT_EQ(1, transport_.accept_calls);
+  EXPECT_EQ(0, transport_.accepted_closes);
+  CheckConnected();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ((std::vector<int>{0, 1, 2}), results_.Ids());
+  EXPECT_EQ((std::vector<int>{net::OK, kRevoked, kRevoked}), results_.Errors());
