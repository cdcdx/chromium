+class NET_EXPORT PendingUpgradeControl
+    : public base::RefCounted<PendingUpgradeControl> {
+ public:
+  enum class State { kPending, kCancelled, kCommitted };
+
+  explicit PendingUpgradeControl(PendingUpgradeResourceGuardCallback guard);
+
+  bool cancelled() const { return state_ == State::kCancelled; }
+  bool pending() const { return state_ == State::kPending; }
+  bool committed() const { return state_ == State::kCommitted; }
+  bool prepared() const { return prepared_; }
+  size_t active_native_count() const { return active_native_count_; }
+
+  // This is a resource-only hold: it deliberately does not count as activity.
+  base::ScopedClosureRunner HoldResources() const {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    return !committed() ? resource_guard_.Run() : base::ScopedClosureRunner();
+  }
+
+  void SetCancelCallback(base::RepeatingClosure callback) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    CHECK(!prepared_);
+    cancel_callback_ = std::move(callback);
+  }
+  void MarkPrepared() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    CHECK(pending());
+    prepared_ = true;
+  }
+  void LatchCancelled() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    CHECK(!committed());
+    state_ = State::kCancelled;
+  }
+  void RequestCancel() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!committed()) {
+      // A repeated cancellation must still drain unclaimed close actions.
+      cancel_callback_.Run();
+    }
+  }
+  bool Commit() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!pending() || !prepared_ || active_native_count_ != 0) {
+      return false;
+    }
+    // No callbacks, destruction, event loop, or per-layer partial commit here.
+    state_ = State::kCommitted;
+    return true;
+  }
+  void EnterNative() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    ++active_native_count_;
+  }
+  void LeaveNative() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    CHECK(active_native_count_);
+    --active_native_count_;
+  }
