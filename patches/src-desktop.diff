+class MivpnTCPServerSocketTest : public MivpnSocketTest {
+ protected:
+  MivpnTCPServerSocketTest()
+      : delegate_(std::make_unique<MivpnRecordingServerDelegate>(transport_)) {}
+
+  void TearDown() override {
+    // All pumps/transports and queued callbacks die before their external
+    // recording state and providers, even if an ASSERT returned early.
+    server_.reset();
+    delegate_.reset();
+    factory_.reset();
+    results_.values.clear();
+    task_environment_.RunUntilIdle();
+  }
+
+  void MakeServer(int backlog = 4) {
+    server_ = std::make_unique<TCPServerSocket>(
+        std::make_unique<MivpnRecordingServerSocket>(transport_), backlog,
+        delegate_.get(), TRAFFIC_ANNOTATION_FOR_TESTS, policy_);
+  }
+  void Queue(int count) {
+    for (int id = 0; id < count; ++id) {
+      server_->Accept(mojo::NullRemote(), results_.Callback(id));
+    }
+  }
+  void CheckConnected(size_t index = 0) {
+    ASSERT_LT(index, results_.values.size());
+    auto& result = results_.values[index];
+    ASSERT_EQ(net::OK, result.error);
+    ASSERT_TRUE(result.socket.is_bound());
+    base::test::TestFuture<bool> no_delay;
+    result.socket->SetNoDelay(true, no_delay.GetCallback());
+    EXPECT_TRUE(no_delay.Get());
+    result.socket.FlushForTesting();
+    EXPECT_TRUE(result.socket.is_connected());
+  }
+
+  MivpnServerTransportState transport_;
+  std::unique_ptr<MivpnRecordingServerDelegate> delegate_;
+  MivpnAcceptResults results_;
+  std::unique_ptr<TCPServerSocket> server_;
+};
