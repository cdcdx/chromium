+    ASSERT_EQ(net::OK, listener_->Listen(
+                           net::IPEndPoint(net::IPAddress::IPv4Localhost(), 0),
+                           1, std::nullopt));
+    net::IPEndPoint address;
+    ASSERT_EQ(net::OK, listener_->GetLocalAddress(&address));
+    int accept_result = listener_->Accept(&peer_, accepted_.callback());
+    CreateTransport(address.port());
+    ASSERT_EQ(net::OK, ConnectTransport());
+    ASSERT_EQ(net::OK, accepted_.GetResult(accept_result));
+  }
+
+  void RoundTrip() {
+    ASSERT_TRUE(work_->socket->IsConnected());
+    net::SSLInfo info;
+    ASSERT_TRUE(work_->socket->GetSSLInfo(&info));
+    EXPECT_TRUE(info.is_valid());
+    auto request = base::MakeRefCounted<net::StringIOBuffer>(
+        "GET /native HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
+    int sent = 0;
+    auto drain =
+        base::MakeRefCounted<net::DrainableIOBuffer>(request, request->size());
+    while (drain->BytesRemaining() > 0) {
+      net::TestCompletionCallback callback;
+      int result = callback.GetResult(work_->socket->Write(
+          drain.get(), drain->BytesRemaining(), callback.callback(),
+          TRAFFIC_ANNOTATION_FOR_TESTS));
+      ASSERT_GT(result, 0);
+      sent += result;
+      drain->DidConsume(result);
+    }
+    EXPECT_EQ(request->size(), sent);
+    auto buffer = base::MakeRefCounted<net::IOBufferWithSize>(4096);
+    std::string response;
+    while (response.find("mivpn-native-ok") == std::string::npos) {
+      net::TestCompletionCallback callback;
+      int result = callback.GetResult(work_->socket->Read(
+          buffer.get(), buffer->size(), callback.callback()));
+      ASSERT_GT(result, 0);
+      response.append(buffer->data(), result);
+      ASSERT_LE(response.size(), 16384u);
+    }
+    EXPECT_NE(std::string::npos, response.find("200 OK"));
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::test::ScopedRunLoopTimeout timeout_;
+  TestSocketBrokerImpl socket_broker_;
+  mojo::Receiver<mojom::SocketBroker> receiver_;
+  std::unique_ptr<BrokeredClientSocketFactory> broker_factory_;
+  std::shared_ptr<MivpnNativeVerifierState> verifier_state_;
+  std::unique_ptr<MivpnNativeVerifier> verifier_;
+  std::unique_ptr<net::TransportSecurityState> security_state_;
+  std::unique_ptr<MivpnNativeSCTDelegate> sct_delegate_;
+  std::unique_ptr<net::SSLClientContext> ssl_context_;
+  std::shared_ptr<MivpnNativeTransportHooks> transport_hooks_;
+  std::unique_ptr<net::TestNetworkQualityEstimator> nqe_;
+  bool with_watcher_ = false;
