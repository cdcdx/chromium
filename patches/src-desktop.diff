+void BrokeredTcpClientSocket::InstallPendingUpgradeControl(
+    scoped_refptr<net::PendingUpgradeControl> control) {
+  CHECK(!pending_upgrade_control_);
+  CHECK_EQ(native_activity_->active(), 0u);
+  pending_upgrade_control_ = std::move(control);
+  brokered_socket_->InstallPendingUpgradeControl(pending_upgrade_control_);
