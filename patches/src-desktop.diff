+    net::handles::NetworkHandle target_network,
+    net::NetLogWithSource net_log,
+    std::optional<ResolveHostParameters> optional_parameters) {
+  return std::make_unique<GuardedResolveRequest>(
+      weak_factory_.GetWeakPtr(), policy_,
+      base::BindOnce(
+          [](net::HostResolver* resolver, url::SchemeHostPort host,
+             net::NetworkAnonymizationKey key,
+             net::handles::NetworkHandle network, net::NetLogWithSource log,
+             std::optional<ResolveHostParameters> parameters) {
+            return resolver->CreateRequest(std::move(host), std::move(key),
+                                           network, std::move(log),
+                                           std::move(parameters));
+          },
+          base::Unretained(inner_.get()), std::move(host),
+          std::move(network_anonymization_key), target_network,
+          std::move(net_log), std::move(optional_parameters)));
+}
+
+std::unique_ptr<net::HostResolver::ResolveHostRequest>
+MivpnHostResolver::CreateRequest(
+    const net::HostPortPair& host,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    net::handles::NetworkHandle target_network,
+    const net::NetLogWithSource& net_log,
+    const std::optional<ResolveHostParameters>& optional_parameters) {
+  return std::make_unique<GuardedResolveRequest>(
+      weak_factory_.GetWeakPtr(), policy_,
+      base::BindOnce(
+          [](net::HostResolver* resolver, const net::HostPortPair& host,
+             const net::NetworkAnonymizationKey& key,
+             net::handles::NetworkHandle network,
+             const net::NetLogWithSource& log,
+             const std::optional<ResolveHostParameters>& parameters) {
+            return resolver->CreateRequest(host, key, network, log, parameters);
+          },
+          base::Unretained(inner_.get()), host, network_anonymization_key,
+          target_network, net_log, optional_parameters));
+}
+
+std::unique_ptr<net::HostResolver::ServiceEndpointRequest>
+MivpnHostResolver::CreateServiceEndpointRequest(
+    Host host,
+    net::NetworkAnonymizationKey network_anonymization_key,
+    net::handles::NetworkHandle target_network,
+    net::NetLogWithSource net_log,
+    ResolveHostParameters parameters) {
+  return std::make_unique<GuardedServiceEndpointRequest>(
+      weak_factory_.GetWeakPtr(), policy_,
