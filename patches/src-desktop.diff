+    EXPECT_EQ(0, read_completion_state_->destructions);
+    EXPECT_EQ(0, socks_hooks_->destructions);
+    EXPECT_EQ(0, work_destructions_);
+    base::RunLoop(base::RunLoop::Type::kNestableTasksAllowed).RunUntilIdle();
