+base::test::ScopedFeatureList MivpnNativeRetryFeatures() {
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeatureWithParameters(
+      net::features::kTimeoutTcpConnectAttempt,
+      {{"TimeoutTcpConnectAttemptMin", "1s"},
+       {"TimeoutTcpConnectAttemptMax", "1s"}});
+  return features;
+}
+
+net::AddressList MivpnNativeRetryAddresses() {
+  net::AddressList addresses(
+      net::IPEndPoint(net::IPAddress::IPv4Localhost(), 12345));
+  addresses.push_back(net::IPEndPoint(net::IPAddress::IPv4Localhost(), 12346));
+  return addresses;
+}
+
+enum class MivpnNativeRetryCancelAction { kBlock, kDestroy, kBlockThenDestroy };
+
+}  // namespace
+
+// Do not change MivpnSocketTest's real-time environment: only these native
+// timeout regression cases use MOCK_TIME. Feature overrides are installed
+// before constructing the task environment or any native socket.
+class MivpnTCPConnectNativeRetryTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_EQ(base::Seconds(1),
+              net::features::kTimeoutTcpConnectAttemptMin.Get());
+    ASSERT_EQ(base::Seconds(1),
+              net::features::kTimeoutTcpConnectAttemptMax.Get());
+  }
+
+  void TearDown() override {
+    // Recording state and callbacks outlive all native owners and queued
+    // non-nestable resource releases, including an early ASSERT return.
+    owner_.reset();
+    task_environment_.RunUntilIdle();
+  }
+
+  void StartNative() {
+    owner_ = std::make_unique<TCPConnectedSocket>(
+        mojo::NullRemote(), net::NetLog::Get(), nullptr, &client_factory_,
+        TRAFFIC_ANNOTATION_FOR_TESTS, policy_);
+    owner_->Connect(std::nullopt, MivpnNativeRetryAddresses(),
+                    MivpnConnectOptions(), results_.Callback());
+    ASSERT_EQ(1, transport_.create_calls);
+    ASSERT_EQ(1, transport_.connect_calls);
+    ASSERT_EQ(1u, transport_.attempts.size());
+    EXPECT_EQ(MivpnNativeRetryAddresses()[0], transport_.attempts[0]);
+    EXPECT_EQ(1, transport_.before_connect_calls);
+    EXPECT_EQ((std::vector<int>{net::OK}), transport_.before_connect_results);
+    EXPECT_TRUE(transport_.native_completions.empty());
+    EXPECT_TRUE(results_.values.empty());
+    EXPECT_EQ(0, transport_.disconnect_calls);
+    EXPECT_EQ(0, transport_.destruct_calls);
+    EXPECT_EQ(0, transport_.active_methods);
+  }
+
+  void RunNestedNativeProbe(bool after_configuration) {
+    EXPECT_EQ(2, transport_.before_connect_calls);
+    EXPECT_EQ(1, transport_.active_before_callbacks);
+    EXPECT_GT(transport_.active_methods, 0);
+    EXPECT_EQ(1, transport_.disconnect_calls);
+    EXPECT_EQ(0, transport_.destruct_calls);
+    base::RunLoop nested(base::RunLoop::Type::kNestableTasksAllowed);
+    task_environment_.GetMainThreadTaskRunner()->PostTask(
+        FROM_HERE, base::BindLambdaForTesting([&] {
+          EXPECT_TRUE(base::RunLoop::IsNestedOnCurrentThread());
+          EXPECT_EQ(0, transport_.destruct_calls);
+          EXPECT_EQ(1, transport_.active_before_callbacks);
+          EXPECT_GT(transport_.active_methods, 0);
+          if (after_configuration) {
+            ++transport_.callback_return_nested_probes;
+          } else {
+            ++transport_.setter_nested_probes;
+          }
+          nested.Quit();
+        }));
+    nested.Run();
+    EXPECT_EQ(0, transport_.destruct_calls);
+  }
+
+  void StartNativeCancellation(MivpnConnectStep step,
+                               MivpnNativeRetryCancelAction action) {
+    transport_.hook_step = step;
+    transport_.hook = base::BindLambdaForTesting([&, action] {
+      EXPECT_EQ(2, transport_.before_connect_calls);
+      EXPECT_EQ(1u, transport_.attempts.size());
+      EXPECT_GT(transport_.active_methods, 0);
+      if (action != MivpnNativeRetryCancelAction::kDestroy) {
+        policy_->Block();
+        // This observation is made before pumping any nested task. Bottom-up
+        // cancellation is synchronous; the owner still holds its callback.
+        EXPECT_EQ(1, transport_.disconnect_calls);
+        EXPECT_TRUE(transport_.cancelled);
+        EXPECT_TRUE(results_.values.empty());
+        EXPECT_EQ(0, transport_.destruct_calls);
+      }
+      if (action != MivpnNativeRetryCancelAction::kBlock) {
+        owner_.reset();
+        EXPECT_FALSE(owner_);
+        // Resource-only keepalive must not keep the service owner alive or
+        // let a previously posted revoke claim its member callback first.
+        EXPECT_EQ((std::vector<int>{net::ERR_ABORTED}), results_.Errors());
+      }
+      EXPECT_EQ(1, transport_.disconnect_calls);
+      EXPECT_TRUE(transport_.cancelled);
+      EXPECT_EQ(0, transport_.destruct_calls);
+      RunNestedNativeProbe(false);
+    });
+    transport_.after_configuration = base::BindLambdaForTesting([&] {
+      EXPECT_TRUE(transport_.alive_after_configuration);
+      RunNestedNativeProbe(true);
+    });
+    StartNative();
+  }
+
+  void CheckNativeCancellation(MivpnConnectStep step, int expected_error) {
+    // There is no manual before-connect invocation. The first real native
+    // attempt remains pending until the explicitly configured timer expires.
+    task_environment_.FastForwardBy(base::Milliseconds(999));
+    ASSERT_EQ(1u, transport_.attempts.size());
+    EXPECT_EQ(1, transport_.before_connect_calls);
+    EXPECT_EQ(0, transport_.hook_calls);
+    EXPECT_TRUE(results_.values.empty());
+    task_environment_.FastForwardBy(base::Milliseconds(1));
+    task_environment_.RunUntilIdle();
+
+    ASSERT_EQ(2, transport_.before_connect_calls);
+    ASSERT_EQ(2u, transport_.before_connect_results.size());
+    EXPECT_EQ(net::OK, transport_.before_connect_results[0]);
+    EXPECT_NE(net::OK, transport_.before_connect_results[1]);
+    EXPECT_NE(net::ERR_IO_PENDING, transport_.before_connect_results[1]);
+    EXPECT_EQ(1, transport_.hook_calls);
+    EXPECT_EQ(1, transport_.setter_nested_probes);
+    EXPECT_EQ(1, transport_.callback_return_nested_probes);
+    EXPECT_TRUE(transport_.alive_after_configuration);
+    EXPECT_EQ(1, transport_.disconnect_calls);
+    EXPECT_EQ(1, transport_.destruct_calls);
+    EXPECT_EQ(0, transport_.active_methods);
+    EXPECT_EQ(0, transport_.active_before_callbacks);
+    EXPECT_EQ(0, transport_.options_after_cancel);
+    // Public native Disconnect reset its real member callback. DoConnectLoop
+    // must not start a new attempt; DidCompleteConnect must not Run that now
+    // empty callback or invent a native terminal result after cancellation.
+    EXPECT_EQ(1u, transport_.attempts.size());
+    EXPECT_TRUE(transport_.native_completions.empty());
+    EXPECT_EQ((std::vector<int>{expected_error}), results_.Errors());
+
+    std::vector<MivpnConnectStep> all_options;
+    std::vector<MivpnConnectStep> options_before_cancel;
+    bool reached_cancel = false;
+    for (auto option : kMivpnAsyncOptionSteps) {
+      all_options.push_back(option);
+      if (!reached_cancel) {
+        options_before_cancel.push_back(option);
+        reached_cancel = option == step;
+      }
+    }
+    EXPECT_TRUE(reached_cancel);
+    EXPECT_EQ(all_options, transport_.first_options);
+    EXPECT_EQ(options_before_cancel, transport_.second_options);
+
+    policy_->Block();
+    task_environment_.FastForwardBy(base::Minutes(1));
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ(2, transport_.before_connect_calls);
+    EXPECT_EQ(1u, transport_.attempts.size());
+    EXPECT_EQ(1, transport_.disconnect_calls);
+    EXPECT_EQ(1, transport_.destruct_calls);
+    EXPECT_TRUE(transport_.native_completions.empty());
+    EXPECT_EQ((std::vector<int>{expected_error}), results_.Errors());
+  }
+
+  base::test::ScopedFeatureList feature_list_ = MivpnNativeRetryFeatures();
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::IO,
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  std::unique_ptr<net::NetworkChangeNotifier> notifier_ =
+      net::NetworkChangeNotifier::CreateMockIfNeeded();
+  scoped_refptr<MivpnResolverPolicy> policy_ =
+      base::MakeRefCounted<MivpnResolverPolicy>();
+  MivpnNativeRetryTransportState transport_;
+  MivpnConnectResults results_;
+  MivpnNativeRetrySocketFactory client_factory_{transport_};
+  std::unique_ptr<TCPConnectedSocket> owner_;
+};
+
+class MivpnTCPConnectNativeRetryOptionsTest
+    : public MivpnTCPConnectNativeRetryTest,
+      public testing::WithParamInterface<MivpnConnectStep> {};
+
+TEST_P(MivpnTCPConnectNativeRetryOptionsTest,
+       NativeMivpnRetryOptionBlockSynchronouslyCancelsWithoutSecondAttempt) {
+  StartNativeCancellation(GetParam(), MivpnNativeRetryCancelAction::kBlock);
+  CheckNativeCancellation(GetParam(), kRevoked);
+  EXPECT_TRUE(owner_);
+}
+
+TEST_P(MivpnTCPConnectNativeRetryOptionsTest,
+       NativeMivpnRetryOptionDestroyAbortsOwnerWithoutExtendingItsLifetime) {
+  StartNativeCancellation(GetParam(), MivpnNativeRetryCancelAction::kDestroy);
+  CheckNativeCancellation(GetParam(), net::ERR_ABORTED);
+  EXPECT_FALSE(owner_);
+}
+
+TEST_P(MivpnTCPConnectNativeRetryOptionsTest,
+       NativeMivpnRetryOptionBlockThenDestroyLetsMemberAbortWin) {
+  StartNativeCancellation(GetParam(),
+                          MivpnNativeRetryCancelAction::kBlockThenDestroy);
+  CheckNativeCancellation(GetParam(), net::ERR_ABORTED);
+  EXPECT_FALSE(owner_);
+}
+
+INSTANTIATE_TEST_SUITE_P(MivpnNativeRetryOptionReentryPoints,
+                         MivpnTCPConnectNativeRetryOptionsTest,
+                         testing::ValuesIn(kMivpnAsyncOptionSteps));
+
+TEST_F(MivpnTCPConnectNativeRetryTest,
+       NativeMivpnAllowedTimeoutFallbackDeliversSecondAttemptErrorExactlyOnce) {
+  StartNative();
+  task_environment_.FastForwardBy(base::Milliseconds(999));
+  ASSERT_EQ(1u, transport_.attempts.size());
+  EXPECT_TRUE(results_.values.empty());
+  task_environment_.FastForwardBy(base::Milliseconds(1));
+  task_environment_.RunUntilIdle();
+
+  ASSERT_EQ(2u, transport_.attempts.size());
+  const auto addresses = MivpnNativeRetryAddresses();
+  EXPECT_EQ(addresses[0], transport_.attempts[0]);
+  EXPECT_EQ(addresses[1], transport_.attempts[1]);
+  EXPECT_EQ(2, transport_.before_connect_calls);
+  EXPECT_EQ((std::vector<int>{net::OK, net::OK}),
+            transport_.before_connect_results);
+  // Native fallback invalidates its existing WeakPtrs in DoDisconnect. This
+  // control proves that ordinary fallback still delivers the real member
+  // callback instead of being dropped by an old WeakPtr captured before it.
+  EXPECT_EQ((std::vector<int>{net::ERR_CONNECTION_REFUSED}),
+            transport_.native_completions);
+  EXPECT_EQ((std::vector<int>{net::ERR_CONNECTION_REFUSED}), results_.Errors());
+  std::vector<MivpnConnectStep> all_options;
+  for (auto step : kMivpnAsyncOptionSteps) {
+    all_options.push_back(step);
+  }
+  EXPECT_EQ(all_options, transport_.first_options);
+  EXPECT_EQ(all_options, transport_.second_options);
+  EXPECT_EQ(0, transport_.hook_calls);
+  EXPECT_EQ(0, transport_.disconnect_calls);
+  EXPECT_EQ(0, transport_.destruct_calls);
+  EXPECT_EQ(0, transport_.active_methods);
+  EXPECT_EQ(0, transport_.active_before_callbacks);
+  EXPECT_TRUE(owner_);
+
+  policy_->Block();
+  task_environment_.FastForwardBy(base::Minutes(1));
+  EXPECT_EQ(2u, transport_.attempts.size());
+  EXPECT_EQ(2, transport_.before_connect_calls);
+  EXPECT_EQ((std::vector<int>{net::ERR_CONNECTION_REFUSED}),
+            transport_.native_completions);
+  EXPECT_EQ((std::vector<int>{net::ERR_CONNECTION_REFUSED}), results_.Errors());
+  EXPECT_EQ(0, transport_.disconnect_calls);
+  EXPECT_EQ(0, transport_.destruct_calls);
+}
