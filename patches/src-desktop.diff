+    return weak_factory_.GetWeakPtr();
+  }
+
+  std::unique_ptr<net::SSLClientSocket> socket;
+
+ private:
+  friend class base::RefCounted<MivpnNativeTLSWork>;
+  ~MivpnNativeTLSWork() {
+    weak_factory_.InvalidateWeakPtrs();
+    if (socket) {
+      socket->Disconnect();
+      socket.reset();
+    }
+    ++*destructions_;
+  }
+
+  raw_ptr<int> destructions_;
+  base::WeakPtrFactory<MivpnNativeTLSWork> weak_factory_{this};
+};
