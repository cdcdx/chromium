+class GuardedServiceEndpointRequest final
+    : public GuardedRequest<net::HostResolver::ServiceEndpointRequest>,
+      private net::HostResolver::ServiceEndpointRequest::Delegate {
+ public:
+  using GuardedRequest::GuardedRequest;
+  using ClientDelegate = net::HostResolver::ServiceEndpointRequest::Delegate;
+
+  int Start(ClientDelegate* delegate) override {
+    const int rv = Begin();
+    if (rv != net::OK) {
+      return rv;
+    }
+    if (priority_) {
+      inner()->ChangeRequestPriority(*priority_);
+    }
+    delegate_ = delegate;
+    const int result = inner()->Start(this);
+    if (result != net::ERR_IO_PENDING) {
+      delegate_ = nullptr;
+    }
+    return result;
+  }
+  base::span<const net::ServiceEndpoint> GetEndpointResults() override {
+    return inner() ? inner()->GetEndpointResults()
+                   : base::span<const net::ServiceEndpoint>();
+  }
+  const std::set<std::string>& GetDnsAliasResults() override {
+    return inner() ? inner()->GetDnsAliasResults() : empty_aliases_;
+  }
+  bool EndpointsCryptoReady() override {
+    return inner() && inner()->EndpointsCryptoReady();
+  }
+  net::ResolveErrorInfo GetResolveErrorInfo() override {
+    return inner() ? inner()->GetResolveErrorInfo()
+                   : net::ResolveErrorInfo(error());
+  }
+  const net::HostCache::EntryStaleness* GetStaleInfo() const override {
+    return inner() ? inner()->GetStaleInfo() : nullptr;
+  }
+  bool IsStaleWhileRefreshing() const override {
+    return inner() && inner()->IsStaleWhileRefreshing();
+  }
+  void ChangeRequestPriority(net::RequestPriority priority) override {
+    priority_ = priority;
+    if (inner()) {
+      inner()->ChangeRequestPriority(priority);
+    }
+  }
+  std::optional<net::ResolutionDetails> GetResolutionDetails() const override {
+    return inner() ? inner()->GetResolutionDetails() : std::nullopt;
+  }
+  std::string DebugString() const override {
+    return inner() ? inner()->DebugString() : "MiVPN resolver denied";
+  }
+
+ private:
+  void OnRevoked(bool notify) override {
+    if (!notify) {
+      delegate_ = nullptr;
+    } else if (delegate_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &GuardedServiceEndpointRequest::OnServiceEndpointRequestFinished,
+              weak_factory_.GetWeakPtr(), error()));
+    }
+  }
+  void OnServiceEndpointsUpdated() override {
+    if (delegate_ && error() == net::OK) {
+      delegate_->OnServiceEndpointsUpdated();
+    }
+  }
+  void OnServiceEndpointRequestFinished(int rv) override {
+    ClientDelegate* delegate = delegate_;
+    delegate_ = nullptr;
+    if (delegate) {
+      delegate->OnServiceEndpointRequestFinished(error() == net::OK ? rv
+                                                                    : error());
+    }
+  }
+
+  raw_ptr<ClientDelegate> delegate_ = nullptr;
+  std::optional<net::RequestPriority> priority_;
+  const std::set<std::string> empty_aliases_;
+  base::WeakPtrFactory<GuardedServiceEndpointRequest> weak_factory_{this};
+};
