+struct MivpnNativeVerifierState {
+  int calls = 0;
+  int active_requests = 0;
+  int request_destructions = 0;
+  net::CompletionOnceCallback callback;
+  base::OnceClosure on_request_destroy;
+  base::test::TestFuture<void> entered;
+};
