+struct MivpnAcceptedResult {
+  int id;
+  int error;
+  std::optional<net::IPEndPoint> address;
+  mojo::Remote<mojom::TCPConnectedSocket> socket;
+  mojo::ScopedDataPipeConsumerHandle receive;
+  mojo::ScopedDataPipeProducerHandle send;
+};
+
+class MivpnAcceptResults {
+ public:
+  TCPServerSocket::AcceptCallback Callback(
+      int id,
+      base::OnceClosure after = base::OnceClosure()) {
+    return base::BindOnce(
+        [](MivpnAcceptResults* results, int id, base::OnceClosure after,
+           int error, const std::optional<net::IPEndPoint>& address,
+           mojo::PendingRemote<mojom::TCPConnectedSocket> socket,
+           mojo::ScopedDataPipeConsumerHandle receive,
+           mojo::ScopedDataPipeProducerHandle send) {
+          EXPECT_EQ(error == net::OK, address.has_value());
+          EXPECT_EQ(error == net::OK, socket.is_valid());
+          EXPECT_EQ(error == net::OK, receive.is_valid());
+          EXPECT_EQ(error == net::OK, send.is_valid());
+          EXPECT_TRUE(std::none_of(results->values.begin(),
+                                   results->values.end(),
+                                   [id](const MivpnAcceptedResult& value) {
+                                     return value.id == id;
+                                   }));
+          MivpnAcceptedResult value{
+              id, error, address, {}, std::move(receive), std::move(send)};
+          if (socket.is_valid()) {
+            value.socket.Bind(std::move(socket));
+          }
+          results->values.push_back(std::move(value));
+          if (after) {
+            std::move(after).Run();
+          }
+        },
+        this, id, std::move(after));
+  }
+
+  std::vector<int> Ids() const {
+    std::vector<int> ids;
+    for (const auto& value : values) {
+      ids.push_back(value.id);
+    }
+    return ids;
+  }
+  std::vector<int> Errors() const {
+    std::vector<int> errors;
+    for (const auto& value : values) {
+      errors.push_back(value.error);
+    }
+    return errors;
+  }
+
+  std::vector<MivpnAcceptedResult> values;
+};
+
+class MivpnRecordingServerDelegate final : public TCPServerSocket::Delegate {
+ public:
+  explicit MivpnRecordingServerDelegate(MivpnServerTransportState& state)
+      : state_(state) {}
+
+  void OnAccept(
+      std::unique_ptr<TCPConnectedSocket> socket,
+      mojo::PendingReceiver<mojom::TCPConnectedSocket> receiver) override {
+    ++state_->delegate_handoffs;
+    connections_.Add(std::move(socket), std::move(receiver));
+    auto hook = std::move(on_accept);
+    if (hook) {
+      // The hook may destroy this delegate as well as the server. No member is
+      // accessed after it returns.
+      std::move(hook).Run();
+    }
+  }
+
+  base::OnceClosure on_accept;
+
+ private:
+  const raw_ref<MivpnServerTransportState> state_;
+  mojo::UniqueReceiverSet<mojom::TCPConnectedSocket> connections_;
+};
+
+class MivpnRecordingSocketObserver : public mojom::SocketObserver {
+ public:
+  mojo::PendingRemote<mojom::SocketObserver> Bind() {
+    return receiver_.BindNewPipeAndPassRemote();
+  }
+  void OnReadError(int error) override { read_errors.push_back(error); }
+  void OnWriteError(int error) override { write_errors.push_back(error); }
+
+  mojo::Receiver<mojom::SocketObserver> receiver_{this};
+  std::vector<int> read_errors;
+  std::vector<int> write_errors;
+};
