+
+void BrokeredTcpClientSocket::ClosePendingUpgrade() {
+  auto scope = TrackPendingUpgradeActivity();
+  CHECK(PendingUpgradeCancelled());
+  // Always recurse: reentrant cancellation can finish the inner layer's
+  // unclaimed actions while a different callback destructor is running.
+  brokered_socket_->ClosePendingUpgrade();
+  read_pending_ = false;
+  write_pending_ = false;
+  if (before_connect_callback_close_.Claim()) {
+    before_connect_callback_.Reset();
+    before_connect_callback_close_.Complete();
+  }
+}
