# 复制为 .env。优先级：命令行 > 同名环境变量（也支持大写）> .env > 默认值。
# 代理仅对本次进程及其子进程生效，不修改 Git 全局配置；空值表示直连。
https_proxy=

# -- depot_tools
depot_tools_src=https://chromium.googlesource.com/chromium/tools/depot_tools.git
# 相对路径按工作区根目录解析。
depot_tools_dir=depot_tools

# -- chromium
chromium_src=https://chromium.googlesource.com/chromium/src.git
chromium_ver=154.0.8037.21
# 1 = 使用 GitHub Chromium 镜像；0 = 使用上述源。
chromium_mirror=0

# -- arupa
arupa_desktop_src=
arupa_desktop_ver=
arupa_android_src=
arupa_android_ver=
# -- nomad
nomad_desktop_src=
nomad_desktop_ver=
nomad_android_src=
nomad_android_ver=

# -- 可选：多版本 Xcode 环境中使用的开发工具目录。
# chromium_developer_dir=/Applications/Xcode.app/Contents/Developer
# pc_developer_dir=/Applications/Xcode.app/Contents/Developer

# -- PC 浏览器 安装 .NET SDK
# dotnet_path=/usr/local/share/dotnet/dotnet

# -- Android 浏览器 安装的 SDK/JDK
# android_home=/path/to/Android/Sdk
# java_home=/path/to/jdk
