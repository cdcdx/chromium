# 复制为 .env。优先级：命令行 > 同名环境变量（也支持大写）> .env > 默认值。
# 代理仅对本次进程及其子进程生效，不修改 Git 全局配置；空值表示直连。
https_proxy=

# -- depot_tools
depot_tools_src=https://chromium.googlesource.com/chromium/tools/depot_tools.git
# 相对路径按工作区根目录解析。
depot_tools_dir=depot_tools

# -- chromium
chromium_src=https://chromium.googlesource.com/chromium/src.git
chromium_ver=154.0.8037.21
# 1 = 使用 GitHub Chromium 镜像；0 = 使用上述源。
chromium_mirror=0

# -- arupa
arupa_desktop_src=
arupa_desktop_ver=
arupa_android_src=
arupa_android_ver=
# -- nomad
nomad_desktop_src=
nomad_desktop_ver=
nomad_android_src=
nomad_android_ver=

# -- 可选：多版本 Xcode 环境中使用的开发工具目录。
# chromium_developer_dir=/Applications/Xcode.app/Contents/Developer
# pc_developer_dir=/Applications/Xcode.app/Contents/Developer

# Windows：从微软官方下载、符合当前 src/docs/windows_build_instructions.md 的 VS bootstrapper。
# 仅 fetch host-deps --os win 或 --install-host-deps 调用；保留安装器交互，不自动重启。
# vs_installer_path=C:\Downloads\vs_Community.exe

# -- PC 浏览器 安装 .NET SDK
# dotnet_path=/usr/local/share/dotnet/dotnet
# fetch dotnet：版本优先使用此项，否则读取 nomadbrowser.pc/global.json；均未指定时使用 channel。
# dotnet_version=10.0.100
# dotnet_channel=10.0

# WebUI：校验 package.json engines.node；当前 PATH 不兼容时尝试本机 nvm 已安装版本。
# 显式指定 node_path 时只使用此安装，必须包含配套 npm。
# node_path=/path/to/node/bin/node

# -- Android 浏览器 安装的 SDK/JDK
# android_home=/path/to/Android/Sdk
# java_home=/path/to/jdk
# fetch android-sdk：默认复用 Chromium DEPS 的 SDK/JDK；按浏览器 Gradle 配置追加 SDK 包。
# 空格分隔，分号属于包名；版本需与项目 compileSdk/buildToolsVersion 匹配。
# android_sdk_packages=platform-tools platforms;android-36 build-tools;36.0.0
