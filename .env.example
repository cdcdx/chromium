# 复制为 .env 后按需修改；已 export 的同名环境变量优先于本文件。

# ── 代理（拉 chromium / cipd / gsutil 用）───────────────────────────────────
# 置空 = 不需要代理，脚本会清掉残留的环境变量与 git 全局 http/https.proxy
https_proxy=http://127.0.0.1:7890

# ── depot_tools ────────────────────────────────────────────────────────────
depot_tools_src=https://chromium.googlesource.com/chromium/tools/depot_tools.git
# 落点，相对路径按工作区根解析；缺省 <工作区>/depot_tools -> ~/depot_tools
depot_tools_dir=depot_tools

# ── chromium ───────────────────────────────────────────────────────────────
chromium_src=https://chromium.googlesource.com/chromium/src.git
chromium_ver=154.0.8037.21
# googlesource 经代理约 120 秒被切断；auto=检测到代理就换 GitHub 镜像，1=强制镜像，0=不换
chromium_mirror=auto

# ── nomad ──────────────────────────────────────────────────────────────────
nomad_kernel_src=
nomad_kernel_ver=
nomad_pc_src=
nomad_pc_ver=

# ── macOS Xcode（多版本并存时按项目选；Chromium 与 PC 要求的 Swift/SDK 不一样）──
# chromium_developer_dir=/Applications/Xcode-26.5.0.app/Contents/Developer
# PC 的 macOS 原生 helper 需要 Swift 6.4 那份（xcode-select 指向 Xcode-26.5 时会报
# "this SDK is not supported by the compiler"）
pc_developer_dir=/Applications/Xcode.app/Contents/Developer

# ── 可选 ───────────────────────────────────────────────────────────────────
# clone_history=shallow    首次对 src 浅克隆（命令行 --shallow 等价）
# kernel_ref=              固定内核仓分支或标签（优先于 nomad_kernel_ver）
# pc_ref=                  固定 PC 仓分支或标签（优先于 nomad_pc_ver）
